# The first end-to-end boring-ui application: an editable todo list (docs/design-notes/
# boring-ui-draft.md, "First implementation target"). Add an item in a modal `Sheet` with its own draft
# state, edit an item in place, select, reorder and delete in a keyed `List` — with the state of
# surviving rows preserved. Driven headlessly by tests/todo_test.br; nothing here knows about a window.
#
# Deviations from the draft's sketch, each waiting on something not built yet:
#   - `Todo`'s editable fields are shared `Slot`s, so a row's native controls can `bind` them. The draft
#     binds a field projection of a keyed element (`TextField(value = item.title)` with `bind Todo item`);
#     keyed element projections exist, but projecting one FIELD into a native control's bind does not.
#   - `selection` is a string key ("" = none) rather than an `int?`, and `Separator` is absent.

use boring.ui.*

pub struct Todo:
    pub int id
    pub var mut Slot<string>'actor title
    pub var mut Slot<bool>'actor completed

pub Todo newTodo(int id, string title):
    Todo(id = id, title = Slot(value = title), completed = Slot(value = false))

# The modal form for a new item. Its `title` is draft state: dismissing the sheet destroys it. The parent's
# collection, id counter and presentation flag cross the boundary through `bind`. The title field asks for
# focus when the sheet opens (`titleFocused` starts true); Add is the Enter default and is disabled while
# the title is blank; Cancel is the Escape action.
pub view NewTodoSheet:
    bind [Todo] items
    bind int nextId
    bind bool isPresented

    state string title = ""
    state bool titleFocused = true

    def add():
        let raw = "{title}"
        let clean = raw.trim()
        if clean.length == 0:
            return
        items.push(newTodo(nextId, clean))
        nextId += 1
        isPresented = false

    body():
        let raw = "{title}"
        let blank = raw.trim().length == 0
        Column(alignment = .Leading, spacing = 12.0):
            Text(content = "New item", font = .Title)
            Focused(value = titleFocused):
                TextField(value = title, label = "Title", placeholder = "Title")
            Row(alignment = .Center, spacing = 8.0):
                Spacer()
                Button(label = "Cancel", role = .Cancel, onActivate = ():
                    isPresented = false)
                Disabled(value = blank):
                    DefaultAction:
                        Button(label = "Add", onActivate = ():
                            self.add())

# A row reports a request (here: "delete") through one callback. (The callback is also what keeps `boring
# build` from deriving `PartialEq` for the view: it does not look at a field type's own derives, and `Todo`'s
# shared-slot fields cannot be compared.)
pub use RowCommand as def void(string)

# `card` sets the row on a white rounded card (the macOS grouped-list look); off by default so the headless goldens stay as they were.
pub view TodoRow:
    Todo item
    RowCommand onCommand
    bool card = false

    body():
        let content = Row(alignment = .Center, spacing = 8.0):
            Toggle(value = item.completed, label = "Completed")
            TextField(value = item.title, label = "Item title", placeholder = "")
            Button(label = "Delete", onActivate = ():
                onCommand("delete"))
        if card:
            Padding(insets = 3.0):
                Background(color = "ElevatedSurface", radius = 10.0):
                    Padding(insets = 8.0):
                        content
        else:
            content

pub view TodoApp:
    bool cards = false
    state [Todo] items = [newTodo(1, "Design boring-ui"), newTodo(2, "Implement the vertical slice")]
    state int nextId = 3
    state string selection = ""
    state bool showingNewItem = false

    def moveItem(int fromIndex, int toIndex):
        items.move(fromIndex, toIndex)

    def dropAt([int] indices):
        items.removeIndices(indices)

    def command(string name, int id):
        if name == "delete":
            var at = -1
            for i in 0..<items.length:
                if items[i].id == id:
                    at = i
            if at >= 0:
                items.removeIndices([at])

    body():
        let page = Column(alignment = .Leading, spacing = 4.0):
            Row(alignment = .Center, spacing = 8.0):
                Text(content = "Todos", font = .Title)
                Spacer()
                Button(label = "Add", onActivate = ():
                    showingNewItem = true)
            List(selection = selection, onMove = (a, b): self.moveItem(a, b), onDelete = (indices): self.dropAt(indices)):
                for item in items with item.id:
                    TodoRow(item = item, card = cards, onCommand = (name):
                        self.command(name, item.id))
            Sheet(isPresented = showingNewItem):
                NewTodoSheet(items = items, nextId = nextId, isPresented = showingNewItem)
        if cards:
            Background(color = "Surface", radius = 14.0):
                Padding(insets = 14.0):
                    page
        else:
            page
