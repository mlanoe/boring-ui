# The window's application: the Todo under a logo (PNG) and a photo (progressive JPEG) that a button fades out and back (a `Transition` under an `AnimationScope`
# triggered by the toggled value; the Todo below slides into the freed space). Apart from main.br so pace_test.br can run it headlessly.

use boring.ui.*
use ui.core.*
use todo.todo.*

# The Todo under a logo: the `Image` view's `source` is the name of a decoded file (`loadImages`).
view WindowApp:
    state bool showLogo = true

    def setShowLogo(bool v):
        showLogo = v

    body():
        Column(alignment = .Leading, spacing = 8.0):
            Button(label = "Toggle logo", onActivate = ():
                showLogo = !showLogo)
            AnimationScope(curve = "EaseInOut", duration = 300.0, value = "{showLogo}"):
                Column(alignment = .Leading, spacing = 8.0):
                    if showLogo:
                        Transition(insertion = .Fade, removal = .Fade):
                            Row(alignment = .Center, spacing = 8.0):
                                Image(source = "logo.png", width = 96.0, height = 64.0, label = "Logo")
                                Image(source = "photo.jpg", width = 96.0, height = 64.0, label = "Landscape")
                    TodoApp()

struct AppRoot as ViewBuilder:
    req View buildView(mut Runtime rt): WindowApp()
