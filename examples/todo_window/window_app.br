# The window's application: the Todo under a logo (PNG) and a photo (progressive JPEG) that a button fades out and back (a `Transition` under an `AnimationScope`
# triggered by the toggled value; the Todo below slides into the freed space). Apart from main.br so pace_test.br can run it headlessly.

use boring.ui.*
use ui.core.*
use todo.todo.*
use ui.controls.*
use ui.mobile.*

pub use BoolAction as def void(bool)

def string screenText(ScreenInfo i):
    "Screen {i.width as int}x{i.height as int} · {sizeClass(i)}"

# The Todo under a logo: the `Image` view's `source` is the name of a decoded file (`loadImages`).
# `phase` (0...1, advanced by the host while `busy`) drives the indeterminate bar; `onBusy` tells the host whether the
# bar is shown, so the window only redraws every frame while something moves.
view WindowApp:
    float phase
    bool busy
    ScreenInfo info = ScreenInfo()
    BoolAction onBusy
    # The theme picker's choices (see `themeForChoice`) and what the host does when one is picked.
    int themeIndex = 0
    int appearanceIndex = 0
    IndexAction onTheme
    IndexAction onAppearance

    state bool showLogo = true
    state int stepped = 3
    state int segment = 0
    state int pick = 1
    state int tab = 0
    state int jump = 0
    state int lang = 0
    state bool askOpen = false
    state bool confirmOpen = false
    state string verdict = ""
    state int dy = 2026
    state int dm = 11
    state int dd = 2
    state int th = 14
    state int tm = 30
    state string bin = "-"
    state string gest = "-"
    state int taps = 0
    state string swipeDir = ""
    state float cr = 0.0
    state float cg = 122.0
    state float cb = 255.0

    def setShowLogo(bool v):
        showLogo = v

    def menuChosen(int i):
        if i == 2:
            confirmOpen = true
        else:
            stepped = i

    def fruitDropped(string v):
        bin = v

    def tapped():
        taps += 1

    def gestured(string what):
        gest = what

    def setDate(int y, int m, int d):
        dy = y
        dm = m
        dd = d

    def setTime(int h, int m):
        th = h
        tm = m

    def decided(string v):
        verdict = v

    body():
        Column(alignment = .Leading, spacing = 8.0):
            Alert(isPresented = askOpen, title = "Discard changes?", message = "This cannot be undone.", buttons = ["Keep", "Discard"], cancel = 0, danger = 1, onSelect = (i):
                self.decided(if i == 1: "Discarded" else: "Kept"))
            ConfirmationDialog(isPresented = confirmOpen, title = "Delete this item?", options = ["Delete"], danger = 0, onSelect = (i):
                self.decided("Deleted"))
            Tooltip(text = "Fades the logo and the photo out and back"):
                Button(label = "Toggle logo", onActivate = ():
                    showLogo = !showLogo)
            Row(alignment = .Center, spacing = 8.0):
                SegmentedControl(selected = themeIndex, options = ["Auto", "macOS", "Fluent", "Adwaita"], onSelect = (i):
                    onTheme(i))
                SegmentedControl(selected = appearanceIndex, options = ["System", "Light", "Dark"], onSelect = (i):
                    onAppearance(i))
            AnimationScope(curve = "EaseInOut", duration = 300.0, value = "{showLogo}"):
                Column(alignment = .Leading, spacing = 8.0):
                    if showLogo:
                        Transition(insertion = .Fade, removal = .Fade):
                            Row(alignment = .Center, spacing = 8.0):
                                Image(source = "logo.png", width = 96.0, height = 64.0, label = "Logo")
                                Image(source = "photo.jpg", width = 96.0, height = 64.0, label = "Landscape")
                    TodoApp(cards = true)
                    DisclosureGroup(title = "Controls"):
                        Frame(maxHeight = 150.0):
                            Scroll(anchor = "tabs", request = jump, animated = true):
                                Column(alignment = .Leading, spacing = 8.0):
                                    Button(label = "Jump to tabs", onActivate = ():
                                        jump += 1)
                                    ContextMenu(items = ["Copy", "Paste", "Delete"], danger = 2, onSelect = (i):
                                        self.menuChosen(i)):
                                        Text(content = "Right-click here")
                                    Button(label = "Ask…", onActivate = ():
                                        askOpen = true)
                                    Text(content = verdict)
                                    DatePicker(year = dy, month = dm, day = dd, onChange = (y, m, d):
                                        self.setDate(y, m, d))
                                    Text(content = "{dy}-{dm}-{dd}")
                                    TimePicker(hour = th, minute = tm, minuteStep = 5, onChange = (h, m):
                                        self.setTime(h, m))
                                    ColorPicker(red = cr, green = cg, blue = cb, label = "Accent", editableHex = true)
                                    Row(alignment = .Center, spacing = 12.0):
                                        Draggable(payload = "fruit:Apple", preview = "Apple"):
                                            Background(color = "#ff9e98", radius = 6.0):
                                                Padding(insets = 8.0):
                                                    Text(content = "Apple")
                                        Draggable(payload = "fruit:Pear"):
                                            Background(color = "#8fe3a6", radius = 6.0):
                                                Padding(insets = 8.0):
                                                    Text(content = "Pear")
                                        DropTarget(accepts = "fruit", onDrop = (v):
                                            self.fruitDropped(v)):
                                            Border(color = "#8e8e93"):
                                                Padding(insets = 8.0):
                                                    Text(content = "Drop here: {bin}")
                                    Adaptive(info = info):
                                        Text(content = "{screenText(info)} — compact layout")
                                        Text(content = "{screenText(info)} — regular layout")
                                    Desktop(width = 340.0, height = 190.0, windowWidth = 150.0, titles = ["Notes", "Counter"]):
                                        Text(content = "Drag my title bar")
                                        Button(label = "Pressed {taps}", onActivate = ():
                                            self.tapped())
                                    OnTap(onActivate = ():
                                        self.gestured("tap")):
                                        OnTap(count = 2, onActivate = ():
                                            self.gestured("double tap")):
                                            OnLongPress(onActivate = ():
                                                self.gestured("long press")):
                                                OnSwipe(value = swipeDir, onActivate = ():
                                                    self.gestured("swipe {swipeDir}")):
                                                    Background(color = "#e5e5ea", radius = 6.0):
                                                        Padding(insets = 10.0):
                                                            Text(content = "Gestures: {gest}")
                                    Canvas(width = 160.0, height = 60.0):
                                        At(x = 0.0, y = 0.0):
                                            Rectangle(color = "#f2f2f7", width = 160.0, height = 60.0, radius = 6.0, stroke = "#d1d1d6")
                                        At(x = 12.0, y = 54.0 - 4.0 * (stepped as float)):
                                            Rectangle(color = colorHex(cr, cg, cb), width = 18.0, height = 4.0 * (stepped as float), radius = 3.0)
                                        At(x = 40.0, y = 54.0 - 2.0 * (stepped as float)):
                                            Rectangle(color = "#34c759", width = 18.0, height = 2.0 * (stepped as float), radius = 3.0)
                                        At(x = 68.0, y = 54.0 - 3.0 * (stepped as float)):
                                            Capsule(color = "#ff9500", width = 18.0, height = 3.0 * (stepped as float))
                                        At(x = 110.0, y = 10.0):
                                            Circle(color = "#ff3b30", diameter = 8.0 + 4.0 * (stepped as float), stroke = "#ffffff", strokeWidth = 2.0)
                                        At(x = 138.0, y = 38.0):
                                            Rectangle(width = 14.0, height = 14.0, radius = 3.0, stroke = "#007aff", strokeWidth = 2.0)
                                    Stepper(value = stepped, min = 0, max = 10, label = "Count", onChange = (v):
                                        stepped = v)
                                    ProgressBar(value = (stepped as float) / 10.0, width = 200.0, label = "Count")
                                    SegmentedControl(selected = segment, options = ["Day", "Week", "Month"], onSelect = (i):
                                        segment = i)
                                    Picker(selected = pick, options = ["Red", "Green", "Blue"], onSelect = (i):
                                        pick = i)
                                    NavigationStack(title = "Settings", names = ["profile", "about"], titles = ["Profile", "About"]):
                                        Column(alignment = .Leading, spacing = 4.0):
                                            NavigationLink(label = "Profile", to = "profile")
                                            NavigationLink(label = "About", to = "about")
                                        Form:
                                            Section(header = "Account", footer = "Shown on your profile."):
                                                LabeledContent(label = "Name"):
                                                    Text(content = "Demo user")
                                                LabeledContent(label = "Language"):
                                                    Menu(label = (["English", "Français", "Deutsch"])[lang], items = ["English", "-", "Français", "Deutsch"], onSelect = (i):
                                                        lang = (if i > 1: i - 1 else: i))
                                            Section(header = "More"):
                                                NavigationLink(label = "About", to = "about")
                                        Column(alignment = .Leading, spacing = 8.0):
                                            Text(content = "A boring-ui demo window.")
                                            Grid(columns = 3, spacing = 6.0):
                                                Button(label = "One", onActivate = ():
                                                    stepped = 1)
                                                Button(label = "Two", onActivate = ():
                                                    stepped = 2)
                                                Button(label = "Three", onActivate = ():
                                                    stepped = 3)
                                                Button(label = "Four", onActivate = ():
                                                    stepped = 4)
                                                Button(label = "Five", onActivate = ():
                                                    stepped = 5)
                                    ScrollAnchor(name = "tabs"):
                                        TabView(selected = tab, titles = ["Info", "Work"], onSelect = (i):
                                            tab = i):
                                            Text(content = "Nothing is running.")
                                            Column(alignment = .Leading, spacing = 4.0):
                                                Tooltip(text = "Starts or stops the indeterminate bar"):
                                                    Button(label = (if busy: "Stop" else "Start"), onActivate = ():
                                                        onBusy(!busy))
                                                if busy:
                                                    IndeterminateBar(phase = phase, width = 200.0)

def void ignoreIndex(int i):
    pass

struct AppRoot as ViewBuilder:
    Slot<bool>'actor busy = Slot(value = false)
    req View buildView(mut Runtime rt): WindowApp(phase = 0.0, busy = busy.value, onTheme = (i): ignoreIndex(i), onAppearance = (i): ignoreIndex(i), onBusy = (v):
        busy.value = v)
