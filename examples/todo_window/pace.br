# The window's frame pacing: the animator between the runtime and the rasterizer. Kept apart from main.br (a Screen
# program, which only builds on the GPU targets) so tests/pace_test.br can drive it headlessly.

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.anim.*
use ui.animator.*
use ui.events.*

def Placed placedOf(Runtime rt, int w, int h):
    layout(rt, w as float, h as float) else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

# What the window keeps between frames besides the runtime: the animator, whether the runtime's layout has changed
# since the last `commit`, and where the pointer was.
struct Motion:
    var Animator an = Animator()
    var bool dirty = false
    var int lastX = 0 - 1
    var int lastY = 0 - 1
    # the previous primary press (time in seconds, position) and how many quick presses in a row it ended
    var float32 pressAt = 0.0 - 10.0
    var int pressX = 0 - 100
    var int pressY = 0 - 100
    var int clicks = 0
    # the time of the previous frame (for inertia) and whether a fling is still running
    var float32 lastSeconds = 0.0
    var bool rolling = false
    # whether the busy indicator was on at the previous frame
    var bool busyShown = false
    # the caret last reported to the input method (window points), and whether one has been
    var int caretX = 0
    var int caretY = 0
    var bool caretKnown = false

def void begin(mut Motion m, Placed first):
    commit(m.an, first, nil, [], 0.0)

# The layout to paint at `now`. `eventful`: an input event reached the runtime this frame. A frame that changed the
# runtime hands the animator the new layout (the transaction's animation and triggered scopes apply to it); while an
# animation runs, one that carries none (pointer motion, say) waits, so it does not snap the animation in flight. A
# removal that finished is released first.
def Placed paceFrame(mut Motion m, mut Runtime rt, Builder host, bool eventful, int x, int y, int w, int h, float32 seconds):
    let now = (seconds as float) * 1000.0
    if eventful or x != m.lastX or y != m.lastY:
        m.dirty = true
    m.lastX = x
    m.lastY = y
    if takeCompletion(m.an, now):
        for id in retiringIds(rt):
            _ = endRetirement(rt, host, id)
            m.dirty = true
    if m.dirty:
        # a `Scroll(anchor, request)` asked to scroll: applied with the laid-out window before this frame's layout is taken
        _ = applyScrollRequests(rt, host, placedOf(rt, w, h))
        let animation = rt.takeAnimation()
        let triggers = rt.takeTriggers()
        if isAnimating(m.an, now) and animation == nil and triggers.length == 0:
            return presentation(m.an, now)
        commit(m.an, placedOf(rt, w, h), animation, triggers, now)
        m.dirty = false
    presentation(m.an, now)

# Whether another frame is due without any input: an animation is running or finishing, or a change waits.
def bool pacePending(Motion m, float32 seconds):
    let now = (seconds as float) * 1000.0
    m.dirty or m.rolling or isAnimating(m.an, now) or !m.an.completionTaken

def void touch(mut Motion m):
    m.dirty = true

# A primary press at (x, y) at `seconds`: a second or third press close in time and place is a double or triple click
# (word / whole text); Shift extends the selection of a text field from where it was anchored.
def void pressWith(mut Motion m, mut Runtime rt, Builder host, int w, int h, int x, int y, float32 seconds, bool shift):
    var near = x - m.pressX < 5 and m.pressX - x < 5 and y - m.pressY < 5 and m.pressY - y < 5
    if near and seconds - m.pressAt < 0.4:
        m.clicks = m.clicks + 1
    else:
        m.clicks = 1
    m.pressAt = seconds
    m.pressX = x
    m.pressY = y
    var mods = ""
    if shift:
        mods = "Range"
    _ = pointerDownClicks(rt, host, placedOf(rt, w, h), x as float, y as float, mods, m.clicks)

# One finger (a touch host, or the right mouse button standing in for one on a desktop): see events.br `touchDown`.
def void touchStart(mut Runtime rt, Builder host, int w, int h, int x, int y, float32 seconds):
    _ = touchDown(rt, host, placedOf(rt, w, h), x as float, y as float, seconds as float)

def void touchDrag(mut Motion m, mut Runtime rt, Builder host, int w, int h, int x, int y, float32 seconds):
    if touchMove(rt, host, placedOf(rt, w, h), x as float, y as float, seconds as float):
        m.dirty = true

def void touchEnd(mut Motion m, mut Runtime rt, Builder host, int w, int h, int x, int y, float32 seconds):
    _ = touchUp(rt, host, placedOf(rt, w, h), x as float, y as float, seconds as float)
    m.dirty = true

# Advances a running fling by the time since the previous frame; `rolling` keeps the loop asking for frames while it lasts.
def void paceMomentum(mut Motion m, mut Runtime rt, Builder host, int w, int h, float32 seconds):
    var dt = (seconds - m.lastSeconds) as float
    m.lastSeconds = seconds
    if dt < 0.001:
        dt = 0.001
    if dt > 0.1:
        dt = 0.1
    m.rolling = false
    if momentumActive(rt):
        m.rolling = stepMomentum(rt, host, placedOf(rt, w, h), dt)
        m.dirty = true

# The system cancelled the touch (a call, the window lost): nothing is pressed and nothing flings.
def void touchAbort(mut Motion m, mut Runtime rt):
    touchCancel(rt)
    m.dirty = true

# The cells the loop writes and the root builder reads (the indeterminate bar of the controls panel).
struct BusyCells:
    Slot<float>'actor phase = Slot(value = 0.0)
    Slot<bool>'actor busy = Slot(value = false)

# The indeterminate bar's phase (0...1) at `seconds`: one sweep every 1.4 s.
def float phaseAt(float32 seconds):
    let t = (seconds as float) * 0.7
    let whole = t as int
    t - (whole as float)

# Keeps the window in step with the busy indicator: while `cells.busy` the phase advances and the root is rebuilt every frame (its
# new phase), and once more when `busy` has just changed (the view reads it). True when the runtime was rebuilt, so the frame must be painted.
def bool syncBusy(mut Motion m, mut Runtime rt, Builder host, BusyCells cells, float32 seconds):
    let busy = cells.busy.value
    if !busy and !m.busyShown:
        return false
    cells.phase.value = phaseAt(seconds)
    m.busyShown = busy
    rt.beginEvent()
    rt.invalidateRoot()
    rt.endEvent(host)
    m.dirty = true
    true

def bool isBusy(BusyCells cells):
    cells.busy.value
