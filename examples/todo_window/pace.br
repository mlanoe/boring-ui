# The window's frame pacing: the animator between the runtime and the rasterizer. Kept apart from main.br (a Screen
# program, which only builds on the GPU targets) so tests/pace_test.br can drive it headlessly.

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.anim.*
use ui.animator.*
use ui.events.*

def Placed placedOf(Runtime rt, int w, int h):
    layout(rt, w as float, h as float) else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

# What the window keeps between frames besides the runtime: the animator, whether the runtime's layout has changed
# since the last `commit`, and where the pointer was.
struct Motion:
    var Animator an = Animator()
    var bool dirty = false
    var int lastX = 0 - 1
    var int lastY = 0 - 1
    # the previous primary press (time in seconds, position) and how many quick presses in a row it ended
    var float32 pressAt = 0.0 - 10.0
    var int pressX = 0 - 100
    var int pressY = 0 - 100
    var int clicks = 0

def void begin(mut Motion m, Placed first):
    commit(m.an, first, nil, [], 0.0)

# The layout to paint at `now`. `eventful`: an input event reached the runtime this frame. A frame that changed the
# runtime hands the animator the new layout (the transaction's animation and triggered scopes apply to it); while an
# animation runs, one that carries none (pointer motion, say) waits, so it does not snap the animation in flight. A
# removal that finished is released first.
def Placed paceFrame(mut Motion m, mut Runtime rt, Builder host, bool eventful, int x, int y, int w, int h, float32 seconds):
    let now = (seconds as float) * 1000.0
    if eventful or x != m.lastX or y != m.lastY:
        m.dirty = true
    m.lastX = x
    m.lastY = y
    if takeCompletion(m.an, now):
        for id in retiringIds(rt):
            _ = endRetirement(rt, host, id)
            m.dirty = true
    if m.dirty:
        let animation = rt.takeAnimation()
        let triggers = rt.takeTriggers()
        if isAnimating(m.an, now) and animation == nil and triggers.length == 0:
            return presentation(m.an, now)
        commit(m.an, placedOf(rt, w, h), animation, triggers, now)
        m.dirty = false
    presentation(m.an, now)

# Whether another frame is due without any input: an animation is running or finishing, or a change waits.
def bool pacePending(Motion m, float32 seconds):
    let now = (seconds as float) * 1000.0
    m.dirty or isAnimating(m.an, now) or !m.an.completionTaken

def void touch(mut Motion m):
    m.dirty = true

# A primary press at (x, y) at `seconds`: a second or third press close in time and place is a double or triple click
# (word / whole text); Shift extends the selection of a text field from where it was anchored.
def void pressWith(mut Motion m, mut Runtime rt, Builder host, int w, int h, int x, int y, float32 seconds, bool shift):
    var near = x - m.pressX < 5 and m.pressX - x < 5 and y - m.pressY < 5 and m.pressY - y < 5
    if near and seconds - m.pressAt < 0.4:
        m.clicks = m.clicks + 1
    else:
        m.clicks = 1
    m.pressAt = seconds
    m.pressX = x
    m.pressY = y
    var mods = ""
    if shift:
        mods = "Range"
    _ = pointerDownClicks(rt, host, placedOf(rt, w, h), x as float, y as float, mods, m.clicks)
