# Opening the "Controls" panel of the window must not push the window's content past its bottom edge: the panel's content scrolls
# in a bounded region and the header stays visible. Run from this directory:
#   boring run controls_panel_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.events.*
use pace
use window_app

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

let host = ViewRoot(inner = AppRoot())
mut rt = Runtime()
rt.start(host)
let before = placedOf(rt, 640, 360)
# the closed window fits (a `Popover` around the first button, the tooltip, must not steal room from the stack)
assert(before.h <= 360.001)
let buttons = ofKind(before, "Button")
let header = buttons[buttons.length - 1]
assert_eq(header.props["label"] else (""), "▸ Controls")
assert(click(rt, host, before, header.x + 2.0, header.y + 2.0))

let after = placedOf(rt, 640, 360)
assert(after.h <= 360.001)
let opened = ofKind(after, "Button")
var found = false
for b in opened:
    if (b.props["label"] else ("")) == "▾ Controls":
        found = true
        assert(b.y + b.h <= 360.001)
assert(found)

# "Jump to tabs" scrolls the panel so the tab bar is inside its viewport (a request applied with the laid-out window).
def Placed? firstOfKind(Placed p, string kind):
    if p.kind == kind:
        return p
    for c in p.children:
        if let f = firstOfKind(c, kind):
            return f
    nil

def Placed? labelled(Placed p, string label):
    if p.kind == "Button" and (p.props["label"] else ("")) == label:
        return p
    for c in p.children:
        if let f = labelled(c, label):
            return f
    nil

let jumpButton = labelled(after, "Jump to tabs") else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))
assert(click(rt, host, after, jumpButton.x + 2.0, jumpButton.y + 2.0))
# The panel's scroller is `animated`: the request starts a glide, stepped here until it lands.
assert(!applyScrollRequests(rt, host, placedOf(rt, 640, 360)))
assert(glideActive(rt))
var glideSteps = 0
while glideActive(rt) and glideSteps < 200:
    _ = stepGlide(rt, host, placedOf(rt, 640, 360), 0.05)
    glideSteps += 1
assert(!glideActive(rt))
let scrolled = placedOf(rt, 640, 360)
let viewport = firstOfKind(scrolled, "Scroll") else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))
let info = labelled(scrolled, "Info") else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))
assert(info.y >= viewport.y - 0.001)
assert(info.y + info.h <= viewport.y + viewport.h + 0.001)
print "controls_panel_test ok"
