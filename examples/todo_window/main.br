# The Todo application (examples/todo) in a native window: the view runtime lays it out headlessly, its display
# list is encoded once, and the tiled kernel rasterizer (render/src/raster_tile.br) draws it straight into the
# pixel buffer `screen.present` shows. On `--target wgpu` that buffer never goes back to the host.
#
# What this does NOT do yet (and why) is the point of the exercise; see README.md, "Window".
#   - the frame is drawn from one fixed display list: the kernel's buffers cannot be replaced from inside the
#     render loop, so input does not change the picture;
#   - the loop renders every frame instead of when something changed.

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.theme.*
use render.display_list.*
use render.raster.*
use render.raster_font.*
use render.raster_gpu.*
use render.raster_tile.*
use todo.todo.*

struct AppRoot as ViewBuilder:
    req View buildView(mut Runtime rt): TodoApp()

let width = 640
let height = 360

# The headless part: lay the Todo application out and encode its display list.
def Encoded todoFrame():
    mut rt = Runtime()
    rt.start(ViewRoot(inner = AppRoot()))
    let placed = layout(rt, 640.0, 360.0) else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))
    # the Todo paints no window background of its own: put the theme's under it (opaque pixels, not transparent)
    mut list = [Command(kind = "FillRect", x = 0.0, y = 0.0, w = 640.0, h = 360.0, hex = placed.theme.colorNamed("WindowBackground"))]
    for c in displayList(placed):
        list.push(c)
    encode(list, 640, 360)

def [uint] atlasWords():
    let small = buildAtlas()
    mut [uint] atlas = []
    for i in 0..<small.length:
        atlas.push(small[i] as uint)
    atlas

# Top-level code is ordinary code, run once before the window opens: the frame is laid out and encoded a
# single time and the kernel constructor takes the values directly (its `init` uploads them).
let frame = todoFrame()
let bins = bin(frame, width, height)

let screen = Screen(Dimension(width, height), title = "boring-ui Todo")
mut k = TileKernel(frame.f, frame.u, atlasWords(), bins.starts, bins.list, bins.across, frame.count, width, height)

kernel:
    loop:
        k(block = (16, 16), grid = ((width + 15) / 16, (height + 15) / 16))
        screen.present(k.out)
        if screen.key("\x1B"):
            break
