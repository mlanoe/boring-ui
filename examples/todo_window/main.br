# The Todo application (`examples/todo`) in a native window, driven by `ui.window` (`src/window.br`) and
# `text.window` (`text/src/window.br`).
#
# `ui.window` handles pointer/touch/wheel/keyboard/IME routing, clipboard sync, accessibility requests,
# safe-area and theme-choice sync, animation frame pacing (`Motion`), and IME caret geometry (`stepWindow`).
# `text.window` wires `swash` font measurement (`windowTheme`), glyph rasterization (`windowGlyphCache`),
# and display-list encoding (`firstFrame`, `encodeFrame`).

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.theme.*
use ui.accessibility.*
use ui.system_settings.*
use ui.mobile.*
use ui.window.*
use render.raster_tile.*
use text.glyph_run.*
use text.window.*
use window_app
use host_settings

# `phase` and `busy` are cells the loop writes (the indeterminate bar of the controls panel): the builder reads them
# whenever the root is rebuilt, and the view's `onBusy` callback flips `busy`.
struct ThemedRoot as ViewBuilder:
    Theme theme
    Slot<float>'actor phase
    Slot<bool>'actor busy
    Slot<ScreenInfo>'actor screenInfo
    Slot<SystemSettings>'actor settings
    Slot<int>'actor themeChoice
    Slot<int>'actor appearanceChoice

    def void pickTheme(int i):
        themeChoice.value = i

    def void pickAppearance(int i):
        appearanceChoice.value = i

    req View buildView(mut Runtime rt):
        Provide(value = themeForChoice(theme, settings.value, themeChoice.value, appearanceChoice.value), children = [SafeArea(info = screenInfo.value, children = [WindowApp(phase = phase.value, busy = busy.value, info = screenInfo.value, themeIndex = themeChoice.value, appearanceIndex = appearanceChoice.value, onTheme = (i): self.pickTheme(i), onAppearance = (i): self.pickAppearance(i), onBusy = (v):
            busy.value = v)])])

let fontsDir = "../../../text/fonts"
let theme = windowTheme(fontsDir)
mut cache = windowGlyphCache(fontsDir)
let cells = BusyCells()
cells.settings.value = readSystemSettings()
let host = ViewRoot(inner = ThemedRoot(theme = theme, phase = cells.phase, busy = cells.busy, screenInfo = cells.screenInfo, settings = cells.settings, themeChoice = cells.themeChoice, appearanceChoice = cells.appearanceChoice))
mut rt = Runtime()
rt.start(host)

let width = 640
let height = 360
let images = loadImagesFrom("../assets", ["logo.png", "photo.jpg"])
let frame = firstFrame(host, images, cache, width, height)
let bins = bin(frame, width, height)

mut pace = Motion()
begin(pace, placedOf(rt, width, height))
var lastShown = placedOf(rt, width, height)

let screen = Screen(Dimension(width, height), title = "boring-ui Todo", redraw = "demand", hidpi = true)
mut k = TileKernel(frame.f, frame.u, atlasWords(), frame.pool, bins.starts, bins.list, bins.across, frame.count, width, height)

kernel:
    loop:
        if screen.resized:
            k.out = blankPicture(screen.width * screen.height)
            k.width = screen.width
            k.height = screen.height
        for r in screen.accessibilityRequests:
            noteAccessibilityRequest(pace, rt, host, lastShown, r.id, r.action, r.arg)
        if shouldPollSystem(pace, screen.focus_gained, screen.time):
            applySystem(pace, rt, host, cells, readSystemSettings())
        let scale = screen.scale as float
        let shown = stepWindow(
            pace,
            rt,
            host,
            cells,
            screen.width,
            screen.height,
            scale,
            screen.resized,
            screen.mouse.x,
            screen.mouse.y,
            screen.mouse_pressed("left"),
            screen.mouse_released("left"),
            screen.mouse_pressed("right"),
            screen.mouse_released("right"),
            screen.mouse.right,
            screen.mouse.scroll_x as float,
            screen.mouse.scroll_y as float,
            screen.touchStarted,
            screen.touching,
            screen.touchEnded,
            screen.touchCancelled,
            screen.touch.x,
            screen.touch.y,
            screen.key_events,
            screen.shift,
            screen.meta or screen.ctrl,
            screen.clipboard,
            screen.marked,
            screen.marked_end,
            screen.text,
            screen.safeTop,
            screen.safeLeft,
            screen.safeBottom,
            screen.safeRight,
            screen.time
        )
        if pace.clipboardChanged:
            screen.setClipboard(pace.clipboardOut)
        screen.setAccessibility(axFrame(rt, shown))
        let next = encodeFrame(shown, images, cache, scale, screen.width, screen.height)
        lastShown = shown
        let nextBins = bin(next, screen.width, screen.height)
        k.f = next.f
        k.u = next.u
        k.img = next.pool
        k.bstart = nextBins.starts
        k.blist = nextBins.list
        k.across = nextBins.across
        k.count = next.count
        k(block = (16, 16), grid = ((screen.width + 15) / 16, (screen.height + 15) / 16))
        screen.present(k.out)
        if pace.redrawImmediate:
            screen.requestRedraw()
        else:
            screen.requestRedrawAfter(pace.redrawAfterMs)
        screen.setImeAllowed(pace.imeAllowed)
        screen.setImeArea(pace.imeX, pace.imeY, pace.imeW, pace.imeH)
        if screen.meta and screen.key("q"):
            break
