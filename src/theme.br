# boring-ui theme (docs/design-notes/boring-ui-draft.md, "Environment, theme, and control styles",
# "Semantic tokens", "Component styles", "Theme validation and fallback"). Layer 3/4 support: a
# concrete, immutable library value — not a trait, not a global. A `Theme` holds only OVERRIDES on
# top of a built-in base (light, or dark): a missing entry inherits from the base, so
# `Theme()` is the complete system theme and `Theme().withColor(...)` replaces one token. Builders
# return a new theme (the old one is untouched). A theme is installed for a subtree with
# `Provide(value = theme)`; the nearest provider wins (the core resolves it onto every mounted node,
# see `Mounted.theme` in core.br).
#
# Roles: `ColorRole`, `MetricRole` (below) and `FontRole` / `ButtonRole` / `ButtonStyle` (boring.ui).
# Deviations from the draft, each deliberate: the destructive roles are `Danger`/`OnDanger` (a
# `.Destructive` dot-prefix would be ambiguous with `ButtonRole.Destructive`) and `Text`, `Border`,
# `Shadow` are `PrimaryText`, `ControlBorder`, `ShadowColor` (an enum variant named like a view would
# shadow `Text(...)` in every module that imports the theme); a few headless
# metrics are added (`ControlPadding`, `ToggleSize`, `TextFieldWidth`, `TextFieldHeight`,
# `StackSpacing`) because the fixture layout needs them; `MinimumHitSize` defaults to 0 (touch
# themes raise it); colors are `#RRGGBB` / `#RRGGBBAA` strings, not a `Color` type; token values
# live in entry lists rather than dictionaries (dictionary iteration differs under `boring build`).
# Variants: a color override may be for one appearance (`light`, `dark`, `contrast`) or for all; `contrast` also
# switches the built-in base to its increased-contrast palettes, and `textScale` multiplies every font size.
# Not here yet: adaptive spacing pairs, custom style traits (`<View> body(Context)`), inherited `.buttonStyle(...)` providers.

use boring.ui.*

pub enum ColorRole:
    WindowBackground
    Surface
    ElevatedSurface
    PrimaryText
    SecondaryText
    PlaceholderText
    DisabledText
    Accent
    OnAccent
    Danger
    OnDanger
    ControlBorder
    Separator
    FocusRing
    Selection
    ShadowColor

pub enum MetricRole:
    ControlPadding
    ToggleSize
    TextFieldWidth
    TextFieldHeight
    StackSpacing
    SpacerMinimum
    ControlRadius
    ControlBorderWidth
    FocusRingWidth
    ToggleFocusRingWidth
    # Corner radius of a toggle's box; the renderer clamps it to half the side, so the default is a circle.
    ToggleRadius
    SeparatorThickness
    MinimumHitSize
    ScrollbarThickness
    SheetCornerRadius
    ShadowRadius

pub struct ColorEntry:
    pub string role
    pub string hex
    # "" = every variant; otherwise "light", "dark" or "contrast" (only while that appearance is in effect).
    pub string scheme = ""

pub struct MetricEntry:
    pub string role
    pub float value

pub struct StyleEntry:
    pub string role
    pub string style

# What a button looks like under a built-in style: background / text color roles, extra padding
# (added to the theme's ControlPadding), and whether it is drawn at all.
pub struct ButtonSpec:
    pub string background
    pub string text
    pub float padding
    pub bool filled

# ── the built-in base ────────────────────────────────────────────────────────────────────────────

def string lightColor(string role):
    if role == "WindowBackground":
        return "#FFFFFF"
    if role == "Surface":
        return "#F5F5F7"
    if role == "ElevatedSurface":
        return "#FFFFFF"
    if role == "PrimaryText":
        return "#1D1D1F"
    if role == "SecondaryText":
        return "#6E6E73"
    if role == "PlaceholderText":
        return "#A1A1A6"
    if role == "DisabledText":
        return "#C7C7CC"
    if role == "Accent":
        return "#0A84FF"
    if role == "OnAccent":
        return "#FFFFFF"
    if role == "Danger":
        return "#FF3B30"
    if role == "OnDanger":
        return "#FFFFFF"
    if role == "ControlBorder":
        return "#D2D2D7"
    if role == "Separator":
        return "#E5E5EA"
    if role == "FocusRing":
        return "#0A84FF"
    if role == "Selection":
        return "#B3D7FF"
    "#00000033"

def string darkColor(string role):
    if role == "WindowBackground":
        return "#1C1C1E"
    if role == "Surface":
        return "#2C2C2E"
    if role == "ElevatedSurface":
        return "#3A3A3C"
    if role == "PrimaryText":
        return "#F5F5F7"
    if role == "SecondaryText":
        return "#A1A1A6"
    if role == "PlaceholderText":
        return "#6E6E73"
    if role == "DisabledText":
        return "#48484A"
    if role == "Accent":
        return "#0A84FF"
    if role == "OnAccent":
        return "#FFFFFF"
    if role == "Danger":
        return "#FF453A"
    if role == "OnDanger":
        return "#FFFFFF"
    if role == "ControlBorder":
        return "#48484A"
    if role == "Separator":
        return "#38383A"
    if role == "FocusRing":
        return "#64D2FF"
    if role == "Selection":
        return "#2F5C9C"
    "#00000066"

# The increased-contrast base: only the roles that change are listed; everything else inherits the normal palette.
def string contrastColor(bool dark, string role):
    if dark:
        if role == "PrimaryText":
            return "#FFFFFF"
        if role == "SecondaryText":
            return "#E5E5EA"
        if role == "PlaceholderText":
            return "#C7C7CC"
        if role == "DisabledText":
            return "#AEAEB2"
        if role == "Accent" or role == "FocusRing":
            return "#409CFF"
        if role == "Danger":
            return "#FF6961"
        if role == "ControlBorder":
            return "#FFFFFF"
        if role == "Separator":
            return "#8E8E93"
        if role == "Selection":
            return "#3D6FB5"
        return ""
    if role == "PrimaryText":
        return "#000000"
    if role == "SecondaryText":
        return "#2C2C2E"
    if role == "PlaceholderText":
        return "#48484A"
    if role == "DisabledText":
        return "#6E6E73"
    if role == "Accent" or role == "FocusRing":
        return "#0040DD"
    if role == "Danger":
        return "#D70015"
    if role == "ControlBorder":
        return "#000000"
    if role == "Separator":
        return "#8E8E93"
    if role == "Selection":
        return "#80B3FF"
    ""

# The fixture metrics the headless layout always used (see layout.br), now named.
def float systemMetric(string role):
    if role == "ControlPadding":
        return 8.0
    if role == "ToggleSize":
        return 20.0
    if role == "TextFieldWidth":
        return 160.0
    if role == "TextFieldHeight":
        return 24.0
    if role == "StackSpacing":
        return 8.0
    if role == "SpacerMinimum":
        return 8.0
    if role == "ControlRadius":
        return 8.0
    if role == "ControlBorderWidth":
        return 1.0
    if role == "FocusRingWidth":
        return 2.0
    if role == "ToggleFocusRingWidth":
        return 2.0
    if role == "ToggleRadius":
        return 1000.0
    if role == "SeparatorThickness":
        return 1.0
    if role == "MinimumHitSize":
        return 0.0
    if role == "ScrollbarThickness":
        return 8.0
    if role == "SheetCornerRadius":
        return 12.0
    4.0

# Font sizes in logical units; the fixture font is `size / 2` wide and `size` tall per cell, so
# `Body` (16) is exactly the 8 x 16 cell every layout test already assumes.
def float systemFontSize(string role):
    if role == "LargeTitle":
        return 32.0
    if role == "Title":
        return 24.0
    if role == "Headline":
        return 18.0
    if role == "Label":
        return 14.0
    if role == "Caption":
        return 12.0
    16.0

def string systemButtonStyle(string buttonRole):
    if buttonRole == "Destructive":
        return "Primary"
    if buttonRole == "Cancel":
        return "Plain"
    "Secondary"

pub def ButtonSpec buttonSpec(string style):
    if style == "Primary":
        return ButtonSpec(background = "Accent", text = "OnAccent", padding = 0.0, filled = true)
    if style == "Plain":
        return ButtonSpec(background = "WindowBackground", text = "Accent", padding = 0.0, filled = false)
    if style == "Danger":
        return ButtonSpec(background = "Danger", text = "OnDanger", padding = 0.0, filled = true)
    if style == "Compact":
        return ButtonSpec(background = "Separator", text = "PrimaryText", padding = -4.0, filled = true)
    ButtonSpec(background = "Separator", text = "PrimaryText", padding = 0.0, filled = true)

# ── the theme value ──────────────────────────────────────────────────────────────────────────────

# ── line break opportunities by rule (the fixture font's, and a fallback for any measurer) ────────────────────────────
# A small version of the Unicode line-break rules (UAX #14): a break is allowed after a run of spaces, after a hyphen (not
# before a digit), and next to a wide (CJK) grapheme, except that a line never starts with closing punctuation nor ends
# with opening punctuation.

pub def bool isSpaceGrapheme(string g):
    g == " " or g == "\t"

# Characters a line may not start with (closing punctuation, CJK and Latin).
pub def bool noBreakBefore(string g):
    "、。，．）」』】》〉！？：；,.!?;:)]}}".contains(g)

# Characters a line may not end with (opening punctuation).
pub def bool noBreakAfter(string g):
    "（「『【《〈([{{".contains(g)

# Whether a line may break between the graphemes `prev` and `cur`.
pub def bool breakBetween(string prev, string cur):
    if isSpaceGrapheme(prev):
        return !isSpaceGrapheme(cur)
    if isSpaceGrapheme(cur):
        return false
    if prev == "-" and cur != "-" and !"0123456789".contains(cur):
        return true
    if (prev.displayWidth == 2 or cur.displayWidth == 2) and !noBreakBefore(cur) and !noBreakAfter(prev):
        return true
    false

# The break opportunities of `s` by the rules above: indices i (0 < i < length) where a break is allowed before grapheme i.
pub def [int] ruleBreakPoints(string s):
    mut [int] points = []
    var prev = ""
    for i in 0..<s.graphemeCount:
        let g = s.graphemeSlice(i, i + 1)
        if i > 0 and breakBetween(prev, g):
            points.push(i)
        prev = "{g}"
    points

# How wide a text is. Layout (wrapping, truncation, intrinsic sizes), the caret and the click-to-caret mapping all ask the
# theme's measurer, so a text engine (text/) can replace the fixture font without layout knowing which one is in use.
pub trait TextMeasurer:
    # The advance of `s` set at `size` pixels per em, on one line.
    req float width(string s, float size)
    # The same with a style: 0 regular, 1 bold, 2 italic, 3 bold italic. A measurer without styled cuts ignores it.
    req float widthStyled(string s, float size, int style)
    # What a truncated line ends with: "..." in the fixture font, "…" (one glyph) in a font that has it.
    req string ellipsis()
    # Where the caret is at logical grapheme `index` of `s` (between grapheme index - 1 and index): pixels from the start of
    # the line. For left-to-right text this is the width of the first `index` graphemes; in right-to-left or mixed text it
    # is the visual position (the text engine knows the run order).
    req float caretX(string s, int index, float size, int style)
    # The visual extents of the graphemes `lo` ..< `hi` as [x0, x1, x0, x1, ...]: one span, or several where a selection
    # crosses a direction change.
    req [float] selectionSpans(string s, int lo, int hi, float size, int style)
    # Whether `s` is a right-to-left paragraph (set against the right edge of its box).
    req bool isRtl(string s)
    # Where a line may break in `s` (a paragraph without newlines): the grapheme indices i, 0 < i < length, such that a break
    # is allowed before grapheme i.
    req [int] breakPoints(string s)

# The fixture font: every display cell is half the size wide (a wide cluster two cells, a combining mark none).
pub struct FixtureMeasurer as TextMeasurer:
    pub req float width(string s, float size):
        (s.displayWidth as float) * (size / 2.0)

    # (the fixture font has one cut: every style measures like the regular one)
    pub req float widthStyled(string s, float size, int style):
        (s.displayWidth as float) * (size / 2.0)

    pub req string ellipsis():
        "..."

    pub req float caretX(string s, int index, float size, int style):
        (s.graphemeSlice(0, index).displayWidth as float) * (size / 2.0)

    pub req bool isRtl(string s):
        false

    pub req [int] breakPoints(string s):
        ruleBreakPoints(s)

    pub req [float] selectionSpans(string s, int lo, int hi, float size, int style):
        let cell = size / 2.0
        [(s.graphemeSlice(0, lo).displayWidth as float) * cell, (s.graphemeSlice(0, hi).displayWidth as float) * cell]

pub struct Theme as EnvValue:
    pub string name = "system"
    pub bool dark = false
    # Increased contrast: the built-in base switches to its high-contrast palette, `contrast` color overrides apply.
    pub bool contrast = false
    # Accessibility text scale: multiplies every font size (and so every measured text).
    pub float textScale = 1.0
    pub [ColorEntry] colors = []
    pub [MetricEntry] metrics = []
    pub [MetricEntry] fontSizes = []
    pub [StyleEntry] buttonStyles = []
    # The text metrics layout and painting use; the fixture font unless the application installs a real engine's.
    pub TextMeasurer'shared measurer = FixtureMeasurer()

    # The resolved color of a role (`#RRGGBB[AA]`): the most specific override for the appearance in effect (a
    # `contrast` one under increased contrast, then `light`/`dark`, then one for every variant), else the base.
    pub req string color(ColorRole role):
        self.colorNamed("{role}")

    pub req float metric(MetricRole role):
        let key = "{role}"
        for e in metrics:
            if e.role == key:
                return e.value
        systemMetric(key)

    pub req float fontSize(FontRole role):
        self.fontSizeNamed("{role}")

    # String-keyed lookups for callers that only have a prop (layout and painting read mounted props).
    pub req string colorNamed(string key):
        var best = ""
        var rank = 0
        var appearance = "light"
        if dark:
            appearance = "dark"
        for e in colors:
            if e.role != key:
                continue
            var r = 0
            if e.scheme == "":
                r = 1
            elif e.scheme == appearance:
                r = 2
            elif contrast and e.scheme == "contrast":
                r = 3
            if r >= rank and r > 0:
                best = e.hex
                rank = r
        if rank > 0:
            return best
        if contrast:
            let hc = contrastColor(dark, key)
            if hc != "":
                return hc
        if dark:
            return darkColor(key)
        lightColor(key)

    # Whether the font role is set bold by default (the headings); a `Text`'s own `bold` adds to it.
    pub req bool fontBoldNamed(string key):
        key == "LargeTitle" or key == "Title" or key == "Headline"

    pub req float fontSizeNamed(string key):
        for e in fontSizes:
            if e.role == key:
                return e.value * textScale
        systemFontSize(key) * textScale

    pub req string buttonStyleNamed(string roleKey):
        for e in buttonStyles:
            if e.role == roleKey:
                return e.style
        systemButtonStyle(roleKey)

    # The built-in style a role maps to (`Primary`, `Secondary`, `Plain`, `Compact`).
    pub req string buttonStyleName(ButtonRole role):
        let key = "{role}"
        for e in buttonStyles:
            if e.role == key:
                return e.style
        systemButtonStyle(key)

    # Builders: a new theme with one entry replaced (the receiver is untouched).
    pub req Theme withColor(ColorRole role, string hex):
        self.withColorVariant(role, "", hex)

    # An override for one appearance only: `scheme` is "light", "dark" or "contrast" ("" = every variant).
    pub req Theme withColorVariant(ColorRole role, string scheme, string hex):
        let key = "{role}"
        mut [ColorEntry] next = []
        for e in colors:
            if e.role != key or e.scheme != scheme:
                next.push(e)
        next.push(ColorEntry(role = key, hex = hex, scheme = scheme))
        Theme(name = name, dark = dark, contrast = contrast, textScale = textScale, colors = next, metrics = metrics, fontSizes = fontSizes, buttonStyles = buttonStyles, measurer = measurer)

    pub req Theme withMetric(MetricRole role, float value):
        let key = "{role}"
        mut [MetricEntry] next = []
        for e in metrics:
            if e.role != key:
                next.push(e)
        next.push(MetricEntry(role = key, value = value))
        Theme(name = name, dark = dark, contrast = contrast, textScale = textScale, colors = colors, metrics = next, fontSizes = fontSizes, buttonStyles = buttonStyles, measurer = measurer)

    pub req Theme withFontSize(FontRole role, float size):
        let key = "{role}"
        mut [MetricEntry] next = []
        for e in fontSizes:
            if e.role != key:
                next.push(e)
        next.push(MetricEntry(role = key, value = size))
        Theme(name = name, dark = dark, contrast = contrast, textScale = textScale, colors = colors, metrics = metrics, fontSizes = next, buttonStyles = buttonStyles, measurer = measurer)

    pub req Theme withButtonStyle(ButtonRole role, string style):
        let key = "{role}"
        mut [StyleEntry] next = []
        for e in buttonStyles:
            if e.role != key:
                next.push(e)
        next.push(StyleEntry(role = key, style = style))
        Theme(name = name, dark = dark, contrast = contrast, textScale = textScale, colors = colors, metrics = metrics, fontSizes = fontSizes, buttonStyles = next, measurer = measurer)

    # The built-in dark base with the same overrides.
    pub req Theme asDark():
        Theme(name = "{name}.dark", dark = true, contrast = contrast, textScale = textScale, colors = colors, metrics = metrics, fontSizes = fontSizes, buttonStyles = buttonStyles, measurer = measurer)

    # Increased contrast on or off, keeping the overrides.
    pub req Theme withContrast(bool on):
        Theme(name = name, dark = dark, contrast = on, textScale = textScale, colors = colors, metrics = metrics, fontSizes = fontSizes, buttonStyles = buttonStyles, measurer = measurer)

    # The accessibility text scale (1.0 = none): every font size, hence every text measurement, is multiplied.
    pub req Theme withTextScale(float scale):
        Theme(name = name, dark = dark, contrast = contrast, textScale = scale, colors = colors, metrics = metrics, fontSizes = fontSizes, buttonStyles = buttonStyles, measurer = measurer)

    # Validation (run once when a theme is installed): colors are `#RRGGBB` / `#RRGGBBAA`, metrics are
    # finite and non-negative, font sizes are positive, style names are built in. Empty = valid.
    pub req [string] issues():
        mut [string] problems = []
        for e in colors:
            if !isHexColor(e.hex):
                problems.push("color {e.role}: '{e.hex}' is not #RRGGBB or #RRGGBBAA")
            if e.scheme != "" and e.scheme != "light" and e.scheme != "dark" and e.scheme != "contrast":
                problems.push("color {e.role}: scheme '{e.scheme}' is not light, dark or contrast")
        for e in metrics:
            if !(e.value >= 0.0) or e.value > 1000000.0:
                problems.push("metric {e.role}: {e.value} is not a finite non-negative length")
        if !(textScale > 0.0) or textScale > 5.0:
            problems.push("text scale {textScale} is not in (0, 5]")
        for e in fontSizes:
            if !(e.value > 0.0) or e.value > 1000000.0:
                problems.push("font {e.role}: {e.value} is not a positive size")
        for e in buttonStyles:
            if !isBuiltInStyle(e.style):
                problems.push("button style for {e.role}: '{e.style}' is not Primary, Secondary, Plain, Compact or Danger")
        problems

def bool isBuiltInStyle(string s):
    s == "Primary" or s == "Secondary" or s == "Plain" or s == "Compact" or s == "Danger"

def bool isHexDigit(string c):
    "0123456789abcdefABCDEF".contains(c)

pub def bool isHexColor(string s):
    if s.length != 7 and s.length != 9:
        return false
    if s[0..<1] != "#":
        return false
    for i in 1..<s.length:
        if !isHexDigit(s[i..<(i + 1)]):
            return false
    true

# The complete built-in themes.
pub def Theme systemTheme():
    Theme()

pub def Theme darkTheme():
    Theme(name = "system.dark", dark = true)

# A macOS-flavoured theme: system blue / red, grouped-background grays, 13 pt body text, 28-pt-tall controls with
# 8-pt corners, 18-pt round check marks, a rounded 12-pt sheet. Built only from overrides (the built-in base is unchanged),
# `Destructive` buttons are filled red (`Danger` style) rather than accent blue.
pub def Theme macTheme():
    macThemeOn(Theme(name = "mac"))

# The same overrides on top of `base` (to keep its text measurer, e.g. a real font engine's).
pub def Theme macThemeOn(Theme base):
    var t = base
    # The grays are the LIGHT appearance's: the dark base (and `asDark`) keeps its own, so these must not apply to every variant.
    t = t.withColorVariant(ColorRole.Accent, "light", "#007AFF")
    t = t.withColorVariant(ColorRole.FocusRing, "light", "#007AFF")
    t = t.withColorVariant(ColorRole.Danger, "light", "#FF3B30")
    t = t.withColorVariant(ColorRole.Accent, "dark", "#0A84FF")
    t = t.withColorVariant(ColorRole.FocusRing, "dark", "#0A84FF")
    t = t.withColorVariant(ColorRole.Danger, "dark", "#FF453A")
    t = t.withColorVariant(ColorRole.Surface, "light", "#F2F2F7")
    t = t.withColorVariant(ColorRole.ControlBorder, "light", "#D1D1D6")
    t = t.withColorVariant(ColorRole.Separator, "light", "#E5E5EA")
    t = t.withColorVariant(ColorRole.SecondaryText, "light", "#8E8E93")
    t = t.withColorVariant(ColorRole.PlaceholderText, "light", "#AEAEB2")
    t = t.withFontSize(FontRole.Title, 22.0)
    t = t.withFontSize(FontRole.Headline, 15.0)
    t = t.withFontSize(FontRole.Body, 13.0)
    t = t.withFontSize(FontRole.Label, 12.0)
    t = t.withFontSize(FontRole.Caption, 10.0)
    t = t.withMetric(MetricRole.ControlPadding, 7.0)
    t = t.withMetric(MetricRole.TextFieldHeight, 28.0)
    t = t.withMetric(MetricRole.TextFieldWidth, 200.0)
    t = t.withMetric(MetricRole.ToggleSize, 18.0)
    t = t.withMetric(MetricRole.ControlRadius, 8.0)
    t = t.withMetric(MetricRole.StackSpacing, 10.0)
    t = t.withMetric(MetricRole.SheetCornerRadius, 12.0)
    t = t.withMetric(MetricRole.ToggleFocusRingWidth, 0.0)
    t = t.withButtonStyle(ButtonRole.Destructive, "Danger")
    t

# A Fluent 2 (Windows 11) flavoured theme, built only from overrides like `macThemeOn`: the brand blue, neutral grays, 4-pt corners,
# 32-pt controls, a square-cornered checkbox, 14-pt body text, a red `Danger` for destructive buttons, and the dark appearance's own
# palette (Fluent's dark neutrals and lighter brand blue). The controls' SHAPE beyond colour, radius and size (the field's accent
# underline, the switch form of a toggle) needs the custom control styles that are not built yet.
pub def Theme fluentTheme():
    fluentThemeOn(Theme(name = "fluent"))

pub def Theme fluentThemeOn(Theme base):
    var t = base
    t = t.withColorVariant(ColorRole.WindowBackground, "light", "#F5F5F5")
    t = t.withColorVariant(ColorRole.Surface, "light", "#FFFFFF")
    t = t.withColorVariant(ColorRole.ElevatedSurface, "light", "#FFFFFF")
    t = t.withColorVariant(ColorRole.PrimaryText, "light", "#242424")
    t = t.withColorVariant(ColorRole.SecondaryText, "light", "#616161")
    t = t.withColorVariant(ColorRole.PlaceholderText, "light", "#707070")
    t = t.withColorVariant(ColorRole.DisabledText, "light", "#BDBDBD")
    t = t.withColorVariant(ColorRole.Accent, "light", "#0F6CBD")
    t = t.withColorVariant(ColorRole.FocusRing, "light", "#242424")
    t = t.withColorVariant(ColorRole.Danger, "light", "#C50F1F")
    t = t.withColorVariant(ColorRole.ControlBorder, "light", "#D1D1D1")
    t = t.withColorVariant(ColorRole.Separator, "light", "#E0E0E0")
    t = t.withColorVariant(ColorRole.Selection, "light", "#CFE4FA")
    t = t.withColorVariant(ColorRole.WindowBackground, "dark", "#1F1F1F")
    t = t.withColorVariant(ColorRole.Surface, "dark", "#292929")
    t = t.withColorVariant(ColorRole.ElevatedSurface, "dark", "#333333")
    t = t.withColorVariant(ColorRole.PrimaryText, "dark", "#FFFFFF")
    t = t.withColorVariant(ColorRole.SecondaryText, "dark", "#D6D6D6")
    t = t.withColorVariant(ColorRole.PlaceholderText, "dark", "#ADADAD")
    t = t.withColorVariant(ColorRole.DisabledText, "dark", "#5C5C5C")
    t = t.withColorVariant(ColorRole.Accent, "dark", "#479EF5")
    t = t.withColorVariant(ColorRole.OnAccent, "dark", "#0A0A0A")
    t = t.withColorVariant(ColorRole.FocusRing, "dark", "#FFFFFF")
    t = t.withColorVariant(ColorRole.Danger, "dark", "#DC626D")
    t = t.withColorVariant(ColorRole.ControlBorder, "dark", "#666666")
    t = t.withColorVariant(ColorRole.Separator, "dark", "#525252")
    t = t.withColorVariant(ColorRole.Selection, "dark", "#0F548C")
    t = t.withFontSize(FontRole.Title, 28.0)
    t = t.withFontSize(FontRole.Headline, 20.0)
    t = t.withFontSize(FontRole.Body, 14.0)
    t = t.withFontSize(FontRole.Label, 14.0)
    t = t.withFontSize(FontRole.Caption, 12.0)
    t = t.withMetric(MetricRole.ControlPadding, 6.0)
    t = t.withMetric(MetricRole.TextFieldHeight, 32.0)
    t = t.withMetric(MetricRole.TextFieldWidth, 200.0)
    t = t.withMetric(MetricRole.ToggleSize, 20.0)
    t = t.withMetric(MetricRole.ToggleRadius, 4.0)
    t = t.withMetric(MetricRole.ControlRadius, 4.0)
    t = t.withMetric(MetricRole.StackSpacing, 8.0)
    t = t.withMetric(MetricRole.SheetCornerRadius, 8.0)
    t = t.withButtonStyle(ButtonRole.Destructive, "Danger")
    t

# The `Theme` nearest in a provider scope (nearest first), or the system theme.
pub def Theme themeIn([EnvValue] scope):
    for v in scope:
        if let t = v as Theme:
            return t
    Theme()

# The first `Theme` among provided values, if any (a provider's own value, for validation).
pub def Theme? firstTheme([EnvValue] values):
    for v in values:
        if let t = v as Theme:
            return t
    nil

# `Theme.validate()` as a free function (callable on any binding, including an `if let` one).
pub def [string] themeProblems(Theme t):
    t.issues()
