# Composite controls built only from boring.ui primitives (no native facade, so no compiler or stdlib change):
# `ProgressBar` and `SegmentedControl`. They are ordinary `view`s: identity, state, theme and accessibility
# come from the views they compose.

use boring.ui.*
use ui.anim.*

# A determinate progress bar: a track with a leading fill of `value` (clamped to 0...1) of its width.
pub view ProgressBar:
    float value
    float width = 160.0
    float height = 6.0
    string label = "Progress"

    body():
        let v = clamp01(value)
        let percent = (v * 100.0) as int
        AccessibilityLabel(label = "{label}: {percent}%"):
            Frame(width = width, height = height):
                Background(color = "#d0d0d8"):
                    Row(spacing = 0.0):
                        Frame(width = width * v, height = height):
                            Background(color = "#3478f6"):
                                Spacer()
                        Spacer()

pub use IndexAction as def void(int)

# A row of mutually exclusive options; `selected` is the chosen index and `onSelect` receives the index of the
# activated option. The selected option is the primary button, the others secondary. (A callback, so the caller
# decides what a choice does; a `bind int selection` would also work now that `bind`s of imported views are linked.)
pub view SegmentedControl:
    int selected
    [string] options
    IndexAction onSelect

    body():
        Row(alignment = .Center, spacing = 2.0):
            for i in 0..<options.length with i:
                Button(label = options[i], style = (if selected == i: .Primary else .Secondary), onActivate = ():
                    onSelect(i))

# Tabs: a `SegmentedControl` over `titles` and, below it, only the child at index `selected` (the other children
# are not mounted, so their state is dropped when their tab is left).
pub view TabView:
    int selected
    [string] titles
    IndexAction onSelect
    [View] children

    body():
        Column(alignment = .Leading, spacing = 8.0):
            SegmentedControl(selected = selected, options = titles, onSelect = onSelect)
            Column(alignment = .Leading, spacing = 0.0):
                if selected >= 0 and selected < children.length:
                    children[selected]

# A drop-down choice: a button showing the selected option that opens the list of options in a `Popover` below it (above it when the
# window has more room there). Choosing an option calls `onSelect` and closes it; a press outside or Escape closes it too. The open flag
# is the picker's own state.
pub view Picker:
    int selected
    [string] options
    IndexAction onSelect

    state bool open = false

    def choose(int i):
        open = false
        onSelect(i)

    def toggle():
        let now = open
        open = !now

    body():
        let shown = if selected >= 0 and selected < options.length: options[selected] else "Choose"
        Popover(isPresented = open):
            Button(label = "{shown} ▾", style = ButtonStyle.Secondary, onActivate = ():
                self.toggle())
            Padding(insets = 4.0):
                Column(alignment = .Leading, spacing = 2.0):
                    for i in 0..<options.length with i:
                        Button(label = options[i], style = (if selected == i: ButtonStyle.Primary else ButtonStyle.Plain), onActivate = ():
                            self.choose(i))

# A menu of actions: a button labelled `label ▾` that opens the `items` in a `Popover` below it (above when the window has more room there). Choosing
# an item closes the menu and calls `onSelect` with its index (nothing is marked as selected, unlike `Picker`); a press outside or Escape closes it
# too. The item at index `danger` (when it is not -1) is a destructive one and shows as such.
pub view Menu:
    string label
    [string] items
    IndexAction onSelect
    int danger = -1

    state bool open = false

    def choose(int i):
        open = false
        onSelect(i)

    def toggle():
        let now = open
        open = !now

    body():
        Popover(isPresented = open):
            Button(label = "{label} ▾", style = ButtonStyle.Secondary, onActivate = ():
                self.toggle())
            Padding(insets = 4.0):
                Column(alignment = .Leading, spacing = 2.0):
                    for i in 0..<items.length with i:
                        Button(label = items[i], style = ButtonStyle.Plain, role = (if i == danger: ButtonRole.Destructive else ButtonRole.Normal), onActivate = ():
                            self.choose(i))

# An indeterminate progress bar: a segment (0.3 of the width) sweeps across the track as `phase` goes 0...1 (the host
# advances it every frame and wraps it: the animation system is value-triggered, it has no free-running loop).
pub view IndeterminateBar:
    float phase
    float width = 160.0
    float height = 6.0
    string label = "Working"

    body():
        let seg = width * 0.3
        let x = (clamp01(phase) * 1.3 - 0.3) * width
        AccessibilityLabel(label = label):
            Frame(width = width, height = height):
                Clip:
                    Background(color = "#d0d0d8"):
                        Row(spacing = 0.0):
                            Offset(x = x):
                                Frame(width = seg, height = height):
                                    Background(color = "#3478f6"):
                                        Spacer()
                            Spacer()

# An integer stepper: "-" and "+" buttons around the value, clamped to `min`...`max`; each activation calls `onChange`
# with the new value (nothing is called when the bound is already reached, and the button is disabled there).
pub view Stepper:
    int value
    int min = 0
    int max = 100
    string label = "Value"
    IndexAction onChange

    body():
        Row(alignment = .Center, spacing = 8.0):
            Disabled(value = value <= min):
                Button(label = "-", onActivate = ():
                    onChange(value - 1))
            AccessibilityLabel(label = label):
                Text(content = "{value}")
            Disabled(value = value >= max):
                Button(label = "+", onActivate = ():
                    onChange(value + 1))

# A section that folds: a header button (with a ▸/▾ marker) and, while open, its children below. The open flag is the
# group's own state, so it survives rebuilds of the parent and resets when the group leaves the tree.
pub view DisclosureGroup:
    state bool open = false

    string title
    [View] children

    def toggle():
        let now = open
        open = !now

    body():
        let marker = if open: "▾" else "▸"
        Column(alignment = .Leading, spacing = 4.0):
            Button(label = "{marker} {title}", style = ButtonStyle.Plain, onActivate = ():
                self.toggle())
            if open:
                Column(alignment = .Leading, spacing = 2.0):
                    for i in 0..<children.length with i:
                        children[i]

# A tooltip: `text` in a small floating panel while the pointer is over the control that `Tooltip` wraps (its one child; the hover target is the
# deepest enabled Button, Toggle, TextField or Slider, so wrap one). The panel opens below the control, above it near the window's bottom
# (a `Popover`). It appears once the pointer has stayed `delay` milliseconds (default 500; 0 = at once) — the host feeds the clock with
# `tickHover` — and goes as soon as the pointer leaves.
pub view Tooltip:
    state bool shown = false

    string text
    int delay = 500
    [View] children

    body():
        Popover(isPresented = shown):
            OnHover(value = shown, delay = delay):
                children[0]
            Padding(insets = 4.0):
                Text(content = text)

# ── navigation ───────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Hierarchical navigation without a native facade: a stack of named pages. `NavigationStack` owns the path (its own state), shows only the top page
# under a bar with a back button and the page's title, and hands its descendants a `Navigator` (through the environment) that
# `NavigationLink` and `NavigationBack` use to push and pop. Pages below the top are not mounted (like `TabView`'s other tabs): their state is
# dropped while covered.

pub use NameAction as def void(string)
pub use PlainAction as def void()

# What a page can do to the stack it sits in; provided by `NavigationStack`, read as `env Navigator nav`.
pub struct Navigator as EnvValue:
    pub NameAction push
    pub PlainAction pop
    pub int depth

# The stack. `children[0]` is the root page (titled `title`); `children[1 + i]` is the page named `names[i]`, titled `titles[i]`. `NavigationLink(to = name)`
# pushes a page by name.
pub view NavigationStack:
    state [string] path = []

    string title = ""
    [string] names = []
    [string] titles = []
    [View] children

    def push(string name):
        path.push(name)

    def pop():
        if path.length > 0:
            _ = path.pop()

    def int indexOf(string name):
        var found = -1
        for i in 0..<names.length:
            if names[i] == name:
                found = i
        found

    body():
        let depth = path.length
        var at = 0
        var heading = title
        if depth > 0:
            let i = self.indexOf(path[depth - 1])
            if i >= 0 and i + 1 < children.length:
                at = i + 1
                if i < titles.length:
                    heading = titles[i]
        let doPush = (name): self.push(name)
        let doPop = (): self.pop()
        Provide(value = Navigator(push = doPush, pop = doPop, depth = depth)):
            Column(alignment = .Leading, spacing = 8.0):
                Row(alignment = .Center, spacing = 8.0):
                    if depth > 0:
                        Button(label = "‹ Back", style = ButtonStyle.Plain, onActivate = ():
                            self.pop())
                    AccessibilityHeading(level = 1):
                        Text(content = heading)
                Separator()
                Column(alignment = .Leading, spacing = 0.0):
                    if at < children.length:
                        children[at]

# A button that pushes the page named `to` onto the enclosing `NavigationStack`.
pub view NavigationLink:
    env Navigator nav

    string label
    string to

    body():
        Button(label = "{label} ›", style = ButtonStyle.Secondary, onActivate = ():
            nav.push(to))

# A button that pops the enclosing `NavigationStack` (the stack's bar already has one while it is deeper than the root).
pub view NavigationBack:
    env Navigator nav

    string label = "Back"

    body():
        Disabled(value = nav.depth == 0):
            Button(label = label, onActivate = ():
                nav.pop())

# ── forms ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# `Form` stacks `Section`s; a `Section` is an optional caption `header`, a bordered group whose rows are separated by hairlines, and an optional `footer`
# caption; `LabeledContent` is one row: a label on the leading side and its control (the child) trailing.

pub view Form:
    [View] children

    body():
        Column(alignment = .Leading, spacing = 16.0):
            for i in 0..<children.length with i:
                children[i]

pub view Section:
    string header = ""
    string footer = ""
    [View] children

    body():
        Column(alignment = .Leading, spacing = 4.0):
            if header != "":
                AccessibilityHeading(level = 2):
                    Text(content = header, font = .Caption, bold = true)
            Border(color = "#c8c8d0"):
                Padding(insets = 8.0):
                    Column(alignment = .Leading, spacing = 6.0):
                        for i in 0..<children.length with i:
                            if i > 0:
                                Separator()
                            children[i]
            if footer != "":
                Text(content = footer, font = .Caption)

pub view LabeledContent:
    string label
    [View] children

    body():
        Row(alignment = .Center, spacing = 12.0):
            Text(content = label)
            Spacer()
            for i in 0..<children.length with i:
                children[i]

# ── grid ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# `Grid(columns = n)` lays its children out left to right, `n` to a row, in rows of equal-width columns (each cell takes an equal share of the width;
# the last row may be short). Cells in a row are aligned at the top. Rows are as tall as their tallest cell. Built from `Row(equal = true)`s of `Fill`s
# (`equal` makes a stack share its axis evenly, see the facade); every child is mounted (use `List` for long, virtualised data).
pub view Grid:
    int columns = 2
    float spacing = 8.0
    [View] children

    body():
        let across = if columns < 1: 1 else columns
        let rows = (children.length + across - 1) / across
        Column(alignment = .Leading, spacing = spacing):
            for r in 0..<rows with r:
                Row(alignment = .Leading, spacing = spacing, equal = true):
                    for c in 0..<across with c:
                        Fill(height = false, alignment = .TopLeading):
                            if r * across + c < children.length:
                                children[r * across + c]
                            if r * across + c >= children.length:
                                Spacer()   # a `Frame` needs a child: the short last row's empty cells
