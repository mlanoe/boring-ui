# boring-ui headless scene building (docs/design-notes/boring-ui-draft.md, "Painting, compositing,
# and render invalidation", "Event dispatch" → hit testing). Layer 3: turns a `Placed` tree into
#   - a deterministic, backend-neutral DISPLAY LIST (no GPU, no pixels), and
#   - HIT-TEST answers (the retained path from the root to the target under a point).
#
# Vocabulary: `FillRect`, `StrokeRect` (inside border), `DrawShadow`, `DrawText`, `PushClip`/`PopClip`
# (`Clip` and `Scroll` viewports), `PushOpacity`/`PopOpacity`; fills and strokes carry a corner `radius`; a checked box adds two `DrawLine`s. A wrapper controls the order of its own
# effects and its child: `Background` paints, then the child; `Border` strokes over the child; `Shadow`
# paints under it; `Opacity` and `Clip` bracket everything the child emits. `Offset` is a placement
# change (see layout.br), so it emits nothing. Overlays, transforms beyond translation, images and
# the accessibility tree are not here yet.
#
# Hit region = a node's layout bounds intersected with ancestor clips: visible overflow never enlarges
# it. Children are tested front to back (reverse paint order), so the topmost wins.

use render.display_list.*
use ui.scrollbar.*
use ui.layout.*
use ui.theme.*
use boring.ui.*

def Command cmd(string kind, Placed p, string text, string color):
    Command(kind = kind, x = p.x, y = p.y, w = p.w, h = p.h, text = text, color = color, node = p.id)

# A color token against the node's theme: a `ColorRole` name resolves through the theme, a `#RRGGBB[AA]`
# value is itself, anything else is left for the renderer (a named color such as "red").
pub def string resolveColor(Placed p, string token):
    if isHexColor(token):
        return token
    let resolved = p.theme.colorNamed(token)
    if token == "WindowBackground" or token == "Surface" or token == "ElevatedSurface" or token == "PrimaryText" or token == "SecondaryText" or token == "PlaceholderText" or token == "DisabledText" or token == "Accent" or token == "OnAccent" or token == "Danger" or token == "OnDanger" or token == "ControlBorder" or token == "Separator" or token == "FocusRing" or token == "Selection" or token == "ShadowColor":
        return resolved
    token

# A prop as the painter sees it: the animation's live value when there is one, else the prop.
pub def string propOrLive(Placed p, string key, string fallback):
    for v in p.live:
        if v.key == key:
            return v.value
    p.props[key] else (fallback)

def float num(Placed p, string key, float fallback):
    let text = propOrLive(p, key, "")
    if text == "":
        return fallback
    text.parseFloat() else (fallback)

# Appends `p`'s commands (and its subtree's) to `out` in paint order.
# How far beyond a list's viewport a row may lie and still be painted (shadows and focus rings reach outside a row).
let rowCullMargin = 48.0

pub def paint(Placed p, mut [Command] out):
    # A subtree with a group-opacity multiplier (a transition in flight) is composited as one.
    if p.alpha < 1.0:
        mut fade = cmd("PushOpacity", p, "", "")
        fade.value = p.alpha
        out.push(fade)
    paintNode(p, out)
    if p.alpha < 1.0:
        mut unfade = cmd("PopOpacity", p, "", "")
        unfade.value = p.alpha
        out.push(unfade)

# The style of a `Text` node (layout.br `styleOf`, on the placed node): 1 bold (by theme for a heading role, or `bold`), 2 italic.
def int textStyleOf(Placed p):
    var style = 0
    if (p.props["bold"] else ("false")) == "true" or p.theme.fontBoldNamed(p.props["font"] else ("Body")):
        style += 1
    if (p.props["italic"] else ("false")) == "true":
        style += 2
    style

# The context an application-written style (`ControlStyle`) is told about the control `p` (a toggle's is the mark's box: see `toggleContext`).
def StyleContext styleContextOf(Placed p, string kind):
    StyleContext(kind = kind, node = p.id, x = p.x, y = p.y, w = p.w, h = p.h, label = (p.props["label"] else ("")), role = (p.props["role"] else ("Normal")), on = (p.props["value"] else ("false")) == "true", hovered = propOrLive(p, "hovered", "false") == "true", focused = propOrLive(p, "focused", "false") == "true", pressed = propOrLive(p, "pressed", "false") == "true", theme = p.theme)

def StyleContext toggleContext(Placed p, float markW, float markH):
    StyleContext(kind = "Toggle", node = p.id, x = p.x, y = p.y, w = markW, h = markH, label = (p.props["label"] else ("")), on = (p.props["value"] else ("false")) == "true", hovered = propOrLive(p, "hovered", "false") == "true", focused = propOrLive(p, "focused", "false") == "true", pressed = propOrLive(p, "pressed", "false") == "true", theme = p.theme)

# What a custom style paints, each command stamped with the control's node.
def void pushStyled(ControlStyle'shared style, StyleContext ctx, mut [Command] out):
    for c in style.paint(ctx):
        mut stamped = c
        stamped.node = ctx.node
        out.push(stamped)

def paintNode(Placed p, mut [Command] out):
    # A presented sheet paints in the presentation layer, after everything else (see `displayList`).
    if p.kind == "Sheet":
        return
    if p.kind == "Background":
        let token = propOrLive(p, "color", "")
        mut fill = cmd("FillRect", p, "", token)
        fill.hex = resolveColor(p, token)
        fill.radius = num(p, "radius", 0.0)
        out.push(fill)
    if p.kind == "Shadow":
        mut shadow = cmd("DrawShadow", p, "", p.props["color"] else ("black"))
        shadow.hex = resolveColor(p, "ShadowColor")
        shadow.value = num(p, "radius", p.theme.metric(MetricRole.ShadowRadius))
        shadow.dx = num(p, "dx", 0.0)
        shadow.dy = num(p, "dy", 2.0)
        out.push(shadow)
    if p.kind == "Opacity":
        mut open = cmd("PushOpacity", p, "", "")
        open.value = num(p, "value", 1.0)
        out.push(open)
    if p.kind == "Text":
        mut text = cmd("DrawText", p, p.props["shown"] else (p.props["content"] else ("")), "")
        text.hex = p.theme.color(ColorRole.PrimaryText)
        text.style = textStyleOf(p)
        out.push(text)
    if p.kind == "Button":
        let spec = buttonSpec(buttonStyleOf(p.theme, p.props))
        let pad = buttonPaddingOf(p.theme, p.props)
        let body = p.theme.fontSizeNamed("Body")
        let customButton = p.theme.stylesFor("Button")
        if customButton.length > 0:
            pushStyled(customButton[0], styleContextOf(p, "Button"), out)
        elif spec.filled:
            mut face = cmd("FillRect", p, "", "button")
            face.hex = p.theme.colorNamed(spec.background)
            face.radius = p.theme.metric(MetricRole.ControlRadius)
            out.push(face)
        if customButton.length == 0 and propOrLive(p, "hovered", "false") == "true":
            # the pointer is over it: a translucent shade over the face, under the label
            mut shade = cmd("FillRect", p, "", "hover")
            shade.hex = p.theme.color(ColorRole.ShadowColor)
            shade.radius = p.theme.metric(MetricRole.ControlRadius)
            out.push(shade)
            if propOrLive(p, "pressed", "false") == "true":
                # pressed: a second shade, so the face is darker than while only hovered
                mut deeper = cmd("FillRect", p, "", "pressed")
                deeper.hex = p.theme.color(ColorRole.ShadowColor)
                deeper.radius = p.theme.metric(MetricRole.ControlRadius)
                out.push(deeper)
        let label = p.props["label"] else ("")
        mut text = Command(kind = "DrawText", x = p.x + pad, y = p.y + pad, w = p.w - 2.0 * pad, h = body, text = label, color = "", node = p.id)
        text.hex = p.theme.colorNamed(spec.text)
        if customButton.length > 0:
            let tone = customButton[0].textColor(styleContextOf(p, "Button"))
            if tone != "":
                text.hex = tone
        out.push(text)
    if p.kind == "TextField":
        let value = p.props["value"] else ("")
        let customField = p.theme.stylesFor("TextField")
        if customField.length > 0:
            pushStyled(customField[0], styleContextOf(p, "TextField"), out)
        else:
            mut field = cmd("FillRect", p, "", "field")
            field.hex = p.theme.color(ColorRole.ElevatedSurface)
            field.radius = p.theme.metric(MetricRole.ControlRadius)
            out.push(field)
            mut edge = cmd("StrokeRect", p, "", "fieldBorder")
            edge.hex = p.theme.color(ColorRole.ControlBorder)
            edge.value = p.theme.metric(MetricRole.ControlBorderWidth)
            edge.radius = p.theme.metric(MetricRole.ControlRadius)
            out.push(edge)
            if p.theme.controlStyle("TextField") == "Underlined" and propOrLive(p, "focused", "false") == "true":
                # an accent line along the bottom edge while focused (it stands in for the focus ring), inset by the corner radius
                let inset = p.theme.metric(MetricRole.ControlRadius)
                mut line = Command(kind = "FillRect", x = p.x + inset, y = p.y + p.h - 2.0, w = p.w - 2.0 * inset, h = 2.0, text = "", color = "underline", node = p.id)
                line.hex = p.theme.color(ColorRole.Accent)
                out.push(line)
        # the text, selection, caret and composition stay inside the field: a value longer than the field is cut at its edge
        # (there is no horizontal scrolling yet; the caret of a value that long is cut with it)
        out.push(Command(kind = "PushClip", x = p.x + 2.0, y = p.y, w = p.w - 4.0, h = p.h, text = "", color = "", node = p.id))
        # While an input method composes, its marked text is shown at the caret (the bound value is untouched).
        var shownText = "{value}"   # a copy: `var x = value` moves the shared string in transpiled code
        let marked = propOrLive(p, "marked", "")
        let valueCount = value.graphemeCount
        var markedAt = 0
        if marked != "":
            let atText = propOrLive(p, "markedAt", "0")
            markedAt = atText.parseInt() else (0)
            if markedAt > valueCount:
                markedAt = valueCount
            shownText = "{value.graphemeSlice(0, markedAt)}{marked}{value.graphemeSlice(markedAt, value.graphemeCount)}"
        let bodyHeight = p.theme.fontSizeNamed("Body")
        # the line is centred vertically in the field (4 pt in the 24-pt fixture field)
        let lineY = p.y + maxOf(0.0, (p.h - bodyHeight) / 2.0)
        let focusedField = propOrLive(p, "focused", "false") == "true"
        var caret = (propOrLive(p, "caret", "0")).parseInt() else (0)
        var anchor = (propOrLive(p, "anchor", "0")).parseInt() else (0)
        # (positions come from the measurer's caret stops: in right-to-left or mixed text they follow the visual order)
        var caretIndex = caret
        if marked != "":
            let cursorText = propOrLive(p, "markedCursor", "0")
            let cursor = cursorText.parseInt() else (0)
            caretIndex = markedAt + cursor
        var caretOffset = 0.0
        if marked != "":
            caretOffset = p.theme.measurer.caretX(shownText, caretIndex, bodyHeight, 0)
        else:
            caretOffset = p.theme.measurer.caretX(value, caretIndex, bodyHeight, 0)
        # where the text starts: against the left edge, or the right one for a right-to-left paragraph, shifted to keep the caret
        # in view (layout.br fieldOrigin, shared with click-to-caret and the input method's area)
        var originAt = 0
        if focusedField:
            originAt = caretIndex
        var originShift = 0.0
        if marked != "":
            originShift = fieldOrigin(p.theme.measurer, shownText, originAt, p.w, bodyHeight)
        else:
            originShift = fieldOrigin(p.theme.measurer, value, originAt, p.w, bodyHeight)
        let originX = p.x + 4.0 + originShift
        # the selection sits under the text (not while composing: the marked text replaces it)
        if focusedField and marked == "" and caret != anchor:
            var lo = caret
            var hi = anchor
            if anchor < caret:
                lo = anchor
                hi = caret
            let spans = p.theme.measurer.selectionSpans(value, lo, hi, bodyHeight, 0)
            var at = 0
            while at + 1 < spans.length:
                mut band = Command(kind = "FillRect", x = originX + spans[at], y = lineY, w = spans[at + 1] - spans[at], h = bodyHeight, text = "", color = "selection", node = p.id)
                band.hex = p.theme.color(ColorRole.Selection)
                out.push(band)
                at += 2
        # (the command's width is the text's own: the field's origin already places it, so a right-to-left line is not aligned twice)
        mut text = Command(kind = "DrawText", x = originX, y = lineY, w = p.theme.measurer.width(shownText, bodyHeight), h = p.theme.fontSizeNamed("Body"), text = shownText, color = "", node = p.id)
        text.hex = p.theme.color(ColorRole.PrimaryText)
        if customField.length > 0:
            let tone = customField[0].textColor(styleContextOf(p, "TextField"))
            if tone != "":
                text.hex = tone
        out.push(text)
        if focusedField:
            # a one-pixel bar before the grapheme at `caret`; while composing, at the cursor inside the marked text
            mut bar = Command(kind = "FillRect", x = originX + caretOffset, y = lineY, w = 1.0, h = bodyHeight, text = "", color = "caret", node = p.id)
            bar.hex = p.theme.color(ColorRole.PrimaryText)
            out.push(bar)
        if marked != "":
            let markedSpans = p.theme.measurer.selectionSpans(shownText, markedAt, markedAt + marked.graphemeCount, bodyHeight, 0)
            var m = 0
            while m + 1 < markedSpans.length:
                mut underline = Command(kind = "MarkedText", x = originX + markedSpans[m], y = lineY, w = markedSpans[m + 1] - markedSpans[m], h = p.theme.fontSizeNamed("Body"), text = marked, color = "", node = p.id)
                underline.hex = p.theme.color(ColorRole.PrimaryText)
                out.push(underline)
                m += 2
        out.push(Command(kind = "PopClip", x = p.x + 2.0, y = p.y, w = p.w - 4.0, h = p.h, text = "", color = "", node = p.id))
    if p.kind == "Separator":
        mut line = cmd("FillRect", p, "", "separator")
        line.hex = p.theme.color(ColorRole.Separator)
        out.push(line)
    if p.kind == "Image":
        out.push(cmd("DrawImage", p, p.props["source"] else (""), ""))
    if p.kind == "Slider":
        let low = num(p, "min", 0.0)
        let high = num(p, "max", 1.0)
        var frac = 0.0
        if high > low:
            frac = (num(p, "value", low) - low) / (high - low)
        if frac < 0.0:
            frac = 0.0
        if frac > 1.0:
            frac = 1.0
        let trackH = 4.0
        mut track = Command(kind = "FillRect", x = p.x, y = p.y + (p.h - trackH) / 2.0, w = p.w, h = trackH, text = "", color = "track", node = p.id)
        track.hex = p.theme.color(ColorRole.ControlBorder)
        track.radius = trackH / 2.0
        out.push(track)
        mut fill = Command(kind = "FillRect", x = p.x, y = p.y + (p.h - trackH) / 2.0, w = p.w * frac, h = trackH, text = "", color = "fill", node = p.id)
        fill.hex = p.theme.color(ColorRole.Accent)
        fill.radius = trackH / 2.0
        out.push(fill)
        mut thumb = Command(kind = "FillRect", x = p.x + frac * (p.w - p.h), y = p.y, w = p.h, h = p.h, text = "", color = "thumb", node = p.id)
        thumb.hex = p.theme.color(ColorRole.ElevatedSurface)
        thumb.radius = p.h / 2.0
        out.push(thumb)
        mut rim = Command(kind = "StrokeRect", x = p.x + frac * (p.w - p.h), y = p.y, w = p.h, h = p.h, text = "", color = "thumbRim", node = p.id)
        rim.hex = p.theme.color(ColorRole.ControlBorder)
        rim.value = 1.0
        rim.radius = p.h / 2.0
        out.push(rim)
    if p.kind == "Toggle":
        var state = "off"
        let value = p.props["value"] else ("false")
        if value == "true":
            state = "on"
        let label = p.props["label"] else ("")
        let box = p.theme.metric(MetricRole.ToggleSize)
        let gap = p.theme.metric(MetricRole.ControlPadding)
        let customToggle = p.theme.stylesFor("Toggle")
        var markW = box
        if customToggle.length > 0:
            markW = toggleWidth(p.theme)
            pushStyled(customToggle[0], toggleContext(p, markW, box), out)
        else:
            let isSwitch = p.theme.controlStyle("Toggle") == "Switch"
            if isSwitch:
                markW = toggleWidth(p.theme)
            var boxRadius = p.theme.metric(MetricRole.ToggleRadius)
            if isSwitch:
                boxRadius = box / 2.0
            mut mark = Command(kind = "FillRect", x = p.x, y = p.y, w = markW, h = box, text = "", color = state, node = p.id)
            mark.radius = boxRadius
            if state == "on":
                mark.hex = p.theme.color(ColorRole.Accent)
            else:
                mark.hex = p.theme.color(ColorRole.ElevatedSurface)
            out.push(mark)
            if state == "off":
                mut ring = Command(kind = "StrokeRect", x = p.x, y = p.y, w = markW, h = box, text = "", color = "off", node = p.id)
                ring.hex = p.theme.color(ColorRole.ControlBorder)
                ring.value = 1.5
                if isSwitch:
                    ring.value = 1.0
                ring.radius = boxRadius
                out.push(ring)
            if state == "on" and !isSwitch:
                # the check mark: two round-ended segments (down to the elbow, then up to the right) in the text-on-accent colour, sized to the box
                let tickWidth = maxOf(1.5, 0.12 * box)
                mut shortArm = Command(kind = "DrawLine", x = p.x + 0.27 * box, y = p.y + 0.52 * box, w = 0.0, h = 0.0, text = "", color = "check", node = p.id)
                shortArm.dx = 0.16 * box
                shortArm.dy = 0.17 * box
                shortArm.value = tickWidth
                shortArm.hex = p.theme.color(ColorRole.OnAccent)
                out.push(shortArm)
                mut longArm = Command(kind = "DrawLine", x = p.x + 0.43 * box, y = p.y + 0.69 * box, w = 0.0, h = 0.0, text = "", color = "check", node = p.id)
                longArm.dx = 0.32 * box
                longArm.dy = -0.36 * box
                longArm.value = tickWidth
                longArm.hex = p.theme.color(ColorRole.OnAccent)
                out.push(longArm)
            if isSwitch:
                # the thumb: a disc inset 3 from the track's ends, at the right end when on (on the accent: the text-on-accent colour)
                let d = box - 6.0
                var thumbX = p.x + 3.0
                if state == "on":
                    thumbX = p.x + markW - 3.0 - d
                mut thumb = Command(kind = "FillRect", x = thumbX, y = p.y + 3.0, w = d, h = d, text = "", color = "thumb", node = p.id)
                if state == "on":
                    thumb.hex = p.theme.color(ColorRole.OnAccent)
                else:
                    thumb.hex = p.theme.color(ColorRole.SecondaryText)
                thumb.radius = d / 2.0
                out.push(thumb)
            if propOrLive(p, "hovered", "false") == "true":
                mut shade = Command(kind = "FillRect", x = p.x, y = p.y, w = markW, h = box, text = "", color = "hover", node = p.id)
                shade.hex = p.theme.color(ColorRole.ShadowColor)
                shade.radius = boxRadius
                out.push(shade)
                if propOrLive(p, "pressed", "false") == "true":
                    mut deeper = Command(kind = "FillRect", x = p.x, y = p.y, w = markW, h = box, text = "", color = "pressed", node = p.id)
                    deeper.hex = p.theme.color(ColorRole.ShadowColor)
                    deeper.radius = boxRadius
                    out.push(deeper)
        # the label is set at the body size it was measured at (layout), centred on the row; not at the row's height
        let labelSize = p.theme.fontSizeNamed("Body")
        mut text = Command(kind = "DrawText", x = p.x + markW + gap, y = p.y + (p.h - labelSize) / 2.0, w = p.w - markW - gap, h = labelSize, text = label, color = "", node = p.id)
        text.hex = p.theme.color(ColorRole.PrimaryText)
        out.push(text)
    if p.kind == "Clip" or p.kind == "Scroll" or (p.kind == "List" or p.kind == "MultiList"):
        out.push(cmd("PushClip", p, "", ""))
    if p.kind == "List" or p.kind == "MultiList":
        # Selected rows get the theme's selection color behind their content (a `MultiList` keeps several keys,
        # newline-separated in its `selection` prop; a `List` one).
        let chosen = (p.props["selection"] else ("")).split("\n")
        for c in p.children:
            if c.key != "" and chosen.contains(c.key):
                mut band = cmd("FillRect", c, "", "selected")
                band.hex = p.theme.color(ColorRole.Selection)
                out.push(band)
    let isList = p.kind == "List" or p.kind == "MultiList"
    var childIndex = 0
    for c in p.children:
        childIndex += 1
        # a presented popover's panel paints in the popover layer, over everything (see `paintPopovers`)
        if p.kind == "Popover" and childIndex > 1:
            continue
        # a row of a list entirely above or below its viewport (by more than a shadow's reach) paints nothing the clip would show
        if isList and (c.y + c.h < p.y - rowCullMargin or c.y > p.y + p.h + rowCullMargin):
            continue
        paint(c, out)
    if p.kind == "Clip" or p.kind == "Scroll" or (p.kind == "List" or p.kind == "MultiList"):
        out.push(cmd("PopClip", p, "", ""))
    if isScroller(p.kind):
        # the scroll indicator, over the content, only while there is something to scroll
        let t = thumbOf(p)
        if t.length > 0:
            mut thumb = Command(kind = "FillRect", x = t[0], y = t[1], w = t[2], h = t[3], text = "", color = "scrollbar", node = p.id)
            var tone = p.theme.color(ColorRole.SecondaryText)
            if tone.length == 7:
                tone = "{tone}B0"
            thumb.hex = tone
            if t[2] < t[3]:
                thumb.radius = t[2] / 2.0
            else:
                thumb.radius = t[3] / 2.0
            out.push(thumb)
    if p.kind == "Opacity":
        mut close = cmd("PopOpacity", p, "", "")
        close.value = num(p, "value", 1.0)
        out.push(close)
    var ringWidth = p.theme.metric(MetricRole.FocusRingWidth)
    if p.kind == "Toggle":
        ringWidth = p.theme.metric(MetricRole.ToggleFocusRingWidth)
    if p.kind == "TextField" and p.theme.controlStyle("TextField") == "Underlined":
        ringWidth = 0.0
    if p.kind == "Button" or p.kind == "Toggle" or p.kind == "TextField":
        let ringStyles = p.theme.stylesFor(p.kind)
        if ringStyles.length > 0 and !ringStyles[0].focusRing(styleContextOf(p, p.kind)):
            ringWidth = 0.0
    if (p.kind == "Button" or p.kind == "Toggle" or p.kind == "TextField" or p.kind == "Slider") and propOrLive(p, "focused", "false") == "true" and ringWidth > 0.0:
        # The focus ring sits just outside the control's bounds, over the control and its own children.
        let width = ringWidth
        var ringX = p.x - width
        var ringW = p.w + 2.0 * width
        if p.kind == "Slider":
            # Only the thumb is ringed, not the whole track.
            let low = num(p, "min", 0.0)
            let high = num(p, "max", 1.0)
            var frac = 0.0
            if high > low:
                frac = (num(p, "value", low) - low) / (high - low)
            if frac < 0.0:
                frac = 0.0
            if frac > 1.0:
                frac = 1.0
            ringX = p.x + frac * (p.w - p.h) - width
            ringW = p.h + 2.0 * width
        mut ring = Command(kind = "StrokeRect", x = ringX, y = p.y - width, w = ringW, h = p.h + 2.0 * width, text = "", color = "focus", node = p.id)
        ring.hex = p.theme.color(ColorRole.FocusRing)
        ring.value = width
        if p.kind == "Toggle":
            ring.radius = p.theme.metric(MetricRole.ToggleRadius) + width
        elif p.kind == "Slider":
            ring.radius = (p.h + 2.0 * width) / 2.0
        else:
            ring.radius = p.theme.metric(MetricRole.ControlRadius) + width
        out.push(ring)
    if p.kind == "Border":
        mut stroke = cmd("StrokeRect", p, "", p.props["color"] else (""))
        stroke.hex = resolveColor(p, p.props["color"] else (""))
        stroke.value = num(p, "lineWidth", 1.0)
        out.push(stroke)

# The popover layer, over the whole tree: each presented popover's panel gets a shadow and an elevated surface, then its content.
def void paintPopovers(Placed p, mut [Command] out):
    if p.kind == "Popover" and p.children.length > 1:
        let panel = p.children[1]
        mut shadow = cmd("DrawShadow", panel, "", "ShadowColor")
        shadow.hex = resolveColor(p, "ShadowColor")
        shadow.value = p.theme.metric(MetricRole.ShadowRadius)
        shadow.dx = 0.0
        shadow.dy = 2.0
        out.push(shadow)
        mut surface = cmd("FillRect", panel, "", "popover")
        surface.hex = p.theme.color(ColorRole.ElevatedSurface)
        surface.radius = p.theme.metric(MetricRole.ControlRadius)
        out.push(surface)
        paint(panel, out)
    for c in p.children:
        paintPopovers(c, out)

# The presentation layer: for each presented sheet (outermost first) a scrim over the window, a surface
# behind its content, then the content itself.
def void paintSheets(Placed p, mut [Command] out):
    if p.kind == "Sheet" and p.children.length > 0:
        mut scrim = cmd("FillRect", p, "", "scrim")
        scrim.hex = p.theme.color(ColorRole.ShadowColor)
        out.push(scrim)
        for c in p.children:
            mut surface = cmd("FillRect", c, "", "sheet")
            surface.hex = p.theme.color(ColorRole.ElevatedSurface)
            surface.radius = p.theme.metric(MetricRole.SheetCornerRadius)
            out.push(surface)
            paint(c, out)
    for c in p.children:
        paintSheets(c, out)

# The chip that follows the pointer during a drag (the root carries it as live props, see `finishLayout`): a shadow, an elevated surface and the preview text.
def void paintDrag(Placed root, mut [Command] out):
    let text = propOrLive(root, "dragText", "")
    if text == "":
        return
    let size = root.theme.fontSizeNamed("Body")
    let textW = root.theme.measurer.width(text, size)
    let pad = 8.0
    let chip = Placed(id = root.id, kind = "DragPreview", x = num(root, "dragX", 0.0) + 12.0, y = num(root, "dragY", 0.0) + 12.0, w = textW + 2.0 * pad, h = size + 2.0 * pad, theme = root.theme)
    mut shadow = cmd("DrawShadow", chip, "", "ShadowColor")
    shadow.hex = resolveColor(root, "ShadowColor")
    shadow.value = root.theme.metric(MetricRole.ShadowRadius)
    shadow.dx = 0.0
    shadow.dy = 2.0
    out.push(shadow)
    mut surface = cmd("FillRect", chip, "", "dragPreview")
    surface.hex = root.theme.color(ColorRole.ElevatedSurface)
    surface.radius = root.theme.metric(MetricRole.ControlRadius)
    out.push(surface)
    let label = Placed(id = root.id, kind = "Text", x = chip.x + pad, y = chip.y + pad, w = textW, h = size, theme = root.theme)
    mut draw = cmd("DrawText", label, text, "")
    draw.hex = root.theme.color(ColorRole.PrimaryText)
    out.push(draw)

# The window background of a laid-out tree. The root of a themed application is the `Provide` that installs the theme and it still
# sees the theme outside it (the default light one), so it is the provided node's theme, one level down, that holds the system's
# appearance. (A tree whose root is not a `Provide` just uses its own theme.)
pub def string windowBackground(Placed root):
    if root.kind == "Provide" and root.children.length > 0:
        return root.children[0].theme.colorNamed("WindowBackground")
    root.theme.colorNamed("WindowBackground")

pub def [Command] displayList(Placed root):
    mut [Command] out = []
    paint(root, out)
    paintPopovers(root, out)
    paintSheets(root, out)
    paintDrag(root, out)
    out

# One line per command, for golden tests.
pub def string describe(Command c):
    var s = "{c.kind} {c.x},{c.y} {c.w}x{c.h}"
    if c.kind == "DrawText" or c.kind == "DrawImage" or c.kind == "MarkedText":
        s = "{s} '{c.text}'"
    if c.kind == "FillRect":
        s = "{s} {c.color}"
    if c.kind == "StrokeRect":
        s = "{s} {c.color} {c.value}"
    if c.kind == "DrawLine":
        s = "{s} {c.color} d={c.dx},{c.dy} w={c.value}"
    if (c.kind == "FillRect" or c.kind == "StrokeRect") and c.radius > 0.0:
        s = "{s} radius={c.radius}"
    if c.kind == "DrawShadow":
        s = "{s} {c.color} r={c.value} d={c.dx},{c.dy}"
    if c.kind == "PushOpacity" or c.kind == "PopOpacity":
        s = "{s} {c.value}"
    s

def bool contains(Placed p, float x, float y):
    x >= p.x and x < p.x + p.w and y >= p.y and y < p.y + p.h

# The ids from the root down to the deepest node under (x, y), or [] when the point hits nothing.
# A point outside a `Clip`'s bounds reaches nothing beneath it.
# The ids from the root down to node `id` (inclusive); false, leaving `path` as it was, when absent.
def bool pathTo(Placed p, int id, mut [int] path):
    path.push(p.id)
    if p.id == id:
        return true
    for c in p.children:
        if pathTo(c, id, path):
            return true
    _ = path.pop()
    false

pub def [int] hitTest(Placed root, float x, float y):
    mut [int] path = []
    # A presented sheet is modal: only its subtree can be hit (the scrim itself hits the sheet node), so
    # nothing underneath it receives pointer input.
    if let sheet = topSheet(root):
        if pathTo(root, sheet.id, path):
            descend(sheet, x, y, path)
            return path
    # A popover's panel floats over its siblings and outside its parents' bounds: it is tested first.
    mut popups = [] as [Placed]
    popupsIn(root, popups)
    var j = popups.length - 1
    while j >= 0:
        let panel = popups[j]
        if contains(panel, x, y) and pathTo(root, panel.id, path):
            descend(panel, x, y, path)
            return path
        j -= 1
    if contains(root, x, y):
        path.push(root.id)
        descend(root, x, y, path)
    path

def descend(Placed p, float x, float y, mut [int] path):
    # front to back: the last child paints last, so it is tested first
    var i = p.children.length - 1
    while i >= 0:
        let c = p.children[i]
        if contains(c, x, y) and !c.ghost:
            path.push(c.id)
            descend(c, x, y, path)
            return
        i -= 1
