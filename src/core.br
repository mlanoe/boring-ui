use boring.ui.*
use ui.theme.*
use ui.anim.*
use ui.layout.*

# boring-ui headless reactive core (docs/design-notes/boring-ui-draft.md, "Runtime architecture",
# "Mounted tree and update pass", "Identity & lifecycle", "UI events and batched refresh").
#
# Layer 2 of the implementation sequence: it knows nothing about windows, layout or rendering, and
# nothing about the *types* of views. A `Desc` is the type-erased shape of one build of a view tree;
# `Runtime` keeps the mounted tree, reconciles each new description against it, hands out
# generation-checked handles, batches writes into event transactions and runs the 64-pass loop guard.
#
# What is deliberately NOT here yet (see boring-ui/README.md):
#   - typed `state` slots: Boring has no downcast on trait objects, so a lowered view's typed
#     `V__State` cannot be stored through this erased tree yet. Mounted nodes carry a small named-int
#     slot map instead, enough to test identity/lifetime semantics.
#   - keys are strings (a lowered `for … with key` will stringify its `IdentityKey` for now).
#   - structural sites are explicit (`Desc.site`) or fall back to the sibling index; the array-block
#     lowering does not emit stable sites for `if` branches yet.
#   - tasks, `onTask` restarts, environments: see below. A pass re-expands only the invalidated composites
#     unless the root itself is dirty (see `applyPartial`).

# One build of a view: its component kind, where it sits, and its children.
#
# Identity of a child is `(site, key)` among its siblings plus a matching `kind`:
#   - `site` is the static position in the parent's block. `-1` means "use the sibling index".
#   - `key` is "" for structural children and the iteration key for a keyed `for` group (the
#     lowering's `KeyedGroup(key, items)`); equal keys at different sites are different identities.
#
# A composite view (one with a `body()`) is described lazily: `view` carries it and the runtime
# expands it with the node's own persistent state while reconciling (see `describe`).
pub struct Desc:
    pub string kind
    pub int site = -1
    pub string key = ""
    pub [Desc] children = []
    pub View? view = nil
    pub {string=string} props = {=}
    # A native control's own view, kept current so the runtime can deliver actions to its callbacks.
    pub View? control = nil

# A mounted node. `id` is recycled after unmount; `generation` never is, so a stale handle can
# always be told from a live one.
pub struct Mounted:
    pub int id
    pub int generation
    pub string kind
    pub int site
    pub string key
    pub var mut [Mounted] children = []
    # The native view's scalar fields (text content, spacing, insets, …) as of the latest build.
    pub var mut {string=string} props = {=}
    pub var View? view = nil
    pub var View? control = nil
    # A `Scroll`'s offset along its axis: identity-scoped mounted control state, kept across rebuilds
    # (reconciliation never touches it) and clamped by layout to the content that is actually there.
    pub var float scroll = 0.0
    # The nearest `Theme` provider above this node (the system theme when there is none), resolved by the
    # core while it reconciles so layout and painting read tokens off the node itself (draft: "Nearest
    # provider wins").
    pub var Theme theme = Theme()
    # Bumped whenever anything layout reads changes in this node or below it (props, theme, scroll, the child list or a
    # child's own `rev`): with `id` and `generation` it names one version of the subtree, the key of layout's cross-frame
    # cache (see `LayoutMemory`).
    pub var int rev = 0

# Whether two themes lay out and paint the same (the text measurer aside: swapping that is `layoutMemory.bump()`).
pub def bool sameTheme(Theme a, Theme b):
    a.name == b.name and a.dark == b.dark and a.contrast == b.contrast and a.textScale == b.textScale and a.colors == b.colors and a.metrics == b.metrics and a.fontSizes == b.fontSizes and a.buttonStyles == b.buttonStyles

# The runtime's view of a tree of lowered `View`s: native views become `Desc`s eagerly, a
# composite view stays a leaf carrying its `View` until it is expanded against its mounted state.
pub Desc describe(View v):
    # `Sited` is the lowering's transparent static-position tag: its one child, at that site.
    if v.viewKind() == "Sited":
        let inner = describe(v.viewChildren()[0])
        return Desc(kind = inner.kind, site = v.viewSite(), key = inner.key, children = inner.children, view = inner.view, props = inner.props, control = inner.control)
    if v.isComposite():
        return Desc(kind = v.viewKind(), site = v.viewSite(), key = v.viewKey(), view = v, props = v.viewProps())
    mut [Desc] kids = []
    for c in v.viewChildren():
        kids.push(describe(c))
    Desc(kind = v.viewKind(), site = v.viewSite(), key = v.viewKey(), children = kids, props = v.viewProps(), control = v)

# The description a composite node was last built from, to re-expand it without its parent.
def Desc lastBuilt(Mounted n):
    Desc(kind = n.kind, site = n.site, key = n.key, view = n.view, props = n.props, control = n.control)

# The identity site of a child at index `i`, encoded so the three ways of being positioned can never
# collide: an explicit static site `n` (>= 0, from the lowering's `Sited` tag) is `2n`, a keyed
# iteration group without one is the shared `-2` (a reorder never changes identity), and a plain
# positional child is `2i + 1`.
def int siteOf(Desc child, int i):
    if child.site >= 0:
        return child.site * 2
    if child.key != "":
        return -2
    i * 2 + 1

# A generation-checked reference to a mounted node.
pub struct Handle:
    pub int id
    pub int generation

def string propText(Mounted n, string name):
    n.props[name] else ("")

pub def bool isFocusableKind(string kind):
    kind == "Button" or kind == "Toggle" or kind == "TextField" or kind == "Slider"

# 1 when node `id` sits inside a `Disabled(true)` subtree, 0 when it does not, -1 when it is absent.
pub def int disabledState(Mounted n, int id, bool inherited):
    var off = inherited
    if n.kind == "Disabled" and propText(n, "value") == "true":
        off = true
    if n.id == id:
        if off:
            return 1
        return 0
    for c in n.children:
        let r = disabledState(c, id, off)
        if r >= 0:
            return r
    -1

# A sibling's traversal rank: a `FocusOrder` wrapper's value, 0 for everything else.
def float orderKey(Mounted c):
    if c.kind == "FocusOrder":
        return (propText(c, "value")).parseFloat() else (0.0)
    0.0

# `m`'s children in traversal order: ascending `FocusOrder` value, ties in structural order (a stable insertion).
def [Mounted] inTraversalOrder(Mounted m):
    mut [Mounted] out = []
    mut [float] keys = []
    for c in m.children:
        let k = orderKey(c)
        var at = out.length
        while at > 0 and keys[at - 1] > k:
            at -= 1
        out.insert(at, c)
        keys.insert(at, k)
    out

# The enabled focusable controls under `m`, in traversal order (structural, adjusted by `FocusOrder`).
# A `Focusable(false)` subtree is skipped by keyboard traversal.
pub def [Handle] focusablesIn(Mounted m, bool inherited):
    mut [Handle] out = []
    var off = inherited
    if m.kind == "Disabled" and propText(m, "value") == "true":
        off = true
    if m.kind == "Focusable" and propText(m, "enabled") == "false":
        return out
    if isFocusableKind(m.kind) and !off:
        out.push(Handle(id = m.id, generation = m.generation))
    for c in inTraversalOrder(m):
        for h in focusablesIn(c, off):
            out.push(h)
    out

# The innermost (or outermost) `FocusSection` that contains node `id` below `m`, nil when none does.
pub def Mounted? sectionOf(Mounted m, int id, Mounted? current, bool innermost):
    var here = current
    if m.kind == "FocusSection":
        if innermost or here == nil:
            here = m
    if m.id == id:
        return here
    for c in m.children:
        if let found = sectionOf(c, id, here, innermost):
            return found
    nil

# The innermost trapping `FocusScope` (`trap = true`) that contains node `id` below `m`, nil when none does.
pub def Mounted? trapScopeOf(Mounted m, int id, Mounted? current):
    var here = current
    if m.kind == "FocusScope" and propText(m, "trap") == "true":
        here = m
    if m.id == id:
        return here
    for c in m.children:
        if let found = trapScopeOf(c, id, here):
            return found
    nil

# The selected row keys of a `MultiList` (its `selection` prop is the keys, newline-separated).
pub def [string] selectedKeysOf(Mounted list):
    mut [string] out = []
    for part in propText(list, "selection").split("\n"):
        if part.length > 0:
            out.push(part)
    out

# The keys of a `List`'s rows, in displayed order (one per keyed `for` iteration).
pub def [string] rowKeysOf(Mounted list):
    mut [string] keys = []
    for c in list.children:
        if c.kind == "KeyedGroup":
            keys.push(c.key)
    keys

# Delivers a semantic action to a native node's control (string parameters, as `boring build` needs).
pub def void deliverAction(Mounted n, string action, string arg) throws:
    if let control = n.control:
        control.viewAct(action, arg)

# The first `DefaultFocus` descendant of `m` that wraps an enabled control, or nil.
def Handle? defaultFocusIn(Mounted m):
    if m.kind == "DefaultFocus" and propText(m, "enabled") != "false":
        let inside = focusablesIn(m, false)
        if inside.length > 0:
            return inside[0]
    for c in m.children:
        if let h = defaultFocusIn(c):
            return h
    nil

# Where focus goes when a scope (a presented sheet) activates: its `DefaultFocus`, else its first control.
pub def Handle? initialFocusIn(Mounted scope):
    if let d = defaultFocusIn(scope):
        return d
    let all = focusablesIn(scope, false)
    if all.length > 0:
        return all[0]
    nil

# Produces a fresh description of the whole window. May invalidate through `rt` while building;
# such invalidations are queued for the next pass instead of re-entering.
pub trait Builder:
    req Desc build(mut Runtime rt)

# The same, for application code that builds `View`s: wrap it in `ViewRoot` to hand it to `start`/
# `flush`.
pub trait ViewBuilder:
    req View buildView(mut Runtime rt)

pub struct ViewRoot as Builder:
    ViewBuilder inner
    req Desc build(mut Runtime rt): describe(inner.buildView(rt))

# What the runtime keeps per mounted id, outside the tree: the named-int slot map, and — for a
# composite view — the typed `V__State` (behind `StateBox`), which lives exactly as long as the
# identity. The tree itself (`Mounted.children`) is plain owned data; nothing aliases it.
struct Meta:
    int generation
    var mut {string=int} slots = {=}
    var StateBox? state = nil
    # An `OnTask` node's current run: `taskGen` is the private task-run generation (bumped on every
    # start and cancellation), `taskId` the restart token the run was started with.
    var int taskGen = 0
    var string taskId = ""
    var bool taskStarted = false

# A subtree in its RETIRING phase (draft, "Animation and transitions"): removed from the active tree — no hit testing,
# focus traversal, events or reconciliation — with its tasks cancelled and focus/capture released, but its hooks,
# slots and ids kept until the removal transition finishes (`finishRetired`). `parent` and `identity`
# (`site|key`) say where it sat, so reinserting that identity before then revives it instead of mounting afresh.
pub struct Retired:
    pub Mounted node
    pub int parent
    pub string identity

# Scratch lists for one reconciliation: hooks are only emitted after the whole tree committed.
struct Pass:
    var mut [string] mounts = []
    var mut [Mounted] retiring = []
    # Subtrees removed under an animated `Transition`: kept mounted (frozen) until their removal finishes.
    var mut [Retired] deferred = []
    # Ids created by this pass, in structural preorder (outermost modifier first): their `OnMount`
    # hooks run after the commit.
    var mut [int] fresh = []

# One reported problem (draft: "Error boundary for event dispatch", "Task errors"): what kind of thing
# failed, the message, the mounted view PATH (`Page/Column/List/TodoRow`, kinds from the root down), the
# mounted node and — for a task — the task-run generation. Nothing here terminates anything: the
# application reporter (a host reading `takeReports`) decides presentation and fatality.
#   kind: "update" (loop guard), "identity" (duplicate keys), "stale" (a write through a dead handle),
#         "env", "theme", "projection", "task", "callback", "hook"
pub struct ErrorReport:
    pub string kind
    pub string message
    pub string path = ""
    pub int node = -1
    pub int run = -1
    pub string source = ""

# An input-method composition in progress (draft, "Accepted value, editing buffer, and IME"): the platform's marked
# (uncommitted) text for one TextField and the cursor inside it. The field's bound value is untouched until the text
# is committed; a composition belongs to the focused field and ends when focus leaves it.
# One finger down (events.br `touchDown` ...): where it started, where it was last seen and when, its smoothed velocity in
# pixels per second, and whether it has moved far enough to be a drag rather than a tap.
pub struct TouchGesture:
    pub float startX
    pub float startY
    pub var float lastX
    pub var float lastY
    pub var float lastT
    pub var float vx = 0.0
    pub var float vy = 0.0
    pub var bool dragging = false

# A drag and drop gesture: pressed inside a `DragSource` (`active` false until the pointer moved a few points), then carrying its payload. `over` holds the
# ids of the `OnDragOver` nodes the pointer is currently inside.
pub struct DragState:
    pub int source
    pub string payload
    pub string preview
    pub float startX
    pub float startY
    pub float x
    pub float y
    pub bool active
    pub [int] over

# The primary press in progress inside at least one gesture view (`OnTap`, `OnLongPress`, `OnSwipe`): their ids, deepest first, where and when (host
# clock, ms) it started, whether it has moved past the slop, and whether a long press already consumed it.
pub struct PressState:
    pub [int] nodes
    pub float startX
    pub float startY
    pub float startMs
    pub bool moved
    pub bool longFired

# An `OnPan` being dragged: its node id and where the pointer was at the last report.
pub struct PanState:
    pub int node
    pub float lastX
    pub float lastY

pub struct ThumbDrag:
    pub int node
    pub int generation
    pub bool vertical
    pub float grab

pub struct Composition:
    pub int node
    pub string text
    pub int cursor = 0

# ── physical key dispatch (draft, "Event dispatch, capture, and errors") ─────────────────────────
# A key travels the retained path root → focused target → root: CAPTURE observers (root toward the target), the
# TARGET's default behaviour (editing, activation, traversal — `keyPress`), then BUBBLE observers (target toward the
# root), which see whether that default consumed the key. Two outcomes are independent: `stop` ends further observer
# delivery, `prevent` suppresses the default behaviour — an ancestor can still observe a key a text field consumed.
# Observers are registered on a mounted identity (`Runtime.observeKeys`) and dropped when it unmounts.

pub struct KeyEvent:
    pub string key
    pub int target = -1           # the focused node (-1: none, the key goes to the window)
    pub bool handled = false      # bubble only: the target's default behaviour consumed the key
    # The observer's answer: set `stop` to end observer delivery, `prevent` to suppress the default behaviour.
    pub var bool stop = false
    pub var bool prevent = false

# What one phase's observers decided, together.
pub struct KeyResponse:
    pub bool stop = false
    pub bool prevent = false

pub trait KeyHandler:
    req void onKey(mut KeyEvent e) throws

pub struct KeyObserver:
    pub int node
    pub int generation
    pub bool capture
    pub KeyHandler handler

# Inertial scrolling in flight (draft, "Scroll": "Momentum is driven by platform-timed follow-up transactions"): the
# scroller it moves, its axis and its velocity in pixels per second (positive = the offset grows). Ended by new input,
# by hitting an edge or friction, and when the scroller unmounts.
# A programmatic scroll gliding to `target` (events.br `stepGlide`).
pub struct Glide:
    pub int node
    pub int generation
    pub float target

pub struct Momentum:
    pub int node
    pub int generation
    pub bool vertical
    pub float velocity

# Undo history of one TextField identity (draft, "Accepted value, editing buffer, and IME"): snapshots of the accepted
# value (and the caret to restore) before each undo group, the redo side, and what grouping needs to know about the
# last edit. It lives with the mounted control and is dropped on unmount.
pub struct EditHistory:
    pub int generation
    pub var mut [string] undoText = []
    pub var mut [int] undoCaret = []
    pub var mut [string] redoText = []
    pub var mut [int] redoCaret = []
    # The value this history last produced; a different bound value is an authoritative external replacement.
    pub var string current = ""
    pub var string lastKind = ""
    pub var int expectCaret = -1

# What layout remembers between frames about the rows of long `List`s (layout.br, "Windowed lists"): the height each row last
# measured, by list id and row key, and the width those heights were measured under, by list id.
pub struct LayoutMemory:
    var mut {string=float} rows = {=}
    var mut {int=float} widths = {=}
    # Bumped whenever the rows/widths above change: what layout worked out under one epoch is only valid under that epoch.
    var int epoch = 0
    # The cross-frame cache (see "Layout cache" in layout.br): the placed subtree of a node version under a size, and the
    # measured height of a list row, both keyed by `id.generation.rev.epoch`. Trimmed when it grows past a few frames' worth.
    var mut {string=PlacedEntry} placed = {=}
    var mut {string=Size} sizes = {=}
    # How many cached subtrees / row sizes were reused since the runtime started (tests and benchmarks read these).
    var int placedHits = 0
    var int sizeHits = 0

    def float? row(string key):
        rows[key]

    def void setRow(string key, float h):
        if (rows[key] else (-1.0)) != h:
            rows[key] = h
            epoch += 1

    def void forgetRow(string key):
        if rows[key] != nil:
            rows.remove(key)
            epoch += 1

    def float widthOf(int list):
        widths[list] else (-1.0)

    def void setWidth(int list, float w):
        if self.widthOf(list) != w:
            widths[list] = w
            epoch += 1

    # A copy of the cached placed subtree under `key` (the lock is released on return: callers go on to read the memory).
    def PlacedEntry? cachedPlaced(string key):
        if let hit = placed[key]:
            placedHits += 1
            return hit
        nil

    # Drops everything cached (a text measurer swapped, say).
    def void bump():
        epoch += 1
        placed = {=}
        sizes = {=}

    def void trim():
        if placed.length > 600 or sizes.length > 6000:
            placed = {=}
            sizes = {=}

# An `OnHover` scope waiting for its `delay` (ms): `since` is the clock reading of the first `tickHover` after the entry (-1.0 until that tick).
pub struct HoverWait:
    pub int id
    pub float since
    pub float delay

pub struct Runtime:
    pub var Mounted? root = nil
    pub var mut [string] events = []
    pub var mut [string] errors = []
    # The same problems, structured (see `ErrorReport`); `errors` keeps the bare messages.
    pub var mut [ErrorReport] reports = []
    pub var mut {int} dirty = {}
    # Layout's memory of the rows of long `List`s (an actor: `layout` reads the runtime, it does not borrow it mutably).
    pub mut LayoutMemory'actor layoutMemory = LayoutMemory()
    # Where composites' callbacks report that they are about to change their own `state` (see
    # `StateOwner` in boring.ui): drained into `dirty` (only the reporting identities) before every pass.
    pub var mut DirtySink'actor sink = DirtySink()
    pub var int depth = 0
    pub var int maxPasses = 64
    # Keyboard focus (generation-checked; cleared when the focused node unmounts).
    pub var Handle? focus = nil
    # The control that took the last pointer press: later move/up/cancel go to it wherever the pointer is
    # (generation-checked; cleared when it unmounts — the draft's "unmounting sends cancellation").
    pub var Handle? capture = nil
    # The enabled interactive control (Button, Toggle, TextField, Slider) under the pointer, set by `pointerMove`
    # (generation-checked; cleared when it unmounts or a sheet opens). The painter shades it.
    pub var Handle? hover = nil
    # `OnHover` scopes the pointer entered whose `delay` has not elapsed yet (see `HoverWait`). Dropped when the pointer leaves the scope.
    pub var mut [HoverWait] hoverPending = []
    # The composition in progress, if any (see `Composition`); pruned after every update pass.
    pub var Composition? composition = nil
    pub var Momentum? momentum = nil
    pub var Glide? glide = nil
    # The internal clipboard (see events.br, `copySelection` / `pasteClipboard`).
    pub var string clipboard = ""
    # A press in a text field is still dragging a selection (a double or triple click is not: it already selected).
    pub var bool dragSelect = false
    # A scroll indicator's thumb being dragged (events.br): the scroller, and where along the thumb it was grabbed.
    pub var ThumbDrag? thumbDrag = nil
    # The drag and drop gesture in progress, if any (see `DragState`).
    pub var DragState? drag = nil
    # The press in progress inside gesture views (see `PressState`), the host clock as last reported (`setClock`, `tickHover`), and the last tap (for `OnTap` counts).
    pub var PressState? press = nil
    pub var float nowMs = 0.0
    pub var float tapMs = -10000.0
    pub var float tapX = 0.0
    pub var float tapY = 0.0
    pub var int taps = 0
    # The `OnPan` drag in progress, if any (see `PanState`).
    pub var PanState? pan = nil
    # The touch in progress, if any (see `touchDown`).
    pub var TouchGesture? gesture = nil
    # Per-TextField undo/redo history, keyed by mounted id (generation-checked; dropped when the node unmounts).
    pub var mut {int=EditHistory} histories = {=}
    pub var mut [KeyObserver] keyObservers = []
    # Subtrees waiting for their animated removal to finish (see `Retired`).
    pub var mut [Retired] retired = []
    # Modal presentation: the ids of the `Sheet` nodes that are presented, outermost first, and the focus
    # each one displaced (restored on dismissal while that control still exists and is enabled).
    pub var [int] openSheets = []
    # The programmatic-scroll request each `Scroll` last had applied (events.br `applyScrollRequests`), by node id: "generation|anchor|request".
    pub var mut {int=string} scrollApplied = {=}
    pub var [Handle] focusReturn = []
    # Animation metadata of the transactions (draft: "An ordinary library function establishes animation
    # metadata on the current UI transaction"): `animate` / `withoutAnimation` record theirs in
    # `lastAnimation` (`None` curve = an explicit snap), an `AnimationScope` whose `value` changed records a
    # `Trigger`. A host reads both after the update pass (`takeAnimation`, `takeTriggers`) and hands them to
    # the `Animator`; nothing animates by default.
    pub var Animation? lastAnimation = nil
    pub var [Trigger] triggers = []
    # How many `AnimationScope`s whose trigger fired are being reconciled (a removal below one is animated).
    pub var int animatingScopes = 0
    pub var int passesRun = 0     # update passes executed by `flush`, over the runtime's lifetime
    pub var int expansions = 0    # composite bodies expanded (a whole-window pass expands every composite)
    pub var int partialPasses = 0 # update passes that re-expanded only the invalidated subtrees
    # Ids that still owe their `OnMount` hook (created by a commit, hook not run yet), in order.
    var mut [int] pendingMount = []
    var int nextId = 1
    var int nextGeneration = 1
    var mut [int] freeIds = []
    var mut {int=Meta} meta = {=}

    # ── error reporting ───────────────────────────────────────────────────────

    # Records a problem about mounted node `node` (-1 for none): the message goes to `errors`, a structured
    # report with the node's view path to `reports`.
    def void report(string kind, string message, int node):
        errors.push(message)
        reports.push(ErrorReport(kind = kind, message = message, path = self.pathOf(node), node = node))

    # The same for a problem that already knows its path (validation of a description before mounting).
    def void reportAtPath(string kind, string message, string path):
        errors.push(message)
        reports.push(ErrorReport(kind = kind, message = message, path = path))

    # A failure raised by user code while the runtime was driving it: `source` names what ran (the action
    # `"activate"`, a hook `"mount"`, a task id). Writes already completed stay committed; the reporter
    # decides what to show. Used by the dispatch boundary for callbacks that throw.
    def void reportFailure(string kind, string source, string message, int node):
        errors.push(message)
        reports.push(ErrorReport(kind = kind, message = message, path = self.pathOf(node), node = node, source = source))

    # An uncaught error of a task body. A cancelled or superseded run (lifecycle removal, an `id` change) is an
    # EXPECTED completion and is not reported; only a run that is still current is. The task then stays
    # finished: a rebuild with the same `id` does not retry it.
    def bool failTask(TaskRun run, string message):
        if !self.isCurrent(run):
            return false
        errors.push(message)
        reports.push(ErrorReport(kind = "task", message = message, path = self.pathOf(run.node), node = run.node, run = run.generation, source = run.id))
        true

    # The reports recorded since the last call (clears them).
    def [ErrorReport] takeReports():
        let out = reports
        reports = []
        out

    # The view path of mounted node `id`: the kinds from the root down, joined with "/" ("" when unknown).
    req string pathOf(int id):
        if id < 0:
            return ""
        if let r = root:
            mut [string] kinds = []
            if self.pathKinds(r, id, kinds):
                return kinds.join("/")
        ""

    req bool pathKinds(Mounted n, int id, mut [string] kinds):
        kinds.push(n.kind)
        if n.id == id:
            return true
        for c in n.children:
            if self.pathKinds(c, id, kinds):
                return true
        _ = kinds.pop()
        false

    # ── mount / update ────────────────────────────────────────────────────────

    # Mounts (first call) or updates (later calls) the tree from `d`. Returns false and leaves the
    # mounted tree untouched when `d` is invalid (duplicate keys).
    def bool apply(Desc d):
        let problems = self.validate(d, d.kind)
        if problems.length > 0:
            for p in problems:
                self.reportAtPath("identity", p, d.kind)
            return false
        mut ctx = Pass()
        if let current = root:
            if current.kind == d.kind:
                mut updated = current
                self.reconcileNode(updated, d, ctx, [])
                root = updated
            else:
                ctx.retiring.push(current)
                root = self.create(d, 0, ctx, [])
        else:
            root = self.create(d, 0, ctx, [])
        self.finishPass(ctx)
        true

    def void finishPass(Pass ctx):
        self.commit(ctx)
        for id in ctx.fresh:
            self.pendingMount.push(id)

    # Re-expands only the invalidated composites: each outermost dirty node is reconciled against the view
    # it was last built from (inputs as of the latest whole-window build) and its own kept state, under the
    # environment its ancestors provide. Native nodes carry no state of their own to rebuild. Everything
    # outside those subtrees is untouched, so no `body()` outside them runs. The tree is plain owned data,
    # so the walk rebuilds each ancestor's child list around the reconciled node, like `reconcileNode`.
    def void applyPartial({int} ids):
        mut ctx = Pass()
        if let r = root:
            mut top = r
            self.partialIn(top, ids, ctx, [])
            root = top
        self.finishPass(ctx)

    def void partialIn(mut Mounted n, {int} ids, mut Pass ctx, [EnvValue] scope):
        if ids.contains(n.id) and n.view != nil:
            self.reconcileNode(n, lastBuilt(n), ctx, scope)
            return
        let below = self.scopeBelow(lastBuilt(n), scope)
        mut [Mounted] next = []
        var changed = false
        for c in n.children:
            let oldRev = c.rev
            mut kept = c
            self.partialIn(kept, ids, ctx, below)
            if kept.rev != oldRev:
                changed = true
            next.push(kept)
        if changed:
            n.rev += 1
        n.children = next

    # Names the version of the mounted tree without reading it (reading `root` copies the whole tree): "" when nothing is
    # mounted. Layout keys its window-level cache with it.
    req string rootStamp():
        if root == nil:
            return ""
        "{root?.id else (-1)}.{root?.generation else (-1)}.{root?.rev else (-1)}"

    # True when the next pass must rebuild the whole window: nothing mounted yet, or the root itself is dirty.
    def bool wholeWindowDirty():
        if let r = root:
            return dirty.contains(r.id)
        true

    def start(Builder b):
        _ = self.apply(b.build(self))
        self.syncModal()
        self.syncFocusBindings()
        self.pruneSelection()
        self.flush(b)

    def int fresh():
        if self.freeIds.length > 0:
            let reused = self.freeIds[self.freeIds.length - 1]
            _ = self.freeIds.pop()
            return reused
        let id = nextId
        nextId += 1
        id

    def Mounted create(Desc d, int site, mut Pass ctx, [EnvValue] scope):
        let id = self.fresh()
        mut node = Mounted(id = id, generation = nextGeneration, kind = d.kind, site = site, key = d.key)
        mut info = Meta(generation = nextGeneration)
        nextGeneration += 1
        node.props = d.props
        node.control = d.control
        node.theme = themeIn(scope)
        ctx.mounts.push("mount {d.kind}#{id}")
        ctx.fresh.push(id)
        if let v = d.view:
            node.view = v
            info.state = v.newOwnedState(StateOwner(id = id, generation = info.generation, sink = sink))
        meta[id] = info
        let kids = self.childrenOf(id, d, scope)
        let below = self.scopeBelow(d, scope)
        if self.checked(kids, d.kind):
            for i in 0..<kids.length:
                let child = kids[i]
                node.children.push(self.create(child, siteOf(child, i), ctx, below))
        node

    # The children to reconcile under `node`: a native node's own, or — for a composite view —
    # its body, expanded against the state this identity has kept since it mounted.
    def [Desc] childrenOf(int id, Desc d, [EnvValue] scope):
        if let v = d.view:
            if let info = meta[id]:
                if let st = info.state:
                    return [self.expanded(v, st, scope)]
            return [self.expanded(v, NoState(), scope)]
        if d.kind == "Sheet":
            if (d.props["isPresented"] else ("false")) != "true":
                return []
        if d.kind == "Popover":
            # the anchor always, the panel only while presented
            if (d.props["isPresented"] else ("false")) != "true" and d.children.length > 1:
                return [d.children[0]]
        d.children

    # One composite's body as a `Desc`. A view with `env` gets the providers in scope for it (nearest
    # ancestor first); one whose `env` is unsatisfied renders `EnvMissing`, reported once.
    def Desc expanded(View v, StateBox st, [EnvValue] scope):
        expansions += 1
        let d = describe(self.expandBody(v, st, scope))
        if d.kind == "EnvMissing":
            let message = "missing environment value: {d.props["what"] else ("?")}"
            if !errors.contains(message):
                self.reportAtPath("env", message, d.kind)
        d

    def View expandBody(View v, StateBox st, [EnvValue] scope):
        if v.usesEnv():
            return v.expandIn(st, scope)
        v.expand(st)

    # The scope the children of `d` see: a `Provide` adds its value in front (nearest wins).
    def [EnvValue] scopeBelow(Desc d, [EnvValue] scope):
        if let control = d.control:
            if let provided = control.viewProvides():
                # A theme is validated once, when it is installed: an invalid one is reported and NOT
                # installed (the subtree keeps the outer theme), so a bad token never reaches layout.
                # (Downcast through an array: `boring build` does not downcast a bare optional method result.)
                mut offered = [provided]
                if let theme = firstTheme(offered):
                    let problems = themeProblems(theme)
                    if problems.length > 0:
                        for problem in problems:
                            let message = "invalid theme '{theme.name}': {problem}"
                            if !errors.contains(message):
                                self.reportAtPath("theme", message, "Provide")
                        return scope
                for v in scope:
                    offered.push(v)
                return offered
        scope

    # A composite's expansion is only known while reconciling, so its keys are checked here, per
    # children list, before that list mutates. A failing subtree is left as it was (draft: "the
    # failed update leaves that entire `for` subtree mounted unchanged").
    def bool checked([Desc] kids, string path):
        let problems = self.validate(Desc(kind = path, children = kids), path)
        for p in problems:
            self.reportAtPath("identity", p, path)
        problems.length == 0

    # A removed child: torn down at once, unless an animated transaction — or an `AnimationScope` whose trigger fired in
    # this very pass, around the removed child — removes it under a `Transition` with a real removal: then it is retired
    # (kept mounted but frozen) until the host reports the removal finished.
    def void retire(Mounted old, int parent, mut Pass ctx):
        var animated = animatingScopes > 0
        if let a = lastAnimation:
            animated = a.curve != "None"
        if animated and old.kind == "Transition" and propText(old, "removal") != "Identity":
            ctx.deferred.push(Retired(node = old, parent = parent, identity = "{old.site}|{old.key}"))
        else:
            ctx.retiring.push(old)

    # The retired subtree that sat at `identity` under `parent`, taken back into the active tree (nil when none).
    def Mounted? takeRetired(int parent, string identity, string kind):
        var Mounted? found = nil
        mut [Retired] rest = []
        for r in retired:
            if found == nil and r.parent == parent and r.identity == identity and r.node.kind == kind:
                found = r.node
            else:
                rest.push(r)
        retired = rest
        found

    # Same identity, same kind: keep the node (and its slots and state), reconcile its children.
    def reconcileNode(mut Mounted node, Desc d, mut Pass ctx, [EnvValue] scope):
        # An `AnimationScope` whose trigger value changed (never on its first mount) fires its animation.
        if node.kind == "AnimationScope":
            if (node.props["value"] else ("")) != (d.props["value"] else ("")):
                let duration = (d.props["duration"] else ("200")).parseFloat() else (200.0)
                let response = (d.props["response"] else ("300")).parseFloat() else (300.0)
                let damping = (d.props["damping"] else ("0.8")).parseFloat() else (0.8)
                triggers.push(Trigger(node = node.id, animation = animationNamed(d.props["curve"] else ("EaseInOut"), duration, response, damping)))
        # (what is removed below a scope that just fired is removed with its animation: see `retire`)
        var fired = false
        if node.kind == "AnimationScope":
            fired = (node.props["value"] else ("")) != (d.props["value"] else (""))
        let nextTheme = themeIn(scope)
        var changed = node.props != d.props or !sameTheme(node.theme, nextTheme)
        node.props = d.props
        node.control = d.control
        node.theme = nextTheme
        if let v = d.view:
            node.view = v
        let kids = self.childrenOf(node.id, d, scope)
        let below = self.scopeBelow(d, scope)
        if !self.checked(kids, d.kind):
            return
        if fired:
            animatingScopes += 1
        mut {string=Mounted} byIdentity = {=}
        for old in node.children:
            byIdentity["{old.site}|{old.key}"] = old
        mut {string} used = {}
        mut [Mounted] next = []
        for i in 0..<kids.length:
            let child = kids[i]
            let site = siteOf(child, i)
            let identity = "{site}|{child.key}"
            if let old = byIdentity[identity]:
                _ = used.add(identity)
                if old.kind == child.kind:
                    let oldRev = old.rev
                    mut kept = old
                    self.reconcileNode(kept, child, ctx, below)
                    if kept.rev != oldRev:
                        changed = true
                    next.push(kept)
                else:
                    self.retire(old, node.id, ctx)
                    next.push(self.create(child, site, ctx, below))
                    changed = true
            else:
                if let back = self.takeRetired(node.id, identity, child.kind):
                    # The identity returns before its removal finished: the same mounted node, no second mount.
                    mut revived = back
                    self.reconcileNode(revived, child, ctx, below)
                    next.push(revived)
                    changed = true
                else:
                    next.push(self.create(child, site, ctx, below))
                    changed = true
        for old in node.children:
            if !used.contains("{old.site}|{old.key}"):
                self.retire(old, node.id, ctx)
                changed = true
        if next.length != node.children.length:
            changed = true
        else:
            for i in 0..<next.length:
                if next[i].id != node.children[i].id or next[i].generation != node.children[i].generation:
                    changed = true
        if changed:
            node.rev += 1
        node.children = next
        if fired:
            animatingScopes -= 1

    # Unmount hooks first (descendants before parents, siblings in reverse), then mount hooks in
    # structural preorder — one transaction's worth of hooks, emitted only after the commit.
    def commit(Pass ctx):
        # Before the first unmount hook, every scoped task of every retiring subtree is cancelled.
        for r in ctx.retiring:
            self.cancelTasks(r)
        var i = ctx.retiring.length - 1
        while i >= 0:
            self.release(ctx.retiring[i])
            i -= 1
        for d in ctx.deferred:
            self.freeze(d.node)
            retired.push(d)
            events.push("retire {d.node.kind}#{d.node.id}")
        for m in ctx.mounts:
            events.push(m)

    # The start of a retiring phase: scoped tasks are cancelled and focus, pointer capture and composition leave the
    # subtree. Hooks and resources wait for `finishRetired`.
    def void freeze(Mounted node):
        self.cancelTasks(node)
        self.dropInteraction(node)

    def void dropInteraction(Mounted n):
        if let f = focus:
            if f.id == n.id:
                focus = nil
        if let c = capture:
            if c.id == n.id:
                capture = nil
        for c in n.children:
            self.dropInteraction(c)

    # Ends the retiring phase of the subtree that sat under `parent` (or of every one when `all`): `onUnmount` hooks
    # run, slots and identities are dropped. Returns how many were torn down.
    def int finishRetiredUnder(int parent):
        mut [Retired] keep = []
        mut [Retired] done = []
        for r in retired:
            if r.parent == parent:
                done.push(r)
            else:
                keep.push(r)
        retired = keep
        for d in done:
            self.release(d.node)
        done.length

    def int finishRetired(int id, bool all):
        mut [Retired] keep = []
        mut [Retired] done = []
        for r in retired:
            if all or r.node.id == id:
                done.push(r)
            else:
                keep.push(r)
        retired = keep
        var i = done.length - 1
        while i >= 0:
            self.release(done[i].node)
            i -= 1
        done.length

    def release(Mounted node):
        # Removing an ancestor ends the transitions of descendants still retiring under it (they go as one group).
        var below = 0
        for r in retired:
            if r.parent == node.id:
                below += 1
        if below > 0:
            _ = self.finishRetiredUnder(node.id)
        var i = node.children.length - 1
        while i >= 0:
            self.release(node.children[i])
            i -= 1
        if let f = focus:
            if f.id == node.id:
                focus = nil
        if let c = capture:
            if c.id == node.id:
                capture = nil
        if let hv = hover:
            if hv.id == node.id:
                hover = nil
        events.push("unmount {node.kind}#{node.id}")
        # The hook runs with the node's own identity (and the inputs it captured) still valid.
        if node.kind == "OnUnmount":
            if let control = node.control:
                let before = sink.reports
                self.dispatch(node, "unmount", "")
                self.settle(before)
        meta.remove(node.id)
        histories.remove(node.id)
        if let m = momentum:
            if m.node == node.id:
                momentum = nil
        self.dropObservers(node.id)
        freeIds.push(node.id)

    # Registers `handler` for keys passing through node `h`: capture (before the target's default) or bubble (after).
    def bool observeKeys(Handle h, bool capture, KeyHandler handler):
        if !self.valid(h):
            return false
        keyObservers.push(KeyObserver(node = h.id, generation = h.generation, capture = capture, handler = handler))
        true

    def void dropObservers(int id):
        mut [KeyObserver] kept = []
        for o in keyObservers:
            if o.node != id:
                kept.push(o)
        keyObservers = kept

    # The ids from the window root down to node `id` (just the root when `id` is -1 or gone).
    req [int] idPath(int id):
        mut [int] out = []
        if let r = root:
            if id < 0 or !self.idPathIn(r, id, out):
                out = [r.id]
        out

    req bool idPathIn(Mounted n, int id, mut [int] out):
        out.push(n.id)
        if n.id == id:
            return true
        for c in n.children:
            if self.idPathIn(c, id, out):
                return true
        _ = out.pop()
        false

    # Keys must be unique among the keyed siblings of one site, checked before anything mutates.
    def [string] validate(Desc d, string path):
        mut [string] problems = []
        mut {string=int} seen = {=}
        for i in 0..<d.children.length:
            let child = d.children[i]
            if child.key != "":
                let identity = "{siteOf(child, i)}|{child.key}"
                if let first = seen[identity]:
                    problems.push("duplicate key '{child.key}' under {path} (indices {first} and {i})")
                else:
                    seen[identity] = i
            for p in self.validate(child, "{path}/{child.kind}"):
                problems.push(p)
        problems

    # ── handles and writes ────────────────────────────────────────────────────

    req Handle? handle(int id):
        if let info = meta[id]:
            return Handle(id = id, generation = info.generation)
        nil

    req bool valid(Handle h):
        if let info = meta[h.id]:
            return info.generation == h.generation
        false

    # A write through a stale handle is a no-op (and is reported), never an access to whatever
    # node later reuses the id.
    def bool write(Handle h, string slot, int value):
        if !self.valid(h):
            self.report("stale", "stale write to {h.id}.{slot}", -1)
            return false
        meta[h.id].slots[slot] = value
        _ = dirty.add(h.id)
        true

    req Mounted? find(int id):
        if let r = root:
            return self.findIn(r, id)
        nil

    req Mounted? findIn(Mounted n, int id):
        if n.id == id:
            return n
        for c in n.children:
            if let hit = self.findIn(c, id):
                return hit
        nil

    # Typed state is mutated in place by callbacks. A callback built by a lowered view reports the
    # composite that owns the state it touches (`sink`), so only that one is re-expanded; anything that
    # reported nothing (or reported that it reaches beyond its own state) invalidates the whole window.
    def void invalidateRoot():
        if let r = root:
            _ = dirty.add(r.id)

    # Folds the callbacks' reports into `dirty`: the reporting identities that are still the same mounted
    # node, or the root when one reached beyond its own state.
    def void drainSink():
        if sink.all:
            self.invalidateRoot()
        for i in 0..<sink.ids.length:
            let id = sink.ids[i]
            if let info = meta[id]:
                if info.generation == sink.generations[i]:
                    _ = dirty.add(id)
        sink.clear()

    def bool anyDirty():
        self.drainSink()
        dirty.length > 0

    # Ends a dispatch that began with `sink.reports == before`: a callback that reported (precisely or
    # not) has said what it dirtied; one that did not is unknown, so the whole window is rebuilt.
    def void settle(int before):
        if sink.reports == before:
            self.invalidateRoot()

    # The typed state of a composite view's mounted node (downcast it with `as V__State`).
    req StateBox? stateOf(Handle h):
        if !self.valid(h):
            return nil
        if let info = meta[h.id]:
            if let st = info.state:
                return st
        nil

    # Marks a node as needing a rebuild without writing a slot (typed state is mutated in place).
    def bool invalidate(Handle h):
        if !self.valid(h):
            self.report("stale", "stale invalidate of {h.id}", -1)
            return false
        _ = dirty.add(h.id)
        true

    req int? read(Handle h, string slot):
        if !self.valid(h):
            return nil
        if let info = meta[h.id]:
            return info.slots[slot]
        nil

    # ── event transactions and the update loop ────────────────────────────────

    def beginEvent():
        depth += 1

    # Leaving the outermost event runs the update passes; a nested event joins the outer one.
    def endEvent(Builder b):
        depth -= 1
        if depth == 0:
            self.flush(b)

    # Runs update passes until nothing is invalidated. Invalidation during a ctx is queued for
    # the next one; more than `maxPasses` consecutive passes is an update-loop error that clears
    # the queue and keeps the last committed tree.
    def bool flush(Builder b):
        if depth > 0:
            return true
        var passes = 0
        while true:
            # Hooks of the last commit run first (their writes are batched into the next pass); tasks
            # only start once the tree is stable, so an `OnMount` that removes its own subtree never
            # starts work that would be cancelled at once.
            self.runMountHooks()
            if !self.anyDirty():
                self.startTasks()
            if !self.anyDirty():
                break
            if passes >= maxPasses:
                self.reportAtPath("update", "update loop: {passes} consecutive passes, still invalidated: {self.dirtyIds().map((i): "{i}").join(",")}", "")
                dirty = {}
                self.pendingMount = []
                return false
            passes += 1
            passesRun += 1
            let whole = self.wholeWindowDirty()
            let wanted = dirty
            dirty = {}
            # Child writes through `bind` projections land in their parents' collections (by key)
            # before anything is rebuilt from them.
            self.commitProjections()
            if whole:
                _ = self.apply(b.build(self))
            else:
                partialPasses += 1
                self.applyPartial(wanted)
            self.syncModal()
            self.syncFocusBindings()
            self.pruneSelection()
            self.pruneComposition()
        true

    # ── modal presentation and focus restoration ─────────────────────────────

    # Presented sheets (preorder, so a later one is nested deeper or comes later = on top).
    req [int] presentedSheets():
        mut out = []
        if let r = root:
            self.sheetsIn(r, out)
        out

    req void sheetsIn(Mounted n, mut [int] out):
        if n.kind == "Sheet" and (n.props["isPresented"] else ("false")) == "true" and n.children.length > 0:
            out.push(n.id)
        for c in n.children:
            self.sheetsIn(c, out)

    # Presented popovers (preorder: a later one is on top): the nodes that have their panel mounted.
    req [int] presentedPopovers():
        mut out = []
        if let r = root:
            self.popoversIn(r, out)
        out

    req void popoversIn(Mounted n, mut [int] out):
        if n.kind == "Popover" and (n.props["isPresented"] else ("false")) == "true" and n.children.length > 1:
            out.push(n.id)
        for c in n.children:
            self.popoversIn(c, out)

    # After every update pass: when a sheet opened, remember the focus, drop any pointer capture and move
    # focus into it (a `DefaultFocus`, else its first enabled control); when one closed, give the focus
    # back if that control still exists and is enabled, else clear it (no automatic replacement).
    def void syncModal():
        let now = self.presentedSheets()
        if now.length == openSheets.length:
            openSheets = now
            return
        if now.length > openSheets.length:
            capture = nil
            hover = nil
            if let f = focus:
                if self.valid(f):
                    focusReturn.push(f)
            if let top = self.find(now[now.length - 1]):
                if let first = initialFocusIn(top):
                    focus = first
                else:
                    focus = nil
        else:
            var Handle? restored = nil
            if focusReturn.length > 0:
                let back = focusReturn[focusReturn.length - 1]
                focusReturn.removeIndices([focusReturn.length - 1])
                if self.valid(back) and !self.disabledAt(back.id):
                    restored = back
            focus = restored
        openSheets = now

    # ── input-method composition ───────────────────────────────────────────────

    # A composition survives only while its field is mounted, enabled and focused (focus moving away, an unmount or
    # a `Disabled` ancestor cancels it: the draft's "text input/IME is suspended").
    def void pruneComposition():
        if let c = composition:
            var keep = false
            if let f = focus:
                if self.valid(f) and f.id == c.node and !self.disabledAt(f.id):
                    keep = true
            if !keep:
                composition = nil

    # ── `.focused(...)` bindings ───────────────────────────────────────────────

    # Every `Focused` / `FocusedAs` node, preorder.
    req [Mounted] focusBindings():
        mut out = []
        if let r = root:
            self.collectBindings(r, out)
        out

    req void collectBindings(Mounted n, mut [Mounted] out):
        if n.kind == "Focused" or n.kind == "FocusedAs":
            out.push(n)
        for c in n.children:
            self.collectBindings(c, out)

    # Synchronizes native focus and the bound values, both ways, once per update pass (draft, "Requests,
    # default focus, and synchronization"). Per binding, with `f` = its control holds focus, `w` = its bound
    # value asks for focus (true / its own token), `h` = we last wrote it as focused:
    #   f and w            consistent
    #   f, not w, not h    focus arrived natively: write the binding on
    #   f, not w, h        the application cleared it: focus is dropped
    #   not f, w, not h    the application asked: focus moves there (first request wins; later ones are
    #                      written back off); if the control is not eligible (disabled, outside the active
    #                      sheet) the request stays pending and is retried each pass
    #   not f, w, h        focus left natively: write the binding off
    def void syncFocusBindings():
        var granted = false
        for n in self.focusBindings():
            let mine = focusablesIn(n, false)
            var f = false
            var Handle? target = nil
            if mine.length > 0:
                target = mine[0]
                if let cur = focus:
                    if self.valid(cur):
                        for m in mine:
                            if m.id == cur.id:
                                f = true
            let isToken = n.kind == "FocusedAs"
            let current = propText(n, "value")
            var w = current == "true"
            if isToken:
                w = current != "" and current == propText(n, "token")
            let handle = Handle(id = n.id, generation = n.generation)
            var h = false
            let stored = self.read(handle, "syncedOn") else (0)
            if stored == 1:
                h = true
            if f and w:
                if !h:
                    _ = self.write(handle, "syncedOn", 1)
            elif f and !w and !h:
                self.bindFocused(n, isToken, true)
                _ = self.write(handle, "syncedOn", 1)
            elif f and !w and h:
                focus = nil
                _ = self.write(handle, "syncedOn", 0)
            elif !f and w and !h:
                if granted:
                    self.bindFocused(n, isToken, false)
                else:
                    # (The option is opened first: `boring build` moves a `Handle?` passed to a method.)
                    if let t = target:
                        if self.eligible(t):
                            focus = t
                            granted = true
                            _ = self.write(handle, "syncedOn", 1)
            elif !f and w and h:
                self.bindFocused(n, isToken, false)
                _ = self.write(handle, "syncedOn", 0)
            elif stored == 1:
                _ = self.write(handle, "syncedOn", 0)

    # ── list selection ─────────────────────────────────────────────────────────

    req [Mounted] lists():
        mut out = []
        if let r = root:
            self.collectLists(r, out)
        out

    req void collectLists(Mounted n, mut [Mounted] out):
        if (n.kind == "List" or n.kind == "MultiList"):
            out.push(n)
        for c in n.children:
            self.collectLists(c, out)

    # After every update pass a selected key that no longer exists is cleared (draft: "During update, a
    # single selected key that no longer exists is cleared").
    def void pruneSelection():
        for l in self.lists():
            if l.kind == "MultiList":
                # A multi-selection is intersected with the remaining keys.
                let wanted = selectedKeysOf(l)
                let rows = rowKeysOf(l)
                mut [string] kept = []
                for k in wanted:
                    if rows.contains(k):
                        kept.push(k)
                if kept.length != wanted.length:
                    let before = sink.reports
                    self.dispatch(l, "setSelection", kept.join("\n"))
                    self.settle(before)
                continue
            let chosen = propText(l, "selection")
            if chosen != "":
                if !rowKeysOf(l).contains(chosen):
                    let before = sink.reports
                    self.dispatch(l, "select", "")
                    self.settle(before)

    # The dispatch boundary for a native control's semantic action: a callback that throws is reported
    # (kind "callback", the action as source, the node's path) instead of escaping; earlier writes stay.
    def void dispatch(Mounted n, string action, string arg):
        try:
            deliverAction(n, action, arg)
        catch:
            self.reportFailure("callback", action, "{error}", n.id)

    # Writes a binding on (true / its token) or off (false / "") through its control.
    def void bindFocused(Mounted n, bool isToken, bool on):
        if isToken:
            if on:
                self.dispatch(n, "setText", propText(n, "token"))
            else:
                if propText(n, "value") == propText(n, "token"):
                    self.dispatch(n, "setText", "")
        else:
            if on:
                self.dispatch(n, "setBool", "true")
            else:
                self.dispatch(n, "setBool", "false")
        self.invalidateRoot()

    # Whether a control may take focus now: mounted, enabled, and inside the active modal scope if any.
    req bool eligible(Handle t):
        if !self.valid(t):
            return false
        if self.disabledAt(t.id):
            return false
        if openSheets.length > 0:
            if let top = self.find(openSheets[openSheets.length - 1]):
                for m in focusablesIn(top, false):
                    if m.id == t.id:
                        return true
            return false
        true

    # Whether node `id` sits inside a `Disabled(true)` subtree.
    req bool disabledAt(int id):
        if let r = root:
            return disabledState(r, id, false) == 1
        false

    # ── animation transactions ────────────────────────────────────────────────

    # Runs `body` as one event transaction tagged with `a`: every write in it, and the update pass it
    # causes, are eligible to animate with `a` (the innermost `animate` of a nested call wins).
    def void animate(Animation a, Builder host, UIAction body):
        self.beginEvent()
        let before = sink.reports
        try:
            body()
        catch:
            self.reportFailure("callback", "animate", "{error}", -1)
        self.settle(before)
        lastAnimation = a
        self.endEvent(host)

    # The same, explicitly snapping: it overrides an inherited animation and any triggered scope.
    def void withoutAnimation(Builder host, UIAction body):
        self.animate(Animation(), host, body)

    # The animation of the last transaction that tagged one (clears it).
    def Animation? takeAnimation():
        let a = lastAnimation
        lastAnimation = nil
        a

    # The `AnimationScope` triggers recorded since the last call (clears them).
    def [Trigger] takeTriggers():
        let t = triggers
        triggers = []
        t

    # ── scroll offsets ────────────────────────────────────────────────────────

    # Sets the offset of the `Scroll` node `id` (layout clamps it); false when there is no such node.
    def bool scrollTo(int id, float offset):
        if let r = root:
            if self.find(id) == nil:
                return false
            root = self.withScroll(r, id, offset)
            return true
        false

    # The tree with one node's scroll offset replaced (a rebuilt copy: nothing is mutated in place).
    def Mounted withScroll(Mounted n, int id, float offset):
        mut [Mounted] kids = []
        for c in n.children:
            kids.push(self.withScroll(c, id, offset))
        var next = n.scroll
        var rev = n.rev
        if n.id == id and offset != n.scroll:
            next = offset
            rev += 1
        for i in 0..<kids.length:
            if kids[i].rev != n.children[i].rev:
                rev += 1
        Mounted(id = n.id, generation = n.generation, kind = n.kind, site = n.site, key = n.key, children = kids, props = n.props, view = n.view, control = n.control, scroll = next, theme = n.theme, rev = rev)

    # ── bind projections ──────────────────────────────────────────────────────

    # Asks every mounted composite view (preorder) to write its projections back by key. A projection
    # whose key is gone is dropped and reported (the draft's stale-handle rule: the write is a no-op).
    def void commitProjections():
        if let r = root:
            let stale = self.commitProjectionsIn(r)
            if stale > 0:
                self.reportAtPath("projection", "stale bind projection: {stale} write(s) dropped, the element's key is gone", "")

    def int commitProjectionsIn(Mounted n):
        var stale = 0
        if let v = n.view:
            if let info = meta[n.id]:
                if let st = info.state:
                    stale += v.commitProjectionsIn(st)
        for c in n.children:
            stale += self.commitProjectionsIn(c)
        stale

    # ── lifecycle hooks and scoped tasks ──────────────────────────────────────

    # `OnMount` hooks of the nodes the last commits created, in structural preorder (outermost
    # modifier first). A node already gone again is skipped. Typed state is mutated in place by
    # callbacks, so a hook that ran invalidates the window (like any other action).
    def void runMountHooks():
        let ids = self.pendingMount
        self.pendingMount = []
        if ids.length == 0:
            return
        # One walk for every pending id: a `find` per id is a full-tree walk each (quadratic in the tree size).
        mut {int} wanted = {}
        for id in ids:
            _ = wanted.add(id)
        mut {int=Mounted} hooks = {=}
        if let r = root:
            self.collectMountHooks(r, wanted, hooks)
        for id in ids:
            if let node = hooks[id]:
                self.runMountHook(node, id)

    def void collectMountHooks(Mounted n, {int} wanted, mut {int=Mounted} hooks):
        if n.kind == "OnMount" and wanted.contains(n.id):
            hooks[n.id] = n
        for c in n.children:
            self.collectMountHooks(c, wanted, hooks)

    def void runMountHook(Mounted node, int id):
        if let control = node.control:
            events.push("hook mount {node.kind}#{id}")
            let before = sink.reports
            self.dispatch(node, "mount", "")
            self.settle(before)

    # Starts a run for every `OnTask` node that has none yet, or whose `id` changed since its run
    # started (the old run is cancelled: its generation goes stale first). Preorder; stops as soon as
    # a body invalidated the window — the rest start after that update is stable.
    def void startTasks():
        if let r = root:
            _ = self.startTasksIn(r)

    def bool startTasksIn(Mounted n):
        if n.kind == "OnTask":
            if let info = meta[n.id]:
                let id = n.props["id"] else ("")
                if !info.taskStarted or info.taskId != id:
                    # Read everything off `info` first: it aliases the entry the writes below update.
                    let previous = info.taskGen
                    let next = previous + 1
                    let nodeGeneration = info.generation
                    if info.taskStarted:
                        events.push("task cancel {n.kind}#{n.id} run {previous}")
                    meta[n.id].taskGen = next
                    meta[n.id].taskStarted = true
                    meta[n.id].taskId = id
                    let run = TaskRun(node = n.id, nodeGeneration = nodeGeneration, generation = next, id = id)
                    events.push("task start {n.kind}#{n.id} run {run.generation}")
                    let before = sink.reports
                    if let control = n.control:
                        try:
                            control.viewTask(run)
                        catch:
                            _ = self.failTask(run, "{error}")
                    self.settle(before)
                    return false
        for c in n.children:
            if !self.startTasksIn(c):
                return false
        true

    # Cancels every started run in a subtree (before its unmount hooks): the generations go stale.
    def void cancelTasks(Mounted n):
        if n.kind == "OnTask":
            if let info = meta[n.id]:
                if info.taskStarted:
                    let previous = info.taskGen
                    meta[n.id].taskGen = previous + 1
                    events.push("task cancel {n.kind}#{n.id} run {previous}")
        for c in n.children:
            self.cancelTasks(c)

    # A run is current only while the node it belongs to is still the same mounted identity AND no
    # later start/cancellation superseded it. Nothing waits for a task: a stale one just stops
    # being able to touch state.
    req bool isCurrent(TaskRun run):
        if let info = meta[run.node]:
            return info.generation == run.nodeGeneration and info.taskGen == run.generation
        false

    # Delivers a task's late result: `action` runs as one event transaction (one update pass) if
    # the run is still current, and is dropped — and reported — if it is stale. The runtime cannot
    # intercept a write made outside this call; `deliver` is the contract for continuations.
    def bool deliver(TaskRun run, Builder b, UIAction action):
        if !self.isCurrent(run):
            self.report("stale", "stale task delivery to {run.node} (run {run.generation})", run.node)
            return false
        self.beginEvent()
        let before = sink.reports
        try:
            action()
        catch:
            _ = self.failTask(run, "{error}")
        self.settle(before)
        self.endEvent(b)
        true

    req [int] dirtyIds():
        mut [int] ids = []
        for id in dirty:
            ids.push(id)
        ids.sort()
        ids

    # ── debugging ─────────────────────────────────────────────────────────────

    req string show():
        if let r = root:
            return self.showNode(r)
        "(empty)"

    req string showNode(Mounted m):
        var out = "{m.kind}#{m.id}"
        if m.key != "":
            out = "{out}@{m.key}"
        if m.children.length > 0:
            mut [string] parts = []
            for c in m.children:
                parts.push(self.showNode(c))
            out = "{out}[{parts.join(", ")}]"
        out
