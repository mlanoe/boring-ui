# boring-ui headless layout (docs/design-notes/boring-ui-draft.md, "Layout and modifier
# composition"): size negotiation and placement over the mounted tree produced by `core.br`.
# Layer 3, first slice. No text shaping, rendering or platform input — text is measured with a
# deterministic fixture font (every character `charWidth` wide, every line `lineHeight` tall) so
# results are exact and golden-testable.
#
# Contract (draft, "Size negotiation and default sizing"): the parent proposes a size, the child
# reports the size it chose, the parent places it. Each proposal axis is independently
# unspecified (`nil`); a proposal is not a constraint, a child may report more. Stacks use the
# draft's deterministic allocation: reserve every child's minimum, then water-fill by priority
# toward each ideal, then toward each maximum.
#
# Implemented: `Text`, `Padding`, `Frame` (fixed/min/max), `Spacer`, `Priority`, `Row`, `Column`
# (spacing, cross-axis alignment); composite views and `KeyedGroup` are transparent.
# Also: `Layer` (overlay stack), `Fill` (accept the proposed size on chosen axes, align the child),
# `Scroll` (a finite viewport; the offset lives on the mounted node and is clamped here), `Offset`
# (a paint/hit-test translation that never changes sizes) and `Text` line limits with tail ellipsis.
# Not yet: baseline alignment, idealWidth, adaptive spacing pairs (one default gap), right-to-left,
# device-pixel rounding, head/middle truncation.

use ui.core.*
use ui.theme.*
use boring.ui.*

# Fixture "theme" and "font". The theme's adaptive spacing is one value for now.
pub let float charWidth = 8.0
pub let float lineHeight = 16.0
pub let float defaultSpacing = 8.0
pub let float spacerMin = 8.0
pub let float controlPadding = 8.0
pub let float toggleBox = 20.0
pub let float textFieldWidth = 160.0
pub let float textFieldHeight = 24.0
# The private unbounded-maximum sentinel of the layout protocol (never a public value).
pub let float unbounded = 1000000000.0

pub struct Size:
    pub float w
    pub float h

# A proposal: each axis independently specified or `nil` (unspecified — "your ideal size").
pub struct Prop:
    pub float? w = nil
    pub float? h = nil

# A child's interval on one axis under the current cross-axis proposal.
pub struct Span:
    pub float min
    pub float ideal
    pub float max

# A placed node, in window coordinates. Transparent nodes (composite views) share their body's frame;
# `KeyedGroup` nodes do not appear — their items are the stack's children directly.
# An interpolated override of one of a node's props (an `Opacity`'s value, a `Background`'s color) while an
# animation is running; painting reads it before the prop.
pub struct PropValue:
    pub string key
    pub string value

pub struct Placed:
    pub int id
    pub string kind
    pub var float x
    pub var float y
    pub float w
    pub float h
    pub var mut {string=string} props = {=}
    pub var mut [Placed] children = []
    # The theme this node resolved against (the nearest provider above it), for painting.
    pub var Theme theme = Theme()
    # A `List` row: the identity key of the keyed `for` iteration this node came from ("" elsewhere).
    pub var string key = ""
    # Presentation state (see animator.br): the group-opacity multiplier of a transition in flight, whether
    # this subtree is a retiring ghost kept only for display (no hit testing, no semantics), and the
    # interpolated prop overrides. A committed layout always has the defaults.
    pub var float alpha = 1.0
    pub var bool ghost = false
    pub var [PropValue] live = []

# A placed subtree kept across frames, with the origin it was placed at (translation moves it).
pub struct PlacedEntry:
    pub Placed placed
    pub float x
    pub float y

# What one layout pass has already worked out, by node id and proposal: a stack asks its children for their spans, then for
# their sizes, and placing asks again, so without this a node is negotiated once per question per level (the cost grows with
# the depth of the tree). A pass never outlives its tree: a fresh `Memo` per `layout`, `measure` or `place` call.
struct Memo:
    var mut {string=Size} sizes = {=}
    var mut {string=Span} spans = {=}
    var mut {string=Neg} negs = {=}
    # Windowed lists (see "Windowed lists"): only `layout` over a runtime turns this on, `measure` and `place` stay exact.
    var bool windowed = false
    var mut LayoutMemory'actor memory = LayoutMemory()
    # A windowed list's rows and their keys, flattened once per pass (flattening clones every row's subtree), and the heights
    # `rowHeights` worked out for it by list id and width.
    var mut {int=Slots} listSlots = {=}
    var mut {string=[float]} listHeights = {=}

def string axisKey(float? v):
    if let x = v:
        return "{x}"
    "-"

struct Neg:
    var mut [Mounted] items = []
    var mut [float] mains = []
    var mut [Size] sizes = []
    var float gap = 0.0
    var float total = 0.0
    var float cross = 0.0

pub def float maxOf(float a, float b):
    if a > b:
        return a
    b

pub def float minOf(float a, float b):
    if a < b:
        return a
    b

def float clampTo(float v, float lo, float hi):
    maxOf(lo, minOf(v, hi))

def float nonNeg(float v):
    maxOf(v, 0.0)

# ── props ─────────────────────────────────────────────────────────────────────────────────────

def float? numProp(Mounted n, string key):
    if let s = n.props[key]:
        return s.parseFloat()
    nil

def bool hasChild(Mounted n):
    n.children.length > 0

# Composite views (they carry their `View`), `Priority`, `Background` and `Clip` forward all layout to
# their one child (the last two only add painting/hit-test behaviour, see scene.br).
def bool isTransparent(Mounted n):
    n.view != nil or transparentKinds().contains(n.kind)

# Wrappers that forward all layout to their one child (they only add behaviour elsewhere).
def [string] transparentKinds():
    ["Priority", "Background", "Clip", "AccessibilityLabel", "AccessibilityHint", "AccessibilityHeading", "AccessibilityHidden", "AccessibilityGroup", "OnMount", "OnUnmount", "OnTask", "Provide", "Border", "Opacity", "Shadow", "Offset", "Disabled", "DefaultAction", "AnimationScope", "Transition", "DefaultFocus", "Focused", "FocusedAs", "FocusScope", "FocusOrder", "Focusable", "FocusSection", "MatchedGeometry", "ScrollAnchor", "OnHover"]

# A stack's children with every `KeyedGroup` replaced by its items, in order.
def [Mounted] flatten(Mounted n):
    mut [Mounted] out = []
    for c in n.children:
        if c.kind == "KeyedGroup":
            for g in flatten(c):
                out.push(g)
        else:
            out.push(c)
    out

def float priorityOf(Mounted n):
    if n.kind == "Priority":
        return numProp(n, "value") else (0.0)
    0.0

def float alignFraction(Mounted n):
    if let a = n.props["alignment"]:
        if a == "Leading":
            return 0.0
        if a == "Trailing":
            return 1.0
    0.5

# Two-axis alignment (`Layer`, `Fill`): the fraction of the free room before the child, per axis.
def float xFraction(string a):
    if a == "TopLeading" or a == "MiddleLeading" or a == "BottomLeading":
        return 0.0
    if a == "TopTrailing" or a == "MiddleTrailing" or a == "BottomTrailing":
        return 1.0
    0.5

def float yFraction(string a):
    if a == "TopLeading" or a == "Top" or a == "TopTrailing":
        return 0.0
    if a == "BottomLeading" or a == "Bottom" or a == "BottomTrailing":
        return 1.0
    0.5

def string alignmentOf(Mounted n):
    n.props["alignment"] else ("Middle")

def bool flag(Mounted n, string key):
    (n.props[key] else ("true")) == "true"

def bool isVerticalScroll(Mounted n):
    (n.props["axis"] else ("Vertical")) == "Vertical"

def float gapOf(Mounted n):
    if (n.kind == "List" or n.kind == "MultiList"):
        return 0.0
    numProp(n, "spacing") else (n.theme.metric(MetricRole.StackSpacing))

# A stack with `equal = true` gives every child the same ideal size along its axis: the largest of the children's ideals.
def bool isEqual(Mounted n):
    (n.props["equal"] else ("false")) == "true"

def [float] equalised(Mounted n, [float] ideals):
    if !isEqual(n):
        return ideals
    var top = 0.0
    for x in ideals:
        top = maxOf(top, x)
    mut out = [] as [float]
    for x in ideals:
        out.push(top)
    out

# The key of the keyed iteration each item of `flatten(n)` came from, in the same order ("" for plain items).
def [string] flattenKeys(Mounted n):
    mut [string] out = []
    for c in n.children:
        if c.kind == "KeyedGroup":
            for i in flatten(c):
                out.push(c.key)
        else:
            out.push("")
    out

# ── text (fixture font) ───────────────────────────────────────────────────────────────────────

# The fixture font: a cell is `size / 2` wide and `size` tall, so `Body` (16) is the 8 x 16 cell of
# `charWidth` x `lineHeight`.
def float textWidthAt(TextMeasurer m, string s, float cell, int style):
    m.widthStyled(s, cell * 2.0, style)

# The logical caret index of `s` whose caret stop is nearest to the x offset `x` (a tie goes to the later one): a click on the
# left half of a left-to-right cluster puts the caret before it, on the right half after it; right-to-left and mixed text
# follow the visual order (the measurer knows it).
pub def int graphemeAtX(TextMeasurer m, string s, float x, float size):
    var best = 0
    var bestDistance = 1000000000.0
    for k in 0..=s.graphemeCount:
        var d = m.caretX(s, k, size, 0) - x
        if d < 0.0:
            d = 0.0 - d
        if d <= bestDistance:
            best = k
            bestDistance = d
    best

# `graphemeAtX` for the fixture font, in cells.
pub def int graphemeAtCells(string s, float cells):
    var x = 0.0
    var i = 0
    for g in s.graphemes():
        let w = g.displayWidth as float
        if cells < x + w / 2.0:
            return i
        x += w
        i += 1
    i

# A text field's horizontal scroll: how far its text is shifted left so the caret (at `caretOffset` pixels from the start
# of the text) stays inside a field `fieldWidth` wide (a 4 px inset each side, one more pixel for the caret bar). Derived
# from the caret alone, so painting and click-to-caret agree without stored state: the text sits unshifted until the
# caret would pass the right edge, then the caret rests at that edge.
pub def float fieldScroll(float caretOffset, float fieldWidth):
    maxOf(0.0, caretOffset + 1.0 - (fieldWidth - 8.0))

# Where a text field's text starts, in pixels from the left of the field's inner box (the field minus its 4 px inset each side):
# 0 for left-to-right text, the right edge for a right-to-left paragraph, then shifted as far as it takes to keep the caret
# (`caretIndex` of `text`) inside. Painting, click-to-caret and the input method's candidate window all use it.
pub def float fieldOrigin(TextMeasurer m, string text, int caretIndex, float fieldWidth, float size):
    let inner = fieldWidth - 8.0
    let w = m.width(text, size)
    let x = m.caretX(text, caretIndex, size, 0)
    var origin = 0.0
    # a caret bar one pixel wide needs one pixel to its right: a left-to-right text's end stops short of the edge by one
    # (a right-to-left one already sits flush against the right edge, its caret at the edge itself)
    var limit = inner - 1.0
    if m.isRtl(text):
        origin = inner - w
        limit = inner
    if origin + x > limit:
        origin = limit - x
    if origin + x < 0.0:
        origin = 0.0 - x
    origin

def float textWidth(string s):
    textWidthAt(FixtureMeasurer(), s, charWidth, 0)

# The text size of a node's `font` role under its theme.
def float fontSizeOf(Mounted n):
    n.theme.fontSizeNamed(n.props["font"] else ("Body"))

# The style of a text node: 1 bold, 2 italic (3 both). A font role can be bold by theme (headings); the node's own
# `bold` / `italic` props add to it.
def int styleOf(Mounted n):
    var style = 0
    if (n.props["bold"] else ("false")) == "true" or n.theme.fontBoldNamed(n.props["font"] else ("Body")):
        style += 1
    if (n.props["italic"] else ("false")) == "true":
        style += 2
    style

def float cellOf(Mounted n):
    fontSizeOf(n) / 2.0

def [string] words(string s):
    mut [string] out = []
    for w in s.split(" "):
        if w.length > 0:
            out.push(w)
    out

# ── line breaking ─────────────────────────────────────────────────────────────────────────────────
# Where a line may break comes from the measurer (`TextMeasurer.breakPoints`): the text engine answers with the Unicode
# line-break rules (UAX #14), the fixture font with a small rule set (theme.br `ruleBreakPoints`). "\n" always breaks. A word
# wider than the line overflows (it is never split inside: `lineLimit` truncates it with an ellipsis) — the usual
# `overflow-wrap: normal`.

# The pieces of a paragraph between break opportunities, spaces kept at the end of the piece they follow.
def [string] segmentsOf(TextMeasurer m, string para):
    mut [string] out = []
    let count = para.graphemeCount
    var start = 0
    for p in m.breakPoints(para):
        if p > start and p < count:
            out.push(para.graphemeSlice(start, p))
            start = p
    if start < count:
        out.push(para.graphemeSlice(start, count))
    out

# `s` without its trailing spaces.
def string trimEnd(string s):
    var n = s.graphemeCount
    while n > 0 and isSpaceGrapheme(s.graphemeSlice(n - 1, n)):
        n -= 1
    s.graphemeSlice(0, n)

# Runs of spaces collapse to one, and the ends are trimmed (white-space: normal).
def string collapseSpaces(string s):
    var out = ""
    var lastSpace = true
    for i in 0..<s.graphemeCount:
        let g = s.graphemeSlice(i, i + 1)
        if isSpaceGrapheme(g):
            if !lastSpace:
                out = "{out} "
            lastSpace = true
        else:
            out = "{out}{g}"
            lastSpace = false
    trimEnd(out)

# Greedy wrap of one paragraph under `limit`.
def [string] wrapParagraph(TextMeasurer m, string paragraph, float limit, float cell, int style):
    mut [string] lines = []
    var current = ""
    for seg in segmentsOf(m, collapseSpaces(paragraph)):
        if current == "":
            current = seg
        elif textWidthAt(m, trimEnd("{current}{seg}"), cell, style) <= limit:
            current = "{current}{seg}"
        else:
            lines.push(trimEnd(current))
            current = seg
    lines.push(trimEnd(current))
    lines

# Word wrap under `limit` (nil = no wrapping: one line per paragraph).
def [string] wrapAt(TextMeasurer m, string content, float? limit, float cell, int style):
    mut [string] lines = []
    for paragraph in content.split("\n"):
        if limit == nil:
            lines.push(collapseSpaces(paragraph))
        else:
            for l in wrapParagraph(m, paragraph, limit else (0.0), cell, style):
                lines.push(l)
    lines

# The visible lines of a text under a width limit and an optional line limit: it wraps first, then
# the last visible line is truncated with the measurer's ellipsis ("..." in the fixture font).
pub def [string] shownLinesAt(TextMeasurer m, string content, float? limit, int? maxLines, float cell, int style):
    let lines = wrapAt(m, content, limit, cell, style)
    if let cap = maxLines:
        if cap >= 1 and lines.length > cap:
            mut [string] visible = []
            for i in 0..<cap:
                visible.push(lines[i])
            var last = visible[cap - 1]
            if let room = limit:
                # The fixture ellipsis is the ASCII "..." (3 cells): a real font engine substitutes the
                # ellipsis glyph. Truncation drops whole grapheme clusters, measured by display width.
                let dots = m.ellipsis()
                while last.graphemeCount > 0 and textWidthAt(m, last, cell, style) + textWidthAt(m, dots, cell, style) > room:
                    last = last.graphemeSlice(0, last.graphemeCount - 1)
            visible[cap - 1] = "{last}{m.ellipsis()}"
            return visible
    lines

# The Body-font form (the 8 x 16 cell), kept for callers without a node.
pub def [string] shownLines(string content, float? limit, int? maxLines):
    shownLinesAt(FixtureMeasurer(), content, limit, maxLines, charWidth, 0)

def int? lineLimitOf(Mounted n):
    if let s = n.props["lineLimit"]:
        return s.parseInt()
    nil

def Size measureText(Mounted n, Prop p):
    let content = n.props["content"] else ("")
    let cell = cellOf(n)
    let style = styleOf(n)
    let lines = shownLinesAt(n.theme.measurer, content, p.w, lineLimitOf(n), cell, style)
    var widest = 0.0
    for l in lines:
        widest = maxOf(widest, textWidthAt(n.theme.measurer, l, cell, style))
    let count = lines.length
    Size(w = widest, h = (count as float) * fontSizeOf(n))

# A button's built-in style under a theme: its own `style` prop, or what the theme maps its role to.
pub def string buttonStyleOf(Theme t, {string=string} props):
    var style = props["style"] else ("Inherit")
    if style == "Inherit":
        style = t.buttonStyleNamed(props["role"] else ("Normal"))
    style

# A button's padding: the theme's control padding, adjusted by its style (Compact tightens it).
pub def float buttonPaddingOf(Theme t, {string=string} props):
    maxOf(0.0, t.metric(MetricRole.ControlPadding) + buttonSpec(buttonStyleOf(t, props)).padding)

def float buttonPadding(Mounted n):
    buttonPaddingOf(n.theme, n.props)

# Intrinsic size of the built-in controls (themed): a button is its label plus padding, a toggle is
# a square box, a gap and its label, a text field a fixed-width single line. `MinimumHitSize`
# (0 by default) is a floor on both axes of a button or toggle.
def Size controlSize(Mounted n):
    let t = n.theme
    let label = n.props["label"] else ("")
    let body = t.fontSizeNamed("Body")
    let floorSize = t.metric(MetricRole.MinimumHitSize)
    if n.kind == "Button":
        let pad = buttonPadding(n)
        return Size(w = maxOf(textWidthAt(t.measurer, label, body / 2.0, 0) + 2.0 * pad, floorSize), h = maxOf(body + 2.0 * pad, floorSize))
    if n.kind == "TextField":
        return Size(w = t.metric(MetricRole.TextFieldWidth), h = t.metric(MetricRole.TextFieldHeight))
    if n.kind == "Slider":
        return Size(w = t.metric(MetricRole.TextFieldWidth), h = maxOf(t.metric(MetricRole.ToggleSize), floorSize))
    let box = t.metric(MetricRole.ToggleSize)
    Size(w = maxOf(box + t.metric(MetricRole.ControlPadding) + textWidthAt(t.measurer, label, body / 2.0, 0), floorSize), h = maxOf(maxOf(box, body), floorSize))

def bool isControl(Mounted n):
    n.kind == "Button" or n.kind == "Toggle" or n.kind == "TextField" or n.kind == "Slider"

def float longestWordAt(TextMeasurer m, string content, float cell, int style):
    var widest = 0.0
    for w in words(content):
        widest = maxOf(widest, textWidthAt(m, w, cell, style))
    widest

# ── spans (min / ideal / max on one axis) ─────────────────────────────────────────────────────

def Span fixedSpan(float v):
    Span(min = v, ideal = v, max = v)

def Span span(Mounted n, bool horiz, float? cross, mut Memo memo):
    let key = "{n.id}|{horiz}|{axisKey(cross)}"
    if let hit = memo.spans[key]:
        return hit
    let found = spanUncached(n, horiz, cross, memo)
    memo.spans[key] = found
    found

def Span spanUncached(Mounted n, bool horiz, float? cross, mut Memo memo):
    if isTransparent(n):
        if !hasChild(n):
            return fixedSpan(0.0)
        return span(n.children[0], horiz, cross, memo)
    let k = n.kind
    if k == "Popover":
        # The anchor's span: the panel (second child) floats and takes no room.
        if !hasChild(n):
            return fixedSpan(0.0)
        return span(n.children[0], horiz, cross, memo)
    if k == "Text":
        let content = n.props["content"] else ("")
        if horiz:
            let cell = cellOf(n)
            let m = n.theme.measurer
            let style = styleOf(n)
            let oneLine = textWidthAt(m, wrapAt(m, content, nil, cell, style)[0], cell, style)
            return Span(min = longestWordAt(m, content, cell, style), ideal = oneLine, max = oneLine)
        let h = measureText(n, Prop(w = cross, h = nil)).h
        return fixedSpan(h)
    if isControl(n):
        let cs = controlSize(n)
        if horiz:
            return fixedSpan(cs.w)
        return fixedSpan(cs.h)
    if k == "Spacer":
        let m = numProp(n, "minLength") else (n.theme.metric(MetricRole.SpacerMinimum))
        return Span(min = m, ideal = m, max = unbounded)
    if k == "Padding":
        let i = numProp(n, "insets") else (0.0)
        let s = span(n.children[0], horiz, shrink(cross, 2.0 * i), memo)
        return Span(min = s.min + 2.0 * i, ideal = s.ideal + 2.0 * i, max = minOf(s.max + 2.0 * i, unbounded))
    if k == "Frame":
        return frameSpan(n, horiz, cross, memo)
    if k == "Row" or k == "Column":
        return stackSpan(n, k == "Row", horiz, cross, memo)
    if k == "Image":
        let imageW = numProp(n, "width") else (0.0)
        let imageH = numProp(n, "height") else (0.0)
        if !horiz:
            return fixedSpan(imageH)
        return fixedSpan(imageW)
    if k == "Layer":
        var lo = 0.0
        var id = 0.0
        var hi = 0.0
        for c in flatten(n):
            let s = span(c, horiz, cross, memo)
            lo = maxOf(lo, s.min)
            id = maxOf(id, s.ideal)
            hi = maxOf(hi, s.max)
        return Span(min = lo, ideal = id, max = hi)
    if k == "Fill":
        let s = span(n.children[0], horiz, cross, memo)
        var grows = flag(n, "width")
        if !horiz:
            grows = flag(n, "height")
        if grows:
            return Span(min = s.min, ideal = s.ideal, max = unbounded)
        return s
    if (k == "List" or k == "MultiList"):
        if windows(n, memo):
            if horiz:
                # the widest row is not known without measuring them all: the first row stands for them
                let first = span(rowAt(n, slotsOf(n, memo), 0), true, nil, memo)
                return Span(min = first.min, ideal = first.ideal, max = unbounded)
            if let w = cross:
                return Span(min = 0.0, ideal = sumOf(rowHeights(n, w, memo)), max = unbounded)
        # A scroll viewport over a vertical stack of its rows.
        let s = stackSpan(n, false, horiz, cross, memo)
        if !horiz:
            return Span(min = 0.0, ideal = s.ideal, max = unbounded)
        return Span(min = s.min, ideal = s.ideal, max = unbounded)
    if k == "Scroll":
        # The viewport takes whatever it is offered; its content decides the ideal on the scrolling axis.
        let scrollsThisAxis = isVerticalScroll(n) != horiz
        var contentCross = cross
        if scrollsThisAxis:
            contentCross = cross
        let s = span(n.children[0], horiz, contentCross, memo)
        if scrollsThisAxis:
            return Span(min = 0.0, ideal = s.ideal, max = unbounded)
        return Span(min = s.min, ideal = s.ideal, max = unbounded)
    fixedSpan(0.0)

def Span frameSpan(Mounted n, bool horiz, float? cross, mut Memo memo):
    var fixed = "width"
    var lo = "minWidth"
    var hi = "maxWidth"
    if !horiz:
        fixed = "height"
        lo = "minHeight"
        hi = "maxHeight"
    if let f = numProp(n, fixed):
        return fixedSpan(f)
    let s = span(n.children[0], horiz, cross, memo)
    let low = numProp(n, lo) else (0.0)
    let high = numProp(n, hi) else (unbounded)
    Span(min = clampTo(s.min, low, high), ideal = clampTo(s.ideal, low, high), max = clampTo(s.max, low, high))

# A child's interval on one axis as seen by a stack: a `Separator` is a thin line ON THE STACK'S MAIN AXIS and
# contributes nothing across it (it is stretched over the stack's cross extent when placed).
def Span spanIn(Mounted c, bool parentIsRow, bool horiz, float? cross, mut Memo memo):
    if c.kind == "Separator":
        if parentIsRow == horiz:
            return fixedSpan(c.theme.metric(MetricRole.SeparatorThickness))
        return fixedSpan(0.0)
    span(c, horiz, cross, memo)

def Span stackSpan(Mounted n, bool isRow, bool horiz, float? cross, mut Memo memo):
    if isRow == horiz:
        # Along the stack's own main axis: children's intervals add up, gaps included.
        let items = flatten(n)
        let g = gapOf(n)
        var lo = 0.0
        var id = 0.0
        var hi = 0.0
        mut [float] idealsHere = []
        for c in items:
            let s = spanIn(c, isRow, horiz, cross, memo)
            lo += s.min
            idealsHere.push(s.ideal)
            hi += s.max
        for x in equalised(n, idealsHere):
            id += x
        let gaps = g * nonNeg((items.length - 1) as float)
        return Span(min = lo + gaps, ideal = id + gaps, max = minOf(hi + gaps, unbounded))
    # Across: negotiate the main axis under the given proposal, then report the resulting extent.
    let neg = negotiate(n, isRow, cross, nil, memo)
    fixedSpan(neg.cross)

# ── stack negotiation ─────────────────────────────────────────────────────────────────────────

def Prop proposal(bool horiz, float? main, float? cross):
    if horiz:
        return Prop(w = main, h = cross)
    Prop(w = cross, h = main)

# Water-filling inside one priority group toward `target`: the child with the smallest remaining
# range reaches its bound first, the rest share what is left equally. Returns the space left over.
def float fill(mut [float] cur, [float] target, [int] group, float remaining):
    var left = remaining
    mut [int] order = []
    for i in group:
        order.push(i)
    # insertion sort by remaining range, ties by index (deterministic)
    var a = 1
    while a < order.length:
        var b = a
        while b > 0 and rangeOf(target, cur, order[b - 1]) > rangeOf(target, cur, order[b]):
            let tmp = order[b - 1]
            order[b - 1] = order[b]
            order[b] = tmp
            b -= 1
        a += 1
    var k = 0
    while k < order.length:
        let i = order[k]
        let share = left / ((order.length - k) as float)
        let take = minOf(target[i] - cur[i], share)
        cur[i] = cur[i] + nonNeg(take)
        left -= nonNeg(take)
        k += 1
    left

def float rangeOf([float] target, [float] cur, int i):
    target[i] - cur[i]

# Floats are not `Ord` in Rust, so sort by hand (insertion sort, descending).
def [float] sortDescending([float] xs):
    mut [float] out = []
    for x in xs:
        out.push(x)
    var a = 1
    while a < out.length:
        var b = a
        while b > 0 and out[b - 1] < out[b]:
            let tmp = out[b - 1]
            out[b - 1] = out[b]
            out[b] = tmp
            b -= 1
        a += 1
    out

def [float] distinctPrioritiesDesc([Mounted] items):
    mut [float] ps = []
    for c in items:
        let p = priorityOf(c)
        if !ps.contains(p):
            ps.push(p)
    sortDescending(ps)

# (`items` of the result is left empty: the children are `flatten(n)`, which callers that place them ask for themselves.)
def Neg negotiate(Mounted n, bool isRow, float? mainProp, float? crossProp, mut Memo memo):
    let key = "{n.id}|{isRow}|{axisKey(mainProp)}|{axisKey(crossProp)}"
    if let hit = memo.negs[key]:
        return hit
    let found = negotiateUncached(n, isRow, mainProp, crossProp, memo)
    memo.negs[key] = found
    found

def Neg negotiateUncached(Mounted n, bool isRow, float? mainProp, float? crossProp, mut Memo memo):
    mut neg = Neg()
    let items = flatten(n)
    neg.gap = gapOf(n)
    let count = items.length
    let gaps = neg.gap * nonNeg((count - 1) as float)
    mut [float] mins = []
    mut [float] ideals = []
    mut [float] maxs = []
    for c in items:
        let s = spanIn(c, isRow, isRow, crossProp, memo)
        mins.push(s.min)
        ideals.push(s.ideal)
        maxs.push(s.max)
    ideals = equalised(n, ideals)
    mut [float] cur = []
    for m in mins:
        cur.push(m)
    if let avail = mainProp:
        var remaining = nonNeg(avail - gaps - sumOf(mins))
        let prios = distinctPrioritiesDesc(items)
        # toward each ideal, then toward each maximum, highest priority group first
        for round in 0..<2:
            var target = ideals.clone()
            if round == 1:
                target = maxs.clone()
            for pr in prios:
                mut [int] group = []
                for i in 0..<count:
                    if priorityOf(items[i]) == pr:
                        group.push(i)
                remaining = fill(cur, target, group, remaining)
    else:
        cur = ideals.clone()
    # measure each child under its assigned main size and the cross proposal
    var main = 0.0
    var crossMax = 0.0
    for i in 0..<count:
        let c = items[i]
        var sz = sizeOf(c, proposal(isRow, cur[i], crossProp), memo)
        if c.kind == "Spacer":
            sz = Size(w = cur[i], h = 0.0)
            if !isRow:
                sz = Size(w = 0.0, h = cur[i])
        if c.kind == "Separator":
            let thick = c.theme.metric(MetricRole.SeparatorThickness)
            sz = Size(w = thick, h = 0.0)
            if !isRow:
                sz = Size(w = 0.0, h = thick)
        neg.sizes.push(sz)
        var m = sz.h
        var x = sz.w
        if isRow:
            m = sz.w
            x = sz.h
        neg.mains.push(m)
        main += m
        crossMax = maxOf(crossMax, x)
    neg.total = main + gaps
    neg.cross = crossMax
    neg

def float sumOf([float] xs):
    var t = 0.0
    for x in xs:
        t += x
    t

# Where the rows of a windowed list sit in its mounted children, without copying them: row `i` is child `outer[i]`, or
# (inside a `KeyedGroup`) child `inner[i]` of that child. `nested` is a `KeyedGroup` inside a `KeyedGroup`, which a list
# never lays out by window.
struct Slots:
    var mut [int] outer = []
    var mut [int] inner = []
    var mut [int] ids = []
    var mut [string] kinds = []
    var mut [string] keys = []
    var bool nested = false

# ── windowed lists ────────────────────────────────────────────────────────────────────────────
# A `List` of more than `windowedRows` rows measures and places only the rows near its viewport (± `windowMargin`): the other
# rows keep their identity, key and a position and size but no content (`Placed.props["virtual"] = "true"`, no children), so
# keyboard navigation, selection and hit testing of the rows in view are unchanged and a frame no longer costs one
# negotiation per row. The height of a row that is not measured is the one it last measured (kept by the runtime, per list and
# row key, valid for one width) or, for a row never seen, the mean of the list's known rows; a row that comes into the window is
# measured at once and corrects the offsets below it, so the scroll extent is exact for the rows seen and an estimate for the
# rest. Only `layout` (a runtime in hand) windows; `measure` and `place` stay exact.

pub let int windowedRows = 64
# How far beyond the viewport a row is still measured and placed in full.
pub let float windowMargin = 96.0

def string rowCacheKey(int list, string key, int i):
    if key == "":
        return "{list}|#{i}"
    "{list}|{key}"

def Slots slotsOf(Mounted n, mut Memo memo):
    if let hit = memo.listSlots[n.id]:
        return hit
    mut found = Slots()
    var ci = 0
    for c in n.children:
        if c.kind == "KeyedGroup":
            var si = 0
            for g in c.children:
                if g.kind == "KeyedGroup":
                    found.nested = true
                found.outer.push(ci)
                found.inner.push(si)
                found.ids.push(g.id)
                found.kinds.push(g.kind)
                found.keys.push(c.key)
                si += 1
        else:
            found.outer.push(ci)
            found.inner.push(-1)
            found.ids.push(c.id)
            found.kinds.push(c.kind)
            found.keys.push("")
        ci += 1
    memo.listSlots[n.id] = found
    found

# Row `i` of a windowed list (a copy of that one row's subtree).
def Mounted rowAt(Mounted n, Slots slots, int i):
    if slots.inner[i] < 0:
        return n.children[slots.outer[i]]
    n.children[slots.outer[i]].children[slots.inner[i]]

# Whether this list is laid out by window (a long list under a runtime-backed pass).
def bool windows(Mounted n, mut Memo memo):
    if !memo.windowed or !(n.kind == "List" or n.kind == "MultiList"):
        return false
    let slots = slotsOf(n, memo)
    slots.keys.length > windowedRows and !slots.nested

# ── layout cache ──────────────────────────────────────────────────────────────────────────────
# A frame that changed little re-lays-out only what changed. `Mounted.rev` names one version of a subtree (id, generation, rev:
# the runtime bumps `rev` on a node and its ancestors when props, theme, scroll or children change) and the runtime's
# `LayoutMemory.epoch` names the state of the remembered row heights, so (id, generation, rev, epoch, size) fixes a placed
# subtree. Only runtime-backed passes (`layout`) use it, and only at the window root and at the rows of a windowed list: a
# cache entry per node would hold every subtree once per ancestor. Placement does not depend on the absolute position, so a
# hit moves by translation; an entry is stored only when the epoch did not change while it was computed (what it holds then
# came from a memory that no longer exists).

def string versionKey(Mounted n, mut Memo memo):
    "{n.id}.{n.generation}.{n.rev}.{memo.memory.epoch}"

def Placed placeCached(Mounted n, float x, float y, Size size, mut Memo memo):
    if !memo.windowed:
        return placeIn(n, x, y, size, memo)
    let key = "{versionKey(n, memo)}|{size.w}|{size.h}"
    let epoch = memo.memory.epoch
    if let hit = memo.memory.placed[key]:
        memo.memory.placedHits += 1
        if hit.x == x and hit.y == y:
            return hit.placed.clone()
        return translated(hit.placed, x - hit.x, y - hit.y)
    let found = placeIn(n, x, y, size, memo)
    if memo.memory.epoch == epoch:
        memo.memory.placed[key] = PlacedEntry(placed = found.clone(), x = x, y = y)
    found

# The size of the window root under the window proposal, from the cache when the tree and the row memory are as they were.
def Size rootSize(Mounted r, float width, float height, mut Memo memo):
    let key = "{versionKey(r, memo)}|root|{width}|{height}"
    let epoch = memo.memory.epoch
    if let hit = memo.memory.sizes[key]:
        memo.memory.sizeHits += 1
        return hit
    let found = sizeOf(r, Prop(w = width, h = height), memo)
    if memo.memory.epoch == epoch:
        memo.memory.sizes[key] = found
    found

# One row as a vertical list gives it room: the height it ideally takes under the list's width.
def Size rowSize(Mounted c, float w, mut Memo memo):
    if !memo.windowed:
        return rowSizeUncached(c, w, memo)
    let key = "{versionKey(c, memo)}|{w}"
    let epoch = memo.memory.epoch
    if let hit = memo.memory.sizes[key]:
        memo.memory.sizeHits += 1
        return hit
    let found = rowSizeUncached(c, w, memo)
    if memo.memory.epoch == epoch:
        memo.memory.sizes[key] = found
    found

def Size rowSizeUncached(Mounted c, float w, mut Memo memo):
    if c.kind == "Separator":
        return Size(w = 0.0, h = c.theme.metric(MetricRole.SeparatorThickness))
    let s = span(c, false, w, memo)
    if c.kind == "Spacer":
        return Size(w = 0.0, h = s.ideal)
    sizeOf(c, Prop(w = w, h = s.ideal), memo)

# The height of every row of a windowed list under width `w`: the last measured one, else the list's mean (the first row is
# measured when nothing is known yet).
def [float] rowHeights(Mounted n, float w, mut Memo memo):
    let cacheKey = "{n.id}|{w}"
    if let hit = memo.listHeights[cacheKey]:
        return hit
    let found = rowHeightsUncached(n, slotsOf(n, memo), w, memo)
    memo.listHeights[cacheKey] = found
    found

def [float] rowHeightsUncached(Mounted n, Slots slots, float w, mut Memo memo):
    let keys = slots.keys
    let count = keys.length
    if memo.memory.widthOf(n.id) != w:
        for i in 0..<count:
            memo.memory.forgetRow(rowCacheKey(n.id, keys[i], i))
        memo.memory.setWidth(n.id, w)
    mut hs = [] as [float]
    mut missing = [] as [int]
    var sum = 0.0
    var seen = 0
    for i in 0..<count:
        if let h = memo.memory.row(rowCacheKey(n.id, keys[i], i)):
            hs.push(h)
            sum += h
            seen += 1
        else:
            hs.push(0.0)
            missing.push(i)
    var estimate = 0.0
    if seen > 0:
        estimate = sum / (seen as float)
    elif count > 0:
        estimate = rowSize(rowAt(n, slots, 0), w, memo).h
    for i in missing:
        hs[i] = estimate
    hs

def void placeWindowed(Mounted n, mut Placed node, float x, float y, Size size, mut Memo memo):
    let slots = slotsOf(n, memo)
    let keys = slots.keys
    let count = keys.length
    let w = size.w
    mut hs = rowHeights(n, w, memo).clone()
    mut fresh = [] as [bool]
    mut sizes = [] as [Size]
    for i in 0..<count:
        fresh.push(false)
        sizes.push(Size(w = w, h = hs[i]))
    var total = 0.0
    var offset = 0.0
    var settled = false
    var rounds = 0
    while !settled and rounds < 8:
        rounds += 1
        total = sumOf(hs)
        offset = clampTo(n.scroll, 0.0, nonNeg(total - size.h))
        var first = count
        var last = count
        var top = 0.0
        var i = 0
        var found = false
        var closed = false
        while i < count and !closed:
            if !found and top + hs[i] >= offset - windowMargin:
                first = i
                found = true
            if found and top > offset + size.h + windowMargin:
                last = i
                closed = true
            top += hs[i]
            i += 1
        settled = true
        if last > first:
            for j in first..<last:
                if !fresh[j]:
                    let measured = rowSize(rowAt(n, slots, j), w, memo)
                    sizes[j] = measured
                    fresh[j] = true
                    memo.memory.setRow(rowCacheKey(n.id, keys[j], j), measured.h)
                    if measured.h != hs[j]:
                        hs[j] = measured.h
                        settled = false
    let most = nonNeg(total - size.h)
    node.props["scroll"] = "{offset}"
    node.props["scrollMax"] = "{most}"
    var rowTop = 0.0
    for i in 0..<count:
        let rowY = y - offset + rowTop
        if fresh[i]:
            mut row = placeCached(rowAt(n, slots, i), x, rowY, sizes[i], memo)
            row.key = keys[i]
            node.children.push(row)
        else:
            mut stub = Placed(id = slots.ids[i], kind = slots.kinds[i], x = x, y = rowY, w = w, h = hs[i], key = keys[i])
            stub.props["virtual"] = "true"
            node.children.push(stub)
        rowTop += hs[i]

# ── measure ───────────────────────────────────────────────────────────────────────────────────

pub def Size measure(Mounted n, Prop p):
    mut memo = Memo()
    sizeOf(n, p, memo)

def Size sizeOf(Mounted n, Prop p, mut Memo memo):
    let key = "{n.id}|{axisKey(p.w)}|{axisKey(p.h)}"
    if let hit = memo.sizes[key]:
        return hit
    let size = sizeUncached(n, p, memo)
    memo.sizes[key] = size
    size

def Size sizeUncached(Mounted n, Prop p, mut Memo memo):
    if isTransparent(n):
        if !hasChild(n):
            return Size(w = 0.0, h = 0.0)
        return sizeOf(n.children[0], p, memo)
    let k = n.kind
    if k == "Popover":
        # The anchor's size: the panel (second child) is floating, it takes no room.
        if !hasChild(n):
            return Size(w = 0.0, h = 0.0)
        return sizeOf(n.children[0], p, memo)
    if k == "Text":
        return measureText(n, p)
    if isControl(n):
        return controlSize(n)
    if k == "Spacer":
        let m = numProp(n, "minLength") else (n.theme.metric(MetricRole.SpacerMinimum))
        return Size(w = maxOf(m, p.w else (m)), h = maxOf(m, p.h else (m)))
    if k == "Padding":
        let i = numProp(n, "insets") else (0.0)
        let cs = sizeOf(n.children[0], Prop(w = shrink(p.w, 2.0 * i), h = shrink(p.h, 2.0 * i)), memo)
        return Size(w = cs.w + 2.0 * i, h = cs.h + 2.0 * i)
    if k == "Frame":
        return measureFrame(n, p, memo)
    if k == "Separator":
        # Outside a stack: its own axis (horizontal unless `axis = .Vertical`).
        let thick = n.theme.metric(MetricRole.SeparatorThickness)
        let lineW = p.w else (0.0)
        let lineH = p.h else (0.0)
        if (n.props["axis"] else ("Auto")) == "VerticalRule":
            return Size(w = thick, h = lineH)
        return Size(w = lineW, h = thick)
    if k == "Image":
        let imageW = numProp(n, "width") else (0.0)
        let imageH = numProp(n, "height") else (0.0)
        return Size(w = imageW, h = imageH)
    if k == "Layer":
        var w = 0.0
        var h = 0.0
        for c in flatten(n):
            let cs = sizeOf(c, p, memo)
            w = maxOf(w, cs.w)
            h = maxOf(h, cs.h)
        return Size(w = w, h = h)
    if k == "Fill":
        let cs = sizeOf(n.children[0], p, memo)
        var w = cs.w
        var h = cs.h
        let offeredW = p.w else (cs.w)
        let offeredH = p.h else (cs.h)
        if flag(n, "width"):
            w = maxOf(cs.w, offeredW)
        if flag(n, "height"):
            h = maxOf(cs.h, offeredH)
        return Size(w = w, h = h)
    if (k == "List" or k == "MultiList"):
        if let w = p.w:
            if windows(n, memo):
                var listH = 0.0
                if let given = p.h:
                    listH = given
                else:
                    listH = sumOf(rowHeights(n, w, memo))
                return Size(w = w, h = listH)
        let neg = negotiate(n, false, nil, p.w, memo)
        let listW = p.w else (neg.cross)
        let listH = p.h else (neg.total)
        return Size(w = listW, h = listH)
    if k == "Scroll":
        # The content proposes nothing on the scrolling axis and keeps the viewport's width otherwise;
        # the viewport itself takes the proposal on both axes (or the content's size when unspecified).
        var contentProp = Prop(w = p.w, h = nil)
        if !isVerticalScroll(n):
            contentProp = Prop(w = nil, h = p.h)
        let cs = sizeOf(n.children[0], contentProp, memo)
        let viewW = p.w else (cs.w)
        let viewH = p.h else (cs.h)
        return Size(w = viewW, h = viewH)
    if k == "Row" or k == "Column":
        let isRow = k == "Row"
        var mainP = p.h
        var crossP = p.w
        if isRow:
            mainP = p.w
            crossP = p.h
        let neg = negotiate(n, isRow, mainP, crossP, memo)
        if isRow:
            return Size(w = neg.total, h = neg.cross)
        return Size(w = neg.cross, h = neg.total)
    Size(w = 0.0, h = 0.0)

def float? shrink(float? v, float by):
    if let x = v:
        return nonNeg(x - by)
    nil

# The proposal a Frame passes to its child on one axis, and the size it reports on that axis.
def float? frameProposal(float? incoming, float? fixed, float? lo, float? hi):
    if let f = fixed:
        return f
    if let x = incoming:
        return clampTo(x, lo else (0.0), hi else (unbounded))
    nil

def Size measureFrame(Mounted n, Prop p, mut Memo memo):
    let child = n.children[0]
    let fw = numProp(n, "width")
    let fh = numProp(n, "height")
    let cs = sizeOf(child, Prop(
        w = frameProposal(p.w, fw, numProp(n, "minWidth"), numProp(n, "maxWidth")),
        h = frameProposal(p.h, fh, numProp(n, "minHeight"), numProp(n, "maxHeight"))), memo)
    var w = clampTo(cs.w, numProp(n, "minWidth") else (0.0), numProp(n, "maxWidth") else (unbounded))
    var h = clampTo(cs.h, numProp(n, "minHeight") else (0.0), numProp(n, "maxHeight") else (unbounded))
    if let f = fw:
        w = f
    if let f = fh:
        h = f
    Size(w = w, h = h)

# ── place ─────────────────────────────────────────────────────────────────────────────────────

def Placed placeChild(Mounted c, float x, float y, Size within, mut Memo memo):
    let cs = sizeOf(c, Prop(w = within.w, h = within.h), memo)
    placeIn(c, x + (within.w - cs.w) / 2.0, y + (within.h - cs.h) / 2.0, cs, memo)

pub def Placed place(Mounted n, float x, float y, Size size):
    mut memo = Memo()
    placeIn(n, x, y, size, memo)

def Placed placeIn(Mounted n, float x, float y, Size size, mut Memo memo):
    mut node = Placed(id = n.id, kind = n.kind, x = x, y = y, w = size.w, h = size.h, theme = n.theme)
    node.props = n.props
    if n.kind == "Text":
        # A line-limited text shows its truncated lines (the full content stays in `content`).
        if let cap = lineLimitOf(n):
            node.props["shown"] = shownLinesAt(n.theme.measurer, n.props["content"] else (""), size.w, cap, cellOf(n), styleOf(n)).join("\n")
    if n.kind == "Offset":
        # A paint/hit-test translation: this node and its subtree move, sizes and siblings do not.
        let dx = numProp(n, "x") else (0.0)
        let dy = numProp(n, "y") else (0.0)
        node.x = x + dx
        node.y = y + dy
        if hasChild(n):
            let cs = sizeOf(n.children[0], Prop(w = size.w, h = size.h), memo)
            node.children.push(placeIn(n.children[0], x + dx, y + dy, cs, memo))
        return node
    if isTransparent(n):
        if hasChild(n):
            let cs = sizeOf(n.children[0], Prop(w = size.w, h = size.h), memo)
            node.children.push(placeIn(n.children[0], x, y, cs, memo))
        return node
    let k = n.kind
    if k == "Padding":
        let i = numProp(n, "insets") else (0.0)
        let cs = sizeOf(n.children[0], Prop(w = nonNeg(size.w - 2.0 * i), h = nonNeg(size.h - 2.0 * i)), memo)
        node.children.push(placeIn(n.children[0], x + i, y + i, cs, memo))
    elif k == "Sheet":
        # Contributes no bounds: its content is placed at its own size (centered in the window later).
        for c in n.children:
            let cs = sizeOf(c, Prop(w = nil, h = nil), memo)
            node.children.push(placeIn(c, x, y, cs, memo))
    elif k == "Popover":
        # The anchor in place; the panel just below it (`withPopovers` moves it above when the window lacks room below).
        var anchorH = 0.0
        for i in 0..<n.children.length:
            let c = n.children[i]
            if i == 0:
                let cs = sizeOf(c, Prop(w = size.w, h = size.h), memo)
                anchorH = cs.h
                node.children.push(placeIn(c, x, y, cs, memo))
            else:
                let cs = sizeOf(c, Prop(w = nil, h = nil), memo)
                node.children.push(placeIn(c, x, y + anchorH, cs, memo))
    elif k == "Layer":
        let a = alignmentOf(n)
        for c in flatten(n):
            let cs = sizeOf(c, Prop(w = size.w, h = size.h), memo)
            node.children.push(placeIn(c, x + (size.w - cs.w) * xFraction(a), y + (size.h - cs.h) * yFraction(a), cs, memo))
    elif k == "Fill":
        let a = alignmentOf(n)
        let cs = sizeOf(n.children[0], Prop(w = size.w, h = size.h), memo)
        node.children.push(placeIn(n.children[0], x + (size.w - cs.w) * xFraction(a), y + (size.h - cs.h) * yFraction(a), cs, memo))
    elif windows(n, memo):
        placeWindowed(n, node, x, y, size, memo)
    elif (k == "List" or k == "MultiList"):
        let neg = negotiate(n, false, nil, size.w, memo)
        let items = flatten(n)
        let keys = flattenKeys(n)
        let most = nonNeg(neg.total - size.h)
        let offset = clampTo(n.scroll, 0.0, most)
        node.props["scroll"] = "{offset}"
        node.props["scrollMax"] = "{most}"
        var rowY = y - offset
        for i in 0..<items.length:
            let sz = neg.sizes[i]
            mut row = placeIn(items[i], x, rowY, sz, memo)
            row.key = keys[i]
            node.children.push(row)
            rowY += neg.mains[i] + neg.gap
    elif k == "Scroll":
        let vertical = isVerticalScroll(n)
        var contentProp = Prop(w = size.w, h = nil)
        if !vertical:
            contentProp = Prop(w = nil, h = size.h)
        let cs = sizeOf(n.children[0], contentProp, memo)
        var extent = cs.h - size.h
        if !vertical:
            extent = cs.w - size.w
        let most = nonNeg(extent)
        let offset = clampTo(n.scroll, 0.0, most)
        node.props["scroll"] = "{offset}"
        node.props["scrollMax"] = "{most}"
        if vertical:
            node.children.push(placeIn(n.children[0], x, y - offset, cs, memo))
        else:
            node.children.push(placeIn(n.children[0], x - offset, y, cs, memo))
    elif k == "Frame":
        node.children.push(placeChild(n.children[0], x, y, size, memo))
    elif k == "Row" or k == "Column":
        let isRow = k == "Row"
        var mainP = size.h
        var crossP = size.w
        var crossExtent = size.w
        if isRow:
            mainP = size.w
            crossP = size.h
            crossExtent = size.h
        let neg = negotiate(n, isRow, mainP, crossP, memo)
        let frac = alignFraction(n)
        let items = flatten(n)
        var offset = 0.0
        for i in 0..<items.length:
            var sz = neg.sizes[i]
            if items[i].kind == "Separator":
                # A separator spans the stack's whole cross extent.
                if isRow:
                    sz = Size(w = sz.w, h = crossExtent)
                else:
                    sz = Size(w = crossExtent, h = sz.h)
            var crossSize = sz.w
            if isRow:
                crossSize = sz.h
            let crossPos = (crossExtent - crossSize) * frac
            if isRow:
                node.children.push(placeIn(items[i], x + offset, y + crossPos, sz, memo))
            else:
                node.children.push(placeIn(items[i], x + crossPos, y + offset, sz, memo))
            offset += neg.mains[i] + neg.gap
    node

# `t` translated by (dx, dy), recursively.
def Placed translated(Placed t, float dx, float dy):
    mut [Placed] kids = []
    for c in t.children:
        kids.push(translated(c, dx, dy))
    Placed(id = t.id, kind = t.kind, x = t.x + dx, y = t.y + dy, w = t.w, h = t.h, props = t.props, children = kids, theme = t.theme, key = t.key, alpha = t.alpha, ghost = t.ghost, live = t.live)

# Whether any `Popover` of the tree is presented (has its panel).
def bool hasPresentedPopover(Placed p):
    if p.kind == "Popover" and p.children.length > 1:
        return true
    for c in p.children:
        if hasPresentedPopover(c):
            return true
    false

# The panel of every presented popover, in preorder (a later one is on top).
pub def void popupsIn(Placed p, mut [Placed] out):
    if p.kind == "Popover" and p.children.length > 1:
        out.push(p.children[1])
    for c in p.children:
        popupsIn(c, out)

# Where a popover's panel goes: below its anchor, left edges aligned, unless it does not fit there and the window has more room
# above (then its bottom edge meets the anchor's top); likewise sideways: past the window's right edge, the panel's right edge meets the
# anchor's. The panel is kept inside the window. `props["side"]` (below/above) and `props["edge"]` (left/right) record the choice.
def Placed popupAt(Placed anchor, Placed panel, float width, float height):
    let below = anchor.y + anchor.h
    var side = "below"
    var ny = below
    if panel.h > height - below and anchor.y > height - below:
        side = "above"
        ny = anchor.y - panel.h
    if ny + panel.h > height:
        ny = height - panel.h
    if ny < 0.0:
        ny = 0.0
    var nx = anchor.x
    var edge = "left"
    if nx + panel.w > width and anchor.x + anchor.w - panel.w >= 0.0:
        # does not fit past the anchor's left edge: its right edge meets the anchor's right edge
        nx = anchor.x + anchor.w - panel.w
        edge = "right"
    if nx + panel.w > width:
        nx = width - panel.w
    if nx < 0.0:
        nx = 0.0
    mut moved = translated(panel, nx - panel.x, ny - panel.y)
    moved.props["side"] = side
    moved.props["edge"] = edge
    moved

# The popover layer: every presented popover's panel is moved next to its anchor (see `popupAt`).
def Placed withPopovers(Placed p, float width, float height):
    mut kids = []
    for i in 0..<p.children.length:
        let c = withPopovers(p.children[i], width, height)
        if p.kind == "Popover" and i >= 1:
            kids.push(popupAt(p.children[0], c, width, height))
        else:
            kids.push(c)
    Placed(id = p.id, kind = p.kind, x = p.x, y = p.y, w = p.w, h = p.h, props = p.props, children = kids, theme = p.theme, key = p.key, alpha = p.alpha, ghost = p.ghost, live = p.live)

# The presentation layer: a presented `Sheet`'s bounds become the whole window and its content is centered
# in it (the sheet itself took no room in its parent's layout).
def Placed withSheets(Placed p, float width, float height):
    mut [Placed] kids = []
    let presented = p.kind == "Sheet" and p.children.length > 0
    for c in p.children:
        if presented:
            kids.push(translated(c, (width - c.w) / 2.0 - c.x, (height - c.h) / 2.0 - c.y))
        else:
            kids.push(withSheets(c, width, height))
    if presented:
        return Placed(id = p.id, kind = p.kind, x = 0.0, y = 0.0, w = width, h = height, props = p.props, children = kids, theme = p.theme, key = p.key, alpha = p.alpha, ghost = p.ghost, live = p.live)
    Placed(id = p.id, kind = p.kind, x = p.x, y = p.y, w = p.w, h = p.h, props = p.props, children = kids, theme = p.theme, key = p.key, alpha = p.alpha, ghost = p.ghost, live = p.live)

# The topmost presented `Sheet` of a placed tree (the last one in preorder), if any.
pub def Placed? topSheet(Placed p):
    var Placed? found = nil
    if p.kind == "Sheet" and p.children.length > 0:
        found = p
    for c in p.children:
        if let deeper = topSheet(c):
            found = deeper
    found

# Marks `node` (by id, there is one) with `marks` as its first live props, in place: only the nodes on the way down to it are
# visited, nothing is rebuilt. `p` is the freshly laid out tree of this frame, nobody else holds it. True once found.
def bool markLive(mut Placed p, int node, [PropValue] marks):
    if p.id == node:
        mut live = [] as [PropValue]
        for v in marks:
            live.push(v)
        for v in p.live:
            live.push(v)
        p.live = live
        return true
    for i in 0..<p.children.length:
        if markLive(p.children[i], node, marks):
            return true
    false

# Whether any `Sheet` of the tree is presented (has content): the only case `withSheets` has anything to do.
def bool hasPresentedSheet(Placed p):
    if p.kind == "Sheet" and p.children.length > 0:
        return true
    for c in p.children:
        if hasPresentedSheet(c):
            return true
    false

# Lays out the whole window: the root gets the window as its proposal. An unchanged tree (same version, same remembered row
# heights, same window) is served from the cache without even reading the mounted tree.
pub def Placed? layout(Runtime rt, float width, float height):
    let stamp = rt.rootStamp()
    if stamp == "":
        return nil
    mut memory = rt.layoutMemory
    let key = "win|{stamp}|{memory.epoch}|{width}|{height}"
    if let hit = memory.cachedPlaced(key):
        return finishLayout(rt, hit.placed.clone(), width, height)
    let epoch = memory.epoch
    if let r = rt.root:
        mut memo = Memo(windowed = true, memory = rt.layoutMemory)
        let size = rootSize(r, width, height, memo)
        let placed = placeCached(r, 0.0, 0.0, size, memo)
        memo.memory.trim()
        if memo.memory.epoch == epoch:
            memo.memory.placed[key] = PlacedEntry(placed = placed.clone(), x = 0.0, y = 0.0)
        return finishLayout(rt, placed, width, height)
    nil

# What the live state adds to a placed window: presented sheets, the focus ring and caret, hover, a composition in progress.
def Placed finishLayout(Runtime rt, Placed laidOut, float width, float height):
    var placed = laidOut
    if hasPresentedPopover(placed):
        placed = withPopovers(placed, width, height)
    if hasPresentedSheet(placed):
        placed = withSheets(placed, width, height)
    if let f = rt.focus:
        if rt.valid(f):
            _ = markLive(placed, f.id, [PropValue(key = "focused", value = "true")])
            if let field = rt.find(f.id):
                if field.kind == "TextField":
                    let valueLen = (field.props["value"] else ("")).graphemeCount
                    var caret = rt.read(f, "caret") else (-1)
                    if caret < 0 or caret > valueLen:
                        caret = valueLen
                    var anchor = rt.read(f, "anchor") else (-1)
                    if anchor < 0 or anchor > valueLen:
                        anchor = caret
                    _ = markLive(placed, f.id, [PropValue(key = "caret", value = "{caret}"), PropValue(key = "anchor", value = "{anchor}")])
    if let hv = rt.hover:
        if rt.valid(hv):
            _ = markLive(placed, hv.id, [PropValue(key = "hovered", value = "true")])
    if let c = rt.composition:
        var at = 0
        if let field = rt.find(c.node):
            let valueLen = (field.props["value"] else ("")).graphemeCount
            at = valueLen
            if let h = rt.handle(c.node):
                let stored = rt.read(h, "caret") else (-1)
                if stored >= 0 and stored <= valueLen:
                    at = stored
        _ = markLive(placed, c.node, [PropValue(key = "marked", value = c.text), PropValue(key = "markedAt", value = "{at}"), PropValue(key = "markedCursor", value = "{c.cursor}")])
    placed
