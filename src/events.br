# boring-ui headless event dispatch and keyboard focus (docs/design-notes/boring-ui-draft.md,
# "UI events and batched refresh", "Event dispatch, capture, and errors", "Focus"). Layer 4, first
# slice. Physical input — a pointer press, a key — is turned into SEMANTIC ACTIONS on a control
# ("activate", "toggle", "setText"); a semantic action from an accessibility client takes exactly the
# same path (`act`). Every action runs inside one event transaction: the control's callback or
# bound-slot write happens, the window is invalidated, and ONE update pass runs when the outermost
# event ends.
#
# Controls: `Button` (activate), `Toggle` (toggle its bound bool), `TextField` (focus; text via
# `typeText`). Keyboard focus is generation-checked, kept on the `Runtime`, and cleared when the
# focused node unmounts.
#
# Scroll input (`scrollBy`) moves the `Scroll` offsets kept on the mounted nodes.
#
# Not here yet: pointer release / capture / cancel, key capture-target-bubble phases, disabled
# state, modal routing, focus rings and `.focused` bindings, caret/selection/IME, momentum,
# scroll-into-view on focus, focus restoration, error reporting from callbacks.

# boring-ui headless event dispatch and keyboard focus (docs/design-notes/boring-ui-draft.md,
# "UI events and batched refresh", "Event dispatch, capture, and errors", "Button", "TextField",
# "Focus"). Layer 4. Physical input — a pointer press, a key — is turned into SEMANTIC ACTIONS on a
# control ("activate", "toggle", "setText", "submit"); a semantic action from an accessibility client
# takes exactly the same path (`act`). Every action runs inside one event transaction: the control's
# callback or bound-slot write happens, the window is invalidated, and ONE update pass runs when the
# outermost event ends.
#
# Pointer: `pointerDown` focuses the deepest enabled control under the pointer and CAPTURES it;
# `pointerUp` activates a Button / toggles a Toggle only when released over the captured control
# (released elsewhere is a cancel); `pointerCancel` drops the capture; `click` is down + up in place.
# Disabled: a control inside a `Disabled` subtree takes no focus, no capture, no action.
# Keys: Tab / ShiftTab traverse the enabled focus order; Space / Enter activate a focused Button,
# Space toggles a focused Toggle; Enter on a TextField with `onSubmit` submits, otherwise the nearest
# `DefaultAction` button activates; Escape activates the first enabled `Cancel` button. A focused
# TextField edits with `typeText` and the keys Backspace, Delete, Left, Right, Home, End (and the
# Shift variants), SelectAll; caret and selection are mounted control state, counted in grapheme clusters
# (a caret never splits a cluster; widths are `displayWidth` cells).
# Scroll input (`scrollBy`) moves the `Scroll` offsets kept on the mounted nodes.
#
# Not here yet: IME / composition, undo, key capture-target-bubble phases, modal routing, focus rings
# and `.focused` bindings, focus scopes, `List`/`Sheet`, momentum, scroll-into-view on focus, error
# reporting from callbacks.

use boring.ui.*
use ui.core.*
use ui.scrollbar.*
use ui.layout.*
use ui.scene.*

def string propOf(Mounted n, string name):
    n.props[name] else ("")

def bool isFocusable(string kind):
    isFocusableKind(kind)

# ── disabled state ─────────────────────────────────────────────────────────────────────────────

pub def bool isDisabled(Runtime rt, int id):
    rt.disabledAt(id)

# The enabled focusable controls in structural (tab) order — inside the topmost presented sheet when there
# is one (a modal scope traps traversal).
pub def [Handle] focusOrder(Runtime rt):
    if rt.openSheets.length > 0:
        if let top = rt.find(rt.openSheets[rt.openSheets.length - 1]):
            return scopedOrder(rt, top)
    if let r = rt.root:
        return scopedOrder(rt, r)
    []

# Traversal below `scope`: when the focus sits inside a trapping `FocusScope`, Tab wraps within it.
def [Handle] scopedOrder(Runtime rt, Mounted scope):
    if let f = rt.focus:
        let Mounted? none = nil
        if let trap = trapScopeOf(scope, f.id, none):
            return focusablesIn(trap, false)
    focusablesIn(scope, false)

# ── directional navigation ────────────────────────────────────────────────────────────────────
# Arrow keys move focus geometrically (draft, "Focus scopes and traversal"): the current `FocusSection` is
# searched first; if it holds no candidate (or there is none), the active scope is, where each section is
# one box (its placed bounds) and the winning section then picks its own control by the same rule.
# Candidates lie in the requested half-plane; the winner minimizes main-axis distance, then cross-axis
# distance, then traversal order. A host sends arrows here (`navigate`) unless a focused TextField consumed
# them as caret movement.

# One candidate target: a control (`section` -1) or a whole section, with its placed rectangle.
struct Cand:
    int id
    int section
    float x
    float y
    float w
    float h

def void collectRects(Placed p, mut {int=[float]} out):
    out[p.id] = [p.x, p.y, p.w, p.h]
    for c in p.children:
        collectRects(c, out)

def Cand candOf(int id, int section, {int=[float]} rects):
    let r = rects[id] else ([0.0, 0.0, 0.0, 0.0])
    Cand(id = id, section = section, x = r[0], y = r[1], w = r[2], h = r[3])

# The index of the best candidate from `origin` towards `dir` ("Left", "Right", "Up", "Down"), or -1.
def int pickBest(Cand origin, string dir, [Cand] cands):
    let fcx = origin.x + origin.w / 2.0
    let fcy = origin.y + origin.h / 2.0
    var best = -1
    var bestMain = 0.0
    var bestCross = 0.0
    for i in 0..<cands.length:
        let c = cands[i]
        let ccx = c.x + c.w / 2.0
        let ccy = c.y + c.h / 2.0
        var inPlane = false
        var main = 0.0
        var cross = 0.0
        if dir == "Right":
            inPlane = ccx > fcx
            main = c.x - (origin.x + origin.w)
            cross = ccy - fcy
        if dir == "Left":
            inPlane = ccx < fcx
            main = origin.x - (c.x + c.w)
            cross = ccy - fcy
        if dir == "Down":
            inPlane = ccy > fcy
            main = c.y - (origin.y + origin.h)
            cross = ccx - fcx
        if dir == "Up":
            inPlane = ccy < fcy
            main = origin.y - (c.y + c.h)
            cross = ccx - fcx
        if !inPlane:
            continue
        if main < 0.0:
            main = 0.0
        if cross < 0.0:
            cross = 0.0 - cross
        if best < 0 or main < bestMain or (main == bestMain and cross < bestCross):
            best = i
            bestMain = main
            bestCross = cross
    best

def [Cand] controlCands([Handle] hs, int skip, {int=[float]} rects):
    mut [Cand] out = []
    for h in hs:
        if h.id != skip:
            out.push(candOf(h.id, -1, rects))
    out

# Moves focus one step in direction `dir` ("Left"/"Right"/"Up"/"Down"), using the laid-out `placed` tree for
# geometry. Returns false when nothing lies that way (focus stays). With no focus yet, the first control gets it.
pub def bool navigate(mut Runtime rt, Builder host, Placed placed, string dir):
    let order = focusOrder(rt)
    if order.length == 0:
        return false
    var current = -1
    if let f = rt.focus:
        if rt.valid(f):
            for h in order:
                if h.id == f.id:
                    current = f.id
    if current < 0:
        focusControl(rt, host, order[0])
        return true
    mut {int=[float]} rects = {=}
    collectRects(placed, rects)
    guard let scope = activeScope(rt) else:
        return false
    let Mounted? none = nil
    let innerSec = sectionOf(scope, current, none, true)
    if let sec = innerSec:
        let inside = controlCands(focusablesIn(sec, false), current, rects)
        let hit = pickBest(candOf(current, -1, rects), dir, inside)
        if hit >= 0:
            focusControl(rt, host, handleOf(rt, inside[hit].id))
            return true
    # Between sections: every control outside any section is a unit, every outermost section one box.
    let outerSec = sectionOf(scope, current, none, false)
    var skipSection = -1
    var origin = candOf(current, -1, rects)
    if let o = outerSec:
        skipSection = o.id
        origin = candOf(o.id, -1, rects)
    mut [Cand] units = []
    mut {int} seen = {}
    for h in order:
        if h.id == current:
            continue
        let s = sectionOf(scope, h.id, none, false)
        if let sec = s:
            if sec.id != skipSection and !seen.contains(sec.id):
                _ = seen.add(sec.id)
                units.push(candOf(sec.id, sec.id, rects))
        else:
            units.push(candOf(h.id, -1, rects))
    let pick = pickBest(origin, dir, units)
    if pick < 0:
        return false
    let unit = units[pick]
    if unit.section < 0:
        focusControl(rt, host, handleOf(rt, unit.id))
        return true
    guard let target = rt.find(unit.section) else:
        return false
    let members = focusablesIn(target, false)
    if members.length == 0:
        return false
    let inner = controlCands(members, -1, rects)
    var at = pickBest(candOf(current, -1, rects), dir, inner)
    if at < 0:
        at = 0
    focusControl(rt, host, handleOf(rt, inner[at].id))
    true

def Handle handleOf(Runtime rt, int id):
    rt.handle(id) else (Handle(id = -1, generation = -1))

# The scope traversal currently runs in: the trapping scope holding the focus, else the topmost presented
# sheet, else the window.
def Mounted? activeScope(Runtime rt):
    var Mounted? base = nil
    if rt.openSheets.length > 0:
        base = rt.find(rt.openSheets[rt.openSheets.length - 1])
    else:
        base = rt.root
    if let b = base:
        if let f = rt.focus:
            let Mounted? none = nil
            if let trap = trapScopeOf(b, f.id, none):
                return trap
        return b
    nil

pub def void setFocus(mut Runtime rt, Handle h):
    if rt.valid(h):
        rt.focus = h

# Moves keyboard focus to `h` as one event, so `.focused(...)` bindings are synchronized in the same
# transaction (the previous control's binding goes off, this one's on).
pub def void focusControl(mut Runtime rt, Builder host, Handle h):
    if rt.valid(h):
        rt.focus = h
        rt.beginEvent()
        rt.invalidateRoot()
        rt.endEvent(host)

# Delivers a semantic action to the control behind `h`, as one event transaction. Returns false for
# a stale handle, a disabled control or a node that is not a native control.
pub def bool act(mut Runtime rt, Builder host, Handle h, string action, string arg):
    if !rt.valid(h):
        return false
    if isDisabled(rt, h.id):
        return false
    let found = rt.find(h.id)
    if found == nil:
        return false
    let node = found else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    if node.kind == "Slider" and (action == "increment" or action == "decrement"):
        var steps = 1
        if action == "decrement":
            steps = -1
        return adjustSlider(rt, host, h, steps)
    if let control = node.control:
        rt.beginEvent()
        let before = rt.sink.reports
        try:
            control.viewAct(action, arg)
        catch:
            rt.reportFailure("callback", action, "{error}", node.id)
        rt.settle(before)
        rt.endEvent(host)
        return true
    false

def Handle? handleFor(Runtime rt, int id):
    rt.handle(id)

# ── text editing state (caret and selection are mounted control state) ──────────────────────────────

def int clampTo(int v, int lo, int hi):
    if v < lo:
        return lo
    if v > hi:
        return hi
    v

# The caret index (stored, or the end of the text for a field nobody has edited yet).
def int caretOf(Runtime rt, Handle h, int len):
    let c = rt.read(h, "caret") else (-1)
    if c < 0 or c > len:
        return len
    c

# The selection anchor (equal to the caret when nothing is selected).
def int anchorOf(Runtime rt, Handle h, int len, int caret):
    let a = rt.read(h, "anchor") else (-1)
    if a < 0 or a > len:
        return caret
    a

# `[caret, anchor]` of a text field as the tests and the semantic layer read them.
pub def [int] selectionOf(Runtime rt, Handle h):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let len = propOf(node, "value").graphemeCount
    let caret = caretOf(rt, h, len)
    [caret, anchorOf(rt, h, len, caret)]

def void moveCaret(mut Runtime rt, Handle h, int caret, int anchor):
    _ = rt.write(h, "caret", caret)
    _ = rt.write(h, "anchor", anchor)

# ── undo / redo ───────────────────────────────────────────────────────────────────────────────
# Every accepted edit goes through `replaceRange`, which records it. Consecutive single-character typing (or
# consecutive deletions) with the caret where the last one left it form ONE undo group; a caret move, a switch
# between typing and deleting, a paste / selection replacement or an IME commit starts a new one. A bound value
# that differs from what the history last produced (an authoritative external replacement) clears it, so undo can
# never cross that boundary and overwrite newer application data; an edit clears redo.

def EditHistory historyOf(Runtime rt, Handle h, string value):
    let known = rt.histories[h.id] else (EditHistory(generation = h.generation, current = value))
    if known.generation != h.generation or known.current != value:
        return EditHistory(generation = h.generation, current = value)
    known

def string editKind(int a, int b, string insert):
    if insert == "":
        return "delete"
    if a == b and insert.graphemeCount == 1:
        return "type"
    "other"

def void recordEdit(mut Runtime rt, Handle h, string before, int caretBefore, int a, int b, string insert, string after):
    mut hist = historyOf(rt, h, before)
    let kind = editKind(a, b, insert)
    let grouped = kind != "other" and kind == hist.lastKind and caretBefore == hist.expectCaret
    if !grouped:
        hist.undoText.push(before)
        hist.undoCaret.push(caretBefore)
    hist.redoText = []
    hist.redoCaret = []
    hist.current = after
    hist.lastKind = kind
    hist.expectCaret = a + insert.graphemeCount
    rt.histories[h.id] = hist

# Steps the focused field back one undo group (a normal accepted edit: the binding is written). False when there is
# nothing to undo (or no enabled focused field).
pub def bool undo(mut Runtime rt, Builder host):
    stepHistory(rt, host, true)

pub def bool redo(mut Runtime rt, Builder host):
    stepHistory(rt, host, false)

def bool stepHistory(mut Runtime rt, Builder host, bool backwards):
    guard let f = focusedField(rt) else:
        return false
    if isDisabled(rt, f.id):
        return false
    guard let node = rt.find(f.id) else:
        return false
    let value = propOf(node, "value")
    mut hist = historyOf(rt, f, value)
    var target = ""
    var targetCaret = 0
    let here = caretOf(rt, f, value.graphemeCount)
    if backwards:
        if hist.undoText.length == 0:
            return false
        let at = hist.undoText.length - 1
        target = hist.undoText[at]
        targetCaret = hist.undoCaret[at]
        _ = hist.undoText.pop()
        _ = hist.undoCaret.pop()
        hist.redoText.push(value)
        hist.redoCaret.push(here)
    else:
        if hist.redoText.length == 0:
            return false
        let at = hist.redoText.length - 1
        target = hist.redoText[at]
        targetCaret = hist.redoCaret[at]
        _ = hist.redoText.pop()
        _ = hist.redoCaret.pop()
        hist.undoText.push(value)
        hist.undoCaret.push(here)
    hist.current = target
    hist.lastKind = ""
    hist.expectCaret = -1
    rt.histories[f.id] = hist
    let c = clampTo(targetCaret, 0, target.graphemeCount)
    moveCaret(rt, f, c, c)
    act(rt, host, f, "setText", target)

# Replaces the text between `a` and `b` with `insert`, leaving the caret after it, as one event.
def bool replaceRange(mut Runtime rt, Builder host, Handle h, Mounted node, int a, int b, string insert):
    let text = propOf(node, "value")
    let len = text.graphemeCount
    let next = "{text.graphemeSlice(0, a)}{insert}{text.graphemeSlice(b, len)}"
    if next != text:
        recordEdit(rt, h, text, caretOf(rt, h, len), a, b, insert, next)
    moveCaret(rt, h, a + insert.graphemeCount, a + insert.graphemeCount)
    act(rt, host, h, "setText", next)

def Handle? focusedField(Runtime rt):
    if let f = rt.focus:
        if rt.valid(f):
            if let node = rt.find(f.id):
                if node.kind == "TextField":
                    return f
    nil

# ── pointer ───────────────────────────────────────────────────────────────────────────────────

# The grapheme index of the text field `node` (laid out as `at`) under pointer x. The field is scrolled by what keeps its
# current caret in view (painting uses the same rule).
def int caretAtPointer(Runtime rt, Handle h, Placed at, Mounted node, float x):
    let body = at.theme.fontSizeNamed("Body")
    let current = propOf(node, "value")
    let origin = fieldOrigin(at.theme.measurer, current, selectionOf(rt, h)[0], at.w, body)
    graphemeAtX(at.theme.measurer, current, x - at.x - 4.0 - origin, body)

# A press on a scroller's indicator (checked before any control: the strip overlays the content): on the thumb it starts a
# drag, on the track beside it the scroller pages toward the pointer.
def bool pressScrollbar(mut Runtime rt, Builder host, Placed placed, float x, float y):
    let path = hitTest(placed, x, y)
    var i = path.length - 1
    while i >= 0:
        if let node = findPlaced(placed, path[i]):
            if isScroller(node.kind) and onTrack(node, x, y):
                let vertical = scrollsVertically(node)
                if let h = rt.handle(node.id):
                    let t = thumbOf(node)
                    var pointer = x
                    var start = t[0]
                    if vertical:
                        pointer = y
                        start = t[1]
                    if onThumb(node, x, y):
                        rt.thumbDrag = ThumbDrag(node = h.id, generation = h.generation, vertical = vertical, grab = pointer - start)
                        return true
                    var page = node.w
                    if vertical:
                        page = node.h
                    var target = numOf(node, "scroll") + page * 0.9
                    if pointer < start:
                        target = numOf(node, "scroll") - page * 0.9
                    rt.beginEvent()
                    _ = rt.scrollTo(node.id, target)
                    rt.invalidateRoot()
                    rt.endEvent(host)
                    return true
        i -= 1
    false

# One drag step of a scroll thumb: the scroller follows the pointer along its track.
def bool dragThumb(mut Runtime rt, Builder host, Placed placed, float x, float y):
    let held = rt.thumbDrag
    guard let d = held else:
        return false
    guard let h = rt.handle(d.node) else:
        rt.thumbDrag = nil
        return false
    if h.generation != d.generation:
        rt.thumbDrag = nil
        return false
    guard let node = findPlaced(placed, d.node) else:
        return false
    var pointer = x
    if d.vertical:
        pointer = y
    let target = offsetForEdge(node, pointer - d.grab)
    if target == numOf(node, "scroll"):
        return true
    rt.beginEvent()
    _ = rt.scrollTo(d.node, target)
    rt.invalidateRoot()
    rt.endEvent(host)
    true

# A pointer press at (x, y) of the laid-out window `placed`: the deepest enabled control on the hit path
# takes focus and captures the pointer (a TextField also places its caret). Nothing activates yet — that
# happens on release over the same control. Returns whether a control was hit.
pub def bool pointerDown(mut Runtime rt, Builder host, Placed placed, float x, float y):
    pointerDownWith(rt, host, placed, x, y, "")

# A press with a selection modifier on a `MultiList` row: "Toggle" (Command/Ctrl) adds or removes the row,
# "Range" (Shift) selects from the anchor to it; "" replaces the selection. Anything else ignores it.
pub def bool pointerDownWith(mut Runtime rt, Builder host, Placed placed, float x, float y, string mods):
    rt.momentum = nil
    rt.glide = nil
    rt.pan = nil
    if pressScrollbar(rt, host, placed, x, y):
        return true
    let path = hitTest(placed, x, y)
    rt.drag = nil
    rt.press = nil
    var pressed = path.length - 1
    while pressed >= 0:
        if let source = rt.find(path[pressed]):
            if source.kind == "DragSource" and !isDisabled(rt, source.id):
                rt.drag = DragState(source = source.id, payload = propOf(source, "payload"), preview = dragPreviewOf(source), startX = x, startY = y, x = x, y = y, active = false, over = [])
                break
        pressed -= 1
    # A press outside the topmost presented popover (its anchor and its panel) dismisses it and goes no further.
    let popovers = rt.presentedPopovers()
    if popovers.length > 0:
        let top = popovers[popovers.length - 1]
        if !path.contains(top):
            if let h = rt.handle(top):
                _ = act(rt, host, h, "dismiss", "")
            return true
    beginPress(rt, path, x, y)
    beginPan(rt, path, x, y)
    var i = path.length - 1
    while i >= 0:
        let id = path[i]
        if let node = rt.find(id):
            if isFocusable(node.kind) and !isDisabled(rt, id):
                # a control inside the pan area keeps its press
                rt.pan = nil
                let h = Handle(id = node.id, generation = node.generation)
                focusControl(rt, host, h)
                rt.capture = h
                if node.kind == "Slider":
                    if let at = findPlaced(placed, id):
                        _ = setSliderFromPointer(rt, host, h, at, x)
                if node.kind == "TextField":
                    if let at = findPlaced(placed, id):
                        let caret = caretAtPointer(rt, h, at, node, x)
                        # Shift (mods "Range") extends the selection from where it was anchored; a plain press places the caret
                        rt.dragSelect = true
                        if mods == "Range":
                            moveCaret(rt, h, caret, anchorOf(rt, h, propOf(node, "value").graphemeCount, caretOf(rt, h, propOf(node, "value").graphemeCount)))
                        else:
                            moveCaret(rt, h, caret, caret)
                        rt.invalidateRoot()
                return true
        i -= 1
    selectRowAt(rt, host, placed, path, mods)

# ── sliders ────────────────────────────────────────────────────────────────────────────────────

def float sliderNumber(Mounted n, string key, float fallback):
    let text = n.props[key] else ("")
    if text == "":
        return fallback
    text.parseFloat() else (fallback)

# The distance one arrow-key press moves a slider: its `step`, or a twentieth of its range.
def float sliderStepOf(Mounted n):
    let low = sliderNumber(n, "min", 0.0)
    let high = sliderNumber(n, "max", 1.0)
    let explicit = sliderNumber(n, "step", 0.0)
    if explicit > 0.0:
        return explicit
    (high - low) / 20.0

# Sets a slider to `v`: clamped to its range and rounded to the nearest step, delivered as one event.
pub def bool setSlider(mut Runtime rt, Builder host, Handle h, float v):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    if node.kind != "Slider":
        return false
    let low = sliderNumber(node, "min", 0.0)
    let high = sliderNumber(node, "max", 1.0)
    var next = v
    let explicit = sliderNumber(node, "step", 0.0)
    if explicit > 0.0:
        let count = ((next - low) / explicit + 0.5) as int
        next = low + (count as float) * explicit
    if next < low:
        next = low
    if next > high:
        next = high
    act(rt, host, h, "setFloat", "{next}")

# Moves a slider by `steps` steps (negative = down).
pub def bool adjustSlider(mut Runtime rt, Builder host, Handle h, int steps):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let current = sliderNumber(node, "value", 0.0)
    setSlider(rt, host, h, current + (steps as float) * sliderStepOf(node))

def bool setSliderFromPointer(mut Runtime rt, Builder host, Handle h, Placed at, float x):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let low = sliderNumber(node, "min", 0.0)
    let high = sliderNumber(node, "max", 1.0)
    var frac = 0.0
    if at.w > 0.0:
        frac = (x - at.x) / at.w
    if frac < 0.0:
        frac = 0.0
    if frac > 1.0:
        frac = 1.0
    setSlider(rt, host, h, low + frac * (high - low))

# Slider keys: Left / Down and Right / Up move one step, PageDown / PageUp ten, Home / End jump to the ends.
def bool sliderKey(mut Runtime rt, Builder host, Handle h, string name):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    if name == "Left" or name == "Down":
        return adjustSlider(rt, host, h, -1)
    if name == "Right" or name == "Up":
        return adjustSlider(rt, host, h, 1)
    if name == "PageDown":
        return adjustSlider(rt, host, h, -10)
    if name == "PageUp":
        return adjustSlider(rt, host, h, 10)
    if name == "Home":
        return setSlider(rt, host, h, sliderNumber(node, "min", 0.0))
    if name == "End":
        return setSlider(rt, host, h, sliderNumber(node, "max", 1.0))
    false

# The deepest enabled interactive control on the hit path at (x, y), if any: what the pointer is "over".
def Handle? hoverTarget(Runtime rt, Placed placed, float x, float y):
    let path = hitTest(placed, x, y)
    var i = path.length - 1
    while i >= 0:
        let id = path[i]
        if let node = rt.find(id):
            if node.kind == "Button" or node.kind == "Toggle" or node.kind == "TextField" or node.kind == "Slider":
                if !isDisabled(rt, id):
                    return rt.handle(id)
        i -= 1
    nil

# The mounted ancestors of node `id` (outermost first, `id` itself excluded) that are `OnHover` wrappers.
def bool hoverPath(Mounted n, int id, mut [int] out):
    if n.id == id:
        return true
    if n.kind == "OnHover":
        out.push(n.id)
    for c in n.children:
        if hoverPath(c, id, out):
            return true
    if n.kind == "OnHover":
        _ = out.pop()
    false

def [int] hoverScopes(Runtime rt, int id):
    mut out = [] as [int]
    if id >= 0:
        if let r = rt.root:
            _ = hoverPath(r, id, out)
    out

# Tells every `OnHover` whose "pointer is over a control inside" answer changed between the old and the new hover target (writes the bound
# `value`: `setBool`). Called inside the event that changes `rt.hover`.
def void syncHoverScopes(mut Runtime rt, Builder host, int fromId, int toId):
    let before = hoverScopes(rt, fromId)
    let after = hoverScopes(rt, toId)
    for id in before:
        if !after.contains(id):
            mut kept = [] as [HoverWait]
            for w in rt.hoverPending:
                if w.id != id:
                    kept.push(w)
            rt.hoverPending = kept
            if let h = rt.handle(id):
                _ = act(rt, host, h, "setBool", "false")
    for id in after:
        if !before.contains(id):
            if let h = rt.handle(id):
                let delay = hoverDelay(rt, id)
                if delay > 0.0:
                    rt.hoverPending.push(HoverWait(id = id, since = -1.0, delay = delay))
                else:
                    _ = act(rt, host, h, "setBool", "true")

def float hoverDelay(Runtime rt, int id):
    if let n = rt.find(id):
        return ((n.props["delay"] else ("0")).parseFloat()) else (0.0)
    0.0

# Whether some `OnHover` with a `delay` is still waiting for it (the host keeps ticking frames while so).
pub def bool hoverWaiting(Runtime rt):
    rt.hoverPending.length > 0 or longPressWaiting(rt)

# The host's clock, `nowMs` milliseconds: an `OnHover` whose delay has elapsed since the pointer entered (counted from the first tick after the
# entry) now reports true. Returns whether the runtime was rebuilt (the frame must be painted).
pub def bool tickHover(mut Runtime rt, Builder host, float nowMs):
    rt.nowMs = nowMs
    let longPressed = fireLongPress(rt, host, nowMs)
    if rt.hoverPending.length == 0:
        return longPressed
    mut waiting = [] as [HoverWait]
    mut due = [] as [int]
    for w in rt.hoverPending:
        if w.since < 0.0:
            waiting.push(HoverWait(id = w.id, since = nowMs, delay = w.delay))
        else:
            if nowMs - w.since >= w.delay:
                due.push(w.id)
            else:
                waiting.push(w)
    rt.hoverPending = waiting
    if due.length == 0:
        return longPressed
    rt.beginEvent()
    for id in due:
        if let h = rt.handle(id):
            _ = act(rt, host, h, "setBool", "true")
    rt.invalidateRoot()
    rt.endEvent(host)
    true

# A secondary press (the right mouse button) at (x, y): the deepest `OnContext` under the pointer gets `true` written into its bound value
# (`ContextMenu` opens its menu). A press outside the topmost presented popover dismisses it, as a primary press does. Returns whether it was used;
# on false the host may treat the press otherwise (the todo window lets the right button stand in for a finger).
pub def bool contextPress(mut Runtime rt, Builder host, Placed placed, float x, float y):
    rt.momentum = nil
    rt.glide = nil
    let path = hitTest(placed, x, y)
    let popovers = rt.presentedPopovers()
    if popovers.length > 0:
        let top = popovers[popovers.length - 1]
        if !path.contains(top):
            if let h = rt.handle(top):
                _ = act(rt, host, h, "dismiss", "")
            return true
    var i = path.length - 1
    while i >= 0:
        let id = path[i]
        if let node = rt.find(id):
            if node.kind == "OnContext":
                if let h = rt.handle(id):
                    return act(rt, host, h, "setBool", "true")
        i -= 1
    false

# ── pointer gestures ───────────────────────────────────────────────────────────────────────────
# `OnTap`, `OnLongPress` and `OnSwipe` wrap a subtree and leave the press to the controls inside it. A press that lands inside one records a
# `PressState`; the release decides between a tap (it never moved past the slop: `OnTap`, counted over quick presses at one place) and a swipe
# (it moved: `OnSwipe`, by the dominant axis). `tickHover` fires `OnLongPress` while the pointer is held still, and spends the press.

def float tapWindow():
    400.0

pub def bool gestureView(string kind):
    kind == "OnTap" or kind == "OnLongPress" or kind == "OnSwipe"

# The host's clock (ms) at an input event, for presses that arrive between ticks (`tickHover` also sets it).
pub def void setClock(mut Runtime rt, float nowMs):
    rt.nowMs = nowMs

def void beginPress(mut Runtime rt, [int] path, float x, float y):
    mut nodes = [] as [int]
    var i = path.length - 1
    while i >= 0:
        if let n = rt.find(path[i]):
            if gestureView(n.kind) and !isDisabled(rt, n.id):
                nodes.push(n.id)
        i -= 1
    if nodes.length > 0:
        rt.press = PressState(nodes = nodes, startX = x, startY = y, startMs = rt.nowMs, moved = false, longFired = false)

def void markPressMoved(mut Runtime rt, float x, float y):
    let current = rt.press
    guard let p = current else:
        return
    if p.moved:
        return
    let dx = x - p.startX
    let dy = y - p.startY
    if dx * dx + dy * dy > touchSlop() * touchSlop():
        rt.press = PressState(nodes = p.nodes, startX = p.startX, startY = p.startY, startMs = p.startMs, moved = true, longFired = p.longFired)

# Whether a press is being held still inside an `OnLongPress` (the host keeps ticking frames while so).
pub def bool longPressWaiting(Runtime rt):
    let current = rt.press
    guard let p = current else:
        return false
    if p.moved or p.longFired:
        return false
    for id in p.nodes:
        if let n = rt.find(id):
            if n.kind == "OnLongPress":
                return true
    false

def bool fireLongPress(mut Runtime rt, Builder host, float nowMs):
    let current = rt.press
    guard let p = current else:
        return false
    if p.moved or p.longFired:
        return false
    for id in p.nodes:
        if let n = rt.find(id):
            if n.kind == "OnLongPress" and nowMs - p.startMs >= sliderNumber(n, "minMs", 500.0):
                rt.press = PressState(nodes = p.nodes, startX = p.startX, startY = p.startY, startMs = p.startMs, moved = false, longFired = true)
                # the press is spent: the control under it neither activates nor drags on release
                rt.capture = nil
                rt.drag = nil
                rt.dragSelect = false
                if let h = rt.handle(id):
                    _ = act(rt, host, h, "activate", "")
                rt.invalidateRoot()
                return true
    false

def float absOf(float v):
    if v < 0.0:
        return 0.0 - v
    v

def string swipeDirection(float dx, float dy):
    if absOf(dx) >= absOf(dy):
        if dx > 0.0:
            return "right"
        return "left"
    if dy > 0.0:
        return "down"
    "up"

# The release of a press that began inside gesture views: a tap or a swipe. Returns whether a gesture view ran.
def bool gestureUp(mut Runtime rt, Builder host, float x, float y):
    let current = rt.press
    rt.press = nil
    guard let p = current else:
        return false
    if p.longFired:
        return false
    let dx = x - p.startX
    let dy = y - p.startY
    var fired = false
    if !p.moved and dx * dx + dy * dy <= touchSlop() * touchSlop():
        var count = 1
        let nearX = absOf(p.startX - rt.tapX) < touchSlop()
        let nearY = absOf(p.startY - rt.tapY) < touchSlop()
        if p.startMs - rt.tapMs < tapWindow() and nearX and nearY:
            count = rt.taps + 1
        rt.taps = count
        rt.tapMs = p.startMs
        rt.tapX = p.startX
        rt.tapY = p.startY
        for id in p.nodes:
            if let n = rt.find(id):
                if n.kind == "OnTap" and (sliderNumber(n, "count", 1.0) as int) == count:
                    if let h = rt.handle(id):
                        if act(rt, host, h, "activate", ""):
                            fired = true
        return fired
    let dir = swipeDirection(dx, dy)
    var far = absOf(dx)
    if absOf(dy) > far:
        far = absOf(dy)
    for id in p.nodes:
        if let n = rt.find(id):
            let only = propOf(n, "direction")
            if n.kind == "OnSwipe" and far >= sliderNumber(n, "minDistance", 40.0) and (only == "" or only == dir):
                if let h = rt.handle(id):
                    _ = act(rt, host, h, "setText", dir)
                    if act(rt, host, h, "activate", ""):
                        fired = true
                if fired:
                    break
    fired

# ── pan ────────────────────────────────────────────────────────────────────────────────────────
# `OnPan`: a press inside it that lands on no control starts a pan; every movement writes "dx,dy" (points since the last report) into its bound value
# and activates it, until the release. A control inside keeps its own press (the press goes to the control, not to the pan).

def void beginPan(mut Runtime rt, [int] path, float x, float y):
    var i = path.length - 1
    while i >= 0:
        if let n = rt.find(path[i]):
            if n.kind == "OnPan" and !isDisabled(rt, n.id):
                rt.pan = PanState(node = n.id, lastX = x, lastY = y)
                return
        i -= 1

def bool panMove(mut Runtime rt, Builder host, float x, float y):
    let current = rt.pan
    guard let p = current else:
        return false
    let dx = x - p.lastX
    let dy = y - p.lastY
    if dx == 0.0 and dy == 0.0:
        return false
    rt.pan = PanState(node = p.node, lastX = x, lastY = y)
    if let h = rt.handle(p.node):
        _ = act(rt, host, h, "setText", "{dx},{dy}")
        _ = act(rt, host, h, "activate", "")
    rt.invalidateRoot()
    true

# ── drag and drop ──────────────────────────────────────────────────────────────────────────────

def string dragPreviewOf(Mounted source):
    let shown = propOf(source, "preview")
    if shown == "":
        return propOf(source, "payload")
    shown

# Delivers a bool to the bound `value` of the node `id` (a `DragSource` or an `OnDragOver`), if it is still mounted.
def void setDragFlag(mut Runtime rt, Builder host, int id, bool on):
    if let h = rt.handle(id):
        var text = "false"
        if on:
            text = "true"
        _ = act(rt, host, h, "setBool", text)

# The `OnDragOver` nodes on a hit path.
def [int] dragOverIds(Runtime rt, [int] path):
    mut [int] ids = []
    for id in path:
        if let node = rt.find(id):
            if node.kind == "OnDragOver":
                ids.push(id)
    ids

# Whether the `OnDrop` node accepts a payload: no `accepts`, or its kind (the part before the first ':') equals it.
def bool dropAccepts(Mounted target, string payload):
    let wanted = propOf(target, "accepts")
    if wanted == "":
        return true
    payload.split(":")[0] == wanted

# A pointer move during a press inside a `DragSource`: once the pointer is a few points away the drag starts (a pending click is cancelled), then
# it follows the pointer, telling every `OnDragOver` it enters or leaves. Returns whether anything changed.
def bool dragMove(mut Runtime rt, Builder host, Placed placed, float x, float y):
    let d = rt.drag else (DragState(source = -1, payload = "", preview = "", startX = 0.0, startY = 0.0, x = 0.0, y = 0.0, active = false, over = []))
    if d.source < 0:
        return false
    if !d.active:
        let dx = x - d.startX
        let dy = y - d.startY
        if dx * dx + dy * dy < 16.0:
            return false
        rt.capture = nil
        rt.dragSelect = false
        setDragFlag(rt, host, d.source, true)
    let now = dragOverIds(rt, hitTest(placed, x, y))
    for id in now:
        if !d.over.contains(id):
            setDragFlag(rt, host, id, true)
    for id in d.over:
        if !now.contains(id):
            setDragFlag(rt, host, id, false)
    rt.drag = DragState(source = d.source, payload = d.payload, preview = d.preview, startX = d.startX, startY = d.startY, x = x, y = y, active = true, over = now)
    true

# Ends an active drag: the flags go back to false and, when the pointer is over an `OnDrop` that accepts the payload, the drop is delivered.
def void dragEnd(mut Runtime rt, Builder host, Placed placed, float x, float y, bool drop):
    let d = rt.drag else (DragState(source = -1, payload = "", preview = "", startX = 0.0, startY = 0.0, x = 0.0, y = 0.0, active = false, over = []))
    rt.drag = nil
    if d.source < 0 or !d.active:
        return
    for id in d.over:
        setDragFlag(rt, host, id, false)
    setDragFlag(rt, host, d.source, false)
    if drop:
        let path = hitTest(placed, x, y)
        var i = path.length - 1
        while i >= 0:
            if let node = rt.find(path[i]):
                if node.kind == "OnDrop" and dropAccepts(node, d.payload):
                    if let h = rt.handle(node.id):
                        _ = act(rt, host, h, "setText", d.payload)
                        _ = act(rt, host, h, "activate", "")
                    break
            i -= 1
    rt.beginEvent()
    rt.invalidateRoot()
    rt.endEvent(host)

# The pointer moved to (x, y): the control under it becomes `rt.hover` (one update pass when that changes; the
# painter shades it), and while a slider holds the pointer, moving it (even outside the slider) drags the value.
# Returns whether anything changed.
pub def bool pointerMove(mut Runtime rt, Builder host, Placed placed, float x, float y):
    markPressMoved(rt, x, y)
    if rt.thumbDrag != nil:
        return dragThumb(rt, host, placed, x, y)
    if rt.pan != nil:
        return panMove(rt, host, x, y)
    if rt.drag != nil:
        let moved = dragMove(rt, host, placed, x, y)
        if let d = rt.drag:
            if d.active:
                return moved
    var changed = false
    var nextId = -1
    if let t = hoverTarget(rt, placed, x, y):
        nextId = t.id
    var currentId = -1
    if let c = rt.hover:
        currentId = c.id
    if nextId != currentId:
        rt.beginEvent()
        rt.hover = hoverTarget(rt, placed, x, y)   # looked up again: binding `target` above would move it
        syncHoverScopes(rt, host, currentId, nextId)
        rt.invalidateRoot()
        rt.endEvent(host)
        changed = true
    if let cap = rt.capture:
        if rt.valid(cap):
            if let node = rt.find(cap.id):
                if node.kind == "Slider":
                    if let at = findPlaced(placed, cap.id):
                        if setSliderFromPointer(rt, host, cap, at, x):
                            changed = true
                if node.kind == "TextField" and rt.dragSelect:
                    # a drag from the press selects: the anchor stays, the caret follows the pointer
                    if let at = findPlaced(placed, cap.id):
                        let sel = selectionOf(rt, cap)
                        let caret = caretAtPointer(rt, cap, at, node, x)
                        if caret != sel[0]:
                            moveCaret(rt, cap, caret, sel[1])
                            rt.invalidateRoot()
                            changed = true
    changed

# The pointer left the window: nothing is hovered.
pub def bool pointerLeave(mut Runtime rt, Builder host):
    if rt.hover == nil:
        return false
    rt.beginEvent()
    var leftId = -1
    if let c = rt.hover:
        leftId = c.id
    rt.hover = nil
    syncHoverScopes(rt, host, leftId, -1)
    rt.invalidateRoot()
    rt.endEvent(host)
    true

# A pointer release: a Button activates and a Toggle toggles only when the pointer is still over the
# control that captured it; released anywhere else it is a cancel. The capture always ends.
pub def bool pointerUp(mut Runtime rt, Builder host, Placed placed, float x, float y):
    rt.pan = nil
    var busy = rt.thumbDrag != nil
    if let d = rt.drag:
        if d.active:
            busy = true
    if busy:
        rt.press = nil
        return releaseCapture(rt, host, placed, x, y)
    let fired = gestureUp(rt, host, x, y)
    let used = releaseCapture(rt, host, placed, x, y)
    fired or used

def bool releaseCapture(mut Runtime rt, Builder host, Placed placed, float x, float y):
    if rt.thumbDrag != nil:
        rt.thumbDrag = nil
        return true
    if let d = rt.drag:
        if d.active:
            dragEnd(rt, host, placed, x, y, true)
            return true
        rt.drag = nil
    let held = rt.capture
    rt.capture = nil
    rt.dragSelect = false
    if held == nil:
        return false
    let h = held else (Handle(id = -1, generation = -1))
    if !rt.valid(h):
        return false
    # A drag on a slider simply ends wherever the pointer is released.
    if let held = rt.find(h.id):
        if held.kind == "Slider":
            return true
    let path = hitTest(placed, x, y)
    if !path.contains(h.id):
        return false
    if let node = rt.find(h.id):
        if node.kind == "Button":
            return act(rt, host, h, "activate", "")
        if node.kind == "Toggle":
            return act(rt, host, h, "toggle", "")
        return true
    false

# The platform cancelled the pointer (window lost, modal opened): the capture ends, nothing happens.
pub def void pointerCancel(mut Runtime rt):
    rt.pan = nil
    rt.press = nil
    rt.thumbDrag = nil
    rt.drag = nil
    rt.capture = nil
    rt.dragSelect = false

# Characters that end a word for double-click selection; everything else (letters, digits, CJK...) belongs to one.
def bool isSeparator(string g):
    " \t\n.,;:!?()[]{}<>\"'/\\|-+=*&^%$#@~`".contains(g)

# A press that is the `clicks`-th of a quick series: the second selects the word under the pointer, the third the whole text.
pub def bool pointerDownClicks(mut Runtime rt, Builder host, Placed placed, float x, float y, string mods, int clicks):
    let handled = pointerDownWith(rt, host, placed, x, y, mods)
    if handled and clicks >= 2:
        # the word (or text) is selected: holding the button and moving must not move the caret away from it
        rt.dragSelect = false
        if let f = focusedField(rt):
            let node = rt.find(f.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
            let text = propOf(node, "value")
            let len = text.graphemeCount
            let caret = caretOf(rt, f, len)
            if clicks >= 3:
                moveCaret(rt, f, len, 0)
            else:
                # the run of same-kind graphemes (word or separators) around the caret
                var lo = caret
                var hi = caret
                var probe = caret
                if probe >= len and len > 0:
                    probe = len - 1
                if len > 0:
                    let kind = isSeparator(text.graphemeSlice(probe, probe + 1))
                    lo = probe
                    while lo > 0 and isSeparator(text.graphemeSlice(lo - 1, lo)) == kind:
                        lo -= 1
                    hi = probe + 1
                    while hi < len and isSeparator(text.graphemeSlice(hi, hi + 1)) == kind:
                        hi += 1
                moveCaret(rt, f, hi, lo)
            rt.invalidateRoot()
    handled

# ── clipboard ─────────────────────────────────────────────────────────────────────────────────────
# The runtime keeps one internal clipboard (`Runtime.clipboard`): copy and cut fill it from the focused text field's
# selection, paste inserts it at the caret (replacing a selection, as one undoable edit). A host with a system clipboard
# mirrors it (reads `rt.clipboard` after a copy, sets it before a paste).

# The focused text field's selected text, "" when nothing is selected.
pub def string selectedText(Runtime rt):
    if let f = focusedField(rt):
        let node = rt.find(f.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
        let sel = selectionOf(rt, f)
        var lo = sel[0]
        var hi = sel[1]
        if sel[1] < sel[0]:
            lo = sel[1]
            hi = sel[0]
        return propOf(node, "value").graphemeSlice(lo, hi)
    ""

# Copies the selection to the clipboard; whether there was one.
pub def bool copySelection(mut Runtime rt):
    let text = selectedText(rt)
    if text == "":
        return false
    rt.clipboard = text
    true

# Copies the selection and deletes it as one edit; whether there was one.
pub def bool cutSelection(mut Runtime rt, Builder host):
    let text = selectedText(rt)
    if text == "":
        return false
    rt.clipboard = text
    typeText(rt, host, "")

# Inserts the clipboard at the caret (replacing the selection); whether it did.
pub def bool pasteClipboard(mut Runtime rt, Builder host):
    if rt.clipboard == "":
        return false
    typeText(rt, host, rt.clipboard)

# A press and release at the same point.
pub def bool click(mut Runtime rt, Builder host, Placed placed, float x, float y):
    clickWith(rt, host, placed, x, y, "")

# The same with a selection modifier (see `pointerDownWith`).
pub def bool clickWith(mut Runtime rt, Builder host, Placed placed, float x, float y, string mods):
    if !pointerDownWith(rt, host, placed, x, y, mods):
        return false
    # A press that captured nothing (a list row selected on press) has no release to deliver.
    if rt.capture == nil:
        return true
    pointerUp(rt, host, placed, x, y)

# ── keyboard ──────────────────────────────────────────────────────────────────────────────────

# A press that hit no control but a row of a `List` selects that row (by its key).
def bool selectRowAt(mut Runtime rt, Builder host, Placed placed, [int] path, string mods):
    var listId = -1
    var rowKey = ""
    for id in path:
        if let node = findPlaced(placed, id):
            if (node.kind == "List" or node.kind == "MultiList"):
                listId = id
                rowKey = ""
            elif listId >= 0 and rowKey == "" and node.key != "":
                rowKey = node.key
    if listId >= 0 and rowKey != "":
        if let h = rt.handle(listId):
            if let list = rt.find(listId):
                if list.kind == "MultiList":
                    return selectMulti(rt, host, h, list, rowKey, mods)
            return act(rt, host, h, "select", rowKey)
    false

# ── multiple selection ────────────────────────────────────────────────────────────────────────
# A `MultiList` keeps its selection as a set of row keys; the runtime computes the new set and writes it whole
# (`setSelection`). Two mounted slots hold the gesture state: `anchor` (where a range starts) and `cursor` (the
# row keyboard extension moves from).

def [string] rangeKeys([string] rows, int a, int b):
    var lo = a
    var hi = b
    if lo > hi:
        lo = b
        hi = a
    mut [string] out = []
    for i in lo..=hi:
        out.push(rows[i])
    out

def bool setMulti(mut Runtime rt, Builder host, Handle h, [string] keys, int anchor, int cursor):
    _ = rt.write(h, "anchor", anchor)
    _ = rt.write(h, "cursor", cursor)
    act(rt, host, h, "setSelection", keys.join("\n"))

def bool selectMulti(mut Runtime rt, Builder host, Handle h, Mounted list, string key, string mods):
    let rows = rowKeysOf(list)
    let idx = indexOfKey(rows, key)
    if idx < 0:
        return false
    let current = selectedKeysOf(list)
    var anchor = rt.read(h, "anchor") else (-1)
    if mods == "Toggle":
        mut [string] next = []
        var had = false
        for k in current:
            if k == key:
                had = true
            else:
                next.push(k)
        if !had:
            next.push(key)
        return setMulti(rt, host, h, next, idx, idx)
    if mods == "Range":
        if anchor < 0 or anchor >= rows.length:
            anchor = idx
        return setMulti(rt, host, h, rangeKeys(rows, anchor, idx), anchor, idx)
    setMulti(rt, host, h, [key], idx, idx)

# The first `List` of the window (the one keyboard commands address).
def Mounted? firstList(Runtime rt):
    let all = rt.lists()
    if all.length > 0:
        return all[0]
    nil

def int indexOfKey([string] keys, string key):
    for i in 0..<keys.length:
        if keys[i] == key:
            return i
    -1

# List keyboard commands: Up / Down move the selection, Delete / Backspace delete the selected row
# (`onDelete([index])`), AltUp / AltDown move it one place (`onMove(from, to)`). The callbacks must be
# given (`viewHandles`); the application mutates its model and the next pass restores identity by key.
def bool listKey(mut Runtime rt, Builder host, string name):
    let found = firstList(rt)
    if found == nil:
        return false
    let list = found else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let keys = rowKeysOf(list)
    if keys.length == 0:
        return false
    if list.kind == "MultiList":
        return multiListKey(rt, host, name, list.id, keys)
    let at = indexOfKey(keys, propOf(list, "selection"))
    guard let h = rt.handle(list.id) else:
        return false
    if name == "Up" or name == "Down":
        var next = 0
        if name == "Up":
            next = keys.length - 1
            if at > 0:
                next = at - 1
            if at == 0:
                next = 0
        else:
            if at >= 0:
                next = clampTo(at + 1, 0, keys.length - 1)
        return act(rt, host, h, "select", keys[next])
    if at < 0:
        return false
    if let control = list.control:
        if name == "Delete" or name == "Backspace":
            if control.viewHandles("delete"):
                return act(rt, host, h, "delete", "{at}")
            return false
        if control.viewHandles("move"):
            var to = at - 1
            if name == "AltDown":
                to = at + 1
            if to < 0 or to >= keys.length:
                return false
            return act(rt, host, h, "move", "{at},{to}")
    false

# MultiList keys: Up/Down move a single selection, ShiftUp/ShiftDown extend it from the anchor, SelectAll takes every
# row, Delete/Backspace delete every selected row (`onDelete` gets their ascending indices), AltUp/AltDown move the
# row when exactly one is selected.
def bool multiListKey(mut Runtime rt, Builder host, string name, int listId, [string] rows):
    guard let h = rt.handle(listId) else:
        return false
    # (Re-found as a local: `boring build` makes a parameter whose `.control` is moved out an owned one.)
    guard let list = rt.find(listId) else:
        return false
    let current = selectedKeysOf(list)
    var cursor = rt.read(h, "cursor") else (-1)
    if cursor < 0 or cursor >= rows.length:
        cursor = -1
        if current.length > 0:
            cursor = indexOfKey(rows, current[0])
    if name == "SelectAll":
        return setMulti(rt, host, h, rows, 0, rows.length - 1)
    if name == "Up" or name == "Down" or name == "ShiftUp" or name == "ShiftDown":
        let up = name == "Up" or name == "ShiftUp"
        var next = 0
        if cursor < 0:
            if up:
                next = rows.length - 1
        else:
            if up:
                next = clampTo(cursor - 1, 0, rows.length - 1)
            else:
                next = clampTo(cursor + 1, 0, rows.length - 1)
        if name == "ShiftUp" or name == "ShiftDown":
            var anchor = rt.read(h, "anchor") else (-1)
            if anchor < 0 or anchor >= rows.length:
                anchor = next
                if cursor >= 0:
                    anchor = cursor
            return setMulti(rt, host, h, rangeKeys(rows, anchor, next), anchor, next)
        return setMulti(rt, host, h, [rows[next]], next, next)
    if current.length == 0:
        return false
    if let control = list.control:
        if name == "Delete" or name == "Backspace":
            if !control.viewHandles("delete"):
                return false
            mut [string] indices = []
            for i in 0..<rows.length:
                if current.contains(rows[i]):
                    indices.push("{i}")
            return act(rt, host, h, "delete", indices.join(","))
        if control.viewHandles("move") and current.length == 1:
            let at = indexOfKey(rows, current[0])
            var to = at - 1
            if name == "AltDown":
                to = at + 1
            if to < 0 or to >= rows.length:
                return false
            return act(rt, host, h, "move", "{at},{to}")
    false

def int indexOf([Handle] order, Handle h):
    for i in 0..<order.length:
        if order[i].id == h.id:
            return i
    -1

# The first enabled Button inside `n`, or -1.
def int firstButton(Mounted n, bool inherited):
    var off = inherited
    if n.kind == "Disabled" and propOf(n, "value") == "true":
        off = true
    if n.kind == "Button" and !off:
        return n.id
    for c in n.children:
        let r = firstButton(c, off)
        if r >= 0:
            return r
    -1

# The Enter default (the first enabled `DefaultAction` wrapping an enabled Button) or the Escape cancel
# (the first enabled Button with role Cancel), by `cancel`. -1 when there is none.
def int findScopeButton(Mounted n, bool inherited, bool cancel):
    var off = inherited
    if n.kind == "Disabled" and propOf(n, "value") == "true":
        off = true
    if !cancel and n.kind == "DefaultAction" and propOf(n, "enabled") != "false" and !off:
        let r = firstButton(n, off)
        if r >= 0:
            return r
    if cancel and n.kind == "Button" and propOf(n, "role") == "Cancel" and !off:
        return n.id
    for c in n.children:
        let r = findScopeButton(c, off, cancel)
        if r >= 0:
            return r
    -1

# Activates the scope's default / cancel button. A presented sheet is the scope when there is one.
def bool activateScopeButton(mut Runtime rt, Builder host, bool cancel):
    var scope = rt.root
    if rt.openSheets.length > 0:
        scope = rt.find(rt.openSheets[rt.openSheets.length - 1])
    if let top = scope:
        let id = findScopeButton(top, false, cancel)
        if id >= 0:
            if let h = rt.handle(id):
                return act(rt, host, h, "activate", "")
    false

# Keys for a focused text field; false when `name` is not an editing key.
def bool editKey(mut Runtime rt, Builder host, Handle h, string name):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let text = propOf(node, "value")
    let len = text.graphemeCount
    let caret = caretOf(rt, h, len)
    let anchor = anchorOf(rt, h, len, caret)
    var lo = caret
    var hi = anchor
    if anchor < caret:
        lo = anchor
        hi = caret
    let hasSelection = lo != hi
    if name == "Backspace":
        if hasSelection:
            return replaceRange(rt, host, h, node, lo, hi, "")
        if caret > 0:
            return replaceRange(rt, host, h, node, caret - 1, caret, "")
        return true
    if name == "Delete":
        if hasSelection:
            return replaceRange(rt, host, h, node, lo, hi, "")
        if caret < len:
            return replaceRange(rt, host, h, node, caret, caret + 1, "")
        return true
    var moved = caret
    var extend = false
    if name == "Left" or name == "ShiftLeft":
        moved = clampTo(caret - 1, 0, len)
        if name == "Left" and hasSelection:
            moved = lo
        extend = name == "ShiftLeft"
    elif name == "Right" or name == "ShiftRight":
        moved = clampTo(caret + 1, 0, len)
        if name == "Right" and hasSelection:
            moved = hi
        extend = name == "ShiftRight"
    elif name == "Home" or name == "ShiftHome":
        moved = 0
        extend = name == "ShiftHome"
    elif name == "End" or name == "ShiftEnd":
        moved = len
        extend = name == "ShiftEnd"
    elif name == "SelectAll":
        moveCaret(rt, h, len, 0)
        rt.invalidateRoot()
        return true
    else:
        return false
    if extend:
        moveCaret(rt, h, moved, anchor)
    else:
        moveCaret(rt, h, moved, moved)
    rt.invalidateRoot()
    true

# ── input-method composition ──────────────────────────────────────────────────────────────────────

# The platform's IME reports its marked (uncommitted) text and the cursor inside it for the focused text field; an
# empty `marked` ends the composition. The bound value is untouched until `imeCommit`.
pub def bool imeUpdate(mut Runtime rt, Builder host, string marked, int cursor):
    if let f = focusedField(rt):
        if isDisabled(rt, f.id):
            return false
        rt.beginEvent()
        if marked == "":
            rt.composition = nil
        else:
            rt.composition = Composition(node = f.id, text = marked, cursor = cursor)
        rt.invalidateRoot()
        rt.endEvent(host)
        return true
    false

# The composition ends with `text` inserted at the caret (replacing a selection), as one edit.
pub def bool imeCommit(mut Runtime rt, Builder host, string text):
    if let c = rt.composition:
        if let f = focusedField(rt):
            rt.composition = nil
            if f.id == c.node:
                return typeText(rt, host, text)
    false

# The composition is abandoned: nothing is inserted.
pub def bool imeCancel(mut Runtime rt, Builder host):
    if rt.composition == nil:
        return false
    rt.beginEvent()
    rt.composition = nil
    rt.invalidateRoot()
    rt.endEvent(host)
    true

# A key press: Tab / ShiftTab move focus through `focusOrder` (wrapping); Escape activates the Cancel
# button; Enter submits a TextField that has `onSubmit`, else activates the focused Button or the
# default action; Space activates / toggles the focused control; editing keys edit the focused
# TextField. Returns whether the key was used.
pub def bool keyPress(mut Runtime rt, Builder host, string name):
    if name == "Escape":
        if let d = rt.drag:
            if d.active:
                dragEnd(rt, host, Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0), 0.0, 0.0, false)
                return true
    if rt.keyObservers.length == 0:
        return defaultKey(rt, host, name)
    var target = -1
    if let f = rt.focus:
        if rt.valid(f):
            target = f.id
    let path = rt.idPath(target)
    var stopped = false
    var prevented = false
    # capture: root toward the target
    for id in path:
        let r = observed(rt, id, true, KeyEvent(key = name, target = target), stopped)
        if r.stop:
            stopped = true
        if r.prevent:
            prevented = true
    # target: the component's own behaviour, unless some capture observer suppressed it
    var handled = prevented
    if !prevented:
        handled = defaultKey(rt, host, name)
    # bubble: the target toward the root, seeing whether the default consumed the key
    var i = path.length - 1
    while i >= 0:
        let r = observed(rt, path[i], false, KeyEvent(key = name, target = target, handled = handled), stopped)
        if r.stop:
            stopped = true
        i -= 1
    handled

# What node `id`'s observers of one phase decided, in registration order; nothing once propagation was stopped.
# A throwing observer is reported (kind "callback", source "key") and counts as no answer.
def KeyResponse observed(mut Runtime rt, int id, bool capture, KeyEvent seen, bool stopped):
    if stopped:
        return KeyResponse()
    var stop = false
    var prevent = false
    let registered = rt.keyObservers
    for o in registered:
        if stop or o.node != id or o.capture != capture:
            continue
        if !rt.valid(Handle(id = o.node, generation = o.generation)):
            continue
        mut ev = KeyEvent(key = seen.key, target = seen.target, handled = seen.handled)
        try:
            o.handler.onKey(ev)
            if ev.stop:
                stop = true
            if ev.prevent:
                prevent = true
        catch:
            rt.reportFailure("callback", "key", "{error}", id)
    KeyResponse(stop = stop, prevent = prevent)

# The target's default behaviour for a key (everything `keyPress` did before observers existed).
def bool defaultKey(mut Runtime rt, Builder host, string name):
    # While an input method composes, Enter and Escape belong to it (commit as typed / cancel) and the editing keys do
    # not touch the committed text: the IME owns them until the composition ends.
    if let c = rt.composition:
        if name == "Enter":
            return imeCommit(rt, host, c.text)
        if name == "Escape":
            return imeCancel(rt, host)
        if name == "Backspace" or name == "Delete" or name == "Left" or name == "Right" or name == "Home" or name == "End":
            return true
    let order = focusOrder(rt)
    if name == "Undo":
        return undo(rt, host)
    if name == "Redo":
        return redo(rt, host)
    if name == "Tab" or name == "ShiftTab":
        if order.length == 0:
            return false
        var at = -1
        if let f = rt.focus:
            at = indexOf(order, f)
        var next = 0
        if name == "Tab":
            next = (at + 1) % order.length
        else:
            next = (at - 1 + order.length) % order.length
            if at < 0:
                next = order.length - 1
        focusControl(rt, host, order[next])
        return true
    if name == "Escape":
        if activateScopeButton(rt, host, true):
            return true
        # No Cancel button: the presented sheet performs its ordinary dismissal (writes `false`).
        if rt.openSheets.length > 0:
            if let h = rt.handle(rt.openSheets[rt.openSheets.length - 1]):
                return act(rt, host, h, "dismiss", "")
        let popovers = rt.presentedPopovers()
        if popovers.length > 0:
            if let h = rt.handle(popovers[popovers.length - 1]):
                return act(rt, host, h, "dismiss", "")
        return false
    if let f = rt.focus:
        if rt.valid(f) and !isDisabled(rt, f.id):
            if let node = rt.find(f.id):
                if node.kind == "TextField":
                    if editKey(rt, host, f, name):
                        return true
                    if name == "Enter":
                        if let control = node.control:
                            if control.viewHandles("submit"):
                                return act(rt, host, f, "submit", "")
                if node.kind == "Slider":
                    if sliderKey(rt, host, f, name):
                        return true
                if node.kind == "Button" and (name == "Enter" or name == "Space"):
                    return act(rt, host, f, "activate", "")
                if node.kind == "Toggle" and name == "Space":
                    return act(rt, host, f, "toggle", "")
    if name == "Up" or name == "Down" or name == "Delete" or name == "Backspace" or name == "AltUp" or name == "AltDown" or name == "ShiftUp" or name == "ShiftDown" or name == "SelectAll":
        if listKey(rt, host, name):
            return true
    if name == "Enter":
        return activateScopeButton(rt, host, false)
    false

# Text input for the focused TextField: replaces the selection (or inserts at the caret).
pub def bool typeText(mut Runtime rt, Builder host, string s):
    if let f = focusedField(rt):
        if isDisabled(rt, f.id):
            return false
        let node = rt.find(f.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
        let len = propOf(node, "value").graphemeCount
        let caret = caretOf(rt, f, len)
        let anchor = anchorOf(rt, f, len, caret)
        var lo = caret
        var hi = anchor
        if anchor < caret:
            lo = anchor
            hi = caret
        return replaceRange(rt, host, f, node, lo, hi, s)
    false

def Placed? findPlaced(Placed p, int id):
    if p.id == id:
        return p
    for c in p.children:
        if let hit = findPlaced(c, id):
            return hit
    nil

def float numOf(Placed p, string key):
    if let s = p.props[key]:
        return s.parseFloat() else (0.0)
    0.0

# ── programmatic scrolling ──────────────────────────────────────────────────────────────────────
# `Scroll(anchor = name, request = n)` scrolls so the `ScrollAnchor(name = name)` below it sits at the viewport's leading edge, as far as the
# content allows. It is request-driven: a request above zero that differs from the last one applied to that scroller (the node's generation,
# the anchor and the request) is applied once; bump `request` to scroll to the same anchor again. A request whose anchor is not laid
# out (yet) stays pending. The host calls `applyScrollRequests` after an update with the laid-out window, like `revealFocus`.

# The first `ScrollAnchor` called `name` in the subtree of `p`.
def Placed? anchorIn(Placed p, string name):
    if p.kind == "ScrollAnchor" and (p.props["name"] else ("")) == name:
        return p
    for c in p.children:
        if let found = anchorIn(c, name):
            return found
    nil

def void scrollRequestsIn(Placed p, mut [Placed] out):
    if p.kind == "Scroll" and (p.props["anchor"] else ("")) != "" and numOf(p, "request") > 0.0:
        out.push(p)
    for c in p.children:
        scrollRequestsIn(c, out)

# Applies the pending requests of every `Scroll` of the laid-out window `placed`. Returns whether any offset moved (the window must be laid out again).
pub def bool applyScrollRequests(mut Runtime rt, Builder host, Placed placed):
    mut pending = [] as [Placed]
    scrollRequestsIn(placed, pending)
    var moved = false
    for v in pending:
        if let node = rt.find(v.id):
            let name = v.props["anchor"] else ("")
            let stamp = "{node.generation}|{name}|{numOf(v, "request")}"
            if (rt.scrollApplied[v.id] else ("")) != stamp:
                if let a = anchorIn(v, name):
                    rt.scrollApplied[v.id] = stamp
                    let vertical = (v.props["axis"] else ("Vertical")) == "Vertical"
                    var delta = a.x - v.x
                    if vertical:
                        delta = a.y - v.y
                    let current = numOf(v, "scroll")
                    var target = current + delta
                    if target < 0.0:
                        target = 0.0
                    let most = numOf(v, "scrollMax")
                    if target > most:
                        target = most
                    let glides = (v.props["animated"] else ("false")) == "true"
                    if glides:
                        if let h = rt.handle(v.id):
                            rt.glide = Glide(node = h.id, generation = h.generation, target = target)
                    if !glides and target != current:
                        rt.beginEvent()
                        _ = rt.scrollTo(v.id, target)
                        rt.invalidateRoot()
                        rt.endEvent(host)
                        moved = true
    moved

pub def bool glideActive(Runtime rt):
    rt.glide != nil

# Advances a programmatic `animated` scroll by `dt` seconds: the remaining distance shrinks by a factor of 1/1000 per 0.4 s (ease-out, frame-rate
# independent) and it lands on the target within half a pixel. Returns whether it is still running (the host schedules another frame).
pub def bool stepGlide(mut Runtime rt, Builder host, Placed placed, float dt):
    let running = rt.glide
    guard let g = running else:
        return false
    guard let h = rt.handle(g.node) else:
        rt.glide = nil
        return false
    guard let node = findPlaced(placed, g.node) else:
        rt.glide = nil
        return false
    if h.generation != g.generation:
        rt.glide = nil
        return false
    let at = numOf(node, "scroll")
    var most = numOf(node, "scrollMax")
    var target = g.target
    if target > most:
        target = most
    var left = target - at
    var pos = target
    var alive = false
    if left > 0.5 or left < -0.5:
        let keep = pow(0.001, dt / 0.4)
        left = left * keep
        pos = target - left
        alive = left > 0.5 or left < -0.5
        if !alive:
            pos = target
    if pos != at:
        rt.beginEvent()
        _ = rt.scrollTo(g.node, pos)
        rt.invalidateRoot()
        rt.endEvent(host)
    if !alive:
        rt.glide = nil
    alive

# ── retiring phase ──────────────────────────────────────────────────────────────────────────────
# A subtree removed under an animated `Transition` stays mounted but frozen until its removal finishes. The host
# reports that — typically when the animator's `takeCompletion` fires — and the hooks, slots and ids go. `ids` are
# the mounted ids of the retired `Transition` nodes (`retiringIds`); `endRetirements(rt, host)` is the forced teardown
# (window close, shutdown) that skips what remains of the animation.

pub def [int] retiringIds(Runtime rt):
    mut [int] out = []
    for r in rt.retired:
        out.push(r.node.id)
    out

pub def int endRetirement(mut Runtime rt, Builder host, int id):
    rt.beginEvent()
    let n = rt.finishRetired(id, false)
    rt.invalidateRoot()
    rt.endEvent(host)
    n

pub def int endRetirements(mut Runtime rt, Builder host):
    rt.beginEvent()
    let n = rt.finishRetired(-1, true)
    rt.invalidateRoot()
    rt.endEvent(host)
    n

# ── scroll-into-view on focus ─────────────────────────────────────────────────────────────────
# Moving focus to a descendant outside a scroll viewport scrolls the minimum needed to reveal its layout bounds
# (draft, "Scroll"): innermost scroller first, each later one seeing the node where the earlier scrolls left it. A
# host calls `revealFocus` after a focus change with the laid-out window.

def bool placedPath(Placed p, int id, mut [Placed] out):
    out.push(p)
    if p.id == id:
        return true
    for c in p.children:
        if placedPath(c, id, out):
            return true
    _ = out.pop()
    false

# The id of the focused node, -1 when nothing (valid) is focused.
def int liveFocusId(Runtime rt):
    if let f = rt.focus:
        if rt.valid(f):
            return f.id
    -1

# Scrolls every ancestor viewport of the focused control just enough to show it. Returns whether any offset moved.
pub def bool revealFocus(mut Runtime rt, Builder host, Placed placed):
    let focused = liveFocusId(rt)
    if focused < 0:
        return false
    mut [Placed] chain = []
    if !placedPath(placed, focused, chain):
        return false
    var top = chain[chain.length - 1].y
    var left = chain[chain.length - 1].x
    let height = chain[chain.length - 1].h
    let width = chain[chain.length - 1].w
    var moved = false
    var i = chain.length - 2
    while i >= 0:
        let v = chain[i]
        if v.kind == "Scroll" or v.kind == "List" or v.kind == "MultiList":
            let vertical = (v.props["axis"] else ("Vertical")) == "Vertical"
            var delta = 0.0
            if vertical:
                if top < v.y:
                    delta = top - v.y
                elif top + height > v.y + v.h:
                    delta = top + height - (v.y + v.h)
                    if height > v.h:
                        delta = top - v.y
            else:
                if left < v.x:
                    delta = left - v.x
                elif left + width > v.x + v.w:
                    delta = left + width - (v.x + v.w)
                    if width > v.w:
                        delta = left - v.x
            if delta != 0.0:
                let current = numOf(v, "scroll")
                let most = numOf(v, "scrollMax")
                var target = current + delta
                if target < 0.0:
                    target = 0.0
                if target > most:
                    target = most
                let used = target - current
                if used != 0.0:
                    rt.beginEvent()
                    _ = rt.scrollTo(v.id, target)
                    rt.invalidateRoot()
                    rt.endEvent(host)
                    moved = true
                    if vertical:
                        top -= used
                    else:
                        left -= used
        i -= 1
    moved

# ── momentum scrolling ────────────────────────────────────────────────────────────────────────
# A touch drag or trackpad swipe that ends with velocity (vx, vy) in pixels per second hands off to inertia:
# `fling` picks the deepest scroller under the pointer that can still move that way, then the host calls
# `stepMomentum` once per platform frame with the elapsed seconds (each call is one event transaction). Friction
# multiplies the velocity by 0.95 every 1/60 s; inertia ends below 20 px/s or at an edge, and any new wheel, press
# or scroll input cancels it.

def float frictionPerTick():
    0.95

pub def bool fling(mut Runtime rt, Placed placed, float x, float y, float vx, float vy):
    rt.momentum = nil
    rt.glide = nil
    let path = hitTest(placed, x, y)
    var i = path.length - 1
    while i >= 0:
        if let node = findPlaced(placed, path[i]):
            if node.kind == "Scroll" or node.kind == "List" or node.kind == "MultiList":
                let vertical = (node.props["axis"] else ("Vertical")) == "Vertical"
                var v = vx
                if vertical:
                    v = vy
                let at = numOf(node, "scroll")
                let most = numOf(node, "scrollMax")
                if (v > 0.0 and at < most) or (v < 0.0 and at > 0.0):
                    if let h = rt.handle(node.id):
                        rt.momentum = Momentum(node = h.id, generation = h.generation, vertical = vertical, velocity = v)
                        return true
        i -= 1
    false

pub def bool momentumActive(Runtime rt):
    rt.momentum != nil

pub def void cancelMomentum(mut Runtime rt):
    rt.momentum = nil
    rt.glide = nil

# Advances inertia by `dt` seconds. Returns whether it is still running (the host schedules another frame).
pub def bool stepMomentum(mut Runtime rt, Builder host, Placed placed, float dt):
    let running = rt.momentum
    guard let m = running else:
        return false
    guard let h = rt.handle(m.node) else:
        rt.momentum = nil
        return false
    if h.generation != m.generation:
        rt.momentum = nil
        return false
    guard let node = findPlaced(placed, m.node) else:
        rt.momentum = nil
        return false
    let start = numOf(node, "scroll")
    let most = numOf(node, "scrollMax")
    var pos = start
    var v = m.velocity
    var ticks = (dt * 60.0 + 0.5) as int
    if ticks < 1:
        ticks = 1
    var alive = true
    var t = 0
    while t < ticks and alive:
        v = v * frictionPerTick()
        pos = pos + v / 60.0
        if pos <= 0.0:
            pos = 0.0
            alive = false
        if pos >= most:
            pos = most
            alive = false
        if v < 20.0 and v > -20.0:
            alive = false
        t += 1
    if pos != start:
        rt.beginEvent()
        _ = rt.scrollTo(m.node, pos)
        rt.invalidateRoot()
        rt.endEvent(host)
    if alive:
        rt.momentum = Momentum(node = m.node, generation = m.generation, vertical = m.vertical, velocity = v)
    else:
        rt.momentum = nil
    alive

# ── touch gestures ────────────────────────────────────────────────────────────────────────────
# A finger as a host reports it: `touchDown` / `touchMove` / `touchUp` with the position and a timestamp in seconds. A finger
# that stays within `slop` pixels is a tap (a press and release at its start). One that moves further is a drag: the
# deepest scroller under where it started follows it (the content tracks the finger, so the offset moves opposite), the
# velocity is smoothed over the last frames, and lifting the finger hands that velocity to `fling` so the content
# keeps going and slows down (`stepMomentum`). Any new touch stops the inertia.

def float touchSlop():
    8.0

# The finger's velocity is considered lost when the last movement is older than this (a held finger does not fling).
def float flingWindow():
    0.1

pub def bool touchDown(mut Runtime rt, Builder host, Placed placed, float x, float y, float t):
    rt.momentum = nil
    rt.glide = nil
    rt.gesture = TouchGesture(startX = x, startY = y, lastX = x, lastY = y, lastT = t)
    rt.nowMs = t * 1000.0
    rt.press = nil
    beginPress(rt, hitTest(placed, x, y), x, y)
    true

pub def bool touchMove(mut Runtime rt, Builder host, Placed placed, float x, float y, float t):
    let current = rt.gesture
    guard let g = current else:
        return false
    markPressMoved(rt, x, y)
    var dragging = g.dragging
    if !dragging:
        let dx0 = x - g.startX
        let dy0 = y - g.startY
        if dx0 * dx0 + dy0 * dy0 > touchSlop() * touchSlop():
            dragging = true
    if !dragging:
        return false
    let dx = x - g.lastX
    let dy = y - g.lastY
    var vx = g.vx
    var vy = g.vy
    let dt = t - g.lastT
    if dt > 0.0:
        # an exponential blend: recent frames count most, one jittery frame does not decide the fling
        vx = 0.7 * (dx / dt) + 0.3 * vx
        vy = 0.7 * (dy / dt) + 0.3 * vy
    rt.gesture = TouchGesture(startX = g.startX, startY = g.startY, lastX = x, lastY = y, lastT = t, vx = vx, vy = vy, dragging = true)
    # the content follows the finger: the scroll offset moves the other way
    scrollBy(rt, host, placed, g.startX, g.startY, 0.0 - dx, 0.0 - dy)

pub def bool touchUp(mut Runtime rt, Builder host, Placed placed, float x, float y, float t):
    let current = rt.gesture
    guard let g = current else:
        return false
    rt.gesture = nil
    if !g.dragging:
        # a long press already ran: its lift is not a tap
        var spent = false
        let held = rt.press
        if let p = held:
            spent = p.longFired
        if spent:
            rt.press = nil
            return true
        _ = pointerDown(rt, host, placed, g.startX, g.startY)
        return pointerUp(rt, host, placed, g.startX, g.startY)
    _ = gestureUp(rt, host, x, y)
    if t - g.lastT > flingWindow():
        return true
    fling(rt, placed, g.startX, g.startY, 0.0 - g.vx, 0.0 - g.vy)

# The platform cancelled the touch (a call, the window lost): nothing is pressed, nothing flings.
pub def void touchCancel(mut Runtime rt):
    rt.press = nil
    rt.gesture = nil

# Wheel / trackpad input: the delta (dx, dy) at (x, y) of the laid-out window `placed`. The deepest
# `Scroll` under the pointer consumes what it can apply on its own axis (clamped to its content); the
# remainder bubbles to the next ancestor scrolling the same axis. Each consumed share is one event
# transaction. Returns whether any offset moved.
pub def bool scrollBy(mut Runtime rt, Builder host, Placed placed, float x, float y, float dx, float dy):
    rt.momentum = nil
    rt.glide = nil
    let path = hitTest(placed, x, y)
    var restX = dx
    var restY = dy
    var moved = false
    var i = path.length - 1
    while i >= 0:
        if let node = findPlaced(placed, path[i]):
            if node.kind == "Scroll" or (node.kind == "List" or node.kind == "MultiList"):
                let vertical = (node.props["axis"] else ("Vertical")) == "Vertical"
                var want = restX
                if vertical:
                    want = restY
                let current = numOf(node, "scroll")
                let most = numOf(node, "scrollMax")
                var target = current + want
                if target < 0.0:
                    target = 0.0
                if target > most:
                    target = most
                let used = target - current
                if used != 0.0:
                    rt.beginEvent()
                    _ = rt.scrollTo(node.id, target)
                    rt.invalidateRoot()
                    rt.endEvent(host)
                    moved = true
                    if vertical:
                        restY -= used
                    else:
                        restX -= used
        i -= 1
    moved
