# boring-ui headless event dispatch and keyboard focus (docs/design-notes/boring-ui-draft.md,
# "UI events and batched refresh", "Event dispatch, capture, and errors", "Focus"). Layer 4, first
# slice. Physical input — a pointer press, a key — is turned into SEMANTIC ACTIONS on a control
# ("activate", "toggle", "setText"); a semantic action from an accessibility client takes exactly the
# same path (`act`). Every action runs inside one event transaction: the control's callback or
# bound-slot write happens, the window is invalidated, and ONE update pass runs when the outermost
# event ends.
#
# Controls: `Button` (activate), `Toggle` (toggle its bound bool), `TextField` (focus; text via
# `typeText`). Keyboard focus is generation-checked, kept on the `Runtime`, and cleared when the
# focused node unmounts.
#
# Scroll input (`scrollBy`) moves the `Scroll` offsets kept on the mounted nodes.
#
# Not here yet: pointer release / capture / cancel, key capture-target-bubble phases, disabled
# state, modal routing, focus rings and `.focused` bindings, caret/selection/IME, momentum,
# scroll-into-view on focus, focus restoration, error reporting from callbacks.

# boring-ui headless event dispatch and keyboard focus (docs/design-notes/boring-ui-draft.md,
# "UI events and batched refresh", "Event dispatch, capture, and errors", "Button", "TextField",
# "Focus"). Layer 4. Physical input — a pointer press, a key — is turned into SEMANTIC ACTIONS on a
# control ("activate", "toggle", "setText", "submit"); a semantic action from an accessibility client
# takes exactly the same path (`act`). Every action runs inside one event transaction: the control's
# callback or bound-slot write happens, the window is invalidated, and ONE update pass runs when the
# outermost event ends.
#
# Pointer: `pointerDown` focuses the deepest enabled control under the pointer and CAPTURES it;
# `pointerUp` activates a Button / toggles a Toggle only when released over the captured control
# (released elsewhere is a cancel); `pointerCancel` drops the capture; `click` is down + up in place.
# Disabled: a control inside a `Disabled` subtree takes no focus, no capture, no action.
# Keys: Tab / ShiftTab traverse the enabled focus order; Space / Enter activate a focused Button,
# Space toggles a focused Toggle; Enter on a TextField with `onSubmit` submits, otherwise the nearest
# `DefaultAction` button activates; Escape activates the first enabled `Cancel` button. A focused
# TextField edits with `typeText` and the keys Backspace, Delete, Left, Right, Home, End (and the
# Shift variants), SelectAll; caret and selection are mounted control state, counted in grapheme clusters
# (a caret never splits a cluster; widths are `displayWidth` cells).
# Scroll input (`scrollBy`) moves the `Scroll` offsets kept on the mounted nodes.
#
# Not here yet: IME / composition, undo, key capture-target-bubble phases, modal routing, focus rings
# and `.focused` bindings, focus scopes, `List`/`Sheet`, momentum, scroll-into-view on focus, error
# reporting from callbacks.

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*

def string propOf(Mounted n, string name):
    n.props[name] else ("")

def bool isFocusable(string kind):
    isFocusableKind(kind)

# ── disabled state ─────────────────────────────────────────────────────────────────────────────

pub def bool isDisabled(Runtime rt, int id):
    rt.disabledAt(id)

# The enabled focusable controls in structural (tab) order — inside the topmost presented sheet when there
# is one (a modal scope traps traversal).
pub def [Handle] focusOrder(Runtime rt):
    if rt.openSheets.length > 0:
        if let top = rt.find(rt.openSheets[rt.openSheets.length - 1]):
            return scopedOrder(rt, top)
    if let r = rt.root:
        return scopedOrder(rt, r)
    []

# Traversal below `scope`: when the focus sits inside a trapping `FocusScope`, Tab wraps within it.
def [Handle] scopedOrder(Runtime rt, Mounted scope):
    if let f = rt.focus:
        let Mounted? none = nil
        if let trap = trapScopeOf(scope, f.id, none):
            return focusablesIn(trap, false)
    focusablesIn(scope, false)

# ── directional navigation ────────────────────────────────────────────────────────────────────
# Arrow keys move focus geometrically (draft, "Focus scopes and traversal"): the current `FocusSection` is
# searched first; if it holds no candidate (or there is none), the active scope is, where each section is
# one box (its placed bounds) and the winning section then picks its own control by the same rule.
# Candidates lie in the requested half-plane; the winner minimizes main-axis distance, then cross-axis
# distance, then traversal order. A host sends arrows here (`navigate`) unless a focused TextField consumed
# them as caret movement.

# One candidate target: a control (`section` -1) or a whole section, with its placed rectangle.
struct Cand:
    int id
    int section
    float x
    float y
    float w
    float h

def void collectRects(Placed p, mut {int=[float]} out):
    out[p.id] = [p.x, p.y, p.w, p.h]
    for c in p.children:
        collectRects(c, out)

def Cand candOf(int id, int section, {int=[float]} rects):
    let r = rects[id] else ([0.0, 0.0, 0.0, 0.0])
    Cand(id = id, section = section, x = r[0], y = r[1], w = r[2], h = r[3])

# The index of the best candidate from `origin` towards `dir` ("Left", "Right", "Up", "Down"), or -1.
def int pickBest(Cand origin, string dir, [Cand] cands):
    let fcx = origin.x + origin.w / 2.0
    let fcy = origin.y + origin.h / 2.0
    var best = -1
    var bestMain = 0.0
    var bestCross = 0.0
    for i in 0..<cands.length:
        let c = cands[i]
        let ccx = c.x + c.w / 2.0
        let ccy = c.y + c.h / 2.0
        var inPlane = false
        var main = 0.0
        var cross = 0.0
        if dir == "Right":
            inPlane = ccx > fcx
            main = c.x - (origin.x + origin.w)
            cross = ccy - fcy
        if dir == "Left":
            inPlane = ccx < fcx
            main = origin.x - (c.x + c.w)
            cross = ccy - fcy
        if dir == "Down":
            inPlane = ccy > fcy
            main = c.y - (origin.y + origin.h)
            cross = ccx - fcx
        if dir == "Up":
            inPlane = ccy < fcy
            main = origin.y - (c.y + c.h)
            cross = ccx - fcx
        if !inPlane:
            continue
        if main < 0.0:
            main = 0.0
        if cross < 0.0:
            cross = 0.0 - cross
        if best < 0 or main < bestMain or (main == bestMain and cross < bestCross):
            best = i
            bestMain = main
            bestCross = cross
    best

def [Cand] controlCands([Handle] hs, int skip, {int=[float]} rects):
    mut [Cand] out = []
    for h in hs:
        if h.id != skip:
            out.push(candOf(h.id, -1, rects))
    out

# Moves focus one step in direction `dir` ("Left"/"Right"/"Up"/"Down"), using the laid-out `placed` tree for
# geometry. Returns false when nothing lies that way (focus stays). With no focus yet, the first control gets it.
pub def bool navigate(mut Runtime rt, Builder host, Placed placed, string dir):
    let order = focusOrder(rt)
    if order.length == 0:
        return false
    var current = -1
    if let f = rt.focus:
        if rt.valid(f):
            for h in order:
                if h.id == f.id:
                    current = f.id
    if current < 0:
        focusControl(rt, host, order[0])
        return true
    mut {int=[float]} rects = {=}
    collectRects(placed, rects)
    guard let scope = activeScope(rt) else:
        return false
    let Mounted? none = nil
    let innerSec = sectionOf(scope, current, none, true)
    if let sec = innerSec:
        let inside = controlCands(focusablesIn(sec, false), current, rects)
        let hit = pickBest(candOf(current, -1, rects), dir, inside)
        if hit >= 0:
            focusControl(rt, host, handleOf(rt, inside[hit].id))
            return true
    # Between sections: every control outside any section is a unit, every outermost section one box.
    let outerSec = sectionOf(scope, current, none, false)
    var skipSection = -1
    var origin = candOf(current, -1, rects)
    if let o = outerSec:
        skipSection = o.id
        origin = candOf(o.id, -1, rects)
    mut [Cand] units = []
    mut {int} seen = {}
    for h in order:
        if h.id == current:
            continue
        let s = sectionOf(scope, h.id, none, false)
        if let sec = s:
            if sec.id != skipSection and !seen.contains(sec.id):
                _ = seen.add(sec.id)
                units.push(candOf(sec.id, sec.id, rects))
        else:
            units.push(candOf(h.id, -1, rects))
    let pick = pickBest(origin, dir, units)
    if pick < 0:
        return false
    let unit = units[pick]
    if unit.section < 0:
        focusControl(rt, host, handleOf(rt, unit.id))
        return true
    guard let target = rt.find(unit.section) else:
        return false
    let members = focusablesIn(target, false)
    if members.length == 0:
        return false
    let inner = controlCands(members, -1, rects)
    var at = pickBest(candOf(current, -1, rects), dir, inner)
    if at < 0:
        at = 0
    focusControl(rt, host, handleOf(rt, inner[at].id))
    true

def Handle handleOf(Runtime rt, int id):
    rt.handle(id) else (Handle(id = -1, generation = -1))

# The scope traversal currently runs in: the trapping scope holding the focus, else the topmost presented
# sheet, else the window.
def Mounted? activeScope(Runtime rt):
    var Mounted? base = nil
    if rt.openSheets.length > 0:
        base = rt.find(rt.openSheets[rt.openSheets.length - 1])
    else:
        base = rt.root
    if let b = base:
        if let f = rt.focus:
            let Mounted? none = nil
            if let trap = trapScopeOf(b, f.id, none):
                return trap
        return b
    nil

pub def void setFocus(mut Runtime rt, Handle h):
    if rt.valid(h):
        rt.focus = h

# Moves keyboard focus to `h` as one event, so `.focused(...)` bindings are synchronized in the same
# transaction (the previous control's binding goes off, this one's on).
pub def void focusControl(mut Runtime rt, Builder host, Handle h):
    if rt.valid(h):
        rt.focus = h
        rt.beginEvent()
        rt.invalidateRoot()
        rt.endEvent(host)

# Delivers a semantic action to the control behind `h`, as one event transaction. Returns false for
# a stale handle, a disabled control or a node that is not a native control.
pub def bool act(mut Runtime rt, Builder host, Handle h, string action, string arg):
    if !rt.valid(h):
        return false
    if isDisabled(rt, h.id):
        return false
    let found = rt.find(h.id)
    if found == nil:
        return false
    let node = found else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    if node.kind == "Slider" and (action == "increment" or action == "decrement"):
        var steps = 1
        if action == "decrement":
            steps = -1
        return adjustSlider(rt, host, h, steps)
    if let control = node.control:
        rt.beginEvent()
        let before = rt.sink.reports
        try:
            control.viewAct(action, arg)
        catch:
            rt.reportFailure("callback", action, "{error}", node.id)
        rt.settle(before)
        rt.endEvent(host)
        return true
    false

def Handle? handleFor(Runtime rt, int id):
    rt.handle(id)

# ── text editing state (caret and selection are mounted control state) ──────────────────────────────

def int clampTo(int v, int lo, int hi):
    if v < lo:
        return lo
    if v > hi:
        return hi
    v

# The caret index (stored, or the end of the text for a field nobody has edited yet).
def int caretOf(Runtime rt, Handle h, int len):
    let c = rt.read(h, "caret") else (-1)
    if c < 0 or c > len:
        return len
    c

# The selection anchor (equal to the caret when nothing is selected).
def int anchorOf(Runtime rt, Handle h, int len, int caret):
    let a = rt.read(h, "anchor") else (-1)
    if a < 0 or a > len:
        return caret
    a

# `[caret, anchor]` of a text field as the tests and the semantic layer read them.
pub def [int] selectionOf(Runtime rt, Handle h):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let len = propOf(node, "value").graphemeCount
    let caret = caretOf(rt, h, len)
    [caret, anchorOf(rt, h, len, caret)]

def void moveCaret(mut Runtime rt, Handle h, int caret, int anchor):
    _ = rt.write(h, "caret", caret)
    _ = rt.write(h, "anchor", anchor)

# Replaces the text between `a` and `b` with `insert`, leaving the caret after it, as one event.
def bool replaceRange(mut Runtime rt, Builder host, Handle h, Mounted node, int a, int b, string insert):
    let text = propOf(node, "value")
    let len = text.graphemeCount
    let next = "{text.graphemeSlice(0, a)}{insert}{text.graphemeSlice(b, len)}"
    moveCaret(rt, h, a + insert.graphemeCount, a + insert.graphemeCount)
    act(rt, host, h, "setText", next)

def Handle? focusedField(Runtime rt):
    if let f = rt.focus:
        if rt.valid(f):
            if let node = rt.find(f.id):
                if node.kind == "TextField":
                    return f
    nil

# ── pointer ───────────────────────────────────────────────────────────────────────────────────

# A pointer press at (x, y) of the laid-out window `placed`: the deepest enabled control on the hit path
# takes focus and captures the pointer (a TextField also places its caret). Nothing activates yet — that
# happens on release over the same control. Returns whether a control was hit.
pub def bool pointerDown(mut Runtime rt, Builder host, Placed placed, float x, float y):
    let path = hitTest(placed, x, y)
    var i = path.length - 1
    while i >= 0:
        let id = path[i]
        if let node = rt.find(id):
            if isFocusable(node.kind) and !isDisabled(rt, id):
                let h = Handle(id = node.id, generation = node.generation)
                focusControl(rt, host, h)
                rt.capture = h
                if node.kind == "Slider":
                    if let at = findPlaced(placed, id):
                        _ = setSliderFromPointer(rt, host, h, at, x)
                if node.kind == "TextField":
                    if let at = findPlaced(placed, id):
                        let cells = (x - at.x - 4.0) / (at.theme.fontSizeNamed("Body") / 2.0)
                        let caret = graphemeAtCells(propOf(node, "value"), cells)
                        moveCaret(rt, h, caret, caret)
                        rt.invalidateRoot()
                return true
        i -= 1
    selectRowAt(rt, host, placed, path)

# ── sliders ────────────────────────────────────────────────────────────────────────────────────

def float sliderNumber(Mounted n, string key, float fallback):
    let text = n.props[key] else ("")
    if text == "":
        return fallback
    text.parseFloat() else (fallback)

# The distance one arrow-key press moves a slider: its `step`, or a twentieth of its range.
def float sliderStepOf(Mounted n):
    let low = sliderNumber(n, "min", 0.0)
    let high = sliderNumber(n, "max", 1.0)
    let explicit = sliderNumber(n, "step", 0.0)
    if explicit > 0.0:
        return explicit
    (high - low) / 20.0

# Sets a slider to `v`: clamped to its range and rounded to the nearest step, delivered as one event.
pub def bool setSlider(mut Runtime rt, Builder host, Handle h, float v):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    if node.kind != "Slider":
        return false
    let low = sliderNumber(node, "min", 0.0)
    let high = sliderNumber(node, "max", 1.0)
    var next = v
    let explicit = sliderNumber(node, "step", 0.0)
    if explicit > 0.0:
        let count = ((next - low) / explicit + 0.5) as int
        next = low + (count as float) * explicit
    if next < low:
        next = low
    if next > high:
        next = high
    act(rt, host, h, "setFloat", "{next}")

# Moves a slider by `steps` steps (negative = down).
pub def bool adjustSlider(mut Runtime rt, Builder host, Handle h, int steps):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let current = sliderNumber(node, "value", 0.0)
    setSlider(rt, host, h, current + (steps as float) * sliderStepOf(node))

def bool setSliderFromPointer(mut Runtime rt, Builder host, Handle h, Placed at, float x):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let low = sliderNumber(node, "min", 0.0)
    let high = sliderNumber(node, "max", 1.0)
    var frac = 0.0
    if at.w > 0.0:
        frac = (x - at.x) / at.w
    if frac < 0.0:
        frac = 0.0
    if frac > 1.0:
        frac = 1.0
    setSlider(rt, host, h, low + frac * (high - low))

# Slider keys: Left / Down and Right / Up move one step, PageDown / PageUp ten, Home / End jump to the ends.
def bool sliderKey(mut Runtime rt, Builder host, Handle h, string name):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    if name == "Left" or name == "Down":
        return adjustSlider(rt, host, h, -1)
    if name == "Right" or name == "Up":
        return adjustSlider(rt, host, h, 1)
    if name == "PageDown":
        return adjustSlider(rt, host, h, -10)
    if name == "PageUp":
        return adjustSlider(rt, host, h, 10)
    if name == "Home":
        return setSlider(rt, host, h, sliderNumber(node, "min", 0.0))
    if name == "End":
        return setSlider(rt, host, h, sliderNumber(node, "max", 1.0))
    false

# While the pointer is captured by a slider, moving it (even outside the slider) drags the value.
pub def bool pointerMove(mut Runtime rt, Builder host, Placed placed, float x, float y):
    if let cap = rt.capture:
        if rt.valid(cap):
            if let node = rt.find(cap.id):
                if node.kind == "Slider":
                    if let at = findPlaced(placed, cap.id):
                        return setSliderFromPointer(rt, host, cap, at, x)
    false

# A pointer release: a Button activates and a Toggle toggles only when the pointer is still over the
# control that captured it; released anywhere else it is a cancel. The capture always ends.
pub def bool pointerUp(mut Runtime rt, Builder host, Placed placed, float x, float y):
    let held = rt.capture
    rt.capture = nil
    if held == nil:
        return false
    let h = held else (Handle(id = -1, generation = -1))
    if !rt.valid(h):
        return false
    # A drag on a slider simply ends wherever the pointer is released.
    if let held = rt.find(h.id):
        if held.kind == "Slider":
            return true
    let path = hitTest(placed, x, y)
    if !path.contains(h.id):
        return false
    if let node = rt.find(h.id):
        if node.kind == "Button":
            return act(rt, host, h, "activate", "")
        if node.kind == "Toggle":
            return act(rt, host, h, "toggle", "")
        return true
    false

# The platform cancelled the pointer (window lost, modal opened): the capture ends, nothing happens.
pub def void pointerCancel(mut Runtime rt):
    rt.capture = nil

# A press and release at the same point.
pub def bool click(mut Runtime rt, Builder host, Placed placed, float x, float y):
    if !pointerDown(rt, host, placed, x, y):
        return false
    # A press that captured nothing (a list row selected on press) has no release to deliver.
    if rt.capture == nil:
        return true
    pointerUp(rt, host, placed, x, y)

# ── keyboard ──────────────────────────────────────────────────────────────────────────────────

# A press that hit no control but a row of a `List` selects that row (by its key).
def bool selectRowAt(mut Runtime rt, Builder host, Placed placed, [int] path):
    var listId = -1
    var rowKey = ""
    for id in path:
        if let node = findPlaced(placed, id):
            if node.kind == "List":
                listId = id
                rowKey = ""
            elif listId >= 0 and rowKey == "" and node.key != "":
                rowKey = node.key
    if listId >= 0 and rowKey != "":
        if let h = rt.handle(listId):
            return act(rt, host, h, "select", rowKey)
    false

# The first `List` of the window (the one keyboard commands address).
def Mounted? firstList(Runtime rt):
    let all = rt.lists()
    if all.length > 0:
        return all[0]
    nil

def int indexOfKey([string] keys, string key):
    for i in 0..<keys.length:
        if keys[i] == key:
            return i
    -1

# List keyboard commands: Up / Down move the selection, Delete / Backspace delete the selected row
# (`onDelete([index])`), AltUp / AltDown move it one place (`onMove(from, to)`). The callbacks must be
# given (`viewHandles`); the application mutates its model and the next pass restores identity by key.
def bool listKey(mut Runtime rt, Builder host, string name):
    let found = firstList(rt)
    if found == nil:
        return false
    let list = found else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let keys = rowKeysOf(list)
    if keys.length == 0:
        return false
    let at = indexOfKey(keys, propOf(list, "selection"))
    guard let h = rt.handle(list.id) else:
        return false
    if name == "Up" or name == "Down":
        var next = 0
        if name == "Up":
            next = keys.length - 1
            if at > 0:
                next = at - 1
            if at == 0:
                next = 0
        else:
            if at >= 0:
                next = clampTo(at + 1, 0, keys.length - 1)
        return act(rt, host, h, "select", keys[next])
    if at < 0:
        return false
    if let control = list.control:
        if name == "Delete" or name == "Backspace":
            if control.viewHandles("delete"):
                return act(rt, host, h, "delete", "{at}")
            return false
        if control.viewHandles("move"):
            var to = at - 1
            if name == "AltDown":
                to = at + 1
            if to < 0 or to >= keys.length:
                return false
            return act(rt, host, h, "move", "{at},{to}")
    false

def int indexOf([Handle] order, Handle h):
    for i in 0..<order.length:
        if order[i].id == h.id:
            return i
    -1

# The first enabled Button inside `n`, or -1.
def int firstButton(Mounted n, bool inherited):
    var off = inherited
    if n.kind == "Disabled" and propOf(n, "value") == "true":
        off = true
    if n.kind == "Button" and !off:
        return n.id
    for c in n.children:
        let r = firstButton(c, off)
        if r >= 0:
            return r
    -1

# The Enter default (the first enabled `DefaultAction` wrapping an enabled Button) or the Escape cancel
# (the first enabled Button with role Cancel), by `cancel`. -1 when there is none.
def int findScopeButton(Mounted n, bool inherited, bool cancel):
    var off = inherited
    if n.kind == "Disabled" and propOf(n, "value") == "true":
        off = true
    if !cancel and n.kind == "DefaultAction" and propOf(n, "enabled") != "false" and !off:
        let r = firstButton(n, off)
        if r >= 0:
            return r
    if cancel and n.kind == "Button" and propOf(n, "role") == "Cancel" and !off:
        return n.id
    for c in n.children:
        let r = findScopeButton(c, off, cancel)
        if r >= 0:
            return r
    -1

# Activates the scope's default / cancel button. A presented sheet is the scope when there is one.
def bool activateScopeButton(mut Runtime rt, Builder host, bool cancel):
    var scope = rt.root
    if rt.openSheets.length > 0:
        scope = rt.find(rt.openSheets[rt.openSheets.length - 1])
    if let top = scope:
        let id = findScopeButton(top, false, cancel)
        if id >= 0:
            if let h = rt.handle(id):
                return act(rt, host, h, "activate", "")
    false

# Keys for a focused text field; false when `name` is not an editing key.
def bool editKey(mut Runtime rt, Builder host, Handle h, string name):
    let node = rt.find(h.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    let text = propOf(node, "value")
    let len = text.graphemeCount
    let caret = caretOf(rt, h, len)
    let anchor = anchorOf(rt, h, len, caret)
    var lo = caret
    var hi = anchor
    if anchor < caret:
        lo = anchor
        hi = caret
    let hasSelection = lo != hi
    if name == "Backspace":
        if hasSelection:
            return replaceRange(rt, host, h, node, lo, hi, "")
        if caret > 0:
            return replaceRange(rt, host, h, node, caret - 1, caret, "")
        return true
    if name == "Delete":
        if hasSelection:
            return replaceRange(rt, host, h, node, lo, hi, "")
        if caret < len:
            return replaceRange(rt, host, h, node, caret, caret + 1, "")
        return true
    var moved = caret
    var extend = false
    if name == "Left" or name == "ShiftLeft":
        moved = clampTo(caret - 1, 0, len)
        if name == "Left" and hasSelection:
            moved = lo
        extend = name == "ShiftLeft"
    elif name == "Right" or name == "ShiftRight":
        moved = clampTo(caret + 1, 0, len)
        if name == "Right" and hasSelection:
            moved = hi
        extend = name == "ShiftRight"
    elif name == "Home" or name == "ShiftHome":
        moved = 0
        extend = name == "ShiftHome"
    elif name == "End" or name == "ShiftEnd":
        moved = len
        extend = name == "ShiftEnd"
    elif name == "SelectAll":
        moveCaret(rt, h, len, 0)
        rt.invalidateRoot()
        return true
    else:
        return false
    if extend:
        moveCaret(rt, h, moved, anchor)
    else:
        moveCaret(rt, h, moved, moved)
    rt.invalidateRoot()
    true

# ── input-method composition ──────────────────────────────────────────────────────────────────────

# The platform's IME reports its marked (uncommitted) text and the cursor inside it for the focused text field; an
# empty `marked` ends the composition. The bound value is untouched until `imeCommit`.
pub def bool imeUpdate(mut Runtime rt, Builder host, string marked, int cursor):
    if let f = focusedField(rt):
        if isDisabled(rt, f.id):
            return false
        rt.beginEvent()
        if marked == "":
            rt.composition = nil
        else:
            rt.composition = Composition(node = f.id, text = marked, cursor = cursor)
        rt.invalidateRoot()
        rt.endEvent(host)
        return true
    false

# The composition ends with `text` inserted at the caret (replacing a selection), as one edit.
pub def bool imeCommit(mut Runtime rt, Builder host, string text):
    if let c = rt.composition:
        if let f = focusedField(rt):
            rt.composition = nil
            if f.id == c.node:
                return typeText(rt, host, text)
    false

# The composition is abandoned: nothing is inserted.
pub def bool imeCancel(mut Runtime rt, Builder host):
    if rt.composition == nil:
        return false
    rt.beginEvent()
    rt.composition = nil
    rt.invalidateRoot()
    rt.endEvent(host)
    true

# A key press: Tab / ShiftTab move focus through `focusOrder` (wrapping); Escape activates the Cancel
# button; Enter submits a TextField that has `onSubmit`, else activates the focused Button or the
# default action; Space activates / toggles the focused control; editing keys edit the focused
# TextField. Returns whether the key was used.
pub def bool keyPress(mut Runtime rt, Builder host, string name):
    # While an input method composes, Enter and Escape belong to it (commit as typed / cancel) and the editing keys do
    # not touch the committed text: the IME owns them until the composition ends.
    if let c = rt.composition:
        if name == "Enter":
            return imeCommit(rt, host, c.text)
        if name == "Escape":
            return imeCancel(rt, host)
        if name == "Backspace" or name == "Delete" or name == "Left" or name == "Right" or name == "Home" or name == "End":
            return true
    let order = focusOrder(rt)
    if name == "Tab" or name == "ShiftTab":
        if order.length == 0:
            return false
        var at = -1
        if let f = rt.focus:
            at = indexOf(order, f)
        var next = 0
        if name == "Tab":
            next = (at + 1) % order.length
        else:
            next = (at - 1 + order.length) % order.length
            if at < 0:
                next = order.length - 1
        focusControl(rt, host, order[next])
        return true
    if name == "Escape":
        if activateScopeButton(rt, host, true):
            return true
        # No Cancel button: the presented sheet performs its ordinary dismissal (writes `false`).
        if rt.openSheets.length > 0:
            if let h = rt.handle(rt.openSheets[rt.openSheets.length - 1]):
                return act(rt, host, h, "dismiss", "")
        return false
    if let f = rt.focus:
        if rt.valid(f) and !isDisabled(rt, f.id):
            if let node = rt.find(f.id):
                if node.kind == "TextField":
                    if editKey(rt, host, f, name):
                        return true
                    if name == "Enter":
                        if let control = node.control:
                            if control.viewHandles("submit"):
                                return act(rt, host, f, "submit", "")
                if node.kind == "Slider":
                    if sliderKey(rt, host, f, name):
                        return true
                if node.kind == "Button" and (name == "Enter" or name == "Space"):
                    return act(rt, host, f, "activate", "")
                if node.kind == "Toggle" and name == "Space":
                    return act(rt, host, f, "toggle", "")
    if name == "Up" or name == "Down" or name == "Delete" or name == "Backspace" or name == "AltUp" or name == "AltDown":
        if listKey(rt, host, name):
            return true
    if name == "Enter":
        return activateScopeButton(rt, host, false)
    false

# Text input for the focused TextField: replaces the selection (or inserts at the caret).
pub def bool typeText(mut Runtime rt, Builder host, string s):
    if let f = focusedField(rt):
        if isDisabled(rt, f.id):
            return false
        let node = rt.find(f.id) else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
        let len = propOf(node, "value").graphemeCount
        let caret = caretOf(rt, f, len)
        let anchor = anchorOf(rt, f, len, caret)
        var lo = caret
        var hi = anchor
        if anchor < caret:
            lo = anchor
            hi = caret
        return replaceRange(rt, host, f, node, lo, hi, s)
    false

def Placed? findPlaced(Placed p, int id):
    if p.id == id:
        return p
    for c in p.children:
        if let hit = findPlaced(c, id):
            return hit
    nil

def float numOf(Placed p, string key):
    if let s = p.props[key]:
        return s.parseFloat() else (0.0)
    0.0

# Wheel / trackpad input: the delta (dx, dy) at (x, y) of the laid-out window `placed`. The deepest
# `Scroll` under the pointer consumes what it can apply on its own axis (clamped to its content); the
# remainder bubbles to the next ancestor scrolling the same axis. Each consumed share is one event
# transaction. Returns whether any offset moved.
pub def bool scrollBy(mut Runtime rt, Builder host, Placed placed, float x, float y, float dx, float dy):
    let path = hitTest(placed, x, y)
    var restX = dx
    var restY = dy
    var moved = false
    var i = path.length - 1
    while i >= 0:
        if let node = findPlaced(placed, path[i]):
            if node.kind == "Scroll" or node.kind == "List":
                let vertical = (node.props["axis"] else ("Vertical")) == "Vertical"
                var want = restX
                if vertical:
                    want = restY
                let current = numOf(node, "scroll")
                let most = numOf(node, "scrollMax")
                var target = current + want
                if target < 0.0:
                    target = 0.0
                if target > most:
                    target = most
                let used = target - current
                if used != 0.0:
                    rt.beginEvent()
                    _ = rt.scrollTo(node.id, target)
                    rt.invalidateRoot()
                    rt.endEvent(host)
                    moved = true
                    if vertical:
                        restY -= used
                    else:
                        restX -= used
        i -= 1
    moved
