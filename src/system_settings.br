# What the operating system says about appearance, applied to a theme (docs/design-notes/boring-ui-draft.md,
# "Theme value and inheritance": `Theme.system()` follows the platform light/dark appearance, accent and text scale).
#
# Deliberately split in two: THIS file is the pure, testable half (settings value in, theme out, no platform call), and a
# host reads the platform and builds a `SystemSettings` (macOS `NSApp.effectiveAppearance` / accent colour, Windows
# `UISettings`, the XDG settings portal). A host that can read nothing passes `SystemSettings()`: the base theme, unchanged.

use ui.theme.*

pub struct SystemSettings:
    # Dark appearance.
    pub bool dark = false
    # Increased contrast ("Increase contrast" / high-contrast mode).
    pub bool contrast = false
    # The user's accent colour as `#RRGGBB[AA]`, "" = the theme's own accent.
    pub string accent = ""
    # Text size preference as a multiplier (1.0 = default).
    pub float textScale = 1.0
    # The operating system as Rust names it ("macos", "ios", "windows", "linux", "android", ...); "" = unknown.
    pub string platform = ""

# `base` (its measurer, metrics and style overrides) with the system's appearance applied: the dark base when `dark`, the
# high-contrast palette when `contrast`, the accent for the accent and the focus ring, and the text scale. An invalid
# accent or a text scale outside (0, 5] is ignored rather than reaching `Theme.validate`.
pub def Theme themeFromSystem(Theme base, SystemSettings s):
    var t = base
    if s.dark:
        t = t.asDark()
    t = t.withContrast(s.contrast)
    if s.textScale > 0.0 and s.textScale <= 5.0:
        t = t.withTextScale(s.textScale)
    if s.accent != "" and isHexColor(s.accent):
        # In both appearances, as variant overrides: a platform theme's own `light` / `dark` accent outranks an every-variant one.
        t = t.withColorVariant(ColorRole.Accent, "light", s.accent)
        t = t.withColorVariant(ColorRole.Accent, "dark", s.accent)
        t = t.withColorVariant(ColorRole.FocusRing, "light", s.accent)
        t = t.withColorVariant(ColorRole.FocusRing, "dark", s.accent)
    t

# The `macThemeOn` theme following the system (a host that has not read any setting gets the light theme).
pub def Theme macThemeFromSystem(Theme base, SystemSettings s):
    themeFromSystem(macThemeOn(base), s)

# The `fluentThemeOn` theme following the system.
pub def Theme fluentThemeFromSystem(Theme base, SystemSettings s):
    themeFromSystem(fluentThemeOn(base), s)

# The `adwaitaThemeOn` theme following the system.
pub def Theme adwaitaThemeFromSystem(Theme base, SystemSettings s):
    themeFromSystem(adwaitaThemeOn(base), s)

# The theme that looks like the platform, following the system: the mac theme on macOS and iOS, Fluent on Windows, Adwaita on Linux,
# and the built-in one elsewhere (Android has no theme of its own yet), each with the appearance applied.
pub def Theme platformThemeFromSystem(Theme base, SystemSettings s):
    if s.platform == "macos" or s.platform == "ios":
        return macThemeFromSystem(base, s)
    if s.platform == "windows":
        return fluentThemeFromSystem(base, s)
    if s.platform == "linux":
        return adwaitaThemeFromSystem(base, s)
    themeFromSystem(base, s)

# The theme for a window that lets the user pick: `choice` 0 = the platform's (`platformThemeFromSystem`), 1 = mac, 2 = Fluent, 3 = Adwaita,
# `appearance` 0 = what the system says, 1 = light, 2 = dark (the system's contrast, accent and text scale still apply). Anything else is 0.
pub def Theme themeForChoice(Theme base, SystemSettings s, int choice, int appearance):
    var dark = s.dark
    if appearance == 1:
        dark = false
    if appearance == 2:
        dark = true
    let chosen = SystemSettings(dark = dark, contrast = s.contrast, accent = s.accent, textScale = s.textScale, platform = s.platform)
    if choice == 1:
        return macThemeFromSystem(base, chosen)
    if choice == 2:
        return fluentThemeFromSystem(base, chosen)
    if choice == 3:
        return adwaitaThemeFromSystem(base, chosen)
    platformThemeFromSystem(base, chosen)
