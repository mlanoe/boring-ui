# boring-ui animator (docs/design-notes/boring-ui-draft.md, "Animation and transitions"). Headless and
# deterministic: it owns no clock, the host passes `now` (milliseconds, monotonic). It interpolates
# PRESENTATION between two committed layouts (`Placed` trees): the application and the runtime always see
# the target; painting, hit testing and accessibility bounds use `presentation(now)`.
#
#   - `commit(animator, layout, transaction, triggers, now)` after each update pass: a new target. With no
#     animation metadata it snaps; with `rt.takeAnimation()` the transaction's animation applies to every
#     node; inside a triggered `AnimationScope` that scope's animation wins, and an explicit
#     `withoutAnimation` (curve `None`) beats everything. A target that arrives while one is running starts
#     from the CURRENT presentation, with the new animation.
#   - Retained nodes (matched by mounted id, so a keyed move is a move, not remove + insert) interpolate
#     x, y, w, h; `Opacity.value`, `Offset` x/y and `Background.color` blend as live prop overrides (colors in
#     linear light, premultiplied).
#   - `Transition` subtrees enter from their insertion state toward the committed one, and a removed one stays
#     as a presentation-only GHOST (no hit testing, no semantics) until its removal finishes. Fade = group
#     opacity, Scale = about the subtree's center, Slide = a translation.
#   - Reduced motion: every animation becomes a short opacity-only cross-fade; geometry snaps; scale and
#     slide transitions become fades.
#
#   - `MatchedGeometry(id)`: a wrapper that appears while another with the same `id` disappears (a different
#     mounted identity) presents from the old frame to its own, and the old one's ghost is not drawn.
#
# Deviation: the draft's retiring phase also delays `onUnmount` and slot teardown until the transition ends;
# here the runtime still unmounts immediately and only the DISPLAY of the removal is kept (ghosts).

use ui.layout.*
use ui.scene.*
use ui.anim.*

pub struct NodeAnim:
    pub int id
    pub Animation animation

# A shared element: the entering `MatchedGeometry` wrapper `node` starts from the frame of the one it replaced.
pub struct Match:
    pub int node
    pub float x
    pub float y
    pub float w
    pub float h

pub struct Animator:
    pub var Placed? from = nil
    pub var Placed? to = nil
    pub var float start = 0.0
    # The transaction's animation, whether it was an explicit snap, and per-node scope animations.
    pub var Animation base = Animation()
    pub var bool snapAll = false
    pub var [NodeAnim] scopes = []
    pub var bool reducedMotion = false
    # Whether the end of the latest run was already reported by `takeCompletion`.
    pub var bool completionTaken = true
    pub var [Match] matches = []
    # Mounted ids of the wrappers whose frame was handed over (a ghost containing one is not drawn).
    pub var [int] absorbed = []

def Placed emptyPlaced():
    Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0)

# ── commit ────────────────────────────────────────────────────────────────────────────────────────

def void collectScopes(Placed p, [Trigger] triggers, Animation? inherited, mut [NodeAnim] out):
    var here = inherited
    for t in triggers:
        if t.node == p.id:
            here = t.animation
    for c in p.children:
        collectScopes(c, triggers, here, out)
    # (After the children: `if let` on an optional moves it under `boring build`, so it must be the last use.)
    if let a = here:
        out.push(NodeAnim(id = p.id, animation = a))

# A new committed layout `target` at time `now`. See the module comment for how metadata is applied.
pub def void commit(mut Animator a, Placed target, Animation? transaction, [Trigger] triggers, float now):
    if a.to == nil:
        a.to = target
        a.from = nil
        return
    let current = presentation(a, now)
    a.from = current
    a.to = target
    a.start = now
    a.snapAll = false
    a.base = Animation()
    if let t = transaction:
        if t.curve == "None":
            a.snapAll = true
        else:
            a.base = t
    mut [NodeAnim] scopes = []
    collectScopes(target, triggers, nil, scopes)
    a.scopes = scopes
    a.completionTaken = false
    findMatches(a, current, target)

def void collectMatched(Placed p, mut [Placed] out):
    if p.kind == "MatchedGeometry":
        out.push(p)
    for c in p.children:
        collectMatched(c, out)

# Pairs each wrapper new in `target` with the same-`id` one that is gone from it (looked up in `current`, the
# presentation the run starts from, so a retargeted run keeps matching).
def void findMatches(mut Animator a, Placed current, Placed target):
    mut [Placed] before = []
    mut [Placed] after = []
    collectMatched(current, before)
    collectMatched(target, after)
    mut [Match] found = []
    mut [int] taken = []
    for n in after:
        var kept = false
        for b in before:
            if b.id == n.id:
                kept = true
        if kept:
            continue
        for b in before:
            if (b.props["id"] else ("")) == (n.props["id"] else ("")) and !taken.contains(b.id):
                var stays = false
                for m in after:
                    if m.id == b.id:
                        stays = true
                if !stays:
                    found.push(Match(node = n.id, x = b.x, y = b.y, w = b.w, h = b.h))
                    taken.push(b.id)
                    break
    a.matches = found
    a.absorbed = taken

def bool containsAbsorbed(Placed p, [int] ids):
    if ids.contains(p.id):
        return true
    for c in p.children:
        if containsAbsorbed(c, ids):
            return true
    false

# True ONCE when the latest committed run has finished (every animation done, or none ever started): a host-level
# observation to stop scheduling frames or to release resources — not an application lifecycle hook (draft: "Animation
# completion is not a general lifecycle hook in the first API"). A new `commit` re-arms it.
pub def bool takeCompletion(mut Animator a, float now):
    if a.completionTaken:
        return false
    if isAnimating(a, now):
        return false
    a.completionTaken = true
    true

def Animation animationFor(Animator a, int id):
    if a.snapAll:
        return Animation()
    var chosen = a.base
    for s in a.scopes:
        if s.id == id:
            chosen = s.animation
    if a.reducedMotion:
        return reduced(chosen)
    chosen

# Whether any animation is still running at `now` (a host stops scheduling frames when none is).
pub def bool isAnimating(Animator a, float now):
    if a.from == nil:
        return false
    if a.snapAll:
        return false
    let elapsed = now - a.start
    if !isDone(a.base, elapsed):
        return true
    for s in a.scopes:
        if !isDone(s.animation, elapsed):
            return true
    false

# ── presentation ───────────────────────────────────────────────────────────────────────────────────

pub def Placed presentation(Animator a, float now):
    if let t = a.to:
        if let f = a.from:
            return blendNode(a, f, t, now, false)
        return t
    emptyPlaced()

def string valueOf(Placed p, string key, string fallback):
    propOrLive(p, key, fallback)

def PropValue? liveBlend(Placed f, Placed t, float p):
    if t.kind == "Opacity":
        let a = valueOf(f, "value", "1").parseFloat() else (1.0)
        let b = valueOf(t, "value", "1").parseFloat() else (1.0)
        if a != b:
            return PropValue(key = "value", value = "{lerp(a, b, p)}")
    if t.kind == "Background":
        let a = resolveColor(f, valueOf(f, "color", ""))
        let b = resolveColor(t, valueOf(t, "color", ""))
        if a != b:
            return PropValue(key = "color", value = lerpColor(a, b, p))
    nil

# The interpolated live values of an `Offset` (its x and y).
def [PropValue] offsetLive(Placed f, Placed t, float p):
    mut [PropValue] out = []
    for key in ["x", "y"]:
        let a = valueOf(f, key, "0").parseFloat() else (0.0)
        let b = valueOf(t, key, "0").parseFloat() else (0.0)
        if a != b:
            out.push(PropValue(key = key, value = "{lerp(a, b, p)}"))
    out

def Placed? childById([Placed] kids, int id):
    for k in kids:
        if k.id == id:
            return k
    nil

# One retained node: geometry between `f` and `t`, live prop values, children (matched by id), plus the
# ghosts of removed `Transition` children.
def Placed blendNode(Animator a, Placed f, Placed t, float now, bool inGhost):
    let anim = animationFor(a, t.id)
    let elapsed = now - a.start
    let p = progress(anim, elapsed)
    var pg = p
    if a.reducedMotion:
        pg = 1.0
    mut [Placed] kids = []
    for tc in t.children:
        if let fc = childById(f.children, tc.id):
            kids.push(blendNode(a, fc, tc, now, false))
        else:
            kids.push(enterNode(a, tc, now))
    # Ghosts: removed Transition subtrees stay until their removal animation finishes.
    if !a.snapAll:
        for fc in f.children:
            if childById(t.children, fc.id) == nil:
                if (fc.kind == "Transition" or fc.ghost) and !containsAbsorbed(fc, a.absorbed):
                    let ghost = ghostNode(a, fc, now)
                    if ghost != nil:
                        kids.push(ghost else (emptyPlaced()))
    mut [PropValue] live = []
    if let v = liveBlend(f, t, p):
        live.push(v)
    if t.kind == "Offset":
        for v in offsetLive(f, t, p):
            live.push(v)
    # what the runtime marked the node with (focus, hover, caret, composition) is not animated: the target's stays
    for v in t.live:
        live.push(v)
    Placed(id = t.id, kind = t.kind, x = lerp(f.x, t.x, pg), y = lerp(f.y, t.y, pg), w = lerp(f.w, t.w, pg), h = lerp(f.h, t.h, pg), props = t.props, children = kids, theme = t.theme, key = t.key, alpha = t.alpha, ghost = t.ghost, live = live)

# ── transitions ────────────────────────────────────────────────────────────────────────────────────

def string kindOf(Placed t, string key):
    t.props[key] else ("Fade")

def float numberOf(Placed t, string key, float fallback):
    (t.props[key] else ("")).parseFloat() else (fallback)

# `t` with its geometry scaled about its own center and translated, recursively (hit testing and painting
# follow the presentation geometry).
def Placed moved(Placed t, float cx, float cy, float scale, float dx, float dy):
    mut [Placed] kids = []
    for c in t.children:
        kids.push(moved(c, cx, cy, scale, dx, dy))
    Placed(id = t.id, kind = t.kind, x = cx + (t.x - cx) * scale + dx, y = cy + (t.y - cy) * scale + dy, w = t.w * scale, h = t.h * scale, props = t.props, children = kids, theme = t.theme, key = t.key, alpha = t.alpha, ghost = t.ghost, live = t.live)

# A transition at `state` (0 = at its rest, committed state; 1 = fully at its insertion / removal state).
def Placed transitioned(Animator a, Placed t, string kind, float state, bool ghost):
    var effective = kind
    if a.reducedMotion and kind != "Identity":
        effective = "Fade"
    let cx = t.x + t.w / 2.0
    let cy = t.y + t.h / 2.0
    var scale = 1.0
    var dx = 0.0
    var dy = 0.0
    var alpha = t.alpha
    if effective == "Fade":
        alpha = t.alpha * (1.0 - state)
    if effective == "Scale":
        scale = lerp(1.0, numberOf(t, "amount", 0.96), state)
    if effective == "Slide":
        dx = numberOf(t, "dx", 0.0) * state
        dy = numberOf(t, "dy", 0.0) * state
    let shifted = moved(t, cx, cy, scale, dx, dy)
    Placed(id = shifted.id, kind = shifted.kind, x = shifted.x, y = shifted.y, w = shifted.w, h = shifted.h, props = shifted.props, children = shifted.children, theme = shifted.theme, key = shifted.key, alpha = alpha, ghost = ghost, live = shifted.live)

# A node new in this commit: a `Transition` presents from its insertion state toward its rest; anything
# else appears as committed (its parent's transition, if any, carries it).
def Placed enterNode(Animator a, Placed t, float now):
    let placed = fitMatches(a, t, now)
    if t.kind != "Transition":
        return placed
    let anim = animationFor(a, t.id)
    let p = progress(anim, now - a.start)
    transitioned(a, placed, kindOf(t, "insertion"), 1.0 - p, false)

# `t` (a subtree new in this commit) with every matched wrapper presented between its predecessor's frame and its own.
def Placed fitMatches(Animator a, Placed t, float now):
    if a.matches.length == 0:
        return t
    if t.kind == "MatchedGeometry":
        for m in a.matches:
            if m.node == t.id:
                let anim = animationFor(a, t.id)
                var p = progress(anim, now - a.start)
                if a.reducedMotion:
                    p = 1.0
                return refit(t, t.x, t.y, lerp(m.x, t.x, p), lerp(m.y, t.y, p), scaleBetween(m.w, t.w, p), scaleBetween(m.h, t.h, p))
    mut [Placed] kids = []
    for c in t.children:
        kids.push(fitMatches(a, c, now))
    Placed(id = t.id, kind = t.kind, x = t.x, y = t.y, w = t.w, h = t.h, props = t.props, children = kids, theme = t.theme, key = t.key, alpha = t.alpha, ghost = t.ghost, live = t.live)

# The factor taking `to` (the rest size) to the size interpolated from `from` at progress `p`.
def float scaleBetween(float from, float to, float p):
    if to <= 0.0:
        return 1.0
    lerp(from, to, p) / to

# `t` with its top-left moved to (nx, ny) and its geometry scaled by (sx, sy) about it, recursively.
def Placed refit(Placed t, float ox, float oy, float nx, float ny, float sx, float sy):
    mut [Placed] kids = []
    for c in t.children:
        kids.push(refit(c, ox, oy, nx, ny, sx, sy))
    Placed(id = t.id, kind = t.kind, x = nx + (t.x - ox) * sx, y = ny + (t.y - oy) * sy, w = t.w * sx, h = t.h * sy, props = t.props, children = kids, theme = t.theme, key = t.key, alpha = t.alpha, ghost = t.ghost, live = t.live)

# A removed `Transition` as a ghost heading to its removal state; nil once the removal finished.
def Placed? ghostNode(Animator a, Placed f, float now):
    let anim = animationFor(a, f.id)
    let elapsed = now - a.start
    if isDone(anim, elapsed) or anim.curve == "None":
        return nil
    let p = progress(anim, elapsed)
    transitioned(a, f, kindOf(f, "removal"), p, true)
