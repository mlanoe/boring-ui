# From a string to `DrawGlyph` commands: shapes it with the engine (engine.br), rasterizes every glyph it has not
# drawn yet at that size into the renderer's `GlyphAtlas` (render/src/display_list.br), and returns one command per
# glyph. The cache keys a glyph by (id, size), so a run of text only ever rasterizes each distinct glyph once.

use render.display_list.*
use text.engine.*

pub struct GlyphCache:
    # the font file; owned here so the methods below never have to move it around
    pub let [uint8] font
    # fonts tried, in order, for the characters `font` lacks (CJK, symbols...)
    pub let [[uint8]] fallbacks = []
    # the bold, italic and bold italic cuts of `font` (style 1, 2, 3); a missing or empty entry means the regular font
    pub let [[uint8]] styled = []
    pub var mut GlyphAtlas atlas = GlyphAtlas()
    # "<style>:<font>:<glyph id>@<size>+<subpixel bin>" -> index in `atlas`, or -1 for a glyph with no image (a space)
    var mut {string=int} index = {=}

    # The atlas index of `glyph` at `size`, rasterizing it on first use; -1 when it has no image.
    # `bin` (0..<SUBPIXEL_BINS) is the pen's quarter-pixel position: the mask is rendered shifted by it.
    # Whether a separate cut of the font exists for `style` (1 bold, 2 italic, 3 both).
    req bool hasCut(int style):
        style > 0 and self.styled.length >= style and self.styled[style - 1].length > 0

    def int glyphFor(int style, int fontIndex, uint glyph, float size, int bin):
        let key = "{style}:{fontIndex}:{glyph}@{size}+{bin}"
        let known = index[key] else (0 - 2)
        if known != 0 - 2:
            return known
        var found = 0 - 1
        var bytes = self.font
        if fontIndex > 0:
            bytes = self.fallbacks[fontIndex - 1]
        elif self.hasCut(style):
            bytes = self.styled[style - 1]
        let imgOpt = rasterizeAt(bytes, glyph, size, bin as float / 4.0)
        if let img = imgOpt:
            if img.width > 0 and img.height > 0:
                found = atlas.addGlyph(img.width, img.height, img.left, img.top, img.alpha)
        index[key] = found
        found

    # `DrawGlyph` commands for `text` at `size` px per em, pen starting at (`x`, `baseline`), colour `hex`.
    def [Command] draw(string text, float size, float x, float baseline, string hex):
        self.drawStyled(text, size, 0, x, baseline, hex)

    # The ascent and descent of the font cut `style` at `size`.
    req LineMetrics metricsFor(float size, int style):
        if self.hasCut(style):
            return lineMetrics(self.styled[style - 1], size)
        lineMetrics(self.font, size)

    # `draw` in a style: 1 bold, 2 italic, 3 both (the regular font where the cut is missing).
    def [Command] drawStyled(string text, float size, int style, float x, float baseline, string hex):
        var mut out = [] as [Command]
        var shaped = [] as [PlacedGlyph]
        if self.hasCut(style):
            shaped = shapeWithFallbacks(self.styled[style - 1], self.fallbacks, text, size)
        else:
            shaped = shapeWithFallbacks(self.font, self.fallbacks, text, size)
        for g in shaped:
            # the pen's fraction of a pixel is quantized to quarters and baked into the mask; the command's pen is whole
            let pen = x + g.x + g.dx
            var whole = pen.floor()
            var bin = ((pen - whole) * 4.0 + 0.5).floor() as int
            if bin >= 4:
                bin = 0
                whole += 1.0
            let at = self.glyphFor(style, g.font, g.id, size, bin)
            if at >= 0:
                out.push(Command(kind = "DrawGlyph", x = whole, y = baseline + g.dy, w = 0.0, h = 0.0, glyph = at, hex = hex))
        out

# `list` with every `DrawText` replaced by the `DrawGlyph` commands of its text set in the cache's font: each line
# (split on newlines) takes a line box of the command's height `h` (the font size) and sits with the font's
# ascent-plus-descent centred in it. Everything else is kept in order.
pub def [Command] glyphify([Command] list, mut GlyphCache cache):
    var mut out = [] as [Command]
    for c in list:
        if c.kind == "DrawText":
            let m = cache.metricsFor(c.h, c.style)
            let baseline = (c.h - (m.ascent + m.descent)) / 2.0 + m.ascent
            var row = 0
            for line in c.text.split("\n"):
                for g in cache.drawStyled(line, c.h, c.style, c.x, c.y + baseline + row as float * c.h, c.hex):
                    out.push(g)
                row += 1
        else:
            out.push(c)
    out
