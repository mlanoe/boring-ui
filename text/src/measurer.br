# The text engine as boring-ui's `TextMeasurer` (src/theme.br): a theme carrying one measures, wraps, truncates and
# places carets with the real font's shaped advances instead of the fixture cells.
#
#     Theme(measurer = EngineMeasurer(font = fs.readBytes("...ttf")))
#
# Widths are remembered per (text, size): layout asks for the same strings many times a frame (wrapping, spans, intrinsic
# sizes), and shaping is the expensive part. The memo is an `'actor` field so a `req` method can fill it; it is emptied when
# it passes `MEMO_LIMIT` entries, so a long session typing new text cannot grow it without bound.

use ui.theme.*
use text.engine.*

pub let MEMO_LIMIT = 4096

pub struct EngineMeasurer as TextMeasurer:
    pub let [uint8] font
    # fonts tried, in order, for the characters `font` lacks (see `GlyphCache.fallbacks`)
    pub let [[uint8]] fallbacks = []
    # the bold, italic and bold italic cuts of `font` (style 1, 2, 3); a missing or empty entry means the regular font
    pub let [[uint8]] styled = []

    # the widths already measured, per "<style>|<size>|<text>" (an `'actor` field: a `req` method fills it)
    let {string=float}'actor memo = {=}

    req bool hasCut(int style):
        style > 0 and self.styled.length >= style and self.styled[style - 1].length > 0

    # The one-glyph ellipsis when the font has it, else three dots.
    pub req string ellipsis():
        if covers(self.font, "…"):
            return "…"
        "..."

    pub req float width(string s, float size):
        self.widthStyled(s, size, 0)

    pub req bool isRtl(string s):
        paragraphIsRtl(s)

    # Where a line may break: swash's UAX #14 analysis.
    pub req [int] breakPoints(string s):
        lineBreakPoints(s)

    # (the caret and selection are placed with the real shaping: right-to-left and mixed text have a visual order)
    pub req float caretX(string s, int index, float size, int style):
        if self.hasCut(style):
            return caretXIn(self.styled[style - 1], self.fallbacks, s, size, index)
        caretXIn(self.font, self.fallbacks, s, size, index)

    pub req [float] selectionSpans(string s, int lo, int hi, float size, int style):
        if self.hasCut(style):
            return selectionSpansIn(self.styled[style - 1], self.fallbacks, s, size, lo, hi)
        selectionSpansIn(self.font, self.fallbacks, s, size, lo, hi)

    pub req float widthStyled(string s, float size, int style):
        let key = "{style}|{size}|{s}"
        let known = memo[key] else (0.0 - 1.0)
        if known >= 0.0:
            return known
        var w = 0.0
        if self.hasCut(style):
            w = runWidth(shapeBidi(self.styled[style - 1], self.fallbacks, s, size))
        else:
            w = runWidth(shapeBidi(self.font, self.fallbacks, s, size))
        if memo.length >= MEMO_LIMIT:
            memo.clear()
        memo[key] = w
        w
