# Text engine (src/engine.br). Build and run: tests/run_tests.sh (needs `boring build`: it calls swash).

use text.engine.*
use render.display_list.*
use render.raster.*
use text.glyph_run.*
use text.fonts.*
use text.measurer.*
use ui.theme.*
use ui.layout.*

let font = fs.readBytes("/System/Library/Fonts/Supplemental/Arial.ttf")

let hello = shape(font, "Hello", 16.0)
assert_eq(hello.length, 5)
# proportional advances: 'H' is wider than 'l'
assert(hello[0].advance > hello[2].advance)
assert_eq(hello[2].advance, hello[3].advance)
assert(hello[1].x == hello[0].advance)
assert_eq(runWidth(hello) > 30.0, true)

# a bigger size scales the run
assert(runWidth(shape(font, "Hello", 32.0)) > 1.9 * runWidth(hello))

let aOpt = rasterize(font, hello[0].id, 32.0)
guard let a = aOpt else:
    print "FAILED: no image for H"
    exit(1)
assert_eq(a.alpha.length, a.width * a.height)
assert(a.width > 10 and a.height > 10)
var ink = 0
for b in a.alpha:
    if b > 0:
        ink += 1
assert(ink > 20)

mut cache = GlyphCache(font = fs.readBytes("/System/Library/Fonts/Supplemental/Arial.ttf"))
let run = cache.draw("Hello", 20.0, 2.0, 18.0, "#000000")
# 5 letters; each (glyph, quarter-pixel pen) has its own mask, so the two 'l's may share one or not
assert_eq(run.length, 5)
let masks = cache.atlas.width.length
assert(masks >= 4 and masks <= 5)
# drawing again reuses the cache
let again = cache.draw("Hello", 20.0, 2.0, 18.0, "#000000")
assert_eq(cache.atlas.width.length, masks)
# a space has no image: no command
assert_eq(cache.draw("a b", 20.0, 0.0, 18.0, "#000000").length, 2)

let picture = rasterizeWith(run, [], cache.atlas, 64, 24)
var inked = 0
for p in picture.pixels:
    if p != 0:
        inked += 1
assert(inked > 40)
assert_eq(picture.unsupported.length, 0)
print "glyph run ok"

# The engine as a theme's measurer: proportional widths, and the fixture's by default.
let engineTheme = Theme(measurer = EngineMeasurer(font = font.clone()))
let fixtureTheme = Theme()
assert_eq(fixtureTheme.measurer.width("iii", 16.0), 24.0)
let narrow = engineTheme.measurer.width("iii", 16.0)
let wide = engineTheme.measurer.width("WWW", 16.0)
assert(narrow < 16.0 and wide > 30.0)
assert_eq(engineTheme.measurer.width("", 16.0), 0.0)
# a click halfway into the first 'W' of "WWW" lands before it, past its middle after it
assert_eq(graphemeAtX(engineTheme.measurer, "WWW", 1.0, 16.0), 0)
assert_eq(graphemeAtX(engineTheme.measurer, "WWW", 13.0, 16.0), 1)
assert_eq(graphemeAtX(engineTheme.measurer, "WWW", 500.0, 16.0), 3)
print "measurer ok"

# ── font fallback: Arial has no CJK, a second font takes those graphemes ─────────────────────────

let cjk = fs.readBytes("/System/Library/Fonts/Hiragino Sans GB.ttc")
assert(covers(font, "Hi"))
assert(!covers(font, "你"))
assert(covers(cjk, "你好"))
let both = [fs.readBytes("/System/Library/Fonts/Supplemental/Arial.ttf"), fs.readBytes("/System/Library/Fonts/Hiragino Sans GB.ttc")]
let mixed = shapeRuns(both, "Hi你好!", 20.0)
assert_eq(mixed.length, 5)
assert_eq(mixed[0].font, 0)
assert_eq(mixed[2].font, 1)
assert_eq(mixed[3].font, 1)
assert_eq(mixed[4].font, 0)                      # back to the primary after the run
# runs are laid out one after the other: positions only grow, and the width is the sum of the parts
assert(mixed[2].x > mixed[1].x and mixed[3].x > mixed[2].x and mixed[4].x > mixed[3].x)
assert(runWidth(mixed) > runWidth(shape(both[0], "Hi", 20.0)) + 30.0)
# without a second font nothing changes
assert_eq(shapeRuns([both[0]], "Hello", 16.0).length, 5)

# the cache rasterizes each glyph with the font that shaped it
mut wide = GlyphCache(font = fs.readBytes("/System/Library/Fonts/Supplemental/Arial.ttf"), fallbacks = [fs.readBytes("/System/Library/Fonts/Hiragino Sans GB.ttc")])
let drawn = wide.draw("Hi你", 20.0, 0.0, 18.0, "#000000")
assert_eq(drawn.length, 3)
let sheet = rasterizeWith(drawn, [], wide.atlas, 60, 24)
var cjkInk = 0
for y in 0..<24:
    for x in 28..<60:
        if sheet.pixels[y * 60 + x] != 0:
            cjkInk += 1
assert(cjkInk > 20)

# and the measurer widens with it
let fallbackTheme = Theme(measurer = EngineMeasurer(font = fs.readBytes("/System/Library/Fonts/Supplemental/Arial.ttf"), fallbacks = [fs.readBytes("/System/Library/Fonts/Hiragino Sans GB.ttc")]))
assert(fallbackTheme.measurer.width("你好", 16.0) > 20.0)
print "fallback ok"

# subpixel positions: the same glyph at a pen shifted by half a pixel gets its own mask, and a pen within an eighth of a pixel
# of a whole one shares it
mut subCache = GlyphCache(font = fs.readBytes("/System/Library/Fonts/Supplemental/Arial.ttf"))
let atWhole = subCache.draw("l", 20.0, 3.0, 18.0, "#000000")
let atHalf = subCache.draw("l", 20.0, 3.5, 18.0, "#000000")
let nearWhole = subCache.draw("l", 20.0, 3.05, 18.0, "#000000")
assert(atWhole[0].glyph != atHalf[0].glyph)
assert_eq(atWhole[0].glyph, nearWhole[0].glyph)
assert_eq(atWhole[0].x, 3.0)
assert_eq(atHalf[0].x, 3.0)
assert(atHalf[0].x == atWhole[0].x)
print "subpixel ok"

# fonts found on this machine, not at a hard-coded path
assert(readFirst([]) == nil)
assert(readFirst(["/definitely/not/a/font.ttf"]) == nil)
let found = systemSansFont([])
assert(found != nil)
# the application's own path wins when it exists, and a missing one is skipped
let viaFirst = systemSansFont(["/definitely/not/a/font.ttf"])
assert(viaFirst != nil)
if let a = found:
    if let b = viaFirst:
        assert_eq(a.length, b.length)
print "fonts ok"

# the bundled Inter (DejaVu Sans behind it for Hebrew and Arabic; the test runs from tests/shape_test_rust/): found, styled cuts differ, a missing directory falls back
let bundled = bundledSans("../../fonts")
assert(bundled.length > 0)
let bundledCuts = bundledSansStyles("../../fonts")
assert_eq(bundledCuts.length, 3)
for cut in bundledCuts:
    assert(cut.length > 0)
let dejavu = Theme(measurer = EngineMeasurer(font = bundled, styled = bundledCuts))
assert(dejavu.measurer.widthStyled("Hello world", 16.0, 1) > dejavu.measurer.width("Hello world", 16.0))
assert_eq(bundledSans("/no/such/dir").length, 0)
assert_eq(sansFontFrom("/no/such/dir").length, systemSansFontOrEmpty().length)
assert_eq(sansFontFrom("../../fonts").length, bundled.length)
assert_eq(bundled.length, 407056)
assert_eq(fallbackFontsFrom("../../fonts")[0].length, 756072)
assert(fallbackFontsFrom("../../fonts").length >= 1)
assert_eq(fallbackFontsFrom("/no/such/dir").length, systemFallbackFonts().length)
print "bundled fonts ok"

# bold and italic cuts: a styled measurer widens bold text, a styled cache rasterizes the bold cut (not the regular glyphs)
let cuts = systemSansStyles()
assert_eq(cuts.length, 3)
if cuts[0].length > 0:
    let styledTheme = Theme(measurer = EngineMeasurer(font = systemSansFontOrEmpty(), styled = cuts))
    let regularWidth = styledTheme.measurer.widthStyled("Hello world", 16.0, 0)
    let boldWidth = styledTheme.measurer.widthStyled("Hello world", 16.0, 1)
    assert(boldWidth > regularWidth)
    assert_eq(styledTheme.measurer.width("Hello world", 16.0), regularWidth)
    # without cuts a style falls back to the regular font
    let plainTheme = Theme(measurer = EngineMeasurer(font = systemSansFontOrEmpty()))
    assert_eq(plainTheme.measurer.widthStyled("Hello world", 16.0, 1), regularWidth)
    mut styledCache = GlyphCache(font = systemSansFontOrEmpty(), styled = cuts)
    let regularRun = styledCache.drawStyled("Hello", 20.0, 0, 0.0, 18.0, "#000000")
    let boldRun = styledCache.drawStyled("Hello", 20.0, 1, 0.0, 18.0, "#000000")
    assert_eq(regularRun.length, boldRun.length)
    # the bold glyphs are other masks, with more ink
    var regularInk = 0
    var boldInk = 0
    for c in regularRun:
        let at = c.glyph
        for i in 0..<(styledCache.atlas.width[at] * styledCache.atlas.height[at]):
            regularInk += styledCache.atlas.alpha[styledCache.atlas.offset[at] + i] as int
    for c in boldRun:
        let at = c.glyph
        for i in 0..<(styledCache.atlas.width[at] * styledCache.atlas.height[at]):
            boldInk += styledCache.atlas.alpha[styledCache.atlas.offset[at] + i] as int
    assert(boldInk > regularInk)
# line breaking with the real font: proportional widths decide the lines, the truncated one ends with the one-glyph ellipsis
let breakTheme = Theme(measurer = EngineMeasurer(font = systemSansFontOrEmpty()))
assert_eq(breakTheme.measurer.ellipsis(), "…")
let narrowLines = shownLinesAt(breakTheme.measurer, "Implement the vertical slice", 120.0, nil, 8.0, 0)
assert(narrowLines.length >= 2)
for l in narrowLines:
    assert(breakTheme.measurer.widthStyled(l, 16.0, 0) <= 120.0)
let cut = shownLinesAt(breakTheme.measurer, "Implement the vertical slice", 120.0, 1, 8.0, 0)
assert_eq(cut.length, 1)
assert(cut[0].endsWith("…"))
assert(breakTheme.measurer.widthStyled(cut[0], 16.0, 0) <= 120.0)
# ── bidirectional text ────────────────────────────────────────────────────────────────────────────
let alef = "א"
let bet = "ב"
let gimel = "ג"
def uint idOf([uint8] f, string s):
    shape(f, s, 20.0)[0].id

def [uint] idsOf([PlacedGlyph] glyphs):
    var mut out = [] as [uint]
    for g in glyphs:
        out.push(g.id)
    out

let aId = idOf(font, "a")
let bId = idOf(font, "b")
let alefId = idOf(font, alef)
let betId = idOf(font, bet)
let gimelId = idOf(font, gimel)

# levels: Latin 0, Hebrew 1 (and the base direction is the first strong letter)
assert_eq(bidiLevels("ab {alef}{bet}{gimel} cd"), [0, 0, 0, 1, 1, 1, 0, 0, 0])
assert_eq(bidiLevels("{alef}{bet} ab"), [1, 1, 1, 2, 2])
assert_eq(bidiLevels("abc"), [0, 0, 0])
assert_eq(bidiLevels(""), [])

# a Hebrew word is laid out right to left: last letter first on the left
let heb = shapeBidi(font, [], "{alef}{bet}{gimel}", 20.0)
assert_eq(idsOf(heb), [gimelId, betId, alefId])
assert_eq(heb[0].x, 0.0)
assert(heb[1].x > heb[0].x and heb[2].x > heb[1].x)

# mixed text: the Latin run stays left to right, the Hebrew run is reversed, in an LTR paragraph
let mixed = shapeBidi(font, [], "ab {alef}{bet}", 20.0)
let mixedIds = idsOf(mixed)
assert_eq(mixedIds[0], aId)
assert_eq(mixedIds[1], bId)
assert_eq(mixedIds[mixedIds.length - 2], betId)
assert_eq(mixedIds[mixedIds.length - 1], alefId)

# in a right-to-left paragraph the Latin word goes to the left of the Hebrew one: "{alef}{bet} ab" shows "ab {bet}{alef}"
let rtlPara = shapeBidi(font, [], "{alef}{bet} ab", 20.0)
let rtlIds = idsOf(rtlPara)
assert_eq(rtlIds[0], aId)
assert_eq(rtlIds[1], bId)
assert_eq(rtlIds[rtlIds.length - 1], alefId)

# widths do not depend on the order: the same glyph advances, however they are arranged
assert_eq(runWidth(shapeBidi(font, [], "{alef}{bet}{gimel}", 20.0)), runWidth(shapeDir(font, "{alef}{bet}{gimel}", 20.0, false)))
# plain Latin takes the ordinary path
assert_eq(idsOf(shapeBidi(font, [], "ab", 20.0)), [aId, bId])
# the measurer and the cache use it: a Hebrew string has a width and draws glyphs
let hebTheme = Theme(measurer = EngineMeasurer(font = systemSansFontOrEmpty()))
assert(hebTheme.measurer.width("{alef}{bet}{gimel}", 16.0) > 10.0)
mut hebCache = GlyphCache(font = systemSansFontOrEmpty())
assert_eq(hebCache.draw("{alef}{bet}{gimel}", 16.0, 0.0, 14.0, "#000000").length, 3)
# ── caret and selection in shaped text ────────────────────────────────────────────────────────────
def float near(float a, float b):
    if a > b:
        return a - b
    b - a

# left to right: the caret at index i is the width of the first i graphemes
let abcWidth = runWidth(shape(font, "abc", 20.0))
assert_eq(caretXIn(font, [], "abc", 20.0, 0), 0.0)
assert(near(caretXIn(font, [], "abc", 20.0, 3), abcWidth) < 0.01)
assert(caretXIn(font, [], "abc", 20.0, 1) > 0.0 and caretXIn(font, [], "abc", 20.0, 1) < caretXIn(font, [], "abc", 20.0, 2))
assert_eq(caretXIn(font, [], "", 20.0, 0), 0.0)

# right to left: the caret starts at the right edge and moves left as the index grows
let hebWidth = runWidth(shape(font, "{alef}{bet}{gimel}", 20.0))
let hebText = "{alef}{bet}{gimel}"
assert(near(caretXIn(font, [], hebText, 20.0, 0), hebWidth) < 0.01)
assert(near(caretXIn(font, [], hebText, 20.0, 3), 0.0) < 0.01)
assert(caretXIn(font, [], hebText, 20.0, 1) > caretXIn(font, [], hebText, 20.0, 2))

# mixed "ab " then Hebrew: the caret before the first Hebrew letter and after the last are both at the Hebrew run's left edge
let mixedText = "ab {alef}{bet}{gimel}"
let beforeHebrew = caretXIn(font, [], mixedText, 20.0, 3)
let afterHebrew = caretXIn(font, [], mixedText, 20.0, 6)
assert(near(beforeHebrew, runWidth(shape(font, "ab ", 20.0))) < 0.01)
assert(near(afterHebrew, beforeHebrew) < 0.01 or afterHebrew > beforeHebrew)
assert(caretXIn(font, [], mixedText, 20.0, 4) > caretXIn(font, [], mixedText, 20.0, 5))
assert(caretXIn(font, [], mixedText, 20.0, 5) > caretXIn(font, [], mixedText, 20.0, 6) - 0.01)

# selections: one span for a left-to-right range, one for a whole Hebrew word, two when the range crosses the direction change
assert_eq(selectionSpansIn(font, [], "abc", 20.0, 1, 3).length, 2)
assert_eq(selectionSpansIn(font, [], hebText, 20.0, 0, 3).length, 2)
assert_eq(selectionSpansIn(font, [], mixedText, 20.0, 1, 5).length, 4)
assert_eq(selectionSpansIn(font, [], "abc", 20.0, 2, 2).length, 0)
let abSpans = selectionSpansIn(font, [], "abc", 20.0, 1, 3)
assert(near(abSpans[1] - abSpans[0], runWidth(shape(font, "bc", 20.0))) < 0.01)

# the measurer exposes them, and a click lands on the nearest caret stop in visual order
let caretTheme = Theme(measurer = EngineMeasurer(font = systemSansFontOrEmpty()))
let hebW = caretTheme.measurer.width(hebText, 16.0)
assert_eq(graphemeAtX(caretTheme.measurer, hebText, hebW - 1.0, 16.0), 0)
assert_eq(graphemeAtX(caretTheme.measurer, hebText, 1.0, 16.0), 3)
assert_eq(graphemeAtX(caretTheme.measurer, "abc", 1.0, 16.0), 0)
assert_eq(graphemeAtX(caretTheme.measurer, "abc", 500.0, 16.0), 3)
# ── alignment of right-to-left paragraphs ─────────────────────────────────────────────────────────
assert(paragraphIsRtl("{alef}{bet}{gimel}"))
assert(paragraphIsRtl("{alef}{bet} ab"))
assert(!paragraphIsRtl("ab {alef}{bet}"))
assert(!paragraphIsRtl("abc"))
assert(!paragraphIsRtl("123"))
assert(!paragraphIsRtl(""))

# glyphify sets a right-to-left line against the right edge of its box, a left-to-right one against the left
mut alignCache = GlyphCache(font = systemSansFontOrEmpty())
let hebLine = Command(kind = "DrawText", x = 10.0, y = 0.0, w = 200.0, h = 20.0, text = "{alef}{bet}{gimel}", hex = "#000000")
let ltrLine = Command(kind = "DrawText", x = 10.0, y = 0.0, w = 200.0, h = 20.0, text = "abc", hex = "#000000")
let hebGlyphs = glyphify([hebLine], alignCache)
let ltrGlyphs = glyphify([ltrLine], alignCache)
let hebWidthPx = runWidth(shapeBidi(systemSansFontOrEmpty(), [], "{alef}{bet}{gimel}", 20.0))
assert_eq(hebGlyphs.length, 3)
assert(near(hebGlyphs[0].x, 10.0 + 200.0 - hebWidthPx) <= 1.0)
assert(near(ltrGlyphs[0].x, 10.0) <= 1.0)
# a box no wider than the line leaves it at the left edge
let tight = Command(kind = "DrawText", x = 10.0, y = 0.0, w = 5.0, h = 20.0, text = "{alef}{bet}{gimel}", hex = "#000000")
assert(near(glyphify([tight], alignCache)[0].x, 10.0) <= 1.0)

# a text field's origin with the real font: a Hebrew value sits against the right edge, an English one against the left
let fieldTheme = Theme(measurer = EngineMeasurer(font = systemSansFontOrEmpty()))
let hebOrigin = fieldOrigin(fieldTheme.measurer, "{alef}{bet}{gimel}", 0, 160.0, 16.0)
assert(near(hebOrigin, 152.0 - fieldTheme.measurer.width("{alef}{bet}{gimel}", 16.0)) < 0.01)
assert(hebOrigin > 60.0)
assert_eq(fieldOrigin(fieldTheme.measurer, "abc", 0, 160.0, 16.0), 0.0)
# ── mirroring ─────────────────────────────────────────────────────────────────────────────────────
assert_eq(mirrored("a(b)c"), "a)b(c")
assert_eq(mirrored("[x]"), "]x[")
assert_eq(mirrored("<«»>"), ">»«<")
assert_eq(mirrored("abc"), "abc")
assert_eq(mirrored(""), "")
assert_eq(mirrored("{{x}}"), "}}x{{")
# in a right-to-left run an opening parenthesis is drawn as the closing glyph, and a left-to-right run keeps it
let openGlyph = shapeDir(font, "(", 20.0, false)[0].id
let closeGlyph = shapeDir(font, ")", 20.0, false)[0].id
assert(openGlyph != closeGlyph)
assert_eq(shapeDir(font, "(", 20.0, true)[0].id, closeGlyph)
assert_eq(shapeDir(font, ")", 20.0, true)[0].id, openGlyph)
assert_eq(shapeDir(font, "(", 20.0, false)[0].id, openGlyph)
# a Hebrew phrase in parentheses: bidi puts the parentheses at odd level when they sit between Hebrew letters, so they flip
let phrase = shapeBidi(font, [], "{alef}({bet}){gimel}", 20.0)
let phraseIds = idsOf(phrase)
assert_eq(phraseIds.length, 5)
# visual order is right to left: gimel, then the (mirrored) closing parenthesis, bet, then the opening one, then alef: the
# glyph shown for the logical "(" is the closing glyph and the one for ")" is the opening glyph
assert_eq(phraseIds[0], gimelId)
assert_eq(phraseIds[1], openGlyph)
assert_eq(phraseIds[2], betId)
assert_eq(phraseIds[3], closeGlyph)
assert_eq(phraseIds[4], alefId)
# ── line breaking by the engine (UAX #14, swash) ──────────────────────────────────────────────────
assert_eq(lineBreakPoints("ab cd"), [3])
assert_eq(lineBreakPoints("ab cd-ef gh"), [3, 6, 9])
assert_eq(lineBreakPoints("日本語"), [1, 2])
# closing punctuation never starts a line (no break before the 。), a break follows it
assert_eq(lineBreakPoints("日本語。日"), [1, 2, 4])
# no break inside a number or around a dot between letters; a slash and an em dash are break opportunities
assert_eq(lineBreakPoints("1,000"), [])
assert_eq(lineBreakPoints("foo.bar"), [])
assert_eq(lineBreakPoints("a/b"), [2])
assert_eq(lineBreakPoints("e—f"), [1, 2])
assert_eq(lineBreakPoints(""), [])
assert_eq(lineBreakPoints("abc"), [])
# the measurer exposes them, and the fixture font keeps its own simpler rules
let breakMeasurer = Theme(measurer = EngineMeasurer(font = systemSansFontOrEmpty())).measurer
assert_eq(breakMeasurer.breakPoints("http://x.com/p"), [7, 13])
assert_eq(Theme().measurer.breakPoints("ab cd"), [3])
assert_eq(Theme().measurer.breakPoints("http://x.com/p"), [])
# a URL wraps at its slashes with the real breaker, and every line fits when its pieces do
let urlLines = shownLinesAt(breakMeasurer, "http://example.com/some/long/path/segment", 130.0, nil, 8.0, 0)
assert(urlLines.length >= 3)
for l in urlLines:
    assert(breakMeasurer.widthStyled(l, 16.0, 0) <= 130.0)
assert_eq(urlLines.join(""), "http://example.com/some/long/path/segment")
print "bidi ok"
print "styles ok"
