# `.focused(...)` bindings: bool and token, both directions, initial request, conflicts
# (src/core.br syncFocusBindings, src/events.br focusControl). Run: boring run tests/focus_binding_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.events.*

view Form:
    state bool nameFocused = false
    state bool emailFocused = false
    state string token = ""
    state string nameText = ""
    state string emailText = ""

    def askName():
        nameFocused = true

    def askEmail():
        emailFocused = true

    def clearName():
        nameFocused = false

    def setToken(string t):
        token = t

    req string summary():
        "{nameFocused}/{emailFocused}/{token}"

    body():
        Column(alignment = .Leading, spacing = 4.0):
            Focused(value = nameFocused):
                TextField(value = nameText, label = "Name")
            Focused(value = emailFocused):
                TextField(value = emailText, label = "Email")
            FocusedAs(value = token, token = "a"):
                Button(label = "A", onActivate = ():
                    self.setToken("a"))
            FocusedAs(value = token, token = "b"):
                Button(label = "B", onActivate = ():
                    self.setToken("b"))

struct FormBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Form()

def Form__State formState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Form__State else (Form__State())

def string summary(Runtime rt):
    Form().summary(formState(rt))

def [Placed] findAll(Placed p, string kind, string key, string want):
    mut out = []
    if p.kind == kind and (p.props[key] else ("")) == want:
        out.push(p)
    for c in p.children:
        for f in findAll(c, kind, key, want):
            out.push(f)
    out

def Placed named(Runtime rt, string kind, string key, string want):
    let p = layout(rt, 300.0, 300.0)
    findAll(p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0)), kind, key, want)[0]

def int focusedId(Runtime rt):
    if let f = rt.focus:
        return f.id
    -1

def poke(mut Runtime rt, Builder host):
    rt.invalidateRoot()
    assert(rt.flush(host))

let host = ViewRoot(inner = FormBuilder())
mut rt = Runtime()
rt.start(host)
let name = named(rt, "TextField", "label", "Name")
let email = named(rt, "TextField", "label", "Email")
let a = named(rt, "Button", "label", "A")
let b = named(rt, "Button", "label", "B")
assert_eq(summary(rt), "false/false/")
assert_eq(focusedId(rt), -1)

# The application asks: focus moves there (a bool binding true = a request).
mut st = formState(rt)
Form().askName(st)
poke(rt, host)
assert_eq(focusedId(rt), name.id)
assert_eq(summary(rt), "true/false/")

# Native focus moves: both bindings follow in the same transaction (the old one goes off).
assert(keyPress(rt, host, "Tab"))
assert_eq(focusedId(rt), email.id)
assert_eq(summary(rt), "false/true/")

# A new request while another control is focused takes the focus; the loser is written back off.
Form().askName(st)
poke(rt, host)
assert_eq(focusedId(rt), name.id)
assert_eq(summary(rt), "true/false/")

# The application clears its own binding: focus is dropped.
Form().clearName(st)
poke(rt, host)
assert_eq(focusedId(rt), -1)
assert_eq(summary(rt), "false/false/")

# Two simultaneous requests: the first by structural order wins, the other is synchronized back.
Form().askEmail(st)
Form().askName(st)
poke(rt, host)
assert_eq(focusedId(rt), name.id)
assert_eq(summary(rt), "true/false/")

# ── token bindings: several controls share one bound value ───────────────────────────────────────

assert(keyPress(rt, host, "Tab"))                      # Name -> Email
assert(keyPress(rt, host, "Tab"))                      # Email -> A
assert_eq(focusedId(rt), a.id)
assert_eq(summary(rt), "false/false/a")                # a control holding focus writes its token
assert(keyPress(rt, host, "Tab"))                      # A -> B
assert_eq(summary(rt), "false/false/b")                # the token moves, one owner at a time
Form().setToken("a", st)                               # the application picks a control by token
poke(rt, host)
assert_eq(focusedId(rt), a.id)
assert_eq(summary(rt), "false/false/a")
Form().setToken("", st)                                # clearing the token drops focus
poke(rt, host)
assert_eq(focusedId(rt), -1)

# A pointer press focuses and writes the binding too.
assert(pointerDown(rt, host, layout(rt, 300.0, 300.0) else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0)), b.x + 2.0, b.y + 2.0))
assert_eq(summary(rt), "false/false/b")
assert_eq(rt.errors.length, 0)

print "focus binding ok"
