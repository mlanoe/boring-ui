# MultiList: multiple selection by row key — plain/toggle/range clicks, Shift-arrows, SelectAll, deletion of the
# selected rows, pruning of keys that disappear (draft, "List, selection, deletion, and reordering").
# Run: boring run tests/multi_list_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.semantics.*
use ui.scene.*
use ui.events.*

pub struct Item:
    pub int id
    pub string title

view Files:
    state [Item] items = [Item(id = 1, title = "a"), Item(id = 2, title = "b"), Item(id = 3, title = "c"), Item(id = 4, title = "d"), Item(id = 5, title = "e")]
    state {string} picked = {}

    def dropAt([int] indices):
        items.removeIndices(indices)

    def forget(int id):
        var at = -1
        for i in 0..<items.length:
            if items[i].id == id:
                at = i
        if at >= 0:
            items.removeIndices([at])

    req string chosen():
        mut [string] keys = []
        for item in items:
            if picked.contains("{item.id}"):
                keys.push("{item.id}")
        keys.join(",")

    body():
        Frame(height = 200.0):
            MultiList(selection = picked, onDelete = (indices): self.dropAt(indices)):
                for item in items with item.id:
                    Text(item.title)

struct FilesBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Files()

def Placed lay(Runtime rt):
    let p = layout(rt, 200.0, 400.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def Files__State state(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Files__State else (Files__State())

def string chosen(Runtime rt):
    Files().chosen(state(rt))

def bool rowClick(mut Runtime rt, Builder host, int row, string mods):
    let rows = ofKind(lay(rt), "MultiList")[0].children
    clickWith(rt, host, lay(rt), rows[row].x + 2.0, rows[row].y + 2.0, mods)

let host = ViewRoot(inner = FilesBuilder())
mut rt = Runtime()
rt.start(host)

# A plain click selects one row; a toggle click adds, another removes; a range click spans from the anchor.
assert(rowClick(rt, host, 1, ""))
assert_eq(chosen(rt), "2")
assert(rowClick(rt, host, 3, "Toggle"))
assert_eq(chosen(rt), "2,4")
assert(rowClick(rt, host, 1, "Toggle"))
assert_eq(chosen(rt), "4")
assert(rowClick(rt, host, 3, ""))
assert(rowClick(rt, host, 0, "Range"))
assert_eq(chosen(rt), "1,2,3,4")
assert(rowClick(rt, host, 0, ""))
assert_eq(chosen(rt), "1")

# The semantic tree reports the selected keys.
assert_eq(semantics(lay(rt)).roots[0].role, "list")

# Shift-arrows extend from the anchor; plain arrows collapse to one row; SelectAll takes everything.
assert(keyPress(rt, host, "ShiftDown"))
assert(keyPress(rt, host, "ShiftDown"))
assert_eq(chosen(rt), "1,2,3")
assert(keyPress(rt, host, "ShiftUp"))
assert_eq(chosen(rt), "1,2")
assert(keyPress(rt, host, "Down"))
assert_eq(chosen(rt), "3")
assert(keyPress(rt, host, "SelectAll"))
assert_eq(chosen(rt), "1,2,3,4,5")

# Delete removes every selected row as one snapshot; the remaining selection is pruned.
assert(rowClick(rt, host, 1, ""))
assert(rowClick(rt, host, 3, "Toggle"))
assert_eq(chosen(rt), "2,4")
assert(keyPress(rt, host, "Delete"))
assert_eq(state(rt).items.length, 3)
assert_eq(chosen(rt), "")

# A key that disappears from the model is dropped from the selection (intersected with the remaining keys).
assert(rowClick(rt, host, 0, ""))
assert(rowClick(rt, host, 2, "Toggle"))
assert_eq(chosen(rt), "1,5")
Files().forget(5, state(rt))
rt.invalidateRoot()
assert(rt.flush(host))
assert_eq(chosen(rt), "1")
print("multi list ok")

# Selected rows are painted with the theme's selection color, behind their content.
assert(rowClick(rt, host, 0, ""))
var bands = 0
for c in displayList(lay(rt)):
    if c.color == "selected":
        bands += 1
        assert_eq(c.hex, "#B3D7FF")
assert_eq(bands, 1)
assert(rowClick(rt, host, 1, "Range"))
var bands2 = 0
for c in displayList(lay(rt)):
    if c.color == "selected":
        bands2 += 1
assert_eq(bands2, 2)
print("selection highlight ok")
