# ColorPicker: three bound channels, a swatch, sliders and presets (src/controls.br).
# Run: boring run tests/color_picker_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.controls.*
use ui.events.*

assert_eq(colorHex(0.0, 0.0, 0.0), "#000000")
assert_eq(colorHex(255.0, 255.0, 255.0), "#ffffff")
assert_eq(colorHex(255.0, 59.0, 48.0), "#ff3b30")
assert_eq(colorHex(300.0, -5.0, 16.9), "#ff0010")

view Page:
    state float r = 10.0
    state float g = 20.0
    state float b = 30.0

    req string current():
        colorHex(r, g, b)

    body():
        ColorPicker(red = r, green = g, blue = b, label = "Fill")

struct PageBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Page()

def Placed lay(Runtime rt):
    let p = layout(rt, 400.0, 400.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] findAll(Placed p, string kind, string key, string want):
    mut out = []
    if p.kind == kind and (p.props[key] else ("")) == want:
        out.push(p)
    for c in p.children:
        for f in findAll(c, kind, key, want):
            out.push(f)
    out

def Placed named(Runtime rt, string kind, string key, string want):
    findAll(lay(rt), kind, key, want)[0]

def int count(Runtime rt, string kind, string key, string want):
    findAll(lay(rt), kind, key, want).length

def Page__State pageState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Page__State else (Page__State())

let host = ViewRoot(inner = PageBuilder())
mut rt = Runtime()
rt.start(host)

# the swatch paints the current color and the value is shown
assert_eq(count(rt, "Background", "color", "#0a141e"), 1)
assert_eq(count(rt, "Text", "content", "#0a141e"), 1)
assert_eq(count(rt, "Slider", "label", "Fill red"), 1)

# a preset writes all three bound channels
let bluePreset = named(rt, "Button", "label", "Blue")
assert(click(rt, host, lay(rt), bluePreset.x + 2.0, bluePreset.y + 2.0))
assert_eq(Page().current(pageState(rt)), "#007aff")
assert_eq(count(rt, "Background", "color", "#007aff"), 1)
assert_eq(count(rt, "Text", "content", "#007aff"), 1)

# dragging the red slider to its right end writes 255 into the bound channel
let redSlider = named(rt, "Slider", "label", "Fill red")
assert(pointerDown(rt, host, lay(rt), redSlider.x + redSlider.w - 0.1, redSlider.y + redSlider.h / 2.0))
_ = pointerUp(rt, host, lay(rt), redSlider.x + redSlider.w - 0.1, redSlider.y + redSlider.h / 2.0)
assert_eq(Page().current(pageState(rt)), "#ff7aff")
print("color_picker_test ok")
