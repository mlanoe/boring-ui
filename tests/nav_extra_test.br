# Tests for Breadcrumb, Pagination, ChipGroup, and SplitPane (src/controls.br).
# Run: boring run tests/nav_extra_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.controls.*
use ui.events.*

view Panel:
    state [string] trail = ["Home", "Projects", "boring-ui"]
    state int crumbClicked = -1
    state int page = 1
    state [string] chosenChips = ["Rust"]

    def pickCrumb(int i):
        crumbClicked = i

    def setPage(int p):
        page = p

    def toggleChip(string name):
        if chosenChips.contains(name):
            mut idx = [] as [int]
            for i in 0..<chosenChips.length:
                if chosenChips[i] == name:
                    idx.push(i)
            chosenChips.removeIndices(idx)
        else:
            chosenChips.push(name)

    req int lastCrumb():
        crumbClicked

    req int currentPage():
        page

    req [string] chips():
        chosenChips

    body():
        Column(alignment = .Leading, spacing = 10.0):
            Breadcrumb(items = trail, onSelect = (i):
                self.pickCrumb(i))
            Pagination(page = page, totalPages = 5, onChange = (p):
                self.setPage(p))
            ChipGroup(options = ["Rust", "GPU", "UI"], selected = chosenChips, onToggle = (name):
                self.toggleChip(name))
            SplitPane(width = 400.0, initialRatio = 0.25, minRatio = 0.15, maxRatio = 0.85):
                Text(content = "Left pane")
                Text(content = "Right pane")

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed lay(Runtime rt):
    let p = layout(rt, 500.0, 400.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def Placed? buttonByLabel(Runtime rt, string label):
    for b in ofKind(lay(rt), "Button"):
        if (b.props["label"] else ("")) == label:
            return b
    nil

def Placed? textByContent(Runtime rt, string content):
    for t in ofKind(lay(rt), "Text"):
        if (t.props["content"] else ("")) == content:
            return t
    nil

def Panel__State panelState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Panel__State else (Panel__State())

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)

# 1. Breadcrumb: intermediate items are buttons, last item is bold Text
assert(buttonByLabel(rt, "Home") != nil)
assert(buttonByLabel(rt, "Projects") != nil)
assert(buttonByLabel(rt, "boring-ui") == nil)
assert(textByContent(rt, "boring-ui") != nil)
let projBtn = buttonByLabel(rt, "Projects") else (lay(rt))
assert(click(rt, host, lay(rt), projBtn.x + 2.0, projBtn.y + 2.0))
assert_eq(Panel().lastCrumb(panelState(rt)), 1)

# 2. Pagination: Prev is disabled on page 1; Next advances to page 2; clicking "4" jumps to 4
let prevBtn = buttonByLabel(rt, "‹ Prev") else (lay(rt))
assert(!click(rt, host, lay(rt), prevBtn.x + 2.0, prevBtn.y + 2.0))
assert_eq(Panel().currentPage(panelState(rt)), 1)
let nextBtn = buttonByLabel(rt, "Next ›") else (lay(rt))
assert(click(rt, host, lay(rt), nextBtn.x + 2.0, nextBtn.y + 2.0))
assert_eq(Panel().currentPage(panelState(rt)), 2)
let page4Btn = buttonByLabel(rt, "4") else (lay(rt))
assert(click(rt, host, lay(rt), page4Btn.x + 2.0, page4Btn.y + 2.0))
assert_eq(Panel().currentPage(panelState(rt)), 4)

# 3. ChipGroup: "Rust" starts Primary, "UI" starts Secondary; clicking "UI" toggles it to Primary
let rustBtn0 = buttonByLabel(rt, "Rust") else (lay(rt))
let uiBtn0 = buttonByLabel(rt, "UI") else (lay(rt))
assert_eq(rustBtn0.props["style"] else (""), "Primary")
assert_eq(uiBtn0.props["style"] else (""), "Secondary")
assert(click(rt, host, lay(rt), uiBtn0.x + 2.0, uiBtn0.y + 2.0))
let uiBtn1 = buttonByLabel(rt, "UI") else (lay(rt))
assert_eq(uiBtn1.props["style"] else (""), "Primary")
assert(click(rt, host, lay(rt), rustBtn0.x + 2.0, rustBtn0.y + 2.0))
let rustBtn1 = buttonByLabel(rt, "Rust") else (lay(rt))
assert_eq(rustBtn1.props["style"] else (""), "Secondary")

# 4. SplitPane: dragging the "⋮" divider rightwards widens the left pane and shifts the right pane
let rightBefore = textByContent(rt, "Right pane") else (lay(rt))
let divider = textByContent(rt, "⋮") else (lay(rt))
_ = pointerDown(rt, host, lay(rt), divider.x + 2.0, divider.y + 2.0)
_ = pointerMove(rt, host, lay(rt), divider.x + 82.0, divider.y + 2.0)
_ = pointerUp(rt, host, lay(rt), divider.x + 82.0, divider.y + 2.0)
let rightAfter = textByContent(rt, "Right pane") else (lay(rt))
assert(rightAfter.x > rightBefore.x + 50.0)

print "nav_extra_test ok"
