# The Todo application driven end to end, headlessly: mount, layout, display list, accessibility tree,
# pointer and keyboard input, semantic actions — through List, Sheet, Focused, DefaultAction, Disabled.
# Run: boring run tests/todo_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.semantics.*
use ui.events.*
use todo.todo.*

struct AppRoot as ViewBuilder:
    req View buildView(mut Runtime rt): TodoApp()

def Placed must(Placed? p):
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def Placed lay(Runtime rt):
    must(layout(rt, 600.0, 600.0))

# Every placed node of `kind` whose prop `key` equals `want`, in structural order.
def [Placed] findAll(Placed p, string kind, string key, string want):
    mut [Placed] out = []
    let have = p.props[key] else ("")
    if p.kind == kind and have == want:
        out.push(p)
    for c in p.children:
        for f in findAll(c, kind, key, want):
            out.push(f)
    out

def Placed nth(Runtime rt, string kind, string key, string want, int n):
    let all = findAll(lay(rt), kind, key, want)
    all[n]

def int countOf(Runtime rt, string kind, string key, string want):
    findAll(lay(rt), kind, key, want).length

def bool press(mut Runtime rt, Builder host, Placed p):
    click(rt, host, lay(rt), p.x + 2.0, p.y + 2.0)

# The row titles in order, read from the TextFields' bound values.
def string titles(Runtime rt):
    mut [string] out = []
    for p in findAll(lay(rt), "TextField", "label", "Item title"):
        out.push(p.props["value"] else (""))
    out.join("|")

def Placed listNode(Runtime rt):
    findAll(lay(rt), "List", "selection", "")[0]

def string chosenKey(Runtime rt):
    let all = findAll(lay(rt), "List", "kind", "")
    var found = ""
    for p in all:
        found = p.props["selection"] else ("")
    found

# A click on a row's own background (the gap between its toggle and its title field): selects the row.
def bool selectRow(mut Runtime rt, Builder host, int index):
    let list = findAll(lay(rt), "List", "scroll", "0")[0]
    let row = list.children[index]
    click(rt, host, lay(rt), row.x + 104.0, row.y + 12.0)

def int focusedId(Runtime rt):
    if let f = rt.focus:
        return f.id
    -1

let host = ViewRoot(inner = AppRoot())
mut rt = Runtime()
rt.start(host)
assert_eq(rt.errors.length, 0)

# ── mounts: two rows, no sheet content ───────────────────────────────────────────────────────

assert_eq(titles(rt), "Design boring-ui|Implement the vertical slice")
assert_eq(countOf(rt, "TextField", "label", "Title"), 0)
let tree = semantics(lay(rt))
assert_eq(tree.errors.length, 0)
let text = describeTree(tree.roots, 0).join("\n")
assert(text.contains("button 'Add'"))
assert(text.contains("list"))

# ── add through the sheet: focus lands in the title field, Add is disabled while it is blank ─────

let addButton = nth(rt, "Button", "label", "Add", 0)
assert(press(rt, host, addButton), "header Add opens the sheet")
assert_eq(rt.openSheets.length, 1)
assert_eq(semantics(lay(rt)).roots[0].role, "dialog")
let titleField = nth(rt, "TextField", "label", "Title", 0)
assert_eq(focusedId(rt), titleField.id)                               # Focused(titleFocused = true) requested it
let sheetAdd = nth(rt, "Button", "label", "Add", 1)
assert(isDisabled(rt, sheetAdd.id))                                   # blank title: not activatable
assert(!keyPress(rt, host, "Enter"))                                  # the default action is disabled too
assert_eq(titles(rt), "Design boring-ui|Implement the vertical slice")
assert(typeText(rt, host, "Write "))
assert(typeText(rt, host, "tests"))
assert(!isDisabled(rt, nth(rt, "Button", "label", "Add", 1).id))
assert(keyPress(rt, host, "Enter"))                                   # Add is the sheet's default action
assert_eq(titles(rt), "Design boring-ui|Implement the vertical slice|Write tests")
assert_eq(rt.openSheets.length, 0)
assert_eq(countOf(rt, "TextField", "label", "Title"), 0)              # the sheet and its draft are gone
assert_eq(focusedId(rt), addButton.id)                                # focus went back to the header Add

# ── cancel (Escape) destroys the draft ───────────────────────────────────────────────────────

assert(press(rt, host, nth(rt, "Button", "label", "Add", 0)))
assert(typeText(rt, host, "never saved"))
assert_eq(nth(rt, "TextField", "label", "Title", 0).props["value"] else (""), "never saved")
assert(keyPress(rt, host, "Escape"))                                  # the sheet's Cancel button
assert_eq(countOf(rt, "TextField", "label", "Title"), 0)
assert(press(rt, host, nth(rt, "Button", "label", "Add", 0)))         # reopen: a new lifetime, a fresh draft
assert_eq(nth(rt, "TextField", "label", "Title", 0).props["value"] else (""), "")
assert(keyPress(rt, host, "Escape"))
assert_eq(titles(rt), "Design boring-ui|Implement the vertical slice|Write tests")

# ── edit in place, toggle ────────────────────────────────────────────────────────────────────

assert(press(rt, host, nth(rt, "TextField", "label", "Item title", 1)), "focus row 2")
assert(keyPress(rt, host, "End"))
assert(typeText(rt, host, "!"))
assert_eq(titles(rt), "Design boring-ui|Implement the vertical slice!|Write tests")
assert(press(rt, host, nth(rt, "Toggle", "label", "Completed", 0)))
let sem = describeTree(semantics(lay(rt)).roots, 0).join("\n")
assert(sem.contains("toggle 'Completed' value='true'"), sem)

# ── select row 2, then reorder with the keyboard: the row (and the focus inside it) keep identity ──

assert(press(rt, host, nth(rt, "TextField", "label", "Item title", 1)))   # focus row 2's title again
let editedField = nth(rt, "TextField", "label", "Item title", 1)
let focusBefore = rt.focus else (Handle(id = -1, generation = -1))
assert_eq(focusBefore.id, editedField.id)
assert(selectRow(rt, host, 1))
assert_eq(chosenKey(rt), "2")
assert_eq(focusedId(rt), editedField.id)                              # selecting a row did not steal focus
assert(keyPress(rt, host, "AltUp"))                                   # onMove(1, 0)
assert_eq(titles(rt), "Implement the vertical slice!|Design boring-ui|Write tests")
let movedField = nth(rt, "TextField", "label", "Item title", 0)       # same node, now first
assert_eq(movedField.id, editedField.id)
assert(rt.valid(focusBefore), "focus handle still valid after the move")
assert_eq(focusedId(rt), editedField.id)
assert_eq(chosenKey(rt), "2")                                         # the selection follows the key

# ── delete through the row's own button ─────────────────────────────────────────────────────────

assert(press(rt, host, nth(rt, "Button", "label", "Delete", 2)))      # "Write tests"
assert_eq(titles(rt), "Implement the vertical slice!|Design boring-ui")
assert(!rt.valid(rt.focus else (Handle(id = -1, generation = -1))) or rt.focus != nil)

# ── delete: with focus outside a text field, Delete removes the selected row ──────────────────────

rt.focus = nil
assert(keyPress(rt, host, "Delete"))                                  # onDelete([0])
assert_eq(titles(rt), "Design boring-ui")
assert_eq(chosenKey(rt), "")                                          # the removed key's selection was cleared
assert(!rt.valid(focusBefore), "the deleted row's handle is stale")
assert(rt.focus == nil)

# ── keyboard: Tab goes through the enabled controls in order; Space opens the sheet ─────────────

assert(keyPress(rt, host, "Tab"))
assert_eq(focusedId(rt), nth(rt, "Button", "label", "Add", 0).id)     # the header Add comes first
assert(keyPress(rt, host, "Space"))
assert_eq(rt.openSheets.length, 1)
assert_eq(focusOrder(rt).length, 2)                                   # Title, Cancel (Add is disabled while blank): the sheet traps traversal
assert(keyPress(rt, host, "Escape"))

# ── the whole thing paints and stays accessible ───────────────────────────────────────────────

assert(displayList(lay(rt)).length > 10)
assert_eq(semantics(lay(rt)).errors.length, 0)
assert_eq(rt.errors.length, 0)

print "todo ok"
