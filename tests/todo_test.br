# The Todo application driven end to end, headlessly: mount, layout, display list, accessibility
# tree, pointer and keyboard input, semantic actions. Run: boring run tests/todo_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.semantics.*
use ui.events.*
use todo.todo.*

struct AppRoot as ViewBuilder:
    req View buildView(mut Runtime rt): TodoApp()

def Placed must(Placed? p):
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def Placed lay(Runtime rt):
    must(layout(rt, 600.0, 600.0))

# Every placed node of `kind` whose prop `key` equals `want`, in structural order.
def [Placed] findAll(Placed p, string kind, string key, string want):
    mut [Placed] out = []
    let have = p.props[key] else ("")
    if p.kind == kind and have == want:
        out.push(p)
    for c in p.children:
        for f in findAll(c, kind, key, want):
            out.push(f)
    out

def Placed nth(Runtime rt, string kind, string key, string want, int n):
    let all = findAll(lay(rt), kind, key, want)
    all[n]

def bool press(mut Runtime rt, Builder host, Placed p):
    click(rt, host, lay(rt), p.x + 2.0, p.y + 2.0)

# The row titles in order, read from the TextFields' bound values.
def string titles(Runtime rt):
    mut [string] out = []
    for p in findAll(lay(rt), "TextField", "label", "Item title"):
        out.push(p.props["value"] else (""))
    out.join("|")

def int rowCount(Runtime rt):
    findAll(lay(rt), "TextField", "label", "Item title").length

let host = ViewRoot(inner = AppRoot())
mut rt = Runtime()
rt.start(host)
assert_eq(rt.errors.length, 0)

# ── mounts: two rows, nothing else ───────────────────────────────────────────────────────────

assert_eq(titles(rt), "Design boring-ui|Implement the vertical slice")
assert_eq(findAll(lay(rt), "TextField", "label", "Title").length, 0)     # no form yet

# The accessibility tree is complete and valid: every interactive node is named.
let tree = semantics(lay(rt))
assert_eq(tree.errors.length, 0)
assert(describeTree(tree.roots, 0).join("\n").contains("button 'Add'"))

# ── add: open the form, type, confirm ────────────────────────────────────────────────────────

assert(press(rt, host, nth(rt, "Button", "label", "Add", 0)), "header Add")
assert_eq(findAll(lay(rt), "TextField", "label", "Title").length, 1)     # the form is mounted
assert(press(rt, host, nth(rt, "TextField", "label", "Title", 0)), "focus the title field")
assert(typeText(rt, host, "Write "))
assert(typeText(rt, host, "tests"))
assert(press(rt, host, nth(rt, "Button", "label", "Add", 1)), "confirm Add")
assert_eq(titles(rt), "Design boring-ui|Implement the vertical slice|Write tests")
assert_eq(findAll(lay(rt), "TextField", "label", "Title").length, 0)     # the form closed itself

# An empty title is refused and keeps the form open.
assert(press(rt, host, nth(rt, "Button", "label", "Add", 0)))
assert(press(rt, host, nth(rt, "Button", "label", "Add", 1)))
assert_eq(rowCount(rt), 3)
assert_eq(findAll(lay(rt), "TextField", "label", "Title").length, 1)

# ── cancel destroys the draft ────────────────────────────────────────────────────────────────

assert(press(rt, host, nth(rt, "TextField", "label", "Title", 0)))
assert(typeText(rt, host, "never saved"))
assert_eq(nth(rt, "TextField", "label", "Title", 0).props["value"] else (""), "never saved")
assert(press(rt, host, nth(rt, "Button", "label", "Cancel", 0)))
assert_eq(findAll(lay(rt), "TextField", "label", "Title").length, 0)
assert(press(rt, host, nth(rt, "Button", "label", "Add", 0)))             # reopen: a fresh draft
assert_eq(nth(rt, "TextField", "label", "Title", 0).props["value"] else (""), "")
assert(press(rt, host, nth(rt, "Button", "label", "Cancel", 0)))

# ── edit in place, toggle ────────────────────────────────────────────────────────────────────

assert(press(rt, host, nth(rt, "TextField", "label", "Item title", 1)), "focus row 2")
assert(keyPress(rt, host, "End"))                                         # the caret goes where the click put it: move it to the end
assert(typeText(rt, host, "!"))
assert_eq(titles(rt), "Design boring-ui|Implement the vertical slice!|Write tests")
assert(press(rt, host, nth(rt, "Toggle", "label", "Completed", 0)))
let sem = describeTree(semantics(lay(rt)).roots, 0).join("\n")
assert(sem.contains("toggle 'Completed' value='true'"), sem)

# ── reorder: Up on row 3 moves it above row 2 — row identity and focus survive ────────────────

assert(press(rt, host, nth(rt, "TextField", "label", "Item title", 1)))   # focus row 2
let editedField = nth(rt, "TextField", "label", "Item title", 1)
let focusBefore = rt.focus else (Handle(id = -1, generation = -1))
assert_eq(focusBefore.id, editedField.id)
# A semantic action (as from a screen reader) does not move keyboard focus; a pointer press would.
let upHandle = rt.handle(nth(rt, "Button", "label", "Up", 2).id) else (Handle(id = -1, generation = -1))
assert(act(rt, host, upHandle, "activate", ""))
assert_eq(titles(rt), "Design boring-ui|Write tests|Implement the vertical slice!")
let movedField = nth(rt, "TextField", "label", "Item title", 2)           # same node, now third
assert_eq(movedField.id, editedField.id)                                   # identity preserved
assert(rt.valid(focusBefore), "focus handle still valid after the move")
assert_eq((rt.focus else (Handle(id = -2, generation = -2))).id, editedField.id)

# ── delete: the row's identity is gone; deleting the focused row clears focus ─────────────────

assert(press(rt, host, nth(rt, "Button", "label", "Delete", 2)))
assert_eq(titles(rt), "Design boring-ui|Write tests")
assert(!rt.valid(focusBefore), "the deleted row's handle is stale")
assert(rt.focus == nil, "focus cleared with the focused node")

# ── keyboard: tab through the interface and activate with Space ───────────────────────────────

assert(keyPress(rt, host, "Tab"))
let first = rt.focus else (Handle(id = -1, generation = -1))
assert_eq(first.id, nth(rt, "Button", "label", "Add", 0).id)              # the header Add comes first
assert(keyPress(rt, host, "Space"))                                             # opens the form
assert_eq(findAll(lay(rt), "TextField", "label", "Title").length, 1)

# ── semantic actions behave like input ───────────────────────────────────────────────────────

let select = nth(rt, "Button", "label", "Select", 0)
let selectHandle = rt.handle(select.id) else (Handle(id = -1, generation = -1))
assert(act(rt, host, selectHandle, "activate", ""))

# ── the whole thing paints and stays accessible ───────────────────────────────────────────────

assert(displayList(lay(rt)).length > 10)
assert_eq(semantics(lay(rt)).errors.length, 0)
assert_eq(rt.errors.length, 0)

print "todo ok"
