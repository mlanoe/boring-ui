# Pointer hover (src/events.br pointerMove / pointerLeave, Runtime.hover, withHover in layout.br, the shade in
# scene.br). Run: boring run tests/hover_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.events.*

view Panel:
    state int taps = 0
    state bool on = false

    body():
        Column(alignment = .Leading, spacing = 8.0):
            Button(label = "A", onActivate = ():
                taps += 1)
            Button(label = "B", onActivate = ():
                taps += 1)
            Disabled(value = true):
                Button(label = "C", onActivate = ():
                    taps += 1)
            Toggle(value = on, label = "on")
            Text("{taps}")

struct PanelRoot as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed must(Placed? p):
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def Placed lay(Runtime rt):
    must(layout(rt, 200.0, 200.0))

def Placed? find(Placed p, string kind, string label):
    if p.kind == kind and (p.props["label"] else ("")) == label:
        return p
    for c in p.children:
        if let f = find(c, kind, label):
            return f
    nil

def Placed at(Runtime rt, string kind, string label):
    must(find(lay(rt), kind, label))

# The shades the painter drew for hovered controls, as "x,y WxH".
def [string] shades(Runtime rt):
    mut out = []
    for c in displayList(lay(rt)):
        if c.kind == "FillRect" and c.color == "hover":
            out.push("{c.x},{c.y} {c.w}x{c.h}")
    out

def bool moveTo(mut Runtime rt, Builder host, Placed target):
    pointerMove(rt, host, lay(rt), target.x + 2.0, target.y + 2.0)

let host = ViewRoot(inner = PanelRoot())
mut rt = Runtime()
rt.start(host)
assert_eq(rt.errors.length, 0)

# Nothing is hovered until the pointer moves over a control.
assert_eq(shades(rt).length, 0)
let a = at(rt, "Button", "A")
let b = at(rt, "Button", "B")
let c = at(rt, "Button", "C")
let toggle = at(rt, "Toggle", "on")

# Over a button: it is hovered and shaded over its own bounds; the layout does not move.
assert(moveTo(rt, host, a))
assert_eq(shades(rt).length, 1)
assert_eq(shades(rt)[0], "{a.x},{a.y} {a.w}x{a.h}")
assert_eq(at(rt, "Button", "A").x, a.x)
assert_eq(at(rt, "Button", "A").h, a.h)
if let h = rt.hover:
    assert_eq(h.id, a.id)
else:
    assert(false, "hover is set")

# Moving within the same control changes nothing: no update pass, nothing reported.
assert(!pointerMove(rt, host, lay(rt), a.x + 3.0, a.y + 3.0))

# To the next control: one shade, now on B.
assert(moveTo(rt, host, b))
assert_eq(shades(rt).length, 1)
assert_eq(shades(rt)[0], "{b.x},{b.y} {b.w}x{b.h}")

# A disabled control is never hovered (and leaving B for it clears the hover).
assert(moveTo(rt, host, c))
assert_eq(shades(rt).length, 0)
assert(rt.hover == nil)

# A toggle's shade covers its box only, not its label.
assert(moveTo(rt, host, toggle))
assert_eq(shades(rt).length, 1)
assert(shades(rt)[0].startsWith("{toggle.x},{toggle.y} "))
assert(shades(rt)[0].endsWith(" 20x20"))

# Over text or empty space nothing is hovered; moving there from a control clears it.
assert(pointerMove(rt, host, lay(rt), 190.0, 190.0))
assert_eq(shades(rt).length, 0)
assert(!pointerMove(rt, host, lay(rt), 191.0, 191.0))

# The pointer leaving the window clears the hover once.
assert(moveTo(rt, host, a))
assert(pointerLeave(rt, host))
assert_eq(shades(rt).length, 0)
assert(!pointerLeave(rt, host))

# Pressing and releasing still activates (hover does not interfere with capture).
assert(moveTo(rt, host, a))
assert(click(rt, host, lay(rt), a.x + 2.0, a.y + 2.0))
assert_eq(rt.errors.length, 0)

print "hover ok"
