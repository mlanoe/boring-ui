# Lifecycle hooks (`OnMount`, `OnUnmount`) and identity-scoped tasks (`OnTask`) through the core:
# hook order, run-once, task start only after a stable commit, `id` restarts with stale generations,
# cancellation on unmount, and delivery of late results.
# Run: boring run tests/core_hooks_test.br

use boring.ui.*
use ui.core.*

view Page:
    state [string] log = []
    state bool show = true
    state string query = "a"
    state [TaskRun] runs = []

    def note(string line):
        log.push(line)

    def started(TaskRun run):
        log.push("task {run.id}")
        runs.push(run)

    # (A loop, not `log.join(",")`: `boring build` mis-emits `join` on a state field.)
    req string lines():
        var out = ""
        for l in log:
            if out == "":
                out = l
            else:
                out = "{out},{l}"
        out

    req int runCount():
        runs.length

    req TaskRun runAt(int i):
        runs[i]

    body():
        Column(alignment = .Center, spacing = nil):
            if show:
                OnMount(onMount = ():
                    self.note("mount outer")):
                    OnUnmount(onUnmount = ():
                        self.note("unmount outer")):
                        OnMount(onMount = ():
                            self.note("mount inner")):
                            OnUnmount(onUnmount = ():
                                self.note("unmount inner")):
                                OnTask(id = query, onTask = (run):
                                    self.started(run)):
                                    Text("x")
            Text("always")

struct PageBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Page()

def Page__State pageState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Page__State else (Page__State())

def string lines(Runtime rt):
    Page().lines(pageState(rt))

def poke(mut Runtime rt, Builder host):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    assert(rt.invalidate(h), "invalidate")
    assert(rt.flush(host), "flush")

let host = ViewRoot(inner = PageBuilder())
mut rt = Runtime()
rt.start(host)

# Mount hooks run once, in structural preorder (outermost modifier first), then the task starts —
# after those hooks and the update they caused were stable.
assert_eq(lines(rt), "mount outer,mount inner,task a")
assert_eq(Page().runCount(pageState(rt)), 1)
let run1 = Page().runAt(0, pageState(rt))
assert(rt.isCurrent(run1))
assert_eq(run1.id, "a")

# A plain rebuild restarts nothing and re-runs no hook.
poke(rt, host)
assert_eq(lines(rt), "mount outer,mount inner,task a")

# Changing the task id cancels the old run (its generation goes stale) and starts a new one; the
# view itself never remounted, so no mount hook ran again.
mut st = pageState(rt)
st.query = "b"
poke(rt, host)
assert_eq(lines(rt), "mount outer,mount inner,task a,task b")
let run2 = Page().runAt(1, pageState(rt))
assert(!rt.isCurrent(run1), "old run is stale")
assert(rt.isCurrent(run2))

# A late result of the old run is dropped and reported; the current run's is applied in one pass.
mut late = pageState(rt)
assert(!rt.deliver(run1, host, ():
    Page().note("late old", late)), "stale delivery refused")
assert_eq(rt.errors.length, 1)
let passesBefore = rt.passesRun
assert(rt.deliver(run2, host, ():
    Page().note("late new", late)), "current delivery accepted")
assert_eq(rt.passesRun, passesBefore + 1)
assert_eq(lines(rt), "mount outer,mount inner,task a,task b,late new")

# Unmount: the task is cancelled before the first hook, hooks run innermost modifier first, and a
# late delivery cannot reach the dead identity.
mut st2 = pageState(rt)
st2.show = false
poke(rt, host)
assert_eq(lines(rt), "mount outer,mount inner,task a,task b,late new,unmount inner,unmount outer")
assert(!rt.isCurrent(run2), "cancelled by unmount")
assert(!rt.deliver(run2, host, ():
    Page().note("late after unmount", late)))
assert_eq(lines(rt), "mount outer,mount inner,task a,task b,late new,unmount inner,unmount outer")

# Mounting it again is a new lifetime: hooks and a fresh task run again (the id is still "b").
mut st3 = pageState(rt)
st3.show = true
poke(rt, host)
assert_eq(lines(rt), "mount outer,mount inner,task a,task b,late new,unmount inner,unmount outer,mount outer,mount inner,task b")

# `OnMount` that removes its own subtree starts no task for it.
view Quick:
    state [string] log = []
    state bool alive = true

    def gone():
        log.push("mounted")
        alive = false

    def ran():
        log.push("task")

    # (A loop, not `log.join(",")`: `boring build` mis-emits `join` on a state field.)
    req string lines():
        var out = ""
        for l in log:
            if out == "":
                out = l
            else:
                out = "{out},{l}"
        out

    body():
        Column(alignment = .Center, spacing = nil):
            if alive:
                OnMount(onMount = ():
                    self.gone()):
                    OnTask(id = "", onTask = (run):
                        self.ran()):
                        Text("q")

struct QuickBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Quick()

let qhost = ViewRoot(inner = QuickBuilder())
mut qrt = Runtime()
qrt.start(qhost)
let qh = qrt.handle(1) else (Handle(id = -1, generation = -1))
let qbox = qrt.stateOf(qh) else (NoState())
mut qst = qbox as Quick__State else (Quick__State())
assert_eq(Quick().lines(qst), "mounted")
assert_eq(qrt.errors.length, 0)

print "core hooks ok"
