# Programmatic scrolling: Scroll(anchor, request) + ScrollAnchor (events.br applyScrollRequests).
# Run: boring run tests/scroll_request_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.events.*

view Panel:
    state int request = 0
    state string target = "c"

    req int current():
        request

    def jump(string name):
        target = name
        request += 1

    body():
        Column(alignment = .Leading, spacing = 0.0):
            Button(label = "go", onActivate = ():
                self.jump("c"))
            Button(label = "goB", onActivate = ():
                self.jump("b"))
            Button(label = "goTail", onActivate = ():
                self.jump("tail"))
            Frame(height = 60.0):
                Scroll(anchor = target, request = request):
                    Column(alignment = .Leading, spacing = 0.0):
                        ScrollAnchor(name = "a"):
                            Frame(height = 40.0):
                                Text(content = "a")
                        ScrollAnchor(name = "b"):
                            Frame(height = 40.0):
                                Text(content = "b")
                        ScrollAnchor(name = "c"):
                            Frame(height = 40.0):
                                Text(content = "c")
                        ScrollAnchor(name = "tail"):
                            Frame(height = 40.0):
                                Text(content = "tail")

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed lay(Runtime rt):
    let p = layout(rt, 200.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def float anchorTop(Runtime rt, string name):
    let p = lay(rt)
    let scroller = ofKind(p, "Scroll")[0]
    for a in ofKind(p, "ScrollAnchor"):
        if (a.props["name"] else ("")) == name:
            return a.y - scroller.y
    -999.0

def bool near(float a, float b):
    let d = a - b
    d < 0.001 and d > 0.0 - 0.001

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)

# Nothing requested: the scroller sits at its start and nothing moves.
assert(!applyScrollRequests(rt, host, lay(rt)))
assert(near(anchorTop(rt, "a"), 0.0))

# A request for "c" (80 down) is clamped to the content's end (160 high in 60: at most 100): "c" lands at 80 - 100 -> top clamp.
let go = ofKind(lay(rt), "Button")[0]
assert(click(rt, host, lay(rt), go.x + 2.0, go.y + 2.0))
assert(applyScrollRequests(rt, host, lay(rt)))
assert(near(anchorTop(rt, "c"), 0.0))          # 80 <= max 100: the anchor is at the viewport's top
# Applied once: the same request is not applied again, and user scrolling afterwards is left alone.
assert(!applyScrollRequests(rt, host, lay(rt)))

# Another request to another anchor scrolls back.
let goB = ofKind(lay(rt), "Button")[1]
assert(click(rt, host, lay(rt), goB.x + 2.0, goB.y + 2.0))
assert(applyScrollRequests(rt, host, lay(rt)))
assert(near(anchorTop(rt, "b"), 0.0))

# An anchor past what the content allows: clamped to the end (tail is 120 down, at most 100 scroll: it ends 20 from the top).
let goTail = ofKind(lay(rt), "Button")[2]
assert(click(rt, host, lay(rt), goTail.x + 2.0, goTail.y + 2.0))
assert(applyScrollRequests(rt, host, lay(rt)))
assert(near(anchorTop(rt, "tail"), 20.0))
print "scroll_request_test ok"
