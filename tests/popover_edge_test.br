# Popover, sideways: past the window's right edge the panel's right edge meets the anchor's (layout.br `popupAt`).
# Run: boring run tests/popover_edge_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.events.*

view Panel:
    float indent
    state bool open = false

    body():
        Column(alignment = .Leading, spacing = 0.0):
            Padding(insets = indent):
                Popover(isPresented = open):
                    Button(label = "Anchor", onActivate = ():
                        open = !open)
                    Frame(width = 120.0):
                        Text(content = "panel")

struct PanelBuilder as ViewBuilder:
    float indent
    req View buildView(mut Runtime rt): Panel(indent = indent)

def Placed lay(Runtime rt):
    let p = layout(rt, 200.0, 200.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def bool near(float a, float b):
    let d = a - b
    d < 0.001 and d > 0.0 - 0.001

def Runtime opened(Builder host):
    mut rt = Runtime()
    rt.start(host)
    let anchor = ofKind(lay(rt), "Button")[0]
    assert(click(rt, host, lay(rt), anchor.x + 2.0, anchor.y + 2.0))
    rt

# Room to the right: left edges aligned.
let hostNear = ViewRoot(inner = PanelBuilder(indent = 0.0))
let rtNear = opened(hostNear)
let near1 = ofKind(lay(rtNear), "Popover")[0]
assert_eq(near1.children[1].props["edge"] else (""), "left")
assert(near1.children[1].x + 0.001 >= near1.children[0].x)
assert(near(near1.children[1].x, near1.children[0].x))

# The anchor near the right edge: the panel (120 wide) would stick out, so its right edge meets the anchor's.
let hostFar = ViewRoot(inner = PanelBuilder(indent = 100.0))
let rtFar = opened(hostFar)
let far = ofKind(lay(rtFar), "Popover")[0]
let anchorFar = far.children[0]
let panelFar = far.children[1]
assert_eq(panelFar.props["edge"] else (""), "right")
assert(near(panelFar.x + panelFar.w, anchorFar.x + anchorFar.w))
assert(panelFar.x >= 0.0)
assert(panelFar.x + panelFar.w <= 200.001)
print "popover_edge_test ok"
