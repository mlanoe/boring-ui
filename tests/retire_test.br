# The retiring phase: a subtree removed under an animated Transition stays mounted but frozen until the host ends
# its removal; reinsertion revives it; an ancestor's removal ends it (src/core.br, events.br).
# Run: boring run tests/retire_test.br

use boring.ui.*
use ui.core.*
use ui.anim.*
use ui.events.*

view Panel:
    state bool shown = false
    state bool outer = true

    def setShown(bool v):
        shown = v

    def setOuter(bool v):
        outer = v

    body():
        Column(alignment = .Leading, spacing = 0.0):
            Text("always")
            if outer:
                Column(alignment = .Leading, spacing = 0.0):
                    if shown:
                        Transition():
                            Button(label = "go", onActivate = ():
                                pass)

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Panel__State panelState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Panel__State else (Panel__State())

def int idOfKind(Mounted m, string kind):
    if m.kind == kind:
        return m.id
    for c in m.children:
        let r = idOfKind(c, kind)
        if r >= 0:
            return r
    -1

def int transitionId(Runtime rt):
    let root = rt.root else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
    idOfKind(root, "Transition")

def int count([string] lines, string needle):
    var n = 0
    for l in lines:
        if l.contains(needle):
            n += 1
    n

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)
mut st = panelState(rt)

# Mount the transition with its button and focus the button.
Panel().setShown(true, st)
rt.invalidateRoot()
assert(rt.flush(host))
let tid = transitionId(rt)
assert(tid > 0)
assert(keyPress(rt, host, "Tab"))
assert(rt.focus != nil, "the button has focus")

# Removed WITHOUT animation: torn down at once, nothing retires.
Panel().setShown(false, st)
rt.invalidateRoot()
assert(rt.flush(host))
assert_eq(count(rt.events, "retire "), 0)
assert_eq(count(rt.events, "unmount Transition"), 1)
assert(rt.focus == nil, "focus left with the unmounted button")

# Removed UNDER an animated transaction: retired — gone from the tree, focus released, hooks and identity kept.
Panel().setShown(true, st)
rt.invalidateRoot()
assert(rt.flush(host))
let t2 = transitionId(rt)
assert(keyPress(rt, host, "Tab"))
let unmountsAtStart = count(rt.events, "unmount Transition")
rt.animate(linear(100.0), host, ():
    Panel().setShown(false, st))
assert_eq(count(rt.events, "retire Transition#{t2}"), 1)
assert_eq(count(rt.events, "unmount Transition"), unmountsAtStart)    # the hooks wait
assert_eq(transitionId(rt), -1, "out of the active tree")
assert(rt.focus == nil, "focus released when the retiring phase began")
assert_eq(retiringIds(rt).length, 1)
assert_eq(retiringIds(rt)[0], t2)
assert(rt.handle(t2) != nil, "its identity is still allocated")

# The host reports the removal finished: now the hooks run and the identity goes.
assert_eq(endRetirement(rt, host, t2), 1)
assert_eq(count(rt.events, "unmount Transition"), unmountsAtStart + 1)
assert_eq(count(rt.events, "unmount Button"), 2)
assert_eq(retiringIds(rt).length, 0)
assert(rt.handle(t2) == nil, "the identity is dropped")

# Reinserting the identity before the removal ends revives the SAME mounted node (no second mount, no unmount).
Panel().setShown(true, st)
rt.invalidateRoot()
assert(rt.flush(host))
let t3 = transitionId(rt)
let mountsBefore = count(rt.events, "mount Transition")
let unmountsBefore = count(rt.events, "unmount Transition")
rt.animate(linear(100.0), host, ():
    Panel().setShown(false, st))
assert_eq(retiringIds(rt).length, 1)
Panel().setShown(true, st)
rt.invalidateRoot()
assert(rt.flush(host))
assert_eq(transitionId(rt), t3, "the same mounted node came back")
assert_eq(retiringIds(rt).length, 0)
assert_eq(count(rt.events, "mount Transition"), mountsBefore)
assert_eq(count(rt.events, "unmount Transition"), unmountsBefore)

# Removing an ancestor ends the retiring descendants with it, as one group.
rt.animate(linear(100.0), host, ():
    Panel().setShown(false, st))
assert_eq(retiringIds(rt).length, 1)
let beforeAncestor = count(rt.events, "unmount Transition")
Panel().setOuter(false, st)
rt.invalidateRoot()
assert(rt.flush(host))
assert_eq(retiringIds(rt).length, 0)
assert_eq(count(rt.events, "unmount Transition"), beforeAncestor + 1)

# Forced teardown skips what remains of the animation.
Panel().setOuter(true, st)
Panel().setShown(true, st)
rt.invalidateRoot()
assert(rt.flush(host))
rt.animate(linear(100.0), host, ():
    Panel().setShown(false, st))
assert_eq(retiringIds(rt).length, 1)
assert_eq(endRetirements(rt, host), 1)
assert_eq(retiringIds(rt).length, 0)
assert_eq(rt.errors.length, 0)
print("retire ok")
