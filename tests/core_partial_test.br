# Precise invalidation: invalidating a composite re-expands only its own subtree (draft: per-identity
# rebuilds); invalidating the root, or an action, still rebuilds the whole window.
# Run: boring run tests/core_partial_test.br

use boring.ui.*
use ui.core.*

view Counter:
    string title
    state int taps = 0

    body():
        if taps > 2:
            return Row(alignment = .Center, spacing = nil, children = [Text("many")])
        Column(alignment = .Center, spacing = nil, children = [Text("{title}")])

view Page:
    [string] ids

    body():
        Column(alignment = .Center, spacing = nil):
            for id in ids with id:
                Counter(title = id)

struct Model:
    var mut [string] ids = []

struct PageBuilder as ViewBuilder:
    Model model
    req View buildView(mut Runtime rt): Page(ids = model.ids)

def int search(Mounted m, string kind, string key):
    if m.kind == kind and m.key == key:
        return m.id
    for c in m.children:
        let r = search(c, kind, key)
        if r >= 0:
            return r
    -1

def tap(Runtime rt, Handle h, int times):
    let box = rt.stateOf(h) else (NoState())
    mut st = box as Counter__State else (Counter__State())
    st.taps = st.taps + times

mut model = Model(ids = ["a", "b"])
let host = ViewRoot(inner = PageBuilder(model = model))
mut rt = Runtime()
rt.start(host)
assert_eq(rt.expansions, 3)     # Page, Counter a, Counter b
assert_eq(rt.partialPasses, 0)

# One counter changes: only its body is expanded again; the page and the other counter are not.
let ca = rt.handle(4) else (Handle(id = -1, generation = -1))
tap(rt, ca, 3)
assert(rt.invalidate(ca))
assert(rt.flush(host))
assert_eq(rt.expansions, 4)
assert_eq(rt.partialPasses, 1)
assert_eq(rt.passesRun, 1)    # `start`'s first build is not a flush pass
assert_eq(rt.show(), "Page#1[Column#2[KeyedGroup#3@a[Counter#4[Row#11[Text#12]]], KeyedGroup#7@b[Counter#8[Column#9[Text#10]]]]]")

# A node and its ancestor both dirty: the ancestor's pass covers the descendant once.
let cb = rt.handle(8) else (Handle(id = -1, generation = -1))
let before = rt.expansions
tap(rt, cb, 3)
assert(rt.invalidate(cb))
assert(rt.invalidate(ca))
assert(rt.flush(host))
assert_eq(rt.expansions, before + 2)   # each counter once
assert_eq(rt.partialPasses, 2)

# The root dirty (or an action's conservative invalidation) rebuilds everything: the builder runs again.
model.ids = ["b"]
let rebuilt = ViewRoot(inner = PageBuilder(model = model))
rt.invalidateRoot()
let whole = rt.expansions
assert(rt.flush(rebuilt))
assert_eq(rt.partialPasses, 2)
assert(rt.expansions > whole, "whole-window pass expands the composites")
assert(!rt.valid(ca), "the removed counter is gone")

# A stale or native invalidation changes nothing and costs no expansion.
let text = rt.handle(search(rt.root else (Mounted(id = 0, generation = 0, kind = "", site = 0, key = "")), "Text", "")) else (Handle(id = -1, generation = -1))
let idle = rt.expansions
if rt.valid(text):
    assert(rt.invalidate(text))
    assert(rt.flush(rebuilt))
    assert_eq(rt.expansions, idle)
print("ok")
