# Tests for Banner, Toast, Accordion, and Table (src/controls.br).
# Run: boring run tests/components_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.controls.*
use ui.events.*
use ui.animator.*

view Panel:
    state bool showToast = false
    state bool dismissedBanner = false
    state int selectedRow = -1

    def dismissBanner():
        dismissedBanner = true

    def openToast():
        showToast = true

    def selectRow(int r):
        selectedRow = r

    req bool bannerDismissed():
        dismissedBanner

    req bool toastShown():
        showToast

    req int rowPicked():
        selectedRow

    body():
        Toast(isPresented = showToast, message = "Saved!", kind = "success"):
            Column(alignment = .Leading, spacing = 8.0):
                if !dismissedBanner:
                    Banner(title = "Heads up", message = "Check settings", kind = "warning", onDismiss = ():
                        self.dismissBanner())
                Button(label = "Show toast", onActivate = ():
                    self.openToast())
                Accordion(titles = ["General", "Advanced"]):
                    Text(content = "general body")
                    Text(content = "advanced body")
                Table(headers = ["Name", "Role"], rows = [["Alice", "Admin"], ["Bob", "User"]], selected = selectedRow, onSelect = (r):
                    self.selectRow(r))

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed lay(Runtime rt):
    let p = layout(rt, 420.0, 420.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def bool hasText(Runtime rt, string content):
    for t in ofKind(lay(rt), "Text"):
        if (t.props["content"] else ("")) == content:
            return true
    false

def Placed? buttonByLabel(Runtime rt, string label):
    for b in ofKind(lay(rt), "Button"):
        if (b.props["label"] else ("")) == label:
            return b
    nil

def Panel__State panelState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Panel__State else (Panel__State())

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)

# 1. Banner shows title, message, warning icon "⚠", and dismiss button "✕"
assert(hasText(rt, "Heads up"))
assert(hasText(rt, "Check settings"))
assert(hasText(rt, "⚠"))
let dismissBannerBtn = buttonByLabel(rt, "✕") else (lay(rt))
assert(click(rt, host, lay(rt), dismissBannerBtn.x + 2.0, dismissBannerBtn.y + 2.0))
assert(Panel().bannerDismissed(panelState(rt)))
assert(!hasText(rt, "Heads up"))

# 2. Toast is hidden initially, opens on button click, and dismisses on "✕"
assert(!hasText(rt, "Saved!"))
let showToastBtn = buttonByLabel(rt, "Show toast") else (lay(rt))
assert(click(rt, host, lay(rt), showToastBtn.x + 2.0, showToastBtn.y + 2.0))
assert(Panel().toastShown(panelState(rt)))
assert(hasText(rt, "Saved!"))
assert(hasText(rt, "✓"))
let closeToastBtn = buttonByLabel(rt, "✕") else (lay(rt))
assert(click(rt, host, lay(rt), closeToastBtn.x + 2.0, closeToastBtn.y + 2.0))
for id in retiringIds(rt):
    _ = endRetirement(rt, host, id)
assert(!Panel().toastShown(panelState(rt)))
assert(!hasText(rt, "Saved!"))

# 3. Accordion: both sections start closed; opening General shows its body; opening Advanced closes General
assert(!hasText(rt, "general body"))
assert(!hasText(rt, "advanced body"))
let genBtn = buttonByLabel(rt, "▸ General") else (lay(rt))
assert(click(rt, host, lay(rt), genBtn.x + 2.0, genBtn.y + 2.0))
assert(hasText(rt, "general body"))
assert(!hasText(rt, "advanced body"))
let advBtn = buttonByLabel(rt, "▸ Advanced") else (lay(rt))
assert(click(rt, host, lay(rt), advBtn.x + 2.0, advBtn.y + 2.0))
for id in retiringIds(rt):
    _ = endRetirement(rt, host, id)
assert(!hasText(rt, "general body"))
assert(hasText(rt, "advanced body"))
# Clicking open Advanced collapses it
let advOpenBtn = buttonByLabel(rt, "▾ Advanced") else (lay(rt))
assert(click(rt, host, lay(rt), advOpenBtn.x + 2.0, advOpenBtn.y + 2.0))
for id in retiringIds(rt):
    _ = endRetirement(rt, host, id)
assert(!hasText(rt, "advanced body"))

# 4. Table renders headers, rows, and supports row selection
assert(hasText(rt, "Name"))
assert(hasText(rt, "Role"))
assert(hasText(rt, "Admin"))
let bobBtn = buttonByLabel(rt, "Bob") else (lay(rt))
assert(click(rt, host, lay(rt), bobBtn.x + 2.0, bobBtn.y + 2.0))
assert_eq(Panel().rowPicked(panelState(rt)), 1)

print "components_test ok"
