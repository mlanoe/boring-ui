# Menu (src/controls.br): opens its items on activation, choosing one closes it and reports the index; outside press closes it.
# Run: boring run tests/menu_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.events.*
use ui.controls.*

view Panel:
    state int last = -1

    req int chosen():
        last

    def picked(int i):
        last = i

    body():
        Column(alignment = .Leading, spacing = 20.0):
            Menu(label = "File", items = ["New", "Open", "Delete"], danger = 2, onSelect = (i):
                self.picked(i))
            Button(label = "Elsewhere", onActivate = ():
                self.picked(-1))

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed lay(Runtime rt):
    let p = layout(rt, 300.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def Placed? button(Runtime rt, string label):
    for b in ofKind(lay(rt), "Button"):
        if (b.props["label"] else ("")) == label:
            return b
    nil

def bool press(mut Runtime rt, Builder host, string label):
    if let b = button(rt, label):
        return click(rt, host, lay(rt), b.x + 2.0, b.y + 2.0)
    false

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)

# Closed: only its button; the items are not mounted.
assert(button(rt, "File ▾") != nil)
assert(button(rt, "Open") == nil)

# Open: the items show; the destructive one carries its role.
assert(press(rt, host, "File ▾"))
assert(button(rt, "Open") != nil)
let del = button(rt, "Delete") else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))
assert_eq(del.props["role"] else (""), "Destructive")

# Choosing reports the index and closes the menu.
assert(press(rt, host, "Open"))
assert(button(rt, "Open") == nil)
assert(button(rt, "File ▾") != nil)

# Reopened, a press in empty space closes it without choosing.
assert(press(rt, host, "File ▾"))
assert(button(rt, "New") != nil)
_ = click(rt, host, lay(rt), 280.0, 280.0)
assert(button(rt, "New") == nil)
print "menu_test ok"
