# Structured error reports (src/core.br ErrorReport, report*, failTask, takeReports, pathOf): every problem
# carries its kind, message, mounted view path and node; a cancelled task is not an error; a failing callback
# is reported with its path while earlier writes stay committed.
# Run: boring run tests/core_errors_test.br

use boring.ui.*
use ui.core.*
use ui.events.*

view Page:
    state [TaskRun] runs = []
    state string query = "a"
    state int taps = 0

    def started(TaskRun run):
        runs.push(run)

    def tap():
        taps += 1

    def explode() throws:
        taps += 10
        throw "disk full"

    req int runCount():
        runs.length

    req TaskRun runAt(int i):
        runs[i]

    body():
        Column(alignment = .Center, spacing = nil):
            OnTask(id = query, onTask = (run):
                self.started(run)):
                Button(label = "Tap", onActivate = ():
                    self.tap())
                Button(label = "Explode", onActivate = ():
                    self.explode())

struct PageBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Page()

def Page__State pageState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Page__State else (Page__State())

def int idOfKind(Mounted m, string kind):
    if m.kind == kind:
        return m.id
    for c in m.children:
        let r = idOfKind(c, kind)
        if r >= 0:
            return r
    -1

def int idOfKind2(Mounted m, string label):
    if m.kind == "Button" and propText(m, "label") == label:
        return m.id
    for c in m.children:
        let r = idOfKind2(c, label)
        if r >= 0:
            return r
    -1

let host = ViewRoot(inner = PageBuilder())
mut rt = Runtime()
rt.start(host)
assert_eq(rt.reports.length, 0)

# ── paths are the kinds from the root down ───────────────────────────────────────────────────────

let root = rt.root else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
let buttonId = idOfKind(root, "Button")
assert_eq(rt.pathOf(buttonId), "Page/Column/OnTask/Button")
assert_eq(rt.pathOf(-1), "")
assert_eq(rt.pathOf(9999), "")

# ── a failing callback: reported with its path, source and message; nothing is rolled back ──────

mut st = pageState(rt)
Page().tap(st)                                   # a write made before the failure stays committed
rt.reportFailure("callback", "activate", "disk full", buttonId)
assert_eq(rt.reports.length, 1)
let first = rt.reports[0]
assert_eq(first.kind, "callback")
assert_eq(first.source, "activate")
assert_eq(first.message, "disk full")
assert_eq(first.path, "Page/Column/OnTask/Button")
assert_eq(first.node, buttonId)
assert_eq(rt.errors[0], "disk full")             # the bare message is kept too
assert_eq(Page().runCount(pageState(rt)), 1)     # (the task started once, nothing else was disturbed)

# ── the dispatch boundary: `act` catches a callback that throws and reports it ───────────────────

let explodeId = idOfKind2(root, "Explode")
let explodeHandle = rt.handle(explodeId) else (Handle(id = -1, generation = -1))
let beforeAct = rt.reports.length
assert(act(rt, host, explodeHandle, "activate", ""))      # the event still completes
assert_eq(rt.reports.length, beforeAct + 1)
let actReport = rt.reports[rt.reports.length - 1]
assert_eq(actReport.kind, "callback")
assert_eq(actReport.source, "activate")
assert_eq(actReport.message, "disk full")
assert_eq(actReport.node, explodeId)
assert_eq(actReport.path, "Page/Column/OnTask/Button")
assert_eq(pageState(rt).taps, 11)                          # the write before the throw stays committed
let tapHandle = rt.handle(buttonId) else (Handle(id = -1, generation = -1))
assert(act(rt, host, tapHandle, "activate", ""))           # a well-behaved callback reports nothing
assert_eq(rt.reports.length, beforeAct + 1)
assert_eq(pageState(rt).taps, 12)

# ── tasks: a current run reports; a cancelled or superseded one is an expected completion ───────

let run1 = Page().runAt(0, pageState(rt))
assert(rt.failTask(run1, "network down"))
let taskReport = rt.reports[rt.reports.length - 1]
assert_eq(taskReport.kind, "task")
assert_eq(taskReport.run, run1.generation)
assert_eq(taskReport.source, "a")                 # the task id
assert_eq(taskReport.path, "Page/Column/OnTask")

st.query = "b"                                    # an id change cancels run 1 and starts run 2
rt.invalidateRoot()
assert(rt.flush(host))
assert(!rt.isCurrent(run1))
let before = rt.reports.length
assert(!rt.failTask(run1, "late failure of the old run"))
assert_eq(rt.reports.length, before)              # not an error
let run2 = Page().runAt(1, pageState(rt))
assert(rt.failTask(run2, "second run failed"))
assert_eq(rt.reports.length, before + 1)

# ── stale handles and the update loop guard are structured too ───────────────────────────────────

let gone = Handle(id = buttonId, generation = 12345)
assert(!rt.invalidate(gone))
assert_eq(rt.reports[rt.reports.length - 1].kind, "stale")

# ── the host takes the reports and the queue starts empty again ──────────────────────────────────

let taken = rt.takeReports()
assert(taken.length >= 5)
assert_eq(taken[0].kind, "callback")
assert_eq(rt.reports.length, 0)
assert(rt.errors.length >= 5)                     # the plain messages are not cleared

print "core errors ok"
