# `env` through the core: a view's `env` fields come from the nearest ancestor `Provide` of that type,
# survive rebuilds, and an unsatisfied `env` renders `EnvMissing` and is reported.
# Run: boring run tests/core_env_test.br

use boring.ui.*
use ui.core.*

struct Theme as EnvValue:
    string name

struct Locale as EnvValue:
    string code

view Label:
    env Theme theme
    string text

    body():
        Text("{text}:{theme.name}")

view Both:
    env Theme theme
    env Locale locale

    body():
        Text("{theme.name}/{locale.code}")

view Page:
    state int rebuilds = 0

    body():
        Column(alignment = .Center, spacing = nil):
            Provide(value = Theme(name = "dark")):
                Provide(value = Locale(code = "fr")):
                    Both()
                Label(text = "outer")
                Provide(value = Theme(name = "light")):
                    Label(text = "inner")
            Label(text = "bare")

struct PageBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Page()

# The content of every Text node, in preorder.
def [string] texts(Mounted m):
    mut out = []
    if m.kind == "Text":
        out.push(m.props["content"] else (""))
    for c in m.children:
        for t in texts(c):
            out.push(t)
    out

let host = ViewRoot(inner = PageBuilder())
mut rt = Runtime()
rt.start(host)
let root = rt.root else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))

# Nearest provider wins (the inner light Theme shadows the outer dark one for "inner" only), a Locale
# provider is found next to a Theme one, and "bare" sits under no provider: it renders EnvMissing.
assert_eq(texts(root), ["dark/fr", "outer:dark", "inner:light"])
assert_eq(rt.errors, ["missing environment value: Theme"])
assert(rt.show().contains("EnvMissing"), "placeholder in the tree")

# A rebuild reconciles the same tree, expands with the same scope, and does not repeat the report.
let h = rt.handle(1) else (Handle(id = -1, generation = -1))
assert(rt.invalidate(h), "invalidate")
assert(rt.flush(host), "flush")
let rebuilt = rt.root else (Mounted(id = -1, generation = -1, kind = "", site = 0, key = ""))
assert_eq(texts(rebuilt), ["dark/fr", "outer:dark", "inner:light"])
assert_eq(rt.errors.length, 1)

print "core env ok"
