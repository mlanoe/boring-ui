# Input-method composition: marked text, commit, cancel, Enter / Escape ownership, suspension when focus leaves
# (src/events.br ime*, core.br Composition / pruneComposition, layout.br, scene.br, semantics.br).
# ASCII text only (see the README: `String.length` differs between the interpreter and `boring build` for
# other text). Run: boring run tests/ime_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.semantics.*
use ui.events.*

view Form:
    state string text = ""
    state string other = ""
    state int submits = 0
    state int cancels = 0
    state int oks = 0

    def submit():
        submits += 1

    def cancel():
        cancels += 1

    def ok():
        oks += 1

    req string summary():
        "{text}|{submits}/{cancels}/{oks}"

    body():
        Column(alignment = .Leading, spacing = 4.0):
            TextField(value = text, label = "Name", onSubmit = ():
                self.submit())
            TextField(value = other, label = "Other")
            Button(label = "Cancel", role = .Cancel, onActivate = ():
                self.cancel())
            DefaultAction:
                Button(label = "OK", onActivate = ():
                    self.ok())
            Disabled(value = true):
                TextField(value = other, label = "Frozen")

struct FormBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Form()

def Placed lay(Runtime rt):
    let p = layout(rt, 300.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind, string key, string want):
    mut out = []
    if p.kind == kind and (p.props[key] else ("")) == want:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind, key, want):
            out.push(f)
    out

def Placed field(Runtime rt, string label):
    ofKind(lay(rt), "TextField", "label", label)[0]

def Form__State state(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Form__State else (Form__State())

def string summary(Runtime rt):
    Form().summary(state(rt))

def [int] sel(Runtime rt):
    selectionOf(rt.focus else (Handle(id = -1, generation = -1)), rt)

let host = ViewRoot(inner = FormBuilder())
mut rt = Runtime()
rt.start(host)
let name = field(rt, "Name")
let left = name.x + 4.0          # the fixture font: 8 px a cell
let mid = name.y + 8.0

assert(click(rt, host, lay(rt), name.x + 2.0, mid))
assert(typeText(rt, host, "hello world"))
assert_eq(summary(rt), "hello world|0/0/0")

# ── drag: the anchor stays at the press, the caret follows the pointer ───────────────────────────

assert(pointerDown(rt, host, lay(rt), left + 16.0, mid))                  # between "he" and "llo"
assert_eq(selectionOf(rt, rt.focus else (Handle(id = -1, generation = -1))), [2, 2])
assert(pointerMove(rt, host, lay(rt), left + 40.0, mid))
assert_eq(selectionOf(rt, rt.focus else (Handle(id = -1, generation = -1))), [5, 2])
assert(pointerMove(rt, host, lay(rt), left + 8.0, mid))                   # back past the anchor
assert_eq(selectionOf(rt, rt.focus else (Handle(id = -1, generation = -1))), [1, 2])
assert(pointerMove(rt, host, lay(rt), left + 500.0, mid))                 # far beyond the text: the end
assert_eq(selectionOf(rt, rt.focus else (Handle(id = -1, generation = -1)))[0], 11)
_ = pointerUp(rt, host, lay(rt), left + 500.0, mid)
# the selection is what typing replaces
assert(pointerDown(rt, host, lay(rt), left + 16.0, mid))
assert(pointerMove(rt, host, lay(rt), left + 40.0, mid))
_ = pointerUp(rt, host, lay(rt), left + 40.0, mid)
assert(typeText(rt, host, "J"))
assert_eq(summary(rt), "heJ world|0/0/0")

# ── Shift-press extends from the anchor ───────────────────────────────────────────────────────────

assert(pointerDown(rt, host, lay(rt), left + 8.0, mid))
_ = pointerUp(rt, host, lay(rt), left + 8.0, mid)
assert(pointerDownWith(rt, host, lay(rt), left + 48.0, mid, "Range"))
_ = pointerUp(rt, host, lay(rt), left + 48.0, mid)
assert_eq(selectionOf(rt, rt.focus else (Handle(id = -1, generation = -1))), [6, 1])

# ── double click: the word under the pointer; triple click: everything ────────────────────────────

assert(pointerDownClicks(rt, host, lay(rt), left + 60.0, mid, "", 2))     # inside "world" (cells 3..8)
_ = pointerUp(rt, host, lay(rt), left + 60.0, mid)
assert_eq(selectionOf(rt, rt.focus else (Handle(id = -1, generation = -1))), [9, 4])
assert_eq(selectedText(rt), "world")
assert(pointerDownClicks(rt, host, lay(rt), left + 4.0, mid, "", 2))      # inside "heJ"
_ = pointerUp(rt, host, lay(rt), left + 4.0, mid)
assert_eq(selectedText(rt), "heJ")
assert(pointerDownClicks(rt, host, lay(rt), left + 25.0, mid, "", 2))     # on the space between the words
_ = pointerUp(rt, host, lay(rt), left + 25.0, mid)
assert_eq(selectedText(rt), " ")
assert(pointerDownClicks(rt, host, lay(rt), left + 60.0, mid, "", 3))
_ = pointerUp(rt, host, lay(rt), left + 60.0, mid)
assert_eq(selectedText(rt), "heJ world")

# ── clipboard: copy, cut and paste replace the selection as one undoable edit ─────────────────────

assert(pointerDownClicks(rt, host, lay(rt), left + 60.0, mid, "", 2))     # "world"
_ = pointerUp(rt, host, lay(rt), left + 60.0, mid)
assert(copySelection(rt))
assert_eq(rt.clipboard, "world")
assert_eq(summary(rt), "heJ world|0/0/0")                                 # a copy changes nothing
assert(cutSelection(rt, host))
assert_eq(summary(rt), "heJ |0/0/0")
assert_eq(rt.clipboard, "world")
assert(pasteClipboard(rt, host))
assert(pasteClipboard(rt, host))
assert_eq(summary(rt), "heJ worldworld|0/0/0")
assert(keyPress(rt, host, "Undo"))
assert_eq(summary(rt), "heJ world|0/0/0")
# nothing selected: copy and cut do nothing, and an empty clipboard pastes nothing
assert(keyPress(rt, host, "End"))
assert(!copySelection(rt))
rt.clipboard = ""
assert(!pasteClipboard(rt, host))

print "selection ok"
