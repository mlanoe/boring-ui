# Tests for Skeleton, BarChart, Sparkline, StatCard, and TreeView (src/controls.br).
# Run: boring run tests/data_viz_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.controls.*
use ui.events.*
use ui.animator.*

view Dashboard:
    state string selectedNode = ""

    def selectNode(string id):
        selectedNode = id

    req string currentSelected():
        selectedNode

    body():
        let treeItems = [
            TreeItem(id = "src", label = "src", depth = 0, hasChildren = true),
            TreeItem(id = "controls", label = "controls.br", depth = 1, hasChildren = false),
            TreeItem(id = "tests", label = "tests", depth = 0, hasChildren = true),
            TreeItem(id = "viz_test", label = "data_viz_test.br", depth = 1, hasChildren = false),
        ]
        Column(alignment = .Leading, spacing = 10.0):
            Row(alignment = .Center, spacing = 8.0):
                Skeleton(width = 32.0, height = 32.0, circle = true)
                Skeleton(width = 120.0, height = 12.0, lines = 2)
            StatCard(title = "Revenue", value = "$42k", delta = "+12%", positive = true, subtitle = "vs last month"):
                Sparkline(values = [2.0, 5.0, 3.0, 8.0], width = 80.0, height = 24.0)
            BarChart(values = [10.0, 25.0, 15.0], labels = ["Jan", "Feb", "Mar"], width = 180.0, height = 80.0)
            TreeView(items = treeItems, selectedId = selectedNode, onSelect = (id):
                self.selectNode(id))

struct DashboardBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Dashboard()

def Placed lay(Runtime rt):
    let p = layout(rt, 500.0, 520.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def bool hasText(Runtime rt, string content):
    for t in ofKind(lay(rt), "Text"):
        if (t.props["content"] else ("")) == content:
            return true
    false

def Placed? buttonByLabel(Runtime rt, string label):
    for b in ofKind(lay(rt), "Button"):
        if (b.props["label"] else ("")) == label:
            return b
    nil

def [Placed] buttonsByLabel(Runtime rt, string label):
    mut out = []
    for b in ofKind(lay(rt), "Button"):
        if (b.props["label"] else ("")) == label:
            out.push(b)
    out

def Dashboard__State dashState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Dashboard__State else (Dashboard__State())

let host = ViewRoot(inner = DashboardBuilder())
mut rt = Runtime()
rt.start(host)

# 1. StatCard + Sparkline + BarChart labels render
assert(hasText(rt, "Revenue"))
assert(hasText(rt, "$42k"))
assert(hasText(rt, "+12%"))
assert(hasText(rt, "vs last month"))
assert(hasText(rt, "Jan"))
assert(hasText(rt, "Feb"))
assert(hasText(rt, "Mar"))

# 2. TreeView: initially collapsed, only root nodes visible
assert(buttonByLabel(rt, "src") != nil)
assert(buttonByLabel(rt, "tests") != nil)
assert(buttonByLabel(rt, "controls.br") == nil)
assert(buttonByLabel(rt, "data_viz_test.br") == nil)

# 3. Expand "src" (first "▸" button)
let expandBtns = buttonsByLabel(rt, "▸")
assert_eq(expandBtns.length, 2)
assert(click(rt, host, lay(rt), expandBtns[0].x + 2.0, expandBtns[0].y + 2.0))
assert(buttonByLabel(rt, "controls.br") != nil)
assert(buttonByLabel(rt, "data_viz_test.br") == nil)

# 4. Select "controls.br"
let ctrlBtn = buttonByLabel(rt, "controls.br") else (lay(rt))
assert(click(rt, host, lay(rt), ctrlBtn.x + 2.0, ctrlBtn.y + 2.0))
assert_eq(Dashboard().currentSelected(dashState(rt)), "controls")

# 5. Collapse "src"
let collapseBtn = buttonByLabel(rt, "▾") else (lay(rt))
assert(click(rt, host, lay(rt), collapseBtn.x + 2.0, collapseBtn.y + 2.0))
assert(buttonByLabel(rt, "controls.br") == nil)

print "data_viz_test ok"
