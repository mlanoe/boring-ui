# Alert / ConfirmationDialog: modal choice dialogs built on Sheet (src/controls.br).
# Run: boring run tests/alert_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.controls.*
use ui.events.*

view Page:
    state bool alertOpen = false
    state bool confirmOpen = false
    state int picked = -1
    state int chosen = -1

    def pick(int i):
        picked = i

    def choose(int i):
        chosen = i

    req int lastPicked():
        picked

    req int lastChosen():
        chosen

    body():
        Column(alignment = .Leading, spacing = 4.0):
            Button(label = "Ask", onActivate = ():
                alertOpen = true)
            Button(label = "Confirm", onActivate = ():
                confirmOpen = true)
            Alert(isPresented = alertOpen, title = "Discard?", message = "Changes are lost.", buttons = ["Keep", "Discard"], cancel = 0, danger = 1, onSelect = (i):
                self.pick(i))
            ConfirmationDialog(isPresented = confirmOpen, title = "Delete", options = ["Delete file", "Archive"], danger = 0, onSelect = (i):
                self.choose(i))

struct PageBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Page()

def Placed lay(Runtime rt):
    let p = layout(rt, 400.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] findAll(Placed p, string kind, string key, string want):
    mut out = []
    if p.kind == kind and (p.props[key] else ("")) == want:
        out.push(p)
    for c in p.children:
        for f in findAll(c, kind, key, want):
            out.push(f)
    out

def Placed named(Runtime rt, string kind, string key, string want):
    findAll(lay(rt), kind, key, want)[0]

def int count(Runtime rt, string kind, string key, string want):
    findAll(lay(rt), kind, key, want).length

def Page__State pageState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Page__State else (Page__State())

let host = ViewRoot(inner = PageBuilder())
mut rt = Runtime()
rt.start(host)

# closed: nothing mounted
assert_eq(count(rt, "Button", "label", "Discard"), 0)
assert_eq(rt.openSheets.length, 0)

# open the alert: message visible, modal
let ask = named(rt, "Button", "label", "Ask")
assert(click(rt, host, lay(rt), ask.x + 2.0, ask.y + 2.0))
assert_eq(rt.openSheets.length, 1)
assert_eq(count(rt, "Text", "content", "Changes are lost."), 1)
assert_eq(count(rt, "Button", "label", "Keep"), 1)

# Enter activates the default (first) button: closes and reports 0
assert(keyPress(rt, host, "Enter"))
assert_eq(rt.openSheets.length, 0)
assert_eq(Page().lastPicked(pageState(rt)), 0)

# reopen: Escape activates the cancel button (index 0)
let ask2 = named(rt, "Button", "label", "Ask")
assert(click(rt, host, lay(rt), ask2.x + 2.0, ask2.y + 2.0))
assert(keyPress(rt, host, "Escape"))
assert_eq(rt.openSheets.length, 0)

# reopen: click the destructive button
let ask3 = named(rt, "Button", "label", "Ask")
assert(click(rt, host, lay(rt), ask3.x + 2.0, ask3.y + 2.0))
let discard = named(rt, "Button", "label", "Discard")
assert(click(rt, host, lay(rt), discard.x + 2.0, discard.y + 2.0))
assert_eq(rt.openSheets.length, 0)
assert_eq(Page().lastPicked(pageState(rt)), 1)

# confirmation dialog: Cancel is automatic and reports nothing
let conf = named(rt, "Button", "label", "Confirm")
assert(click(rt, host, lay(rt), conf.x + 2.0, conf.y + 2.0))
assert_eq(count(rt, "Button", "label", "Cancel"), 1)
assert(keyPress(rt, host, "Escape"))
assert_eq(rt.openSheets.length, 0)
assert_eq(Page().lastChosen(pageState(rt)), -1)

let conf2 = named(rt, "Button", "label", "Confirm")
assert(click(rt, host, lay(rt), conf2.x + 2.0, conf2.y + 2.0))
let arch = named(rt, "Button", "label", "Archive")
assert(click(rt, host, lay(rt), arch.x + 2.0, arch.y + 2.0))
assert_eq(Page().lastChosen(pageState(rt)), 1)
print("alert_test ok")
