# ContextMenu (src/controls.br) and contextPress (events.br): a right press inside the child opens the items, choosing one reports it and closes.
# Run: boring run tests/context_menu_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.events.*
use ui.controls.*

view Panel:
    state int last = -1
    state bool pressed = false

    req int chosen():
        last

    def picked(int i):
        last = i

    body():
        Column(alignment = .Leading, spacing = 30.0):
            ContextMenu(items = ["Copy", "Delete"], danger = 1, onSelect = (i):
                self.picked(i)):
                Text(content = "Right-click me")
            Button(label = "Plain", onActivate = ():
                self.picked(-5))

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed lay(Runtime rt):
    let p = layout(rt, 300.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def Placed? button(Runtime rt, string label):
    for b in ofKind(lay(rt), "Button"):
        if (b.props["label"] else ("")) == label:
            return b
    nil

def Placed textBox(Runtime rt):
    for t in ofKind(lay(rt), "Text"):
        if (t.props["content"] else ("")) == "Right-click me":
            return t
    Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0)

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)

# Closed: no items; a right press on the plain button (no OnContext above it) is not used.
assert(button(rt, "Copy") == nil)
let plain = button(rt, "Plain") else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))
assert(!contextPress(rt, host, lay(rt), plain.x + 2.0, plain.y + 2.0))

# A right press on the text opens the menu; the destructive item carries its role.
let t = textBox(rt)
assert(contextPress(rt, host, lay(rt), t.x + 2.0, t.y + 2.0))
assert(button(rt, "Copy") != nil)
let del = button(rt, "Delete") else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))
assert_eq(del.props["role"] else (""), "Destructive")

# Choosing an item closes it.
let copy = button(rt, "Copy") else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))
assert(click(rt, host, lay(rt), copy.x + 2.0, copy.y + 2.0))
assert(button(rt, "Copy") == nil)

# Reopened, a right press elsewhere dismisses it (and is consumed).
assert(contextPress(rt, host, lay(rt), t.x + 2.0, t.y + 2.0))
assert(button(rt, "Copy") != nil)
assert(contextPress(rt, host, lay(rt), 280.0, 280.0))
assert(button(rt, "Copy") == nil)
print "context_menu_test ok"
