# An `AnimationScope` whose trigger changed animates the removal of a `Transition` below it, with no
# `rt.animate` transaction: the subtree is retired, its ghost fades out over the scope's animation, and the
# host releases it when the animation finishes (src/core.br `retire`, src/animator.br `commit`).
# Run: boring run tests/scope_transition_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.events.*
use ui.anim.*
use ui.animator.*

view Panel:
    state bool shown = true
    state bool plain = true

    def setShown(bool v):
        shown = v

    def setPlain(bool v):
        plain = v

    body():
        Column(alignment = .Leading, spacing = 0.0):
            AnimationScope(curve = "Linear", duration = 100.0, value = "{shown}"):
                Column(alignment = .Leading, spacing = 0.0):
                    if shown:
                        Transition(insertion = .Fade, removal = .Fade):
                            Frame(width = 50.0, height = 20.0):
                                Text("pop")
            # a removal outside every scope still tears down at once
            if plain:
                Transition(insertion = .Fade, removal = .Fade):
                    Frame(width = 30.0, height = 10.0):
                        Text("plain")

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Panel__State panelState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Panel__State else (Panel__State())

def Placed layedOut(Runtime rt):
    let p = layout(rt, 400.0, 400.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def float lowest(Placed p):
    var low = p.alpha
    for c in p.children:
        let l = lowest(c)
        if l < low:
            low = l
    low

def int frames(Placed p, string kind):
    var n = 0
    if p.kind == kind:
        n = 1
    for c in p.children:
        n += frames(c, kind)
    n

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)
mut an = Animator()
commit(an, layedOut(rt), rt.takeAnimation(), rt.takeTriggers(), 0.0)
mut st = panelState(rt)
assert_eq(frames(layedOut(rt), "Frame"), 2)

# Removed outside any scope: torn down at once, nothing retires
Panel().setPlain(false, st)
rt.invalidateRoot()
assert(rt.flush(host))
assert_eq(retiringIds(rt).length, 0)
commit(an, layedOut(rt), rt.takeAnimation(), rt.takeTriggers(), 10.0)
assert_eq(frames(presentation(an, 10.0), "Frame"), 1)

# The scope's trigger changes and the child goes: retired, and the ghost fades over the scope's 100 ms
Panel().setShown(false, st)
rt.invalidateRoot()
assert(rt.flush(host))
assert_eq(retiringIds(rt).length, 1)
assert_eq(frames(layedOut(rt), "Frame"), 0)                       # out of the committed layout
commit(an, layedOut(rt), rt.takeAnimation(), rt.takeTriggers(), 1000.0)
assert_eq(frames(presentation(an, 1000.0), "Frame"), 1)           # still presented: the ghost
let half = lowest(presentation(an, 1050.0))
assert(half > 0.0 and half < 1.0)
assert(isAnimating(an, 1050.0))
# finished: the animator reports it once, the ghost is gone, and the host releases the retired subtree
assert_eq(frames(presentation(an, 1100.0), "Frame"), 0)
assert(takeCompletion(an, 1100.0))
for id in retiringIds(rt):
    _ = endRetirement(rt, host, id)
assert_eq(retiringIds(rt).length, 0)

print "scope transition ok"
