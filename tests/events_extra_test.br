# Interaction: disabled subtrees, pointer capture (activate on release), Enter/Escape (submit, default
# action, cancel) and TextField editing with caret and selection (src/events.br).
# Run: boring run tests/events_extra_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.semantics.*
use ui.events.*

view Form:
    state string name = ""
    state string other = ""
    state string frozen = "ice"
    state int submitted = 0
    state int okays = 0
    state int cancels = 0
    state int locked = 0

    def submit():
        submitted += 1

    def ok():
        okays += 1

    def cancel():
        cancels += 1

    def lock():
        locked += 1

    req string summary():
        "{submitted}/{okays}/{cancels}/{locked}|{name}|{other}"

    body():
        Column(alignment = .Leading, spacing = 4.0):
            TextField(value = name, label = "Name", onSubmit = ():
                self.submit())
            TextField(value = other, label = "Other")
            DefaultAction:
                Button(label = "OK", onActivate = ():
                    self.ok())
            Button(label = "Cancel", role = .Cancel, onActivate = ():
                self.cancel())
            Disabled(value = true):
                Button(label = "Locked", onActivate = ():
                    self.lock())
                TextField(value = frozen, label = "Frozen")

struct FormBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Form()

def string summary(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    mut st = box as Form__State else (Form__State())
    Form().summary(st)

def Placed lay(Runtime rt):
    let p = layout(rt, 300.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] findAll(Placed p, string kind, string key, string want):
    mut out = []
    if p.kind == kind and (p.props[key] else ("")) == want:
        out.push(p)
    for c in p.children:
        for f in findAll(c, kind, key, want):
            out.push(f)
    out

def Placed named(Runtime rt, string kind, string key, string want):
    findAll(lay(rt), kind, key, want)[0]

def Handle handleOf(Runtime rt, Placed p):
    rt.handle(p.id) else (Handle(id = -1, generation = -1))

let host = ViewRoot(inner = FormBuilder())
mut rt = Runtime()
rt.start(host)
assert_eq(summary(rt), "0/0/0/0||")

# ── disabled: no focus, no capture, no action; still in the tree, reported as disabled ───────────

let locked = named(rt, "Button", "label", "Locked")
assert(isDisabled(rt, locked.id))
assert_eq(focusOrder(rt).length, 4)                         # Name, Other, OK, Cancel (not Locked, not Frozen)
assert(!click(rt, host, lay(rt), locked.x + 2.0, locked.y + 2.0))
assert(!act(rt, host, handleOf(rt, locked), "activate", ""))
assert_eq(summary(rt), "0/0/0/0||")
let tree = describeTree(semantics(lay(rt)).roots, 0).join("\n")
assert(tree.contains("button 'Locked'"))
assert(tree.contains("disabled"))
let lockedNode = semantics(lay(rt)).roots[4]
assert_eq(lockedNode.actions.length, 0)
assert(lockedNode.disabled)

# ── pointer capture: activation happens on release over the captured control ──────────────────────

let ok = named(rt, "Button", "label", "OK")
let okX = ok.x + 2.0
let okY = ok.y + 2.0
assert(pointerDown(rt, host, lay(rt), okX, okY))
assert_eq(summary(rt), "0/0/0/0||")                          # a press alone does nothing
assert(rt.capture != nil)
assert(!pointerUp(rt, host, lay(rt), 290.0, 290.0))          # released elsewhere: a cancel
assert_eq(summary(rt), "0/0/0/0||")
assert(rt.capture == nil)
assert(pointerDown(rt, host, lay(rt), okX, okY))
pointerCancel(rt)
assert(!pointerUp(rt, host, lay(rt), okX, okY))              # nothing captured any more
assert_eq(summary(rt), "0/0/0/0||")
assert(pointerDown(rt, host, lay(rt), okX, okY))
assert(pointerUp(rt, host, lay(rt), okX, okY))
assert_eq(summary(rt), "0/1/0/0||")

# ── editing: caret, selection and the editing keys ───────────────────────────────────────────────

let nameField = named(rt, "TextField", "label", "Name")
assert(click(rt, host, lay(rt), nameField.x + 5.0, nameField.y + 5.0))
let nameHandle = handleOf(rt, nameField)
assert(typeText(rt, host, "hello"))
assert_eq(summary(rt), "0/1/0/0|hello|")
assert_eq(selectionOf(rt, nameHandle), [5, 5])
assert(keyPress(rt, host, "Left"))
assert(keyPress(rt, host, "Left"))
assert_eq(selectionOf(rt, nameHandle), [3, 3])
assert(typeText(rt, host, "XY"))                              # inserted at the caret
assert_eq(summary(rt), "0/1/0/0|helXYlo|")
assert_eq(selectionOf(rt, nameHandle), [5, 5])
assert(keyPress(rt, host, "Home"))
assert(keyPress(rt, host, "Delete"))
assert_eq(summary(rt), "0/1/0/0|elXYlo|")
assert(keyPress(rt, host, "End"))
assert(keyPress(rt, host, "Backspace"))
assert_eq(summary(rt), "0/1/0/0|elXYl|")
assert(keyPress(rt, host, "ShiftHome"))                       # select to the start
assert_eq(selectionOf(rt, nameHandle), [0, 5])
assert(typeText(rt, host, "Z"))                               # replaces the selection
assert_eq(summary(rt), "0/1/0/0|Z|")
assert(keyPress(rt, host, "SelectAll"))
assert(keyPress(rt, host, "Backspace"))
assert_eq(summary(rt), "0/1/0/0||")
assert(typeText(rt, host, "ok"))

# A click places the caret at the clicked cell.
assert(click(rt, host, lay(rt), nameField.x + 4.0 + 8.0, nameField.y + 5.0))
assert_eq(selectionOf(rt, nameHandle), [1, 1])

# ── Enter and Escape ─────────────────────────────────────────────────────────────────────────────

# A TextField with onSubmit consumes Enter: submitted, and the default action stays put.
assert(keyPress(rt, host, "Enter"))
assert_eq(summary(rt), "1/1/0/0|ok|")
# One without falls through to the default action (OK).
let otherField = named(rt, "TextField", "label", "Other")
assert(click(rt, host, lay(rt), otherField.x + 5.0, otherField.y + 5.0))
assert(keyPress(rt, host, "Enter"))
assert_eq(summary(rt), "1/2/0/0|ok|")
# Escape activates the Cancel button, wherever the focus is.
assert(keyPress(rt, host, "Escape"))
assert_eq(summary(rt), "1/2/1/0|ok|")
assert_eq(rt.errors.length, 0)

print "events extra ok"
