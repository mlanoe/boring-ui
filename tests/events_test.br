# Event dispatch and focus (src/events.br). Run: boring run tests/events_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.semantics.*
use ui.events.*

view Panel:
    state int taps = 0
    state bool on = false
    state string text = ""

    body():
        Column(alignment = .Leading, spacing = 0.0):
            Button(label = "+", onActivate = ():
                taps += 1)
            Toggle(value = on, label = "on")
            TextField(value = text, label = "name", placeholder = "")
            Text("{taps}:{text}")

struct PanelRoot as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed must(Placed? p):
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def Placed relayout(Runtime rt):
    must(layout(rt, 200.0, 200.0))

def string label(Runtime rt):
    # The Text node's content: the last DrawText of the display list.
    var out = ""
    for c in displayList(relayout(rt)):
        if c.kind == "DrawText":
            out = c.text
    out

let host = ViewRoot(inner = PanelRoot())
mut rt = Runtime()
rt.start(host)
assert_eq(label(rt), "0:")

# ── pointer: a press on a Button activates it, focuses it, and rebuilds once ────────────────────

let placed = relayout(rt)
let button = placed.children[0].children[0]            # Panel → Column → Button
assert_eq(button.kind, "Button")
let passesBefore = rt.passesRun
assert(click(rt, host, placed, button.x + 4.0, button.y + 4.0), "hit the button")
assert_eq(label(rt), "1:")                              # the callback ran against the panel's state
assert_eq(rt.passesRun, passesBefore + 1)               # one update pass for the whole event
assert(rt.focus != nil, "pressing a control focuses it")

# A press that hits no control does nothing.
assert(!click(rt, host, relayout(rt), 190.0, 190.0))
assert_eq(label(rt), "1:")

# ── keyboard: tab order, activate, toggle, typing ──────────────────────────────────────────────

assert_eq(focusOrder(rt).length, 3)                     # Button, Toggle, TextField
assert(keyPress(rt, host, "Space"), "space on the focused button")   # focus is on the Button from the press
assert_eq(label(rt), "2:")
assert(keyPress(rt, host, "Tab"))                            # → Toggle
assert(keyPress(rt, host, "Space"))                          # toggles the bound bool
let tree = semantics(relayout(rt))
assert_eq(tree.roots[1].role, "toggle")
assert_eq(tree.roots[1].value, "true")
assert(keyPress(rt, host, "Tab"))                            # → TextField
assert(typeText(rt, host, "Ad"))
assert(typeText(rt, host, "a"))
assert_eq(label(rt), "2:Ada")
assert(keyPress(rt, host, "Tab"))                            # wraps to the Button
assert(!typeText(rt, host, "x"), "typing needs a focused text field")
assert(keyPress(rt, host, "ShiftTab"))                       # back to the TextField
assert(typeText(rt, host, "!"))
assert_eq(label(rt), "2:Ada!")

# ── semantic actions take the same path as input ───────────────────────────────────────────────

let a11yButton = rt.handle(button.id) else (Handle(id = -1, generation = -1))
assert(act(rt, host, a11yButton, "activate", ""))
assert_eq(label(rt), "3:Ada!")

# ── stale handles and unmounting clear/ignore ──────────────────────────────────────────────────

let gone = Handle(id = button.id, generation = -5)
assert(!act(rt, host, gone, "activate", ""))
assert_eq(label(rt), "3:Ada!")

print "events ok"
