# Drag and drop: Draggable / DropTarget over DragSource, OnDragOver, OnDrop (src/controls.br, events.br, scene.br).
# Run: boring run tests/drag_drop_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.controls.*
use ui.events.*

view Page:
    state string last = ""
    state int drops = 0
    state int clicks = 0

    def got(string v):
        last = v
        drops += 1

    def clicked():
        clicks += 1

    req string lastDrop():
        last

    req int dropCount():
        drops

    req int clickCount():
        clicks

    body():
        Column(alignment = .Leading, spacing = 20.0):
            Draggable(payload = "fruit:apple", preview = "Apple"):
                Button(label = "Apple", onActivate = ():
                    self.clicked())
            Draggable(payload = "tool:saw"):
                Text(content = "Saw")
            Frame(width = 120.0, height = 60.0):
                DropTarget(accepts = "fruit", onDrop = (v):
                    self.got(v)):
                    Frame(width = 120.0, height = 60.0):
                        Text(content = "Fruit bin")

struct PageBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Page()

def Placed lay(Runtime rt):
    let p = layout(rt, 400.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] findAll(Placed p, string kind, string key, string want):
    mut out = []
    if p.kind == kind and (p.props[key] else ("")) == want:
        out.push(p)
    for c in p.children:
        for f in findAll(c, kind, key, want):
            out.push(f)
    out

def Placed named(Runtime rt, string kind, string key, string want):
    findAll(lay(rt), kind, key, want)[0]

def Page__State pageState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Page__State else (Page__State())

def bool previewShown(Runtime rt, string text):
    var found = false
    for c in displayList(lay(rt)):
        if c.kind == "FillRect" and c.color == "dragPreview":
            found = true
    found

let host = ViewRoot(inner = PageBuilder())
mut rt = Runtime()
rt.start(host)

let apple = named(rt, "Button", "label", "Apple")
let bin = named(rt, "Text", "content", "Fruit bin")
let saw = named(rt, "Text", "content", "Saw")

# a press without moving is still a click
assert(click(rt, host, lay(rt), apple.x + 4.0, apple.y + 4.0))
assert_eq(Page().clickCount(pageState(rt)), 1)
assert(!previewShown(rt, "Apple"))

# press on the Apple, move a little: still nothing dragged
assert(pointerDown(rt, host, lay(rt), apple.x + 4.0, apple.y + 4.0))
_ = pointerMove(rt, host, lay(rt), apple.x + 6.0, apple.y + 4.0)
assert(!previewShown(rt, "Apple"))

# move far: the drag starts, the chip follows the pointer and the bin is highlighted
assert(pointerMove(rt, host, lay(rt), bin.x + 10.0, bin.y + 10.0))
assert(previewShown(rt, "Apple"))
assert_eq(findAll(lay(rt), "Background", "color", "#007aff30").length, 1)
assert_eq(findAll(lay(rt), "Opacity", "value", "0.4").length, 1)

# release over the bin: the payload is delivered, everything goes back, the Button was not activated
assert(pointerUp(rt, host, lay(rt), bin.x + 10.0, bin.y + 10.0))
assert_eq(Page().lastDrop(pageState(rt)), "fruit:apple")
assert_eq(Page().dropCount(pageState(rt)), 1)
assert_eq(Page().clickCount(pageState(rt)), 1)
assert(!previewShown(rt, "Apple"))
assert_eq(findAll(lay(rt), "Background", "color", "#007aff30").length, 0)
assert_eq(findAll(lay(rt), "Opacity", "value", "0.4").length, 0)

# a payload of another kind is refused by `accepts`
_ = pointerDown(rt, host, lay(rt), saw.x + 2.0, saw.y + 2.0)
assert(pointerMove(rt, host, lay(rt), bin.x + 10.0, bin.y + 10.0))
assert(pointerUp(rt, host, lay(rt), bin.x + 10.0, bin.y + 10.0))
assert_eq(Page().dropCount(pageState(rt)), 1)

# released elsewhere: nothing is delivered
assert(pointerDown(rt, host, lay(rt), apple.x + 4.0, apple.y + 4.0))
assert(pointerMove(rt, host, lay(rt), 300.0, 250.0))
assert(pointerUp(rt, host, lay(rt), 300.0, 250.0))
assert_eq(Page().dropCount(pageState(rt)), 1)

# Escape cancels a drag in progress
assert(pointerDown(rt, host, lay(rt), apple.x + 4.0, apple.y + 4.0))
assert(pointerMove(rt, host, lay(rt), bin.x + 10.0, bin.y + 10.0))
assert(previewShown(rt, "Apple"))
assert(keyPress(rt, host, "Escape"))
assert(!previewShown(rt, "Apple"))
assert_eq(findAll(lay(rt), "Background", "color", "#007aff30").length, 0)
_ = pointerUp(rt, host, lay(rt), bin.x + 10.0, bin.y + 10.0)
assert_eq(Page().dropCount(pageState(rt)), 1)
print("drag_drop_test ok")
