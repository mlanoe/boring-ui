# Animated programmatic scrolling: Scroll(anchor, request, animated = true) glides (events.br stepGlide).
# Run: boring run tests/scroll_glide_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.events.*

view Panel:
    state int request = 0
    state string target = "c"

    req int current():
        request

    def jump(string name):
        target = name
        request += 1

    body():
        Column(alignment = .Leading, spacing = 0.0):
            Button(label = "go", onActivate = ():
                self.jump("c"))
            Button(label = "goB", onActivate = ():
                self.jump("b"))
            Button(label = "goTail", onActivate = ():
                self.jump("tail"))
            Frame(height = 60.0):
                Scroll(anchor = target, request = request, animated = true):
                    Column(alignment = .Leading, spacing = 0.0):
                        ScrollAnchor(name = "a"):
                            Frame(height = 40.0):
                                Text(content = "a")
                        ScrollAnchor(name = "b"):
                            Frame(height = 40.0):
                                Text(content = "b")
                        ScrollAnchor(name = "c"):
                            Frame(height = 40.0):
                                Text(content = "c")
                        ScrollAnchor(name = "tail"):
                            Frame(height = 40.0):
                                Text(content = "tail")

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed lay(Runtime rt):
    let p = layout(rt, 200.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def float anchorTop(Runtime rt, string name):
    let p = lay(rt)
    let scroller = ofKind(p, "Scroll")[0]
    for a in ofKind(p, "ScrollAnchor"):
        if (a.props["name"] else ("")) == name:
            return a.y - scroller.y
    -999.0

def bool near(float a, float b):
    let d = a - b
    d < 0.001 and d > 0.0 - 0.001

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)

# A request glides: applying it moves nothing yet, it starts a glide.
let go = ofKind(lay(rt), "Button")[0]
assert(click(rt, host, lay(rt), go.x + 2.0, go.y + 2.0))
assert(!applyScrollRequests(rt, host, lay(rt)))
assert(glideActive(rt))
assert(near(anchorTop(rt, "c"), 80.0))

# One short step moves part of the way (ease-out), never past the target; it keeps running.
assert(stepGlide(rt, host, lay(rt), 0.1))
let part = anchorTop(rt, "c")
assert(part < 80.0 and part > 0.0)
assert(stepGlide(rt, host, lay(rt), 0.1))
assert(anchorTop(rt, "c") < part)

# It lands exactly on the target, then stops.
var steps = 0
while glideActive(rt) and steps < 200:
    _ = stepGlide(rt, host, lay(rt), 0.05)
    steps += 1
assert(!glideActive(rt))
assert(near(anchorTop(rt, "c"), 0.0))

# The wheel stops a glide in flight.
let goB = ofKind(lay(rt), "Button")[1]
assert(click(rt, host, lay(rt), goB.x + 2.0, goB.y + 2.0))
assert(!applyScrollRequests(rt, host, lay(rt)))
assert(glideActive(rt))
let sc = ofKind(lay(rt), "Scroll")[0]
_ = scrollBy(rt, host, lay(rt), sc.x + 5.0, sc.y + 5.0, 0.0, 1.0)
assert(!glideActive(rt))
assert(!stepGlide(rt, host, lay(rt), 0.1))
print "scroll_glide_test ok"
