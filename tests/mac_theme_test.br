# The macOS-flavoured theme (src/theme.br `macTheme`): palette, rounded 28-pt controls, 18-pt toggles, red Destructive buttons.
# Run: boring run tests/mac_theme_test.br

use boring.ui.*
use ui.core.*
use ui.theme.*
use ui.layout.*
use ui.scene.*

struct Fixed as ViewBuilder:
    Theme theme
    View root
    req View buildView(mut Runtime rt): Provide(value = theme, children = [root])

def Placed lay(View root):
    mut rt = Runtime()
    rt.start(ViewRoot(inner = Fixed(theme = macTheme(), root = root)))
    let p = layout(rt, 400.0, 200.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] allOf(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in allOf(c, kind):
            out.push(f)
    out

def noop():
    return

let mac = macTheme()
assert_eq(mac.issues().length, 0)
assert_eq(mac.color(ColorRole.Accent), "#007AFF")
assert_eq(mac.color(ColorRole.Surface), "#F2F2F7")
assert_eq(mac.metric(MetricRole.ToggleSize), 18.0)
assert_eq(mac.buttonStyleName(ButtonRole.Destructive), "Danger")
assert_eq(mac.buttonStyleName(ButtonRole.Cancel), "Plain")
# the built-in base is untouched
assert_eq(systemTheme().metric(MetricRole.ToggleSize), 20.0)
assert_eq(buttonSpec("Danger").background, "Danger")

let root = Column(alignment = .Leading, spacing = 8.0):
    TextField(value = Slot(value = ""), label = "t", placeholder = "Nouvelle tâche")
    Button(label = "Supprimer", role = .Destructive, onActivate = noop)
    Toggle(value = Slot(value = true), label = "Done")
let placed = lay(root)
assert_eq(allOf(placed, "TextField")[0].h, 28.0)
assert_eq(allOf(placed, "Button")[0].h, 27.0)
assert_eq(allOf(placed, "Toggle")[0].h, 18.0)
let card = lay(Background(color = "Surface", radius = 12.0, children = [Spacer()]))
var rounded = 0
for c in displayList(card):
    if c.kind == "FillRect" and c.radius == 12.0 and c.hex == "#F2F2F7":
        rounded += 1
assert_eq(rounded, 1)
# the text of a field is centred vertically: 28-pt field, 13-pt line -> 7.5 pt from the top
let field = lay(TextField(value = Slot(value = "abc"), label = "t", placeholder = ""))
let fieldTop = allOf(field, "TextField")[0].y
var textTop = -1.0
for c in displayList(field):
    if c.kind == "DrawText":
        textTop = c.y - fieldTop
assert_eq(textTop, 7.5)
print "mac_theme_test ok"
