# TabView (src/controls.br): only the selected tab's content is mounted.
# Run: boring run tests/tabs_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.events.*
use ui.controls.*

view Panel:
    state int tab = 0

    req int current():
        tab

    def pick(int i):
        tab = i

    body():
        TabView(selected = tab, titles = ["One", "Two"], onSelect = (i):
            self.pick(i)):
            Text(content = "first page")
            Text(content = "second page")

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed lay(Runtime rt):
    let p = layout(rt, 300.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def string page(Runtime rt):
    let t = ofKind(lay(rt), "Text")
    if t.length != 1:
        return "count {t.length}"
    t[0].props["content"] else ("")

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)

assert_eq(page(rt), "first page")
let buttons = ofKind(lay(rt), "Button")
assert_eq(buttons.length, 2)
assert(click(rt, host, lay(rt), buttons[1].x + 2.0, buttons[1].y + 2.0))
assert_eq(page(rt), "second page")
assert(click(rt, host, lay(rt), buttons[0].x + 2.0, buttons[0].y + 2.0))
assert_eq(page(rt), "first page")
print "tabs_test ok"
