# Layer, Fill, Scroll, Offset and Text line limits (src/layout.br). Run: boring run tests/layout_extra_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*

struct Fixed as ViewBuilder:
    View root
    req View buildView(mut Runtime rt): root

def Placed? layIn(mut Runtime rt, View root, float w, float h):
    rt.start(ViewRoot(inner = Fixed(root = root)))
    layout(rt, w, h)

def Placed lay(View root, float w, float h):
    mut rt = Runtime()
    let p = layIn(rt, root, w, h)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

# ── Layer: the same proposal to every child, the union as its size, aligned placement ─────────────

let layer = lay(Layer(alignment = .BottomTrailing, children = [Frame(width = 100.0, height = 40.0, children = [Text("bg")]), Text("new")]), 500.0, 500.0)
assert_eq(layer.w, 100.0)
assert_eq(layer.h, 40.0)
assert_eq(layer.children[0].x, 0.0)
assert_eq(layer.children[1].x, 76.0)       # 100 - 24: trailing
assert_eq(layer.children[1].y, 24.0)       # 40 - 16: bottom

let centered = lay(Layer(children = [Frame(width = 100.0, height = 40.0, children = [Text("bg")]), Text("new")]), 500.0, 500.0)
assert_eq(centered.children[1].x, 38.0)
assert_eq(centered.children[1].y, 12.0)

# ── Fill: accept the proposal, align the child in the extra room, never clip a larger child ───────

let filled = lay(Fill(width = true, height = false, alignment = .MiddleLeading, children = [Text("hi")]), 200.0, 100.0)
assert_eq(filled.w, 200.0)
assert_eq(filled.h, 16.0)
assert_eq(filled.children[0].x, 0.0)

let trailing = lay(Fill(alignment = .BottomTrailing, children = [Text("hi")]), 200.0, 100.0)
assert_eq(trailing.children[0].x, 184.0)
assert_eq(trailing.children[0].y, 84.0)

# A fill does not manufacture space from an unspecified proposal, and a larger child wins.
let tight = lay(Fill(children = [Frame(width = 300.0, height = 10.0, children = [Text("x")])]), 200.0, 100.0)
assert_eq(tight.w, 300.0)

# In a Row, a filling child takes the leftover room.
let row = lay(Row(alignment = .Center, spacing = 0.0, children = [Text("a"), Fill(width = true, height = false, children = [Text("b")]), Text("c")]), 100.0, 50.0)
assert_eq(row.children[1].w, 84.0)
assert_eq(row.children[2].x, 92.0)

# ── Offset: paint/hit geometry moves, sizes and siblings do not ───────────────────────────────────

let moved = lay(Row(alignment = .Center, spacing = 0.0, children = [Offset(x = 5.0, y = 3.0, children = [Text("a")]), Text("b")]), 100.0, 50.0)
assert_eq(moved.w, 16.0)                    # unchanged: 8 + 8
assert_eq(moved.children[1].x, 8.0)         # sibling not displaced
assert_eq(moved.children[0].x, 5.0)
assert_eq(moved.children[0].y, 3.0)
assert_eq(moved.children[0].children[0].x, 5.0)

# ── Text line limits: wrap first, then truncate the last visible line with an ellipsis ────────────

assert_eq(shownLines("aa bb cc dd", 40.0, 2), ["aa bb", "cc dd"])
assert_eq(shownLines("aa bb cc dd ee", 40.0, 2), ["aa bb", "cc..."])
assert_eq(shownLines("aa bb cc", 40.0, 1), ["aa..."])
assert_eq(shownLines("aa bb cc", nil, 1), ["aa bb cc"])
assert_eq(shownLines("aa bb cc", 40.0, nil), ["aa bb", "cc"])

let limited = lay(Text(content = "aa bb cc dd ee", lineLimit = 2), 40.0, 500.0)
assert_eq(limited.h, 32.0)
assert_eq(limited.props["shown"], "aa bb\ncc...")

print "layout extra ok"
