# Input-method composition: marked text, commit, cancel, Enter / Escape ownership, suspension when focus leaves
# (src/events.br ime*, core.br Composition / pruneComposition, layout.br, scene.br, semantics.br).
# ASCII text only (see the README: `String.length` differs between the interpreter and `boring build` for
# other text). Run: boring run tests/ime_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.semantics.*
use ui.events.*
use ui.animator.*

view Form:
    state string text = ""
    state string other = ""
    state int submits = 0
    state int cancels = 0
    state int oks = 0

    def submit():
        submits += 1

    def cancel():
        cancels += 1

    def ok():
        oks += 1

    req string summary():
        "{text}|{submits}/{cancels}/{oks}"

    body():
        Column(alignment = .Leading, spacing = 4.0):
            TextField(value = text, label = "Name", onSubmit = ():
                self.submit())
            TextField(value = other, label = "Other")
            Button(label = "Cancel", role = .Cancel, onActivate = ():
                self.cancel())
            DefaultAction:
                Button(label = "OK", onActivate = ():
                    self.ok())
            Disabled(value = true):
                TextField(value = other, label = "Frozen")

struct FormBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Form()

def Placed lay(Runtime rt):
    let p = layout(rt, 300.0, 300.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind, string key, string want):
    mut out = []
    if p.kind == kind and (p.props[key] else ("")) == want:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind, key, want):
            out.push(f)
    out

def Placed field(Runtime rt, string label):
    ofKind(lay(rt), "TextField", "label", label)[0]

# The `FillRect`s the painter adds for the caret and the selection of the field `id`: [x, w, color] each.
def [string] marks(Runtime rt, int id):
    mut out = []
    for c in displayList(lay(rt)):
        if c.kind == "FillRect" and c.node == id and (c.color == "caret" or c.color == "selection"):
            out.push("{c.color}@{c.x}+{c.w}")
    out

let host = ViewRoot(inner = FormBuilder())
mut rt = Runtime()
rt.start(host)
let name = field(rt, "Name")
let left = name.x + 4.0

# an unfocused field draws no caret
assert_eq(marks(rt, name.id).length, 0)

# focused: a one-pixel bar after the last typed cell (8 px a cell)
assert(click(rt, host, lay(rt), name.x + 2.0, name.y + 2.0))
assert(typeText(rt, host, "abc"))
assert_eq(marks(rt, name.id), ["caret@{left + 24.0}+1"])

# the caret moves with the arrows
assert(keyPress(rt, host, "Left"))
assert_eq(marks(rt, name.id), ["caret@{left + 16.0}+1"])

# a selection shades its cells, under the text
assert(keyPress(rt, host, "ShiftLeft"))
let both = marks(rt, name.id)
assert_eq(both.length, 2)
assert_eq(both[0], "selection@{left + 8.0}+8")
assert_eq(both[1], "caret@{left + 8.0}+1")
var selectionIndex = 0 - 1
var textIndex = 0 - 1
var at = 0
for c in displayList(lay(rt)):
    if c.node == name.id and c.color == "selection":
        selectionIndex = at
    if c.node == name.id and c.kind == "DrawText":
        textIndex = at
    at += 1
assert(selectionIndex >= 0 and selectionIndex < textIndex)

# composing: the bar sits at the cursor inside the marked text, and the selection is not drawn
assert(keyPress(rt, host, "End"))
assert(imeUpdate(rt, host, "nihao", 2))
assert_eq(marks(rt, name.id), ["caret@{left + 40.0}+1"])          # 3 value cells + 2 marked cells
assert(imeUpdate(rt, host, "nihao", 5))
assert_eq(marks(rt, name.id), ["caret@{left + 64.0}+1"])
# the field keeps its focus ring while composing
var ring = false
for c in displayList(lay(rt)):
    if c.kind == "StrokeRect" and c.color == "focus":
        ring = true
assert(ring)

# the animator's presentation keeps the runtime's marks (focus, caret, composition) on the node
mut an = Animator()
commit(an, lay(rt), nil, [], 0.0)
commit(an, lay(rt), nil, [], 1000.0)
let shownField = ofKind(presentation(an, 2000.0), "TextField", "label", "Name")[0]
assert_eq(propOrLive(shownField, "focused", "false"), "true")
assert_eq(propOrLive(shownField, "markedCursor", "-1"), "5")
var presented = false
for c in displayList(presentation(an, 2000.0)):
    if c.kind == "FillRect" and c.node == name.id and c.color == "caret":
        presented = true
assert(presented)

# ── a value longer than the field scrolls to keep the caret in view (layout.br fieldScroll) ──────────────────────
# the "Other" field: 160 px wide, 152 visible; 30 typed cells are 240 px, so the text is shifted by 240 + 1 - 152 = 89
let other = field(rt, "Other")
assert(click(rt, host, lay(rt), other.x + 2.0, other.y + 2.0))
assert(typeText(rt, host, "abcdefghijklmnopqrstuvwxyz0123"))
let scrolled = field(rt, "Other")
assert_eq(marks(rt, scrolled.id), ["caret@{scrolled.x + 4.0 + 240.0 - 89.0}+1"])
var textX = 0.0
for c in displayList(lay(rt)):
    if c.kind == "DrawText" and c.node == scrolled.id:
        textX = c.x
assert_eq(textX, scrolled.x + 4.0 - 89.0)
assert_eq(fieldScroll(0.0, 160.0), 0.0)
assert_eq(fieldScroll(100.0, 160.0), 0.0)
# a click 10 px into the visible field lands on the cell under it: (10 + 89) / 8 = 12.4 -> the caret before cell 12
assert(click(rt, host, lay(rt), scrolled.x + 4.0 + 10.0, scrolled.y + 2.0))
assert_eq(marks(rt, scrolled.id).length, 1)
assert_eq(marks(rt, scrolled.id)[0], "caret@{scrolled.x + 4.0 + 96.0}+1")

print "caret ok"
