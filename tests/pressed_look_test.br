# The built-in look of a pressed Button and Toggle: a second shade over the hover one, only while the pointer that went down on the control is
# still over it (src/scene.br, Runtime.capture + Runtime.hover in layout.br). Run: boring run tests/pressed_look_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.events.*

def noop():
    pass

view Panel:
    state bool on = false

    body():
        Column(alignment = .Leading, spacing = 8.0):
            Button(label = "A", onActivate = noop)
            Toggle(value = on, label = "on")

struct PanelRoot as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed must(Placed? p):
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def Placed lay(Runtime rt):
    must(layout(rt, 200.0, 200.0))

def Placed? find(Placed p, string kind):
    if p.kind == kind:
        return p
    for c in p.children:
        if let f = find(c, kind):
            return f
    nil

def int count(Runtime rt, string color):
    var n = 0
    for c in displayList(lay(rt)):
        if c.color == color:
            n += 1
    n

let host = ViewRoot(inner = PanelRoot())
mut rt = Runtime()
rt.start(host)

# the button: nothing, then hovered, then pressed (a second shade), then hovered again once released
let button = must(find(lay(rt), "Button"))
let bx = button.x + 2.0
let by = button.y + 2.0
assert_eq(count(rt, "hover"), 0)
assert_eq(count(rt, "pressed"), 0)
_ = pointerMove(rt, host, lay(rt), bx, by)
assert_eq(count(rt, "hover"), 1)
assert_eq(count(rt, "pressed"), 0)
_ = pointerDown(rt, host, lay(rt), bx, by)
assert_eq(count(rt, "hover"), 1)
assert_eq(count(rt, "pressed"), 1)
# the second shade covers the same box as the first
var first = Command(kind = "FillRect", x = -1.0, y = -1.0, w = 0.0, h = 0.0)
var second = Command(kind = "FillRect", x = -2.0, y = -2.0, w = 0.0, h = 0.0)
for c in displayList(lay(rt)):
    if c.color == "hover":
        first = c
    if c.color == "pressed":
        second = c
assert_eq(second.x, first.x)
assert_eq(second.w, first.w)
assert_eq(second.radius, first.radius)
# the pointer slides off while still down: back to no shade at all
_ = pointerMove(rt, host, lay(rt), 190.0, 190.0)
assert_eq(count(rt, "pressed"), 0)
_ = pointerMove(rt, host, lay(rt), bx, by)
assert_eq(count(rt, "pressed"), 1)
_ = pointerUp(rt, host, lay(rt), bx, by)
assert_eq(count(rt, "pressed"), 0)
assert_eq(count(rt, "hover"), 1)

# the toggle: the same
let toggle = must(find(lay(rt), "Toggle"))
let tx = toggle.x + 2.0
let ty = toggle.y + 2.0
_ = pointerMove(rt, host, lay(rt), tx, ty)
_ = pointerDown(rt, host, lay(rt), tx, ty)
assert_eq(count(rt, "pressed"), 1)
_ = pointerUp(rt, host, lay(rt), tx, ty)
assert_eq(count(rt, "pressed"), 0)

print "pressed look ok"
