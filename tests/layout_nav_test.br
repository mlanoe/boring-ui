# Tests for Drawer, Toolbar, EmptyState, and Wizard (src/controls.br).
# Run: boring run tests/layout_nav_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.scene.*
use ui.controls.*
use ui.events.*
use ui.animator.*

view Panel:
    state bool drawerOpen = false
    state int wizardStep = 0
    state bool finished = false
    state int emptyClicks = 0

    def openDrawer():
        drawerOpen = true

    def setStep(int s):
        wizardStep = s

    def completeWizard():
        finished = true

    def emptyAction():
        emptyClicks += 1

    req bool isDrawerOpen():
        drawerOpen

    req int currentStep():
        wizardStep

    req bool isFinished():
        finished

    req int emptyActionCount():
        emptyClicks

    body():
        Drawer(isOpen = drawerOpen, drawerWidth = 200.0):
            Column(alignment = .Leading, spacing = 10.0):
                Toolbar(title = "Editor"):
                    Button(label = "Menu", onActivate = ():
                        self.openDrawer())
                    Spacer(minLength = 0.0)
                    Button(label = "Save", onActivate = ():
                        pass)
                EmptyState(title = "No items", message = "Create one to begin", actionLabel = "Create", onAction = ():
                    self.emptyAction())
                Wizard(step = wizardStep, titles = ["Account", "Plan", "Confirm"], onStep = (s): self.setStep(s), onFinish = ():
                    self.completeWizard()):
                    Text(content = "Step 1 body")
                    Text(content = "Step 2 body")
                    Text(content = "Step 3 body")
            Column(alignment = .Leading, spacing = 6.0):
                Text(content = "Sidebar Menu", bold = true)
                Text(content = "Settings")

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed lay(Runtime rt):
    let p = layout(rt, 500.0, 480.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def bool hasText(Runtime rt, string content):
    for t in ofKind(lay(rt), "Text"):
        if (t.props["content"] else ("")) == content:
            return true
    false

def Placed? buttonByLabel(Runtime rt, string label):
    for b in ofKind(lay(rt), "Button"):
        if (b.props["label"] else ("")) == label:
            return b
    nil

def Panel__State panelState(Runtime rt):
    let h = rt.handle(1) else (Handle(id = -1, generation = -1))
    let box = rt.stateOf(h) else (NoState())
    box as Panel__State else (Panel__State())

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)

# 1. Toolbar displays title and action buttons
assert(hasText(rt, "Editor"))
assert(buttonByLabel(rt, "Menu") != nil)
assert(buttonByLabel(rt, "Save") != nil)

# 2. EmptyState renders title, message, and fires onAction
assert(hasText(rt, "No items"))
assert(hasText(rt, "Create one to begin"))
let createBtn = buttonByLabel(rt, "Create") else (lay(rt))
assert(click(rt, host, lay(rt), createBtn.x + 2.0, createBtn.y + 2.0))
assert_eq(Panel().emptyActionCount(panelState(rt)), 1)

# 3. Wizard steps forward from 0 -> 1 -> 2, Back is disabled at 0, and Finish fires at step 2
assert(hasText(rt, "1. Account"))
assert(hasText(rt, "Step 1 body"))
assert(!hasText(rt, "Step 2 body"))
let backBtn0 = buttonByLabel(rt, "Back") else (lay(rt))
assert(!click(rt, host, lay(rt), backBtn0.x + 2.0, backBtn0.y + 2.0))
assert_eq(Panel().currentStep(panelState(rt)), 0)
let nextBtn0 = buttonByLabel(rt, "Next") else (lay(rt))
assert(click(rt, host, lay(rt), nextBtn0.x + 2.0, nextBtn0.y + 2.0))
assert_eq(Panel().currentStep(panelState(rt)), 1)
assert(hasText(rt, "Step 2 body"))
let nextBtn1 = buttonByLabel(rt, "Next") else (lay(rt))
assert(click(rt, host, lay(rt), nextBtn1.x + 2.0, nextBtn1.y + 2.0))
assert_eq(Panel().currentStep(panelState(rt)), 2)
assert(hasText(rt, "Step 3 body"))
let finishBtn = buttonByLabel(rt, "Finish") else (lay(rt))
assert(click(rt, host, lay(rt), finishBtn.x + 2.0, finishBtn.y + 2.0))
assert(Panel().isFinished(panelState(rt)))

# 4. Drawer starts closed, opens on Menu click, and closes on "✕" click
assert(!hasText(rt, "Sidebar Menu"))
let menuBtn = buttonByLabel(rt, "Menu") else (lay(rt))
assert(click(rt, host, lay(rt), menuBtn.x + 2.0, menuBtn.y + 2.0))
assert(Panel().isDrawerOpen(panelState(rt)))
assert(hasText(rt, "Sidebar Menu"))
let closeBtn = buttonByLabel(rt, "✕") else (lay(rt))
assert(click(rt, host, lay(rt), closeBtn.x + 2.0, closeBtn.y + 2.0))
for id in retiringIds(rt):
    _ = endRetirement(rt, host, id)
assert(!Panel().isDrawerOpen(panelState(rt)))
assert(!hasText(rt, "Sidebar Menu"))

print "layout_nav_test ok"
