# Form / Section / LabeledContent (src/controls.br): sections with a header and footer, hairlines between rows, a label with its control.
# Run: boring run tests/form_test.br

use boring.ui.*
use ui.core.*
use ui.layout.*
use ui.events.*
use ui.controls.*

view Panel:
    state bool on = false

    body():
        Form:
            Section(header = "Account", footer = "Shown on your profile."):
                LabeledContent(label = "Name"):
                    Text(content = "Ada")
                LabeledContent(label = "Notifications"):
                    Toggle(label = "On", value = on)
            Section(header = "Other"):
                Button(label = "Sign out", onActivate = ():
                    self.signOut())

    def signOut():
        on = false

struct PanelBuilder as ViewBuilder:
    req View buildView(mut Runtime rt): Panel()

def Placed lay(Runtime rt):
    let p = layout(rt, 400.0, 400.0)
    p else (Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0))

def [Placed] ofKind(Placed p, string kind):
    mut out = []
    if p.kind == kind:
        out.push(p)
    for c in p.children:
        for f in ofKind(c, kind):
            out.push(f)
    out

def Placed textOf(Runtime rt, string s):
    for t in ofKind(lay(rt), "Text"):
        if (t.props["content"] else ("")) == s:
            return t
    Placed(id = -1, kind = "", x = 0.0, y = 0.0, w = 0.0, h = 0.0)

let host = ViewRoot(inner = PanelBuilder())
mut rt = Runtime()
rt.start(host)

# Headers, footers and rows all appear, in order, top to bottom.
let account = textOf(rt, "Account")
let name = textOf(rt, "Name")
let footer = textOf(rt, "Shown on your profile.")
let other = textOf(rt, "Other")
assert(account.id >= 0 and name.id >= 0 and footer.id >= 0 and other.id >= 0)
assert(account.y < name.y and name.y < footer.y and footer.y < other.y)

# A hairline sits between the two rows of the first section, none under the first row of the second.
assert_eq(ofKind(lay(rt), "Separator").length, 1)

# LabeledContent: the label leads, its control trails (the value is pushed to the right of the label).
let value = textOf(rt, "Ada")
assert(value.x > name.x + name.w)

# The section's button still works inside the form.
let signOut = ofKind(lay(rt), "Button")[0]
assert(click(rt, host, lay(rt), signOut.x + 2.0, signOut.y + 2.0))
print "form_test ok"
