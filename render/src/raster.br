# boring-ui CPU reference rasterizer (docs/design-notes/boring-ui-renderer-draft.md, step 0).
# Turns the backend-neutral display list (`[Command]`, see scene.br) into a pixel buffer. It is the ORACLE
# every GPU kernel is later compared against, so it favours exact, boring semantics over speed.
#
# Pixel format: `0xAARRGGBB`, one `uint` per pixel (the layout `Screen`'s `'surface` buffers present as BGRA8). The
# buffer starts fully transparent.
#
# Colour pipeline (the renderer draft's: a LINEAR working space): colours arrive sRGB-encoded, every blend decodes to
# linear light, composites premultiplied there and encodes the result back, rounding to 8 bits per operation. A
# stored channel is therefore the sRGB encoding of the *premultiplied linear* value (for an opaque pixel simply its
# sRGB colour, which is what a window shows); alpha is stored linearly. Blending in the encoded space instead makes
# anti-aliased dark-on-light edges (text) too heavy and light-on-dark too thin; the encoded-space version of this
# file is in git history (before this change).
#
# Coverage: an axis-aligned rectangle is rasterized with exact area coverage (a pixel half inside a
# rectangle gets alpha 0.5), and a clip is the geometric intersection of the rectangle with the clip
# rectangle, so a clipped edge anti-aliases the same way a rectangle edge does.
#
# `DrawShadow` is an OUTER, blurred shadow of the command's rectangle: the rectangle is offset by (`dx`, `dy`) and
# blurred with a Gaussian of sigma `value / 2` (so `value`, the radius, is the CSS blur radius: the edge ramps
# over roughly one radius on each side). Coverage is the exact separable box-Gaussian integral evaluated at the
# pixel centre (erf by Abramowitz-Stegun 7.1.26, max error 1.5e-7), truncated 3 sigma beyond the offset
# rectangle; with radius 0 it is the exact area coverage of a hard-edged shadow. It is never drawn inside the
# original rectangle (coverage there is scaled by the rectangle's own uncovered fraction), so a translucent
# child does not show its own shadow through itself.
#
# `DrawText` draws the fixture bitmap font (raster_font.br): a grapheme occupies `displayWidth` cells of
# `h / 2` by `h` pixels (the layout's text metrics), starting at (`x`, `y`) and advancing left to right; each
# glyph's 6x8 texel cell is stretched onto its cell and a pixel's coverage is the exact area of the lit texels
# it overlaps (a box filter, never double-counted), so a glyph anti-aliases like a rectangle does. A grapheme
# the font has no shape for draws a hollow box; zero-width ones draw nothing. Text is not clipped to `w`, only
# by `PushClip`.
#
# `MarkedText` is the input method's composition marker: an underline under the composing text, `h / 16` pixels thick
# (at least one), along the bottom of its cell row, in the command's colour; the text itself is a `DrawText`.
#
# `DrawImage` stretches the named `Bitmap` (see display_list.br) over the command's rectangle: for each pixel the
# image is sampled bilinearly at the pixel centre (texel centres at half-integers, coordinates clamped to the edge),
# in premultiplied linear light, and the result is blended with the rectangle's exact area coverage, so the edges
# anti-alias like a rectangle's. A name that matches no image draws nothing and is listed in `unsupported`.
#
# Implemented so far: `DrawGlyph` (an atlas mask, pen snapped to the pixel grid), `DrawImage`, `FillRect`, `StrokeRect` (an inside border, drawn as four non-overlapping rectangles so
# a translucent border never double-blends at the corners), `PushClip`/`PopClip` and `PushOpacity`/`PopOpacity`
# (group opacity: the group is drawn into its own transparent layer, then composited once at the group's
# opacity, so overlapping descendants do not become darker). Every other command kind is skipped and its kind
# listed in `Raster.unsupported` (a `DrawImage` with no matching image included; so a test, or a reader, can see what the picture is missing).

use render.display_list.*
use render.raster_font.*

def float rmax(float a, float b):
    if a > b:
        return a
    b

def float rmin(float a, float b):
    if a < b:
        return a
    b

pub struct Raster:
    pub int width
    pub int height
    pub [uint] pixels
    # Kinds present in the display list that this rasterizer does not draw yet, each listed once.
    pub [string] unsupported

# A rectangle by its edges (x0 <= x1, y0 <= y1), in pixels.
@derive(Clone)
pub struct Area:
    pub float x0
    pub float y0
    pub float x1
    pub float y1

pub struct Rgba:
    pub int r
    pub int g
    pub int b
    pub int a

pub def Area intersect(Area a, Area b):
    let x0 = rmax(a.x0, b.x0)
    let y0 = rmax(a.y0, b.y0)
    Area(x0 = x0, y0 = y0, x1 = rmax(x0, rmin(a.x1, b.x1)), y1 = rmax(y0, rmin(a.y1, b.y1)))

# The underline of a `MarkedText` command: along the bottom of its rows, `h / 16` thick (at least one pixel).
pub def Area underlineOf(Command c):
    let thick = rmax(1.0, (c.h / 16.0).floor())
    Area(x0 = c.x, y0 = c.y + c.h - thick, x1 = c.x + rmax(c.w, 0.0), y1 = c.y + c.h)

pub def Area areaOf(Command c):
    Area(x0 = c.x, y0 = c.y, x1 = c.x + rmax(c.w, 0.0), y1 = c.y + rmax(c.h, 0.0))

def int hexDigit(string c):
    let i = "0123456789abcdefABCDEF".indexOf(c) else (0)
    if i >= 16:
        return i - 6
    i

def int hexByte(string s, int at):
    hexDigit(s[at..<(at + 1)]) * 16 + hexDigit(s[(at + 1)..<(at + 2)])

# `#RRGGBB[AA]`, or a few named colours (what `resolveColor` leaves for the painter); anything else is
# magenta, so a token the rasterizer does not know shows up instead of vanishing.
pub def Rgba parseColor(string token):
    if (token.length == 7 or token.length == 9) and token[0..<1] == "#":
        var alpha = 255
        if token.length == 9:
            alpha = hexByte(token, 7)
        return Rgba(r = hexByte(token, 1), g = hexByte(token, 3), b = hexByte(token, 5), a = alpha)
    if token == "black":
        return Rgba(r = 0, g = 0, b = 0, a = 255)
    if token == "white":
        return Rgba(r = 255, g = 255, b = 255, a = 255)
    if token == "red":
        return Rgba(r = 255, g = 0, b = 0, a = 255)
    if token == "green":
        return Rgba(r = 0, g = 128, b = 0, a = 255)
    if token == "blue":
        return Rgba(r = 0, g = 0, b = 255, a = 255)
    if token == "transparent":
        return Rgba(r = 0, g = 0, b = 0, a = 0)
    Rgba(r = 255, g = 0, b = 255, a = 255)

def int byteOf(uint p, int shift):
    ((p >> shift) & 255) as int

# The sRGB transfer functions (IEC 61966-2-1): `srgbToLinear` takes an encoded channel on the 0..255 scale and
# returns linear light in 0..1; `linearToSrgb` is its inverse back to 0..255, not rounded.
pub def float srgbToLinear(float c):
    let x = c / 255.0
    if x <= 0.04045:
        return x / 12.92
    pow((x + 0.055) / 1.055, 2.4)

pub def float linearToSrgb(float v):
    if v <= 0.0031308:
        return 255.0 * 12.92 * v
    255.0 * (1.055 * pow(v, 1.0 / 2.4) - 0.055)

# A linear-light value as an sRGB-encoded 8-bit channel: rounded to nearest, clamped to 0..255.
pub def int encode8(float linear):
    let e = (linearToSrgb(linear) + 0.5).floor()
    if e > 255.0:
        return 255
    if e < 0.0:
        return 0
    e as int

# Source-over onto one destination pixel, in linear light. The source is premultiplied linear (`lr`,`lg`,`lb` in 0..1,
# already scaled by its alpha) with alpha `sa` on the 0..255 scale; each destination channel is decoded to linear,
# `src + dst * (1 - sa)` is formed, and the sum is encoded back and rounded. Alpha: `sa + dst alpha * (1 - sa)`.
def uint blend(uint dst, float lr, float lg, float lb, float sa):
    let keep = 1.0 - sa / 255.0
    let a = ((sa + byteOf(dst, 24) as float * keep) + 0.5).floor() as int
    let r = encode8(lr + srgbToLinear(byteOf(dst, 16) as float) * keep)
    let g = encode8(lg + srgbToLinear(byteOf(dst, 8) as float) * keep)
    let b = encode8(lb + srgbToLinear(byteOf(dst, 0) as float) * keep)
    (((a << 24) | (r << 16) | (g << 8) | b) as uint)

# Layers are stored back to back in one buffer: layer `k` occupies `[k * width * height, (k + 1) * width * height)`.
# `base` is the offset of the layer being drawn into.
def fillArea(mut [uint] px, int base, int width, int height, Area area, Rgba color):
    if area.x1 <= area.x0 or area.y1 <= area.y0 or color.a == 0:
        return
    let first_x = rmax(area.x0.floor(), 0.0) as int
    let first_y = rmax(area.y0.floor(), 0.0) as int
    let last_x = rmin(area.x1.ceil() - 1.0, (width - 1) as float) as int
    let last_y = rmin(area.y1.ceil() - 1.0, (height - 1) as float) as int
    var y = first_y
    while y <= last_y:
        let cover_y = rmin((y + 1) as float, area.y1) - rmax(y as float, area.y0)
        var x = first_x
        while x <= last_x:
            let cover = (rmin((x + 1) as float, area.x1) - rmax(x as float, area.x0)) * cover_y
            if cover > 0.0:
                let a = color.a as float * cover
                let k = a / 255.0
                let i = base + y * width + x
                px[i] = blend(px[i], srgbToLinear(color.r as float) * k, srgbToLinear(color.g as float) * k, srgbToLinear(color.b as float) * k, a)
            x += 1
        y += 1

# The inside border of `c`, `c.value` wide (clamped so it never exceeds half the rectangle): top and bottom
# bands across the full width, left and right bands between them.
def strokeArea(mut [uint] px, int base, int width, int height, Area box, float line, Area clip, Rgba color):
    let w = rmin(line, rmin((box.x1 - box.x0) / 2.0, (box.y1 - box.y0) / 2.0))
    if w <= 0.0:
        return
    fillArea(px, base, width, height, intersect(Area(x0 = box.x0, y0 = box.y0, x1 = box.x1, y1 = box.y0 + w), clip), color)
    fillArea(px, base, width, height, intersect(Area(x0 = box.x0, y0 = box.y1 - w, x1 = box.x1, y1 = box.y1), clip), color)
    fillArea(px, base, width, height, intersect(Area(x0 = box.x0, y0 = box.y0 + w, x1 = box.x0 + w, y1 = box.y1 - w), clip), color)
    fillArea(px, base, width, height, intersect(Area(x0 = box.x1 - w, y0 = box.y0 + w, x1 = box.x1, y1 = box.y1 - w), clip), color)

# erf(x), Abramowitz-Stegun 7.1.26. The GPU kernels must use this same polynomial to stay within one LSB.
def float erfOf(float x):
    let t = 1.0 / (1.0 + 0.3275911 * abs(x))
    let poly = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t
    let y = 1.0 - poly * exp(-x * x)
    if x < 0.0:
        return -y
    y

# Length of the overlap of [lo, hi] with [a, b].
def float overlap1d(float lo, float hi, float a, float b):
    rmax(0.0, rmin(hi, b) - rmax(lo, a))

# Coverage of pixel `i` along one axis by the interval [a, b] blurred with `sigma` (exact overlap when sigma is 0).
def float gauss1d(int i, float a, float b, float sigma):
    if sigma <= 0.0:
        return overlap1d(i as float, (i + 1) as float, a, b)
    let c = i as float + 0.5
    let k = sigma * 1.4142135623730951
    0.5 * (erfOf((b - c) / k) - erfOf((a - c) / k))

def shadowArea(mut [uint] px, int base, int width, int height, Area box, float radius, float dx, float dy, Area clip, Rgba color):
    if box.x1 <= box.x0 or box.y1 <= box.y0 or color.a == 0:
        return
    let sigma = rmax(radius, 0.0) / 2.0
    let reach = 3.0 * sigma
    let sx0 = box.x0 + dx
    let sx1 = box.x1 + dx
    let sy0 = box.y0 + dy
    let sy1 = box.y1 + dy
    let first_x = rmax(rmax((sx0 - reach).floor(), clip.x0.floor()), 0.0) as int
    let first_y = rmax(rmax((sy0 - reach).floor(), clip.y0.floor()), 0.0) as int
    let last_x = rmin(rmin((sx1 + reach).ceil(), clip.x1.ceil()) - 1.0, (width - 1) as float) as int
    let last_y = rmin(rmin((sy1 + reach).ceil(), clip.y1.ceil()) - 1.0, (height - 1) as float) as int
    var y = first_y
    while y <= last_y:
        let cover_y = gauss1d(y, sy0, sy1, sigma)
        let inside_y = overlap1d(y as float, (y + 1) as float, box.y0, box.y1)
        let clip_y = overlap1d(y as float, (y + 1) as float, clip.y0, clip.y1)
        var x = first_x
        while x <= last_x:
            let inside = overlap1d(x as float, (x + 1) as float, box.x0, box.x1) * inside_y
            let clipped = overlap1d(x as float, (x + 1) as float, clip.x0, clip.x1) * clip_y
            let cover = gauss1d(x, sx0, sx1, sigma) * cover_y * (1.0 - inside) * clipped
            if cover > 0.0:
                let a = color.a as float * cover
                let k = a / 255.0
                let i = base + y * width + x
                px[i] = blend(px[i], srgbToLinear(color.r as float) * k, srgbToLinear(color.g as float) * k, srgbToLinear(color.b as float) * k, a)
            x += 1
        y += 1

# One glyph of the atlas stretched onto the cell (`cx`, `cy`, `cw` x `ch`), coverage accumulated per pixel from
# the lit texels it overlaps, then blended once.
def drawGlyph(mut [uint] px, int base, int width, int height, [uint8] atlas, int glyph, float cx, float cy, float cw, float ch, Area clip, Rgba color):
    if cw <= 0.0 or ch <= 0.0 or color.a == 0:
        return
    let tw = cw / GLYPH_COLUMNS as float
    let th = ch / GLYPH_ROWS as float
    let first_x = rmax(rmax(cx.floor(), clip.x0.floor()), 0.0) as int
    let first_y = rmax(rmax(cy.floor(), clip.y0.floor()), 0.0) as int
    let last_x = rmin(rmin((cx + cw).ceil(), clip.x1.ceil()) - 1.0, (width - 1) as float) as int
    let last_y = rmin(rmin((cy + ch).ceil(), clip.y1.ceil()) - 1.0, (height - 1) as float) as int
    var y = first_y
    while y <= last_y:
        let row_lo = rmax(((y as float - cy) / th).floor(), 0.0) as int
        let row_hi = rmin(((y + 1) as float - cy) / th, GLYPH_ROWS as float).ceil() as int - 1
        let clip_y = overlap1d(y as float, (y + 1) as float, clip.y0, clip.y1)
        var x = first_x
        while x <= last_x:
            let col_lo = rmax(((x as float - cx) / tw).floor(), 0.0) as int
            let col_hi = rmin(((x + 1) as float - cx) / tw, GLYPH_COLUMNS as float).ceil() as int - 1
            var cover = 0.0
            var r = row_lo
            while r <= row_hi:
                let over_y = overlap1d(y as float, (y + 1) as float, cy + r as float * th, cy + (r + 1) as float * th)
                var c = col_lo
                while c <= col_hi:
                    if atlas[glyph * GLYPH_TEXELS + r * GLYPH_COLUMNS + c] > 0:
                        cover += overlap1d(x as float, (x + 1) as float, cx + c as float * tw, cx + (c + 1) as float * tw) * over_y
                    c += 1
                r += 1
            cover = cover * overlap1d(x as float, (x + 1) as float, clip.x0, clip.x1) * clip_y
            if cover > 0.0:
                let a = color.a as float * rmin(cover, 1.0)
                let k = a / 255.0
                let i = base + y * width + x
                px[i] = blend(px[i], srgbToLinear(color.r as float) * k, srgbToLinear(color.g as float) * k, srgbToLinear(color.b as float) * k, a)
            x += 1
        y += 1

def drawText(mut [uint] px, int base, int width, int height, [uint8] atlas, Command c, Area clip, Rgba color):
    let cell = c.h / 2.0
    var pen = c.x
    for i in 0..<c.text.graphemeCount:
        let g = c.text.graphemeSlice(i, i + 1)
        let cells = g.displayWidth
        if cells > 0:
            drawGlyph(px, base, width, height, atlas, glyphIndex(g), pen, c.y, cell * cells as float, c.h, clip, color)
        pen += cell * cells as float

# One atlas glyph (a `DrawGlyph`): its mask is copied with the pen snapped to the pixel grid, each pixel's coverage
# the mask byte times the clip's coverage of the pixel, blended like a rectangle's.
def drawAtlasGlyph(mut [uint] px, int base, int width, int height, GlyphAtlas atlas, Command c, Area clip, Rgba color):
    let g = c.glyph
    if g < 0 or g >= atlas.width.length or color.a == 0:
        return
    let w = atlas.width[g]
    let h = atlas.height[g]
    let ox = (c.x + 0.5).floor() as int + atlas.left[g]
    let oy = (c.y + 0.5).floor() as int - atlas.top[g]
    let start = atlas.offset[g]
    var row = 0
    while row < h:
        let y = oy + row
        if y >= 0 and y < height:
            let clip_y = overlap1d(y as float, (y + 1) as float, clip.y0, clip.y1)
            var col = 0
            while col < w:
                let x = ox + col
                if x >= 0 and x < width:
                    let m = atlas.alpha[start + row * w + col]
                    if m > 0:
                        let cover = overlap1d(x as float, (x + 1) as float, clip.x0, clip.x1) * clip_y * (m as float / 255.0)
                        if cover > 0.0:
                            let a = color.a as float * cover
                            let k = a / 255.0
                            let i = base + y * width + x
                            px[i] = blend(px[i], srgbToLinear(color.r as float) * k, srgbToLinear(color.g as float) * k, srgbToLinear(color.b as float) * k, a)
                col += 1
        row += 1

# The index of the image called `name`, or -1.
pub def int findImage([Bitmap] images, string name):
    var i = 0
    while i < images.length:
        if images[i].name == name:
            return i
        i += 1
    0 - 1

# One texel as premultiplied linear light, [r, g, b, a] with a on the 0..1 scale.
def [float] texelLinear(Bitmap img, int x, int y):
    let t = img.pixels[y * img.width + x]
    let a = byteOf(t, 24) as float / 255.0
    [srgbToLinear(byteOf(t, 16) as float) * a, srgbToLinear(byteOf(t, 8) as float) * a, srgbToLinear(byteOf(t, 0) as float) * a, a]

def drawImage(mut [uint] px, int base, int width, int height, Bitmap img, Command c, Area clip):
    let box = intersect(areaOf(c), clip)
    if box.x1 <= box.x0 or box.y1 <= box.y0 or c.w <= 0.0 or c.h <= 0.0 or img.width <= 0 or img.height <= 0:
        return
    let first_x = rmax(box.x0.floor(), 0.0) as int
    let first_y = rmax(box.y0.floor(), 0.0) as int
    let last_x = rmin(box.x1.ceil() - 1.0, (width - 1) as float) as int
    let last_y = rmin(box.y1.ceil() - 1.0, (height - 1) as float) as int
    let maxu = (img.width - 1) as float
    let maxv = (img.height - 1) as float
    var y = first_y
    while y <= last_y:
        let cover_y = overlap1d(y as float, (y + 1) as float, box.y0, box.y1)
        let v = rmax(0.0, rmin(((y as float + 0.5 - c.y) / c.h) * img.height as float - 0.5, maxv))
        let y0 = v.floor() as int
        let y1 = (y0 + 1) as int
        let wy = v - y0 as float
        var x = first_x
        while x <= last_x:
            let cover = overlap1d(x as float, (x + 1) as float, box.x0, box.x1) * cover_y
            if cover > 0.0:
                let u = rmax(0.0, rmin(((x as float + 0.5 - c.x) / c.w) * img.width as float - 0.5, maxu))
                let x0 = u.floor() as int
                let wx = u - x0 as float
                var x1 = x0 + 1
                if x1 > img.width - 1:
                    x1 = img.width - 1
                var yy = y1
                if yy > img.height - 1:
                    yy = img.height - 1
                let t00 = texelLinear(img, x0, y0)
                let t10 = texelLinear(img, x1, y0)
                let t01 = texelLinear(img, x0, yy)
                let t11 = texelLinear(img, x1, yy)
                let w00 = (1.0 - wx) * (1.0 - wy)
                let w10 = wx * (1.0 - wy)
                let w01 = (1.0 - wx) * wy
                let w11 = wx * wy
                let lr = (t00[0] * w00 + t10[0] * w10 + t01[0] * w01 + t11[0] * w11) * cover
                let lg = (t00[1] * w00 + t10[1] * w10 + t01[1] * w01 + t11[1] * w11) * cover
                let lb = (t00[2] * w00 + t10[2] * w10 + t01[2] * w01 + t11[2] * w11) * cover
                let sa = (t00[3] * w00 + t10[3] * w10 + t01[3] * w01 + t11[3] * w11) * 255.0 * cover
                if sa > 0.0:
                    let i = base + y * width + x
                    px[i] = blend(px[i], lr, lg, lb, sa)
            x += 1
        y += 1

# Composites the layer at offset `src` onto the one at `dst` at `opacity` (0..1): the layer's premultiplied linear
# channels and its alpha are scaled by it, then blended source-over.
def compositeLayer(mut [uint] px, int src, int dst, int count, float opacity):
    var i = 0
    while i < count:
        let s = px[src + i]
        if s != 0:
            px[dst + i] = blend(px[dst + i], srgbToLinear(byteOf(s, 16) as float) * opacity, srgbToLinear(byteOf(s, 8) as float) * opacity, srgbToLinear(byteOf(s, 0) as float) * opacity, byteOf(s, 24) as float * opacity)
        i += 1

# Draws `list` into a fresh `width` x `height` buffer. Paint order is list order. `DrawImage` is skipped (no images).
pub def Raster rasterize([Command] list, int width, int height):
    rasterizeImages(list, [], width, height)

# `rasterize` with the images `DrawImage` commands name (see `Bitmap`).
pub def Raster rasterizeImages([Command] list, [Bitmap] images, int width, int height):
    rasterizeWith(list, images, GlyphAtlas(), width, height)

# `rasterizeImages` plus the glyph atlas `DrawGlyph` commands index (see `GlyphAtlas`).
pub def Raster rasterizeWith([Command] list, [Bitmap] images, GlyphAtlas glyphs, int width, int height):
    let count = width * height
    # layer 0 is the picture; each open `PushOpacity` adds one layer on top (grown on demand, reused after)
    mut [uint] store = [0 for ..<count]
    mut [float] opacities = []
    mut [string] skipped = []
    # the glyph atlas is built the first time a DrawText needs it
    var mut [uint8] atlas = []
    mut [Area] clips = [Area(x0 = 0.0, y0 = 0.0, x1 = width as float, y1 = height as float)]
    for c in list:
        let base = opacities.length * count
        let clip = clips[clips.length - 1]
        if c.kind == "FillRect":
            fillArea(store, base, width, height, intersect(areaOf(c), clip), parseColor(c.hex))
        elif c.kind == "MarkedText":
            fillArea(store, base, width, height, intersect(underlineOf(c), clip), parseColor(c.hex))
        elif c.kind == "StrokeRect":
            strokeArea(store, base, width, height, areaOf(c), c.value, clip, parseColor(c.hex))
        elif c.kind == "DrawShadow":
            shadowArea(store, base, width, height, areaOf(c), c.value, c.dx, c.dy, clip, parseColor(c.hex))
        elif c.kind == "DrawText":
            if atlas.length == 0:
                atlas = buildAtlas()
            drawText(store, base, width, height, atlas, c, clip, parseColor(c.hex))
        elif c.kind == "DrawGlyph":
            drawAtlasGlyph(store, base, width, height, glyphs, c, clip, parseColor(c.hex))
        elif c.kind == "DrawImage" and findImage(images, c.text) >= 0:
            let which = findImage(images, c.text)
            drawImage(store, base, width, height, images[which], c, clip)
        elif c.kind == "PushClip":
            clips.push(intersect(areaOf(c), clip))
        elif c.kind == "PopClip":
            if clips.length > 1:
                _ = clips.pop()
        elif c.kind == "PushOpacity":
            opacities.push(rmax(0.0, rmin(c.value, 1.0)))
            let top = opacities.length * count
            if store.length < top + count:
                var k = 0
                while k < count:
                    store.push(0)
                    k += 1
            else:
                var i = 0
                while i < count:
                    store[top + i] = 0
                    i += 1
        elif c.kind == "PopOpacity":
            if opacities.length > 0:
                let opacity = opacities[opacities.length - 1]
                compositeLayer(store, opacities.length * count, (opacities.length - 1) * count, count, opacity)
                _ = opacities.pop()
        elif !skipped.contains(c.kind):
            skipped.push(c.kind)
    # a group left open at the end of the list is composited like a closed one
    while opacities.length > 0:
        compositeLayer(store, opacities.length * count, (opacities.length - 1) * count, count, opacities[opacities.length - 1])
        _ = opacities.pop()
    Raster(width = width, height = height, pixels = store[0..<count], unsupported = skipped)

# The pixel at (x, y) as `#AARRGGBB` (premultiplied), for tests and debugging.
pub def string pixelHex(Raster r, int x, int y):
    "#{r.pixels[y * r.width + x]:08X}"

# The picture as a plain-text PPM (P3), composited over white in linear light (PPM has no alpha channel).
pub def string toPpm(Raster r):
    mut rows = []
    for y in 0..<r.height:
        mut cells = []
        for x in 0..<r.width:
            let p = r.pixels[y * r.width + x]
            let rest = 1.0 - byteOf(p, 24) as float / 255.0
            cells.push("{encode8(srgbToLinear(byteOf(p, 16) as float) + rest)} {encode8(srgbToLinear(byteOf(p, 8) as float) + rest)} {encode8(srgbToLinear(byteOf(p, 0) as float) + rest)}")
        rows.push(cells.join(" "))
    "P3\n{r.width} {r.height}\n255\n{rows.join("\n")}\n"
