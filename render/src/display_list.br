# boring-ui display list vocabulary: the `Command` a scene emits (scene.br) and a renderer consumes
# (raster.br, raster_gpu.br). Kept apart from scene.br, which needs the whole view machinery, so a renderer
# can be built for the kernel targets without pulling it in.
#
# Vocabulary (`kind`): `FillRect`, `StrokeRect` (inside border), `DrawShadow`, `DrawText`, `DrawImage`,
# `DrawGlyph`, `MarkedText`, `DrawLine`, `PushClip`/`PopClip`, `PushOpacity`/`PopOpacity`. `FillRect`/`StrokeRect` carry an optional corner `radius`.
#
# `DrawLine` is one straight segment with round ends: it starts at (`x`, `y`), ends at (`x + dx`, `y + dy`) and is `value` thick (a check mark is
# two of them). `w`, `h` are unused (0).
#
# `DrawGlyph` is one shaped glyph of a real font: `glyph` is its index in the `GlyphAtlas` handed next to the list,
# (`x`, `y`) the pen position on the baseline (pixels, snapped to the pixel grid by the renderers), `hex` its colour.

pub struct Command:
    pub string kind
    pub float x
    pub float y
    pub float w
    pub float h
    pub string text = ""
    pub string color = ""
    pub var int node = -1
    # `DrawGlyph`: the index of the glyph in the atlas.
    pub int glyph = -1
    # `DrawText`: 0 regular, 1 bold, 2 italic, 3 bold italic (which cut of the font the text engine sets it in).
    pub var int style = 0
    # Border width / opacity / shadow radius, and a shadow's offset.
    # The color token resolved against the node's theme (`#RRGGBB[AA]`); `color` keeps the semantic token.
    pub var string hex = ""
    pub var float value = 0.0
    pub var float dx = 0.0
    pub var float dy = 0.0
    # `FillRect` / `StrokeRect`: the corner radius (0 = square corners). Clamped to half the shorter side by the renderers;
    # a `StrokeRect`'s inner edge follows it inset by the border width.
    pub var float radius = 0.0

# A decoded image a `DrawImage` command refers to by `name` (the command's `text`): `width` x `height` texels, row-major,
# straight-alpha sRGB `0xAARRGGBB`. Decoding files (PNG, JPEG, ...) is outside Boring; a renderer is handed the
# result next to the display list (`rasterizeImages` and its kernel twins). A `DrawImage` whose name matches no
# image is not drawn.
pub struct Bitmap:
    pub string name
    pub int width
    pub int height
    pub [uint] pixels

# The most pixels (width x height) an image decoder accepts: a header can declare any size, and the decoders allocate from it
# (the JPEG one keeps a coefficient array of about three times as many entries), so a hostile file must not be able to ask
# for gigabytes. 16 megapixels is a 4096 x 4096 picture, well above any window.
pub let int maxImagePixels = 16777216

# The glyph images a `DrawGlyph` command refers to, as one pool of 8-bit coverage masks (struct of arrays, so a
# kernel reads plain numeric buffers). Glyph `g` is `width[g]` x `height[g]` bytes starting at `offset[g]` in
# `alpha`, row-major; `left[g]`/`top[g]` locate its top-left corner from the pen on the baseline (`top` positive
# upward). Nothing is packed in 2D: a mask is contiguous, so a sample is `alpha[offset + row * width + col]`.
# The host (the text engine) renders each glyph once at its size and adds it with `addGlyph`.
pub struct GlyphAtlas:
    pub var mut [int] width = []
    pub var mut [int] height = []
    pub var mut [int] left = []
    pub var mut [int] top = []
    pub var mut [int] offset = []
    pub var mut [uint8] alpha = []

    # Appends a glyph mask (`w` * `h` bytes) and returns its index.
    def int addGlyph(int w, int h, int l, int t, [uint8] mask):
        width.push(w)
        height.push(h)
        left.push(l)
        top.push(t)
        offset.push(alpha.length)
        for b in mask:
            alpha.push(b)
        width.length - 1
