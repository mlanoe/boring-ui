# The kernel rasterizer (src/raster_gpu.br) against the CPU reference (src/raster.br): every channel of every
# pixel within one LSB (the f32 headroom), on a corpus covering each command kind and their combinations.
# Run: boring run tests/raster_gpu_test.br   (kernels are simulated sequentially on the CPU there; also
# `boring build --target simd` and `--target wgpu` for the real thing)

use render.display_list.*
use render.raster.*
use render.raster_gpu.*

def Command rect(float x, float y, float w, float h, string hex):
    Command(kind = "FillRect", x = x, y = y, w = w, h = h, hex = hex)

def Command stroke(float x, float y, float w, float h, float line, string hex):
    Command(kind = "StrokeRect", x = x, y = y, w = w, h = h, hex = hex, value = line)

def Command shadow(float x, float y, float w, float h, float radius, float dx, float dy, string hex):
    Command(kind = "DrawShadow", x = x, y = y, w = w, h = h, hex = hex, value = radius, dx = dx, dy = dy)

def Command text(float x, float y, float h, string content, string hex):
    Command(kind = "DrawText", x = x, y = y, w = 100.0, h = h, text = content, hex = hex)

def Command clip(float x, float y, float w, float h):
    Command(kind = "PushClip", x = x, y = y, w = w, h = h)

def Command pop():
    Command(kind = "PopClip", x = 0.0, y = 0.0, w = 0.0, h = 0.0)

def Command fade(float opacity):
    Command(kind = "PushOpacity", x = 0.0, y = 0.0, w = 0.0, h = 0.0, value = opacity)

def Command unfade():
    Command(kind = "PopOpacity", x = 0.0, y = 0.0, w = 0.0, h = 0.0)

# Renders `list` both ways and returns the largest channel difference.
def int compare([Command] list, int w, int h) throws:
    maxDifference(rasterize(list, w, h), rasterizeGpu(list, w, h))

assert_eq(compare([rect(1.0, 1.0, 6.0, 4.0, "#FF0000"), rect(4.0, 2.0, 8.0, 5.0, "#0000FF80")], 16, 8), 0)
assert_eq(compare([rect(0.5, 0.25, 6.3, 4.1, "#336699")], 16, 8), 0)
assert_eq(compare([clip(2.0, 1.0, 5.5, 3.0), rect(0.0, 0.0, 16.0, 8.0, "#00FF00"), pop(), rect(9.0, 0.0, 3.0, 2.0, "#FFFFFF")], 16, 8), 0)
assert(compare([stroke(1.0, 1.0, 10.0, 6.0, 2.0, "#FFFFFF80")], 16, 8) <= 1)
assert(compare([stroke(0.5, 0.5, 9.0, 5.0, 1.5, "#102030")], 16, 8) <= 1)
assert(compare([shadow(5.0, 5.0, 6.0, 6.0, 0.0, 2.0, 2.0, "#000000")], 20, 20) <= 1)
assert(compare([shadow(8.0, 8.0, 4.0, 4.0, 4.0, 0.0, 0.0, "#000000")], 20, 20) <= 1)
assert(compare([rect(0.0, 0.0, 20.0, 20.0, "#FFFFFF"), shadow(6.0, 6.0, 8.0, 8.0, 6.0, 1.0, 2.0, "#00000080"), rect(6.0, 6.0, 8.0, 8.0, "#3366FF")], 20, 20) <= 1)
assert(compare([text(0.0, 0.0, 16.0, "Hello", "#000000")], 48, 16) <= 1)
assert(compare([text(0.5, 0.25, 24.0, "日I e", "#FF8800")], 80, 24) <= 1)
assert(compare([clip(0.0, 0.0, 30.0, 16.0), text(0.0, 0.0, 16.0, "Clipped text", "#000000"), pop()], 48, 16) <= 1)
assert(compare([fade(0.5), rect(0.0, 0.0, 6.0, 4.0, "#FF0000"), rect(3.0, 0.0, 6.0, 4.0, "#0000FF"), unfade()], 12, 4) <= 1)
assert(compare([rect(0.0, 0.0, 12.0, 4.0, "#0000FF"), fade(0.5), fade(0.5), rect(2.0, 0.0, 6.0, 4.0, "#FFFFFF"), unfade(), unfade()], 12, 4) <= 1)
assert(compare([unfade(), fade(0.4), rect(0.0, 0.0, 6.0, 4.0, "#FFFFFF")], 12, 4) <= 1)
assert(compare([fade(0.5), shadow(2.0, 2.0, 4.0, 4.0, 2.0, 1.0, 1.0, "#000000"), text(0.0, 0.0, 16.0, "Hi", "#000000"), unfade()], 24, 16) <= 1)

assert(compare([text(0.0, 0.0, 16.0, "nihao", "#000000"), Command(kind = "MarkedText", x = 0.0, y = 0.0, w = 20.0, h = 16.0, text = "nihao", hex = "#0A84FF")], 48, 16) <= 1)
assert(compare([clip(0.0, 0.0, 9.0, 40.0), Command(kind = "MarkedText", x = 2.0, y = 4.0, w = 12.0, h = 32.0, text = "ni", hex = "#FF0000"), pop()], 24, 40) <= 1)


# DrawImage: a 3 x 2 image with an opaque, a translucent and a transparent texel, stretched to non-integer boxes,
# clipped, inside a group, and one that overlaps a fill (plus a name no image has, which both skip).
def [Bitmap] sampleList():
    [Bitmap(name = "s", width = 3, height = 2, pixels = [0xFFFF0000 as uint, 0x8000FF00 as uint, 0x000000FF as uint, 0xFF336699 as uint, 0xFFFFFFFF as uint, 0xC0102030 as uint])]
def Command pic(float x, float y, float w, float h, string name):
    Command(kind = "DrawImage", x = x, y = y, w = w, h = h, text = name)
def int compareImages([Command] list, int w, int h) throws:
    maxDifference(rasterizeImages(list, sampleList(), w, h), rasterizeGpuImages(list, sampleList(), w, h))

assert(compareImages([pic(1.0, 1.0, 3.0, 2.0, "s")], 6, 4) <= 1)
assert(compareImages([rect(0.0, 0.0, 20.0, 12.0, "#FFFFFF"), pic(2.5, 1.25, 13.7, 8.3, "s")], 20, 12) <= 1)
assert(compareImages([clip(4.0, 2.0, 7.0, 5.0), pic(2.5, 1.25, 13.7, 8.3, "s"), pop(), pic(0.0, 0.0, 2.0, 2.0, "nope")], 20, 12) <= 1)
assert(compareImages([fade(0.5), pic(1.0, 1.0, 9.0, 6.0, "s"), rect(4.0, 0.0, 6.0, 4.0, "#0000FF"), unfade()], 12, 8) <= 1)

# Nothing to draw: no kernel dispatch, same empty picture.
assert_eq(compare([], 4, 4), 0)

# DrawGlyph: masks from an atlas (varied coverage), pens at fractional positions, clipped, inside a group,
# one glyph straddling the 16 pixel tile edge, and an index the atlas has not got (both skip it).
def GlyphAtlas sampleGlyphs():
    mut a = GlyphAtlas()
    _ = a.addGlyph(5, 4, 1, 4, [0, 64, 128, 255, 255, 30, 90, 180, 220, 10, 255, 255, 255, 255, 255, 0, 0, 0, 7, 0])
    _ = a.addGlyph(3, 3, 0, 3, [255, 128, 0, 128, 255, 128, 0, 128, 255])
    a
def Command mark(int index, float x, float y, string hex):
    Command(kind = "DrawGlyph", x = x, y = y, w = 0.0, h = 0.0, glyph = index, hex = hex)

def int compareGlyphs([Command] list, int w, int h) throws:
    maxDifference(rasterizeWith(list, [], sampleGlyphs(), w, h), rasterizeGpuWith(list, [], sampleGlyphs(), w, h))
assert(compareGlyphs([mark(0, 3.0, 6.0, "#000000"), mark(1, 14.4, 6.6, "#FF8800")], 40, 20) <= 1)
assert(compareGlyphs([rect(0.0, 0.0, 40.0, 20.0, "#FFFFFF"), mark(0, 13.0, 10.0, "#336699"), mark(1, 15.5, 10.0, "#FF000080"), mark(7, 2.0, 2.0, "#000000")], 40, 20) <= 1)
assert(compareGlyphs([clip(0.0, 0.0, 15.0, 20.0), mark(0, 13.0, 10.0, "#000000"), pop()], 40, 20) <= 1)
assert(compareGlyphs([fade(0.5), rect(0.0, 0.0, 20.0, 20.0, "#0000FF"), mark(0, 3.0, 8.0, "#FFFFFF"), unfade()], 40, 20) <= 1)

def Command roundedRect(float x, float y, float w, float h, float r, string hex):
    Command(kind = "FillRect", x = x, y = y, w = w, h = h, hex = hex, radius = r)

def Command roundedStroke(float x, float y, float w, float h, float line, float r, string hex):
    Command(kind = "StrokeRect", x = x, y = y, w = w, h = h, hex = hex, value = line, radius = r)

assert(compare([roundedRect(1.0, 1.0, 12.0, 6.0, 3.0, "#336699")], 16, 8) <= 1)
assert(compare([roundedRect(0.5, 0.25, 14.3, 7.1, 4.0, "#FF000080"), roundedStroke(0.5, 0.25, 14.3, 7.1, 1.0, 4.0, "#0000FF")], 16, 8) <= 1)
assert(compare([clip(2.0, 1.0, 9.5, 5.0), roundedRect(0.0, 0.0, 16.0, 8.0, 8.0, "#00FF00"), pop(), roundedStroke(2.0, 1.0, 12.0, 6.0, 1.5, 3.0, "#000000")], 16, 8) <= 1)

def Command seg(float x, float y, float dx, float dy, float w, string hex):
    Command(kind = "DrawLine", x = x, y = y, w = 0.0, h = 0.0, dx = dx, dy = dy, value = w, hex = hex)

assert(compare([seg(2.0, 4.5, 8.0, 0.0, 1.0, "#FF0000")], 16, 9) <= 1)
assert(compare([seg(1.5, 1.25, 9.5, 5.75, 2.2, "#336699"), seg(11.0, 6.0, 3.0, -4.5, 1.6, "#FF880080")], 16, 9) <= 1)
assert(compare([clip(3.0, 1.0, 7.5, 5.0), seg(0.0, 0.0, 15.0, 8.0, 3.0, "#00AA55"), pop()], 16, 9) <= 1)
assert(compare([fade(0.5), seg(2.0, 2.0, 10.0, 3.0, 2.0, "#0000FF"), unfade()], 16, 9) <= 1)

print "raster gpu ok"
