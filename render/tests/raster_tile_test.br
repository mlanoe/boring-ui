# The tiled kernel rasterizer (src/raster_tile.br) against the per-pixel one (src/raster_gpu.br): bit-identical
# (a difference of 0), and so within one LSB of the CPU reference (src/raster.br). Includes more than one round
# of 256 commands per tile and opacity groups that open in one round and close in a later one.
# Run: boring run tests/raster_tile_test.br   (the simulation costs about a second per tile and round: the
# pictures are small here; run_kernel_tests.sh runs the file on the real simd and wgpu targets, and
# bench/run_bench.sh compares the two kernels at 1280 x 720 and above)

use render.display_list.*
use render.raster.*
use render.raster_gpu.*
use render.raster_tile.*

def Command rect(float x, float y, float w, float h, string hex):
    Command(kind = "FillRect", x = x, y = y, w = w, h = h, hex = hex)

def Command stroke(float x, float y, float w, float h, float line, string hex):
    Command(kind = "StrokeRect", x = x, y = y, w = w, h = h, hex = hex, value = line)

def Command shadow(float x, float y, float w, float h, float radius, float dx, float dy, string hex):
    Command(kind = "DrawShadow", x = x, y = y, w = w, h = h, hex = hex, value = radius, dx = dx, dy = dy)

def Command text(float x, float y, float h, string content, string hex):
    Command(kind = "DrawText", x = x, y = y, w = 100.0, h = h, text = content, hex = hex)

def Command clip(float x, float y, float w, float h):
    Command(kind = "PushClip", x = x, y = y, w = w, h = h)

def Command pop():
    Command(kind = "PopClip", x = 0.0, y = 0.0, w = 0.0, h = 0.0)

def Command fade(float opacity):
    Command(kind = "PushOpacity", x = 0.0, y = 0.0, w = 0.0, h = 0.0, value = opacity)

def Command unfade():
    Command(kind = "PopOpacity", x = 0.0, y = 0.0, w = 0.0, h = 0.0)

# Both kernels, bit-identical; returns the tiled kernel's largest difference against the CPU reference.
def int compare([Command] list, int w, int h) throws:
    let pixel = rasterizeGpu(list, w, h)
    let tiled = rasterizeTiled(list, w, h)
    assert_eq(maxDifference(pixel, tiled), 0)
    maxDifference(rasterize(list, w, h), tiled)

# Content spread over several tiles, shapes straddling tile edges, a shadow whose blur crosses tiles.
assert(compare([rect(10.0, 4.0, 20.0, 9.5, "#336699"), rect(15.5, 8.25, 20.0, 8.0, "#FF880080")], 40, 20) <= 1)
assert(compare([rect(0.0, 0.0, 40.0, 20.0, "#FFFFFF"), shadow(8.0, 4.0, 20.0, 10.0, 8.0, 3.0, 2.0, "#00000080"), stroke(8.0, 4.0, 20.0, 10.0, 1.5, "#202020")], 40, 20) <= 1)
assert(compare([clip(5.0, 3.0, 25.0, 12.0), text(0.0, 2.0, 16.0, "Tiles and text", "#000000"), pop()], 40, 20) <= 1)

# More than one round of 256 commands per tile; a group opens in the first round and closes in the last.
def [Command] many(int n):
    mut [Command] list = [fade(0.7)]
    for i in 0..<n:
        let x = ((i * 37) % 30) as float
        let y = ((i * 53) % 12) as float
        list.push(rect(x, y, 9.5, 6.25, "#3366FF40"))
        if i == n / 2:
            list.push(fade(0.5))
            list.push(text(2.0, 4.0, 16.0, "mid", "#CC0000"))
        if i == n - 20:
            list.push(unfade())
    list.push(unfade())
    list.push(stroke(3.0, 3.0, 25.0, 14.0, 2.0, "#000000"))
    list
assert(compare(many(520), 40, 20) <= 1)

# A tile no command reaches stays transparent, a tile with only an empty group too.
assert(compare([fade(0.5), rect(0.0, 0.0, 4.0, 4.0, "#FFFFFF"), unfade()], 48, 20) <= 1)


# DrawImage: a 3 x 2 image with an opaque, a translucent and a transparent texel, stretched to non-integer boxes,
# clipped, inside a group, and one that overlaps a fill (plus a name no image has, which both skip).
def [Bitmap] sampleList():
    [Bitmap(name = "s", width = 3, height = 2, pixels = [0xFFFF0000 as uint, 0x8000FF00 as uint, 0x000000FF as uint, 0xFF336699 as uint, 0xFFFFFFFF as uint, 0xC0102030 as uint])]
def Command pic(float x, float y, float w, float h, string name):
    Command(kind = "DrawImage", x = x, y = y, w = w, h = h, text = name)
def int compareImages([Command] list, int w, int h) throws:
    let pixel = rasterizeGpuImages(list, sampleList(), w, h)
    let tiled = rasterizeTiledImages(list, sampleList(), w, h)
    assert_eq(maxDifference(pixel, tiled), 0)
    maxDifference(rasterizeImages(list, sampleList(), w, h), tiled)

# an image spanning several tiles, clipped mid-tile, plus one under a group
assert(compareImages([rect(0.0, 0.0, 40.0, 20.0, "#FFFFFF"), clip(5.0, 3.0, 30.0, 12.0), pic(2.5, 1.25, 36.7, 17.3, "s"), pop()], 40, 20) <= 1)
assert(compareImages([fade(0.6), pic(1.0, 1.0, 38.0, 18.0, "s"), rect(10.0, 4.0, 20.0, 8.0, "#0000FF80"), unfade()], 40, 20) <= 1)

# DrawGlyph: masks from an atlas (varied coverage), pens at fractional positions, clipped, inside a group,
# one glyph straddling the 16 pixel tile edge, and an index the atlas has not got (both skip it).
def GlyphAtlas sampleGlyphs():
    mut a = GlyphAtlas()
    _ = a.addGlyph(5, 4, 1, 4, [0, 64, 128, 255, 255, 30, 90, 180, 220, 10, 255, 255, 255, 255, 255, 0, 0, 0, 7, 0])
    _ = a.addGlyph(3, 3, 0, 3, [255, 128, 0, 128, 255, 128, 0, 128, 255])
    a
def Command mark(int index, float x, float y, string hex):
    Command(kind = "DrawGlyph", x = x, y = y, w = 0.0, h = 0.0, glyph = index, hex = hex)

def int compareGlyphs([Command] list, int w, int h) throws:
    let pixel = rasterizeGpuWith(list, [], sampleGlyphs(), w, h)
    let tiled = rasterizeTiledWith(list, [], sampleGlyphs(), w, h)
    assert_eq(maxDifference(pixel, tiled), 0)
    maxDifference(rasterizeWith(list, [], sampleGlyphs(), w, h), tiled)
assert(compareGlyphs([mark(0, 3.0, 6.0, "#000000"), mark(1, 14.4, 6.6, "#FF8800")], 40, 20) <= 1)
assert(compareGlyphs([rect(0.0, 0.0, 40.0, 20.0, "#FFFFFF"), mark(0, 13.0, 10.0, "#336699"), mark(1, 15.5, 10.0, "#FF000080"), mark(7, 2.0, 2.0, "#000000")], 40, 20) <= 1)
assert(compareGlyphs([clip(0.0, 0.0, 15.0, 20.0), mark(0, 13.0, 10.0, "#000000"), pop()], 40, 20) <= 1)
assert(compareGlyphs([fade(0.5), rect(0.0, 0.0, 20.0, 20.0, "#0000FF"), mark(0, 3.0, 8.0, "#FFFFFF"), unfade()], 40, 20) <= 1)

# rounded corners: a fill and a border with a radius, across a tile boundary (x = 16) and under a clip
assert(compare([Command(kind = "FillRect", x = 10.0, y = 2.0, w = 22.0, h = 14.0, hex = "#336699", radius = 5.0), Command(kind = "StrokeRect", x = 10.0, y = 2.0, w = 22.0, h = 14.0, hex = "#FF8800", value = 1.5, radius = 5.0)], 40, 20) <= 1)
assert(compare([clip(12.0, 3.0, 12.5, 9.0), Command(kind = "FillRect", x = 10.0, y = 2.0, w = 22.0, h = 14.0, hex = "#00AA55", radius = 7.0), pop()], 40, 20) <= 1)

# lines, across the tile boundary at x = 16 and in a group
assert(compare([Command(kind = "DrawLine", x = 6.0, y = 3.0, w = 0.0, h = 0.0, dx = 24.0, dy = 11.0, value = 2.5, hex = "#336699"), Command(kind = "DrawLine", x = 30.0, y = 4.0, w = 0.0, h = 0.0, dx = -12.0, dy = 10.0, value = 1.5, hex = "#FF880080")], 40, 20) <= 1)
assert(compare([fade(0.6), Command(kind = "DrawLine", x = 4.0, y = 16.0, w = 0.0, h = 0.0, dx = 30.0, dy = -12.0, value = 3.0, hex = "#0000FF"), unfade()], 40, 20) <= 1)

print "raster tile ok"
