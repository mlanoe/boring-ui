# Speed of the rasterizers on a UI-like scene: the CPU reference against the kernel rasterizer, on the real
# kernel targets. Run with bench/run_bench.sh (it builds this for `simd` and `wgpu`).
#
# A scene of `cards` cards on a window background: each card has a shadow, a face, a border and three lines of
# text (about 60 glyph commands), the way a settings or list screen is made.

use std.time.Instant
use render.display_list.*
use render.raster.*
use render.raster_gpu.*
use render.raster_tile.*

def Command rect(float x, float y, float w, float h, string hex):
    Command(kind = "FillRect", x = x, y = y, w = w, h = h, hex = hex)

def Command stroke(float x, float y, float w, float h, float line, string hex):
    Command(kind = "StrokeRect", x = x, y = y, w = w, h = h, hex = hex, value = line)

def Command shadow(float x, float y, float w, float h, float radius, float dx, float dy, string hex):
    Command(kind = "DrawShadow", x = x, y = y, w = w, h = h, hex = hex, value = radius, dx = dx, dy = dy)

def Command text(float x, float y, float h, string content, string hex):
    Command(kind = "DrawText", x = x, y = y, w = 400.0, h = h, text = content, hex = hex)

def [Command] scene(int cards, int width, int height):
    mut [Command] list = [rect(0.0, 0.0, width as float, height as float, "#F2F2F7")]
    let columns = 4
    let cardW = (width as float - 20.0 * (columns + 1) as float) / columns as float
    let cardH = 150.0
    for i in 0..<cards:
        let x = 20.0 + (i % columns) as float * (cardW + 20.0)
        let y = 20.0 + (i / columns) as float * (cardH + 20.0)
        list.push(shadow(x, y, cardW, cardH, 12.0, 0.0, 4.0, "#00000040"))
        list.push(rect(x, y, cardW, cardH, "#FFFFFF"))
        list.push(stroke(x, y, cardW, cardH, 1.0, "#D1D1D6"))
        list.push(text(x + 12.0, y + 12.0, 20.0, "Card number {i} title", "#000000"))
        list.push(text(x + 12.0, y + 48.0, 16.0, "Second line of the card {i}", "#3C3C43"))
        list.push(text(x + 12.0, y + 76.0, 16.0, "Third line, a little longer", "#8E8E93"))
        list.push(rect(x + 12.0, y + 108.0, 80.0, 28.0, "#007AFF"))
        list.push(text(x + 20.0, y + 114.0, 16.0, "Open", "#FFFFFF"))
    list

def int ms(Instant start):
    start.elapsed().asMillis() as int

def run(int cards, int width, int height) throws:
    let list = scene(cards, width, height)
    let t0 = Instant.now()
    let encoded = encode(list, width, height)
    let encodeMs = ms(t0)
    # the first call of a kernel also creates its pipeline: warm each up, then time the following ones
    _ = rasterizeGpu(list, width, height)
    let t1 = Instant.now()
    let pixel = rasterizeGpu(list, width, height)
    let pixelMs = ms(t1)
    _ = rasterizeTiled(list, width, height)
    let t2 = Instant.now()
    var tiled = rasterizeTiled(list, width, height)
    for rep in 0..<2:
        tiled = rasterizeTiled(list, width, height)
    let tiledMs = ms(t2) / 3
    let t3 = Instant.now()
    let cpu = rasterize(list, width, height)
    let cpuMs = ms(t3)
    print "{width}x{height} commands={encoded.count}: cpu {cpuMs} ms | per-pixel kernel {pixelMs} ms | tiled kernel {tiledMs} ms (encode {encodeMs} ms) | tiled vs per-pixel {maxDifference(pixel, tiled)}, vs cpu {maxDifference(cpu, tiled)}"

run(8, 1280, 720)
run(24, 1280, 720)
run(24, 1920, 1080)
